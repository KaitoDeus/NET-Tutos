@model NET_Tutos.Models.ViewModels.TutorialEditViewModel
@{
    ViewData["Title"] = "Soạn bài học mới";
}

<div class="container-fluid px-3 px-xl-4 py-4">
    <partial name="_AdminNav" />

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Quản trị</a></li>
                    <li class="breadcrumb-item"><a asp-controller="AdminTutorials" asp-action="Index">Bài học</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Soạn mới</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0">Tạo bài học mới</h3>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
        </a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <partial name="_TutorialForm" model="Model" />
    </form>
</div>
