            70% {
                transform: scale(1);
                box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
            }
        }
        .interviewer-avatar-glow {
            position: relative;
            width: 104px;
            height: 104px;
            margin: 0 auto;
