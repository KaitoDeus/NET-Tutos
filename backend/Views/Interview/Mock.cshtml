@model NET_Tutos.Models.ViewModels.MockInterviewViewModel
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? ".NET AI Mock Technical Interview Simulator" : "Phòng Phỏng Vấn Kỹ Thuật .NET Với AI";
}

@Html.AntiForgeryToken()

<div class="container py-4 py-md-5" style="max-width: 980px;">
    <!-- Top Header & Timer Bar -->
    <div class="card border-0 rounded-4 shadow-sm bg-body p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center shadow-xs flex-shrink-0" style="width: 58px; height: 58px;">
                    <i class="bi bi-robot fs-2"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-danger bg-opacity-15 text-danger rounded-pill px-3 py-1 fw-bold d-inline-flex align-items-center gap-1.5">
                            <span class="spinner-grow spinner-grow-sm text-danger" role="status" style="width: 0.55rem; height: 0.55rem;"></span>
                            @(isEn ? "AI TECHNICAL INTERVIEW" : "PHỎNG VẤN TRỰC TIẾP VỚI AI")
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1 small fw-semibold">
                            @Model.Questions.Count @(isEn ? "Questions" : "Câu hỏi")
                        </span>
                    </div>
                    <h3 class="fw-bold mb-0 text-body-emphasis">
                        @(isEn ? ".NET Technical Mock Interview Simulator" : "Mô Phỏng Phỏng Vấn Kỹ Thuật .NET")
                    </h3>
                </div>
            </div>

            <!-- Countdown Timer & Actions -->
            <div class="d-flex align-items-center gap-3">
                <div class="text-end">
                    <div class="small text-muted">@(isEn ? "Time Remaining" : "Thời gian còn lại")</div>
                    <div id="mockCountdownTimer" class="fs-3 fw-bold font-monospace text-danger">10:00</div>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 small" onclick="return confirm('@(isEn ? "Are you sure you want to quit this mock interview?" : "Bạn có chắc chắn muốn thoát phiên phỏng vấn thử?")');">
                    <i class="bi bi-box-arrow-left me-1"></i> @(isEn ? "Quit" : "Thoát")
                </a>
            </div>
        </div>

        <!-- Mode Toggle & Navigation Stepper -->
        <div class="border-top mt-3 pt-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <!-- Mode switcher & Voice Call Button -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <div class="btn-group btn-group-sm p-1 rounded-pill bg-body-tertiary border shadow-xs" role="group">
                    <button type="button" class="btn btn-sm rounded-pill active fw-semibold px-3" id="tabModeAi" onclick="switchMode('ai')">
                        <i class="bi bi-robot me-1.5 text-primary"></i> @(isEn ? "AI Tech Lead Interviewer" : "Chấm Điểm Với AI Tech Lead")
                    </button>
                    <button type="button" class="btn btn-sm rounded-pill fw-semibold px-3 text-muted" id="tabModeClassic" onclick="switchMode('classic')">
                        <i class="bi bi-pencil-square me-1.5"></i> @(isEn ? "Classic Self-Check" : "Tự Ôn Tập Nhanh")
                    </button>
                </div>

                <button type="button" class="btn btn-sm btn-call-gradient text-white rounded-pill px-3.5 py-1.5 fw-bold shadow-sm d-inline-flex align-items-center gap-1.5" onclick="launchVoiceCall()">
                    <span class="pulse-call-dot"></span>
                    <i class="bi bi-telephone-fill"></i> @(isEn ? "Live Voice Call Mode" : "Cuộc Gọi Thoại 1-1")
                </button>
            </div>

            <!-- Question Stepper Badges -->
            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                <span class="small text-muted fw-semibold me-1">@(isEn ? "Jump to:" : "Câu hỏi:")</span>
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    <button type="button" class="btn btn-sm rounded-circle p-0 fw-bold border question-stepper-btn @(i == 0 ? "btn-primary text-white" : "btn-outline-secondary")" 
                            style="width: 32px; height: 32px;" id="stepperBtn-@i" onclick="scrollToQuestion(@i)">
                        @(i + 1)
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Active Interview Form -->
    <div id="mockInterviewFormContainer">
        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="card border rounded-4 shadow-sm p-4 mb-4 bg-body mock-question-block" id="questionBlock-@i" data-question-id="@q.Id" data-question-index="@i" data-question-topic="@q.Topic" data-question-diff="@q.Difficulty">
                <!-- Question Header -->
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-bold">
                            @(isEn ? $"Question {i + 1}" : $"Câu hỏi {i + 1}") / @Model.Questions.Count
                        </span>
                        <span class="badge bg-@q.TopicBadgeClass bg-opacity-10 text-@q.TopicBadgeClass rounded-pill px-2.5 py-1 small fw-semibold">
                            @q.TopicName
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-@q.DifficultyBadgeClass bg-opacity-15 text-@q.DifficultyBadgeClass rounded-pill px-2.5 py-1 small">
                            @q.DifficultyName
                        </span>
                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1 small ai-status-badge d-none" id="aiStatusBadge-@q.Id">
                            <i class="bi bi-check2"></i> @(isEn ? "AI Evaluated" : "Đã có nhận xét AI")
                        </span>
                    </div>
                </div>

                <!-- Question Prompt -->
                <h5 class="fw-bold text-body-emphasis mb-3" style="line-height: 1.5;" id="questionText-@q.Id">
                    @q.Question
                </h5>

                @if (!string.IsNullOrEmpty(q.QuickHint))
                {
                    <div class="small text-muted mb-3 d-flex align-items-center gap-1.5">
                        <i class="bi bi-lightbulb text-warning"></i>
                        <span><strong>@(isEn ? "Hint:" : "Gợi ý:")</strong> @q.QuickHint</span>
                    </div>
                }

                <!-- Candidate Answer Input Area -->
                <div class="mb-3">
                    <div class="d-flex align-items-center justify-content-between mb-1.5">
                        <label class="form-label small fw-semibold text-muted mb-0">
                            <i class="bi bi-chat-quote-fill text-primary me-1"></i> @(isEn ? "Your Technical Explanation (State concept, mechanism, & real-world caveats):" : "Câu trả lời của bạn (Trình bày khái niệm, cơ chế bên dưới, và ví dụ/lưu ý thực tế):")
                        </label>
                        <div class="d-flex align-items-center gap-1.5">
                            <!-- AI Read Question button (TTS) -->
                            <button type="button" class="btn btn-xs btn-outline-primary rounded-pill px-2.5 py-1 small fw-semibold d-inline-flex align-items-center gap-1" id="ttsBtn-@q.Id" onclick="toggleReadQuestion(@q.Id)">
                                <i class="bi bi-volume-up-fill" id="ttsIcon-@q.Id"></i> <span id="ttsBtnText-@q.Id">@(isEn ? "Read Question" : "Tech Lead Đọc")</span>
                            </button>
                            <!-- Speech-to-text dictation button -->
                            <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2.5 py-1 small fw-semibold d-inline-flex align-items-center gap-1 voice-record-btn" id="voiceBtn-@q.Id" onclick="toggleVoiceRecording(@q.Id)">
                                <i class="bi bi-mic-fill"></i> <span id="voiceBtnText-@q.Id">@(isEn ? "Speak Answer" : "Nói câu trả lời")</span>
                            </button>
                        </div>
                    </div>
                    <textarea class="form-control rounded-3 font-monospace small candidate-answer-text" id="answerInput-@q.Id" rows="4" placeholder="@(isEn ? "Example: Explain the core definition, internal state machine / CLR execution, and production trade-offs..." : "Ví dụ: Trình bày khái niệm, cách CLR xử lý bên dưới, và các bẫy thực tế trong dự án lớn...")"></textarea>
                </div>

                <!-- AI Evaluation Action Bar (AI Mode) -->
                <div class="ai-mode-panel mb-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3.5 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs" id="btnEvaluateAi-@q.Id" onclick="evaluateAnswerWithAi(@q.Id)">
                            <i class="bi bi-robot"></i> <span>@(isEn ? "Submit to AI Tech Lead for Assessment" : "Gửi Cho AI Tech Lead Chấm Điểm")</span>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5 small fw-semibold" onclick="toggleBenchmarkAnswer(@q.Id)">
                            <i class="bi bi-eye me-1"></i> @(isEn ? "View Benchmark Answer" : "Xem Đáp Án Chuẩn")
                        </button>
                    </div>
                </div>

                <!-- AI Live Assessment Result Card -->
                <div id="aiEvaluationResult-@q.Id" class="border rounded-4 p-3.5 mb-3 d-none bg-body-tertiary">
                    <!-- Dynamic AI Output will be injected here -->
                </div>

                <!-- Hidden Benchmark Answer Area -->
                <div id="benchmarkAnswer-@q.Id" class="p-3.5 bg-body-tertiary rounded-4 border mb-3 d-none">
                    <div class="small fw-bold text-success text-uppercase mb-2">
                        <i class="bi bi-check2-circle me-1"></i> @(isEn ? "Interviewer's Expected Benchmark Answer:" : "Tiêu Chuẩn Đánh Giá Của Phỏng Vấn Viên:")
                    </div>
                    <div class="tutorial-markdown-content small mb-3">
                        @Html.Raw(q.AnswerHtml)
                    </div>

                    @if (!string.IsNullOrEmpty(q.InterviewTip))
                    {
                        <div class="alert alert-warning border-warning rounded-3 p-2.5 mb-3 small">
                            <i class="bi bi-stars text-warning me-1"></i> <strong>@(isEn ? "Pro Interview Tip:" : "Mẹo Phỏng Vấn Thực Chiến:")</strong> @q.InterviewTip
                        </div>
                    }

                    <!-- Classic Self-Rating Radio Group (Visible in Classic Mode) -->
                    <div class="classic-mode-panel border-top pt-2.5">
                        <label class="form-label small fw-bold text-body-emphasis mb-2">
                            @(isEn ? "Self-Evaluate Your Answer:" : "Tự đánh giá câu trả lời của bạn:")
                        </label>
                        <div class="d-flex gap-2 flex-wrap">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input score-radio" type="radio" name="score_@q.Id" id="score_@q.Id-0" value="0" />
                                <label class="form-check-label small" for="score_@q.Id-0">0% (@(isEn ? "Blank" : "Chưa nhớ gì"))</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input score-radio" type="radio" name="score_@q.Id" id="score_@q.Id-50" value="50" />
                                <label class="form-check-label small" for="score_@q.Id-50">50% (@(isEn ? "Partial" : "Được 1 phần ý"))</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input score-radio" type="radio" name="score_@q.Id" id="score_@q.Id-80" value="80" checked />
                                <label class="form-check-label small" for="score_@q.Id-80">80% (@(isEn ? "Good" : "Khá tốt / Đủ ý"))</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input score-radio" type="radio" name="score_@q.Id" id="score_@q.Id-100" value="100" />
                                <label class="form-check-label small fw-bold text-success" for="score_@q.Id-100">100% (@(isEn ? "Senior" : "Xuất sắc / Chuyên sâu"))</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Finish & Submit Interview Bar -->
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-body text-center">
            <h5 class="fw-bold mb-1 text-body-emphasis">@(isEn ? "Completed All Interview Questions?" : "Đã Hoàn Thành Toàn Bộ Câu Hỏi?")</h5>
            <p class="small text-muted mb-3">@(isEn ? "Submit your responses to receive a comprehensive Technical Readiness Report and earn XP!" : "Nộp bài để AI Lead tổng hợp Báo cáo Năng lực Kỹ thuật toàn diện và nhận thưởng điểm XP!")</p>
            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-primary rounded-pill px-5 py-2.5 fw-bold fs-6 shadow-sm d-inline-flex align-items-center gap-2" id="btnFinishMock" onclick="submitFullMockInterview()">
                    <i class="bi bi-send-check-fill"></i>
                    <span>@(isEn ? "Finish & Get AI Evaluation Report" : "Hoàn Thành & Xuất Báo Cáo Năng Lực AI")</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Results View (Hidden until submit) -->
    <div id="mockResultsView" class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-body d-none">
        <div class="text-center mb-4">
            <div id="resultIconBox" class="rounded-circle bg-success bg-opacity-15 text-success mx-auto mb-3 d-flex align-items-center justify-content-center shadow-xs" style="width: 84px; height: 84px;">
                <i class="bi bi-award-fill display-5"></i>
            </div>
            <span class="badge rounded-pill px-3 py-1.5 fw-bold mb-2 fs-6" id="resultReadinessBadge"></span>
            <h2 id="resultReadinessTitle" class="display-6 fw-bold text-body-emphasis mb-1"></h2>
            <div class="fs-1 fw-bold text-primary mb-2">
                <span id="resultAvgScore">0</span><small class="fs-4 text-muted">/100</small>
            </div>
            <p id="resultFeedbackText" class="text-body-secondary lead fs-6 mx-auto mb-3" style="max-width: 720px;"></p>

            <div class="d-inline-flex align-items-center gap-2 mb-3">
                <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-50 rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-lightning-charge-fill text-danger me-1"></i> +<span id="resultXpAwarded">0</span> XP
                </span>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-stopwatch me-1"></i> <span id="resultTimeSpent">0s</span>
                </span>
            </div>
        </div>

        <!-- 5-Core .NET Skill Breakdown Radar / Bars -->
        <div class="border rounded-4 p-4 mb-4 bg-body-tertiary">
            <h6 class="fw-bold mb-3 d-flex align-items-center gap-2 text-body">
                <i class="bi bi-bar-chart-line-fill text-primary"></i>
                @(isEn ? "Candidate Technical Skill Assessment:" : "Đánh Giá Năng Lực 5 Kỹ Năng Cốt Lõi .NET:")
            </h6>
            <div id="skillBreakdownContainer" class="d-flex flex-column gap-3">
                <!-- Injected via JS -->
            </div>
        </div>

        <!-- Actionable Learning Recommendations -->
        <div class="border rounded-4 p-4 mb-4 bg-body" id="recommendedLessonsBox">
            <h6 class="fw-bold mb-2 d-flex align-items-center gap-2 text-success">
                <i class="bi bi-mortarboard-fill"></i>
                @(isEn ? "Actionable Next Steps - Tailored Lesson Recommendations:" : "Lộ Trình Cải Thiện - Bài Học Đề Xuất Cho Bạn:")
            </h6>
            <p class="small text-muted mb-3">@(isEn ? "Based on your mock performance, study these tutorials to bridge your technical gaps:" : "Dựa trên điểm số phỏng vấn, hãy ôn luyện thêm các bài học sau để bứt phá lên bậc tiếp theo:")</p>
            <div id="recommendedLessonsList" class="row g-2.5">
                <!-- Injected via JS -->
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a asp-action="Mock" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-xs">
                <i class="bi bi-arrow-repeat me-1"></i> @(isEn ? "Take Another Mock" : "Thử Bộ Đề Khác")
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-bold">
                <i class="bi bi-house-door-fill me-1"></i> @(isEn ? "Back to Flashcards Hub" : "Về Trung Tâm Flashcards")
            </a>
        </div>
    </div>
</div>

<!-- Virtual AI Technical Interview Meeting Modal (Voice Call Mode) -->
<div class="modal fade" id="voiceCallModal" tabindex="-1" aria-labelledby="voiceCallModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden" style="background: #0a0f1d; color: #f8fafc; min-height: 620px;">
            
            <!-- Modal Header (Meeting Bar) -->
            <div class="modal-header border-bottom border-secondary border-opacity-25 px-4 py-3" style="background: #0e1629;">
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-danger rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center gap-1.5">
                        <span class="spinner-grow spinner-grow-sm text-white" role="status" style="width: 0.5rem; height: 0.5rem;"></span>
                        LIVE MEETING
                    </span>
                    <div>
                        <h6 class="modal-title fw-bold mb-0 text-white" id="voiceCallModalLabel">
                            <i class="bi bi-camera-video-fill text-primary me-1.5"></i>
                            @(isEn ? "1-on-1 Technical Screen: .NET Senior Competency" : "Phỏng Vấn Sát Hạch Kỹ Thuật 1-1 (.NET Senior)")
                        </h6>
                        <small class="text-secondary" id="callStatusIndicator">Đang kết nối với AI Tech Lead...</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2.5 flex-wrap">
                    <!-- Call Timer -->
                    <div class="badge bg-dark border border-secondary border-opacity-25 text-white font-monospace px-3 py-2 fs-6">
                        <i class="bi bi-clock me-1 text-warning"></i> <span id="callDurationTimer">00:00</span>
                    </div>

                    <!-- Persona Switcher -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill text-white" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btnCurrentPersona">
                            <i class="bi bi-person-badge me-1 text-info"></i> Alex Nguyen (Architect)
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-sm">
                            <li><h6 class="dropdown-header">Chọn Phỏng Vấn Viên:</h6></li>
                            <li><a class="dropdown-item active" href="javascript:void(0)" onclick="selectCallPersona('alex')"><strong>Alex Nguyen</strong> - Senior Principal Architect (Sát hạch sâu CLR)</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="selectCallPersona('sarah')"><strong>Sarah Pham</strong> - Engineering Manager (Kiến trúc & Clean Code)</a></li>
                        </ul>
                    </div>

                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="closeVoiceCall()"></button>
                </div>
            </div>

            <!-- Modal Body (Meeting Stage) -->
            <div class="modal-body p-4 p-md-5 d-flex flex-column justify-content-between" style="background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.12) 0%, rgba(10, 15, 29, 0.98) 70%);">
                
                <!-- Main Interviewer Virtual Presence -->
                <div class="text-center my-auto">
                    <!-- Glow Avatar -->
                    <div class="interviewer-avatar-glow mb-3" id="interviewerAvatarGlow">
                        <div class="interviewer-avatar-img" id="interviewerAvatarIcon">
                            <i class="bi bi-person-fill"></i>
                        </div>
                    </div>

                    <h4 class="fw-bold text-white mb-1" id="interviewerName">Alex Nguyen</h4>
                    <p class="text-secondary small mb-3" id="interviewerRole">Senior Principal .NET Architect • Lead Interviewer</p>

                    <!-- Animated Voice Sound Wave -->
                    <div class="voice-wave mb-3" id="voiceWaveVisualizer">
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                        <div class="bar"></div>
                    </div>

                    <div class="badge bg-primary bg-opacity-20 text-primary-emphasis border border-primary border-opacity-25 rounded-pill px-3 py-1 mb-3" id="callInterviewerStatus">
                        Tech Lead đang chuẩn bị câu hỏi...
                    </div>
                </div>

                <!-- Live Subtitles & Conversation Stage -->
                <div class="card border border-secondary border-opacity-25 rounded-4 p-3.5 mb-3 mx-auto w-100" style="max-width: 860px; background: rgba(17, 24, 39, 0.7); backdrop-filter: blur(8px);">
                    <!-- Question Header & Badges -->
                    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-pill px-2.5 py-1 fw-bold" id="callQuestionBadge">Câu 1 / 5</span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1" id="callTopicBadge">C# Core</span>
                        </div>
                        <button type="button" class="btn btn-xs btn-outline-info rounded-pill px-2.5 py-1" onclick="replayCallQuestion()">
                            <i class="bi bi-arrow-repeat me-1"></i> Nghe lại câu hỏi
                        </button>
                    </div>

                    <!-- Question Text -->
                    <h5 class="fw-bold text-white mb-3" id="callQuestionText" style="line-height: 1.45;">...</h5>

                    <!-- Live Candidate Transcript / Input -->
                    <div class="p-3 rounded-3 border border-secondary border-opacity-25 mb-2" style="background: rgba(0, 0, 0, 0.35);">
                        <div class="d-flex align-items-center justify-content-between mb-1.5">
                            <span class="small fw-semibold text-info d-flex align-items-center gap-1.5">
                                <i class="bi bi-mic-fill" id="callCandidateMicIcon"></i>
                                <span id="callCandidateStatus">Đang lắng nghe câu trả lời của bạn...</span>
                            </span>
                            <span class="small text-secondary" id="callWordCount">0 từ</span>
                        </div>
                        <p class="mb-0 text-white font-monospace small" id="callLiveTranscript" style="min-height: 48px; max-height: 120px; overflow-y: auto;">
                            <em>Bấm bật micro hoặc nói câu trả lời của bạn vào mic máy tính...</em>
                        </p>
                    </div>

                    <!-- AI Instant Spoken Feedback Box (Visible after answer submission) -->
                    <div class="p-3 rounded-3 border border-success border-opacity-25 d-none" id="callFeedbackBox" style="background: rgba(6, 78, 59, 0.3);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-success rounded-pill px-2.5 py-1 fw-bold" id="callScoreBadge">85/100</span>
                                <span class="fw-semibold text-success small" id="callRatingBadge">Trình độ Middle/Senior</span>
                            </div>
                            <button type="button" class="btn btn-xs btn-outline-success rounded-pill px-2 py-0.5" onclick="replayAiFeedback()">
                                <i class="bi bi-volume-up-fill me-1"></i> Nghe lại nhận xét
                            </button>
                        </div>
                        <p class="small text-white-50 mb-2" id="callFeedbackText">...</p>
                        
                        <!-- Follow-up Question Alert -->
                        <div class="card border-warning-subtle bg-warning bg-opacity-10 p-2.5 rounded-3 mb-0" id="callFollowUpCard">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="small fw-bold text-warning"><i class="bi bi-question-circle-fill me-1"></i> Câu hỏi xoáy từ Tech Lead:</span>
                                <span class="badge bg-warning text-dark rounded-pill">+Bonus XP</span>
                            </div>
                            <p class="small text-warning-emphasis fw-semibold mb-0" id="callFollowUpText">...</p>
                        </div>
                    </div>
                </div>

                <!-- Floating Meeting Control Dock -->
                <div class="text-center mt-2">
                    <div class="call-dock">
                        <!-- Mic Toggle -->
                        <button type="button" class="call-dock-btn btn-mic-active" id="btnCallToggleMic" onclick="toggleCallMic()" title="Bật/Tắt Micro">
                            <i class="bi bi-mic-fill" id="callMicIcon"></i>
                        </button>

                        <!-- AI Voice Audio Toggle -->
                        <button type="button" class="call-dock-btn bg-dark text-white border border-secondary" id="btnCallToggleSpeaker" onclick="toggleCallSpeaker()" title="Bật/Tắt Loa AI">
                            <i class="bi bi-volume-up-fill" id="callSpeakerIcon"></i>
                        </button>

                        <!-- Voice Speed Switcher -->
                        <button type="button" class="btn btn-sm btn-dark border border-secondary rounded-pill px-3 py-2 text-white small fw-bold" id="btnCallSpeed" onclick="cycleCallSpeed()">
                            1.0x
                        </button>

                        <div class="vr bg-secondary opacity-50 my-1"></div>

                        <!-- Submit Current Answer -->
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-1.5 shadow-sm" id="btnCallSubmitAnswer" onclick="submitCallAnswer()">
                            <i class="bi bi-send-fill"></i> <span>Gửi Trả Lời</span>
                        </button>

                        <!-- Next Question Button -->
                        <button type="button" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1" id="btnCallNextQuestion" onclick="nextCallQuestion()">
                            <span>Câu tiếp</span> <i class="bi bi-chevron-right"></i>
                        </button>

                        <!-- Hangup / End Meeting -->
                        <button type="button" class="call-dock-btn btn-hangup" onclick="endVoiceCall()" title="Kết thúc buổi phỏng vấn & Xuất báo cáo">
                            <i class="bi bi-telephone-x-fill"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <style>
        .btn-call-gradient {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%);
            border: none;
            transition: all 0.25s ease;
        }
        .btn-call-gradient:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(124, 58, 237, 0.45);
