        function escapeHtml(text) {
            if (!text) return '';
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.toString().replace(/[&<>"']/g, m => map[m]);
        }

        function escapeAttr(text) {
            if (!text) return '';
            return text.toString()
                .replace(/\\/g, '\\\\')
                .replace(/'/g, "\\'")
                .replace(/"/g, '&quot;')
                .replace(/\r/g, '')
                .replace(/\n/g, '\\n');
        }

        // ==========================================
        // Web Audio API Meeting Sound Effects
        // ==========================================
        const CallAudio = {
            ctx: null,
            getCtx: function () {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (AudioContext) this.ctx = new AudioContext();
                }
                if (this.ctx && this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
                return this.ctx;
            },
            playJoin: function () {
                const ctx = this.getCtx();
                if (!ctx) return;
                try {
                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.18); // E5
                    gain.gain.setValueAtTime(0.01, now);
                    gain.gain.linearRampToValueAtTime(0.18, now + 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

                    osc.start(now);
                    osc.stop(now + 0.4);
                } catch (e) { console.warn(e); }
            },
            playMicBeep: function (isOn) {
                const ctx = this.getCtx();
                if (!ctx) return;
                try {
                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    const freq = isOn ? 784 : 440;
                    osc.frequency.setValueAtTime(freq, now);
                    gain.gain.setValueAtTime(0.01, now);
                    gain.gain.linearRampToValueAtTime(0.12, now + 0.03);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);

                    osc.start(now);
                    osc.stop(now + 0.18);
                } catch (e) { console.warn(e); }
            },
            playSubmitChime: function () {
                const ctx = this.getCtx();
                if (!ctx) return;
                try {
                    const notes = [523.25, 659.25, 783.99]; // C - E - G chord
                    notes.forEach((freq, i) => {
                        const now = ctx.currentTime + i * 0.08;
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.frequency.setValueAtTime(freq, now);
                        gain.gain.setValueAtTime(0.01, now);
                        gain.gain.linearRampToValueAtTime(0.16, now + 0.02);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
                        osc.start(now);
                        osc.stop(now + 0.28);
                    });
                } catch (e) { console.warn(e); }
            },
            playHangup: function () {
                const ctx = this.getCtx();
                if (!ctx) return;
                try {
                    const now = ctx.currentTime;
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.connect(gain);
                    gain.connect(ctx.destination);

                    osc.frequency.setValueAtTime(440, now);
                    osc.frequency.exponentialRampToValueAtTime(261.63, now + 0.25);
                    gain.gain.setValueAtTime(0.14, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);

                    osc.start(now);
                    osc.stop(now + 0.3);
                } catch (e) { console.warn(e); }
            }
        };

        // ==========================================
        // AI Voice Synthesis (Web Speech API TTS)
        // ==========================================
        const AiVoice = {
            synth: window.speechSynthesis,
            isMuted: false,
            rate: 1.0,
            currentUtterance: null,

            cleanMarkdown: function (text) {
                if (!text) return '';
                return text
                    .replace(/```[\s\S]*?```/g, ' ')
                    .replace(/`([^`]+)`/g, '$1')
                    .replace(/#{1,6}\s+/g, '')
                    .replace(/(\*\*|__)(.*?)\1/g, '$2')
                    .replace(/(\*|_)(.*?)\1/g, '$2')
                    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
                    .replace(/<[^>]*>/g, '')
                    .replace(/&nbsp;/g, ' ')
                    .replace(/&amp;/g, '&')
                    .trim();
            },

            speak: function (text, onStart, onEnd) {
                if (!this.synth) {
                    console.warn('SpeechSynthesis is not supported by this browser.');
                    if (onEnd) onEnd();
                    return;
                }

                this.stop();
                if (this.isMuted) {
                    if (onEnd) onEnd();
                    return;
                }

                const clean = this.cleanMarkdown(text);
                if (!clean) {
                    if (onEnd) onEnd();
                    return;
                }

                const utterance = new SpeechSynthesisUtterance(clean);
                utterance.rate = this.rate;
                utterance.pitch = (VoiceCallManager.persona === 'sarah') ? 1.15 : 0.95;

                const voices = this.synth.getVoices();
                const targetLang = isEn ? 'en' : 'vi';
                let matchedVoice = null;

                if (VoiceCallManager.persona === 'sarah') {
                    matchedVoice = voices.find(v => v.lang.toLowerCase().startsWith(targetLang) &&
                        (v.name.toLowerCase().includes('female') || v.name.toLowerCase().includes('zira') || v.name.toLowerCase().includes('linh') || v.name.toLowerCase().includes('samantha')));
                } else {
                    matchedVoice = voices.find(v => v.lang.toLowerCase().startsWith(targetLang) &&
                        (v.name.toLowerCase().includes('male') || v.name.toLowerCase().includes('david') || v.name.toLowerCase().includes('an') || v.name.toLowerCase().includes('nam')));
                }

                if (!matchedVoice) {
                    matchedVoice = voices.find(v => v.lang.toLowerCase().startsWith(targetLang));
                }

                if (matchedVoice) {
                    utterance.voice = matchedVoice;
                } else {
                    utterance.lang = isEn ? 'en-US' : 'vi-VN';
                }

                utterance.onstart = () => {
                    this.currentUtterance = utterance;
                    document.getElementById('voiceWaveVisualizer')?.classList.add('speaking');
                    document.getElementById('interviewerAvatarGlow')?.classList.add('speaking');
                    if (onStart) onStart();
                };

                utterance.onend = () => {
                    this.currentUtterance = null;
                    document.getElementById('voiceWaveVisualizer')?.classList.remove('speaking');
                    document.getElementById('interviewerAvatarGlow')?.classList.remove('speaking');
                    if (onEnd) onEnd();
                };

                utterance.onerror = (e) => {
                    console.warn('TTS playback error:', e);
                    this.currentUtterance = null;
                    document.getElementById('voiceWaveVisualizer')?.classList.remove('speaking');
                    document.getElementById('interviewerAvatarGlow')?.classList.remove('speaking');
                    if (onEnd) onEnd();
                };

                this.synth.speak(utterance);
            },

            stop: function () {
                if (this.synth) {
                    this.synth.cancel();
                }
                this.currentUtterance = null;
                document.getElementById('voiceWaveVisualizer')?.classList.remove('speaking');
                document.getElementById('interviewerAvatarGlow')?.classList.remove('speaking');
            }
        };

        // In-card TTS player for individual questions
        let activeReadingQuestionId = null;
        function toggleReadQuestion(qId) {
            const btnText = document.getElementById(`ttsBtnText-${qId}`);
            const icon = document.getElementById(`ttsIcon-${qId}`);
            const qText = document.getElementById(`questionText-${qId}`)?.innerText || '';

            if (activeReadingQuestionId === qId) {
                AiVoice.stop();
                activeReadingQuestionId = null;
                if (btnText) btnText.innerText = isEn ? "Read Question" : "Tech Lead Đọc";
                if (icon) icon.className = "bi bi-volume-up-fill";
                return;
            }

            if (activeReadingQuestionId !== null) {
                const prevBtnText = document.getElementById(`ttsBtnText-${activeReadingQuestionId}`);
                const prevIcon = document.getElementById(`ttsIcon-${activeReadingQuestionId}`);
                if (prevBtnText) prevBtnText.innerText = isEn ? "Read Question" : "Tech Lead Đọc";
                if (prevIcon) prevIcon.className = "bi bi-volume-up-fill";
                AiVoice.stop();
            }

            activeReadingQuestionId = qId;
            if (btnText) btnText.innerText = isEn ? "Stop Audio" : "Dừng Đọc";
            if (icon) icon.className = "bi bi-stop-circle-fill text-danger";

            AiVoice.speak(qText, null, () => {
                activeReadingQuestionId = null;
                if (btnText) btnText.innerText = isEn ? "Read Question" : "Tech Lead Đọc";
                if (icon) icon.className = "bi bi-volume-up-fill";
            });
        }

        // ==========================================
        // Live Voice Call Mode Meeting Manager
        // ==========================================
        const VoiceCallManager = {
            modalInstance: null,
            currentIndex: 0,
            persona: 'alex',
            isActive: false,
            timerSeconds: 0,
            timerInterval: null,
            recognition: null,
            isMicListening: false,
            currentTranscript: '',
            evaluations: {},

            init: function () {
                if (this.recognition) return;
                const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
                if (SpeechRecognition) {
                    this.recognition = new SpeechRecognition();
                    this.recognition.lang = isEn ? 'en-US' : 'vi-VN';
                    this.recognition.continuous = true;
                    this.recognition.interimResults = true;

                    this.recognition.onstart = () => {
                        this.isMicListening = true;
                        this.updateMicUI(true);
                    };

                    this.recognition.onresult = (event) => {
                        let interim = '';
                        for (let i = event.resultIndex; i < event.results.length; ++i) {
                            if (event.results[i].isFinal) {
                                this.currentTranscript += ' ' + event.results[i][0].transcript;
                            } else {
                                interim += event.results[i][0].transcript;
                            }
                        }
                        const display = (this.currentTranscript + ' ' + interim).trim();
                        const transcriptEl = document.getElementById('callLiveTranscript');
                        if (transcriptEl) {
                            transcriptEl.innerText = display || (isEn ? 'Listening to your voice...' : 'Đang lắng nghe câu trả lời...');
                        }
                        const words = display ? display.split(/\s+/).filter(w => w.length > 0).length : 0;
                        const wordEl = document.getElementById('callWordCount');
                        if (wordEl) wordEl.innerText = `${words} ${isEn ? 'words' : 'từ'}`;
                    };

                    this.recognition.onerror = (e) => {
                        console.warn('Call mic recognition error:', e.error);
                        if (e.error === 'not-allowed') {
                            alert(isEn ? 'Microphone permission was denied. Please allow microphone access in your browser.' : 'Quyền truy cập Microphone bị từ chối. Vui lòng cấp quyền micro để đàm thoại.');
                        }
                        this.isMicListening = false;
                        this.updateMicUI(false);
                    };

                    this.recognition.onend = () => {
                        this.isMicListening = false;
                        this.updateMicUI(false);
                    };
                }
            },

            updateMicUI: function (listening) {
                const btn = document.getElementById('btnCallToggleMic');
                const icon = document.getElementById('callMicIcon');
                const candMicIcon = document.getElementById('callCandidateMicIcon');
                const candStatus = document.getElementById('callCandidateStatus');

                if (listening) {
                    if (btn) btn.className = 'call-dock-btn btn-mic-active';
                    if (icon) icon.className = 'bi bi-mic-fill';
                    if (candMicIcon) candMicIcon.className = 'bi bi-mic-fill text-success';
                    if (candStatus) candStatus.innerText = isEn ? 'AI Lead is listening to your answer...' : 'AI Lead đang lắng nghe câu trả lời của bạn...';
                } else {
                    if (btn) btn.className = 'call-dock-btn btn-mic-muted';
                    if (icon) icon.className = 'bi bi-mic-mute-fill';
                    if (candMicIcon) candMicIcon.className = 'bi bi-mic-mute-fill text-danger';
                    if (candStatus) candStatus.innerText = isEn ? 'Microphone is muted (Click mic button to speak)' : 'Micro đang tắt (Bấm biểu tượng micro bên dưới để nói)';
                }
            },

            startListening: function () {
                if (!this.recognition) return;
                if (this.isMicListening) return;
                try {
                    CallAudio.playMicBeep(true);
                    this.recognition.start();
                } catch (e) {
                    console.warn(e);
                }
            },

            stopListening: function () {
                if (!this.recognition) return;
                if (!this.isMicListening) return;
                try {
                    CallAudio.playMicBeep(false);
                    this.recognition.stop();
                } catch (e) {
                    console.warn(e);
                }
            },

            toggleMic: function () {
                if (this.isMicListening) {
                    this.stopListening();
                } else {
                    this.startListening();
                }
            },

            toggleSpeaker: function () {
                AiVoice.isMuted = !AiVoice.isMuted;
                const icon = document.getElementById('callSpeakerIcon');
                const btn = document.getElementById('btnCallToggleSpeaker');
                if (AiVoice.isMuted) {
                    AiVoice.stop();
                    if (icon) icon.className = 'bi bi-volume-mute-fill text-danger';
                    if (btn) btn.className = 'call-dock-btn bg-danger text-white border-0';
                } else {
                    if (icon) icon.className = 'bi bi-volume-up-fill text-white';
                    if (btn) btn.className = 'call-dock-btn bg-dark text-white border border-secondary';
                }
            },

            cycleSpeed: function () {
                if (AiVoice.rate === 1.0) AiVoice.rate = 1.25;
                else if (AiVoice.rate === 1.25) AiVoice.rate = 0.85;
                else AiVoice.rate = 1.0;

                const btn = document.getElementById('btnCallSpeed');
                if (btn) btn.innerText = `${AiVoice.rate}x`;
            },

            setPersona: function (type) {
                this.persona = type;
                const btn = document.getElementById('btnCurrentPersona');
                const avatarIcon = document.getElementById('interviewerAvatarIcon');
                const nameEl = document.getElementById('interviewerName');
                const roleEl = document.getElementById('interviewerRole');

                if (type === 'sarah') {
                    if (btn) btn.innerHTML = `<i class="bi bi-person-badge me-1 text-warning"></i> Sarah Pham (EM)`;
                    if (avatarIcon) avatarIcon.innerHTML = `<i class="bi bi-person-heart"></i>`;
                    if (nameEl) nameEl.innerText = 'Sarah Pham';
                    if (roleEl) roleEl.innerText = isEn ? 'Engineering Manager • Software Architect' : 'Engineering Manager • Chuyên gia Kiến trúc & Clean Code';
                } else {
                    if (btn) btn.innerHTML = `<i class="bi bi-person-badge me-1 text-info"></i> Alex Nguyen (Architect)`;
                    if (avatarIcon) avatarIcon.innerHTML = `<i class="bi bi-person-fill"></i>`;
                    if (nameEl) nameEl.innerText = 'Alex Nguyen';
                    if (roleEl) roleEl.innerText = isEn ? 'Senior Principal .NET Architect • Lead Interviewer' : 'Senior Principal .NET Architect • Giám khảo Sát hạch CLR';
                }
            },

            startCall: function () {
                const modalEl = document.getElementById('voiceCallModal');
                if (!modalEl) return;

                this.init();
                this.isActive = true;
                this.currentIndex = 0;
                this.timerSeconds = 0;

                CallAudio.playJoin();

                if (!this.modalInstance) {
                    this.modalInstance = new bootstrap.Modal(modalEl, { backdrop: 'static', keyboard: false });
                }
                this.modalInstance.show();

                if (this.timerInterval) clearInterval(this.timerInterval);
                this.timerInterval = setInterval(() => {
                    this.timerSeconds++;
                    const mins = Math.floor(this.timerSeconds / 60);
                    const secs = this.timerSeconds % 60;
                    const timerEl = document.getElementById('callDurationTimer');
                    if (timerEl) timerEl.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                }, 1000);

                this.loadQuestion(0);
            },

            loadQuestion: function (index) {
                if (!mockQuestions || mockQuestions.length === 0) return;
                if (index < 0 || index >= mockQuestions.length) return;

                this.currentIndex = index;
                const q = mockQuestions[index];

                this.currentTranscript = '';
                const transcriptEl = document.getElementById('callLiveTranscript');
                if (transcriptEl) transcriptEl.innerHTML = `<em>${isEn ? 'Interviewer is speaking the question. Speak after they finish...' : 'AI Lead đang đọc câu hỏi. Bạn hãy trả lời sau khi Lead dứt lời...'}</em>`;
                const wordEl = document.getElementById('callWordCount');
                if (wordEl) wordEl.innerText = `0 ${isEn ? 'words' : 'từ'}`;

                document.getElementById('callFeedbackBox')?.classList.add('d-none');
                document.getElementById('callQuestionBadge').innerText = `${isEn ? 'Question' : 'Câu'} ${index + 1} / ${mockQuestions.length}`;
                document.getElementById('callTopicBadge').innerText = q.topic || '.NET Core';
                document.getElementById('callQuestionText').innerText = q.question;

                const nextBtn = document.getElementById('btnCallNextQuestion');
                if (nextBtn) {
                    nextBtn.innerHTML = (index === mockQuestions.length - 1)
                        ? `<span>${isEn ? 'Finish Call' : 'Hoàn Tất & Nộp Bài'}</span> <i class="bi bi-award-fill ms-1"></i>`
                        : `<span>${isEn ? 'Next Question' : 'Câu tiếp'}</span> <i class="bi bi-chevron-right"></i>`;
                }

                const statusEl = document.getElementById('callInterviewerStatus');
                if (statusEl) statusEl.innerText = `${this.persona === 'sarah' ? 'Sarah' : 'Alex'} ${isEn ? 'is reading question...' : 'đang đọc câu hỏi sát hạch...'}`;

                this.stopListening();

                const greeting = index === 0
                    ? (isEn ? `Welcome to your technical screen. Let's begin with question one: ${q.question}` : `Chào bạn, chúng ta bắt đầu buổi phỏng vấn nhé. Câu hỏi đầu tiên dành cho bạn: ${q.question}`)
                    : (isEn ? `Question number ${index + 1}: ${q.question}` : `Câu hỏi số ${index + 1}: ${q.question}`);

                AiVoice.speak(greeting, null, () => {
                    if (statusEl) statusEl.innerText = `${this.persona === 'sarah' ? 'Sarah' : 'Alex'} ${isEn ? 'is listening to your response.' : 'đang lắng nghe bạn trả lời.'}`;
                    if (transcriptEl) transcriptEl.innerHTML = `<em>${isEn ? 'Start speaking your answer into the microphone...' : 'Mời bạn bắt đầu nói câu trả lời vào micro...'}</em>`;
                    this.startListening();
                });
            },

            replayQuestion: function () {
                if (!mockQuestions || !mockQuestions[this.currentIndex]) return;
                const q = mockQuestions[this.currentIndex];
                this.stopListening();
                AiVoice.speak(q.question, null, () => {
                    this.startListening();
                });
            },

            submitAnswer: async function () {
                if (!mockQuestions || !mockQuestions[this.currentIndex]) return;
                const q = mockQuestions[this.currentIndex];
                const answer = this.currentTranscript.trim();

                if (!answer) {
                    alert(isEn ? 'Please speak your answer into the microphone before submitting.' : 'Vui lòng nói câu trả lời vào micro trước khi gửi đánh giá.');
                    return;
                }

                this.stopListening();
                CallAudio.playSubmitChime();

                const submitBtn = document.getElementById('btnCallSubmitAnswer');
                submitBtn.disabled = true;
                submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> ${isEn ? 'Evaluating...' : 'Đang chấm điểm...'}`;

                const statusEl = document.getElementById('callInterviewerStatus');
                if (statusEl) statusEl.innerText = `${this.persona === 'sarah' ? 'Sarah' : 'Alex'} ${isEn ? 'is analyzing your response...' : 'đang phân tích câu trả lời của bạn...'}`;

                const mainInput = document.getElementById(`answerInput-${q.id}`);
                if (mainInput) mainInput.value = answer;

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const res = await fetch('/Interview/EvaluateAiAnswer', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            FlashcardId: q.id,
                            Question: q.question,
                            CandidateAnswer: answer,
                            Topic: q.topic,
                            Difficulty: q.difficulty
                        })
                    });

                    const data = await res.json();
                    if (data && data.success) {
                        evaluatedScores[q.id] = data.overallScore;
                        this.evaluations[this.currentIndex] = data;

                        renderAiEvaluationCard(q.id, data);
                        const statusBadge = document.getElementById(`aiStatusBadge-${q.id}`);
                        if (statusBadge) {
                            statusBadge.className = 'badge bg-success-subtle text-success rounded-pill px-2.5 py-1 small fw-semibold';
                            statusBadge.innerHTML = `<i class="bi bi-check2-circle me-1"></i> ${data.overallScore}/100`;
                            statusBadge.classList.remove('d-none');
                        }

                        const fBox = document.getElementById('callFeedbackBox');
                        fBox.classList.remove('d-none');
                        document.getElementById('callScoreBadge').innerText = `${data.overallScore}/100`;
                        document.getElementById('callRatingBadge').innerText = data.performanceRating || 'Đạt yêu cầu';
                        document.getElementById('callFeedbackText').innerText = data.feedback || '';

                        const followUpCard = document.getElementById('callFollowUpCard');
                        if (data.followUpQuestion) {
                            followUpCard.classList.remove('d-none');
                            document.getElementById('callFollowUpText').innerText = data.followUpQuestion;
                        } else {
                            followUpCard.classList.add('d-none');
                        }

                        let spokenSummary = `${isEn ? 'I evaluated your answer at' : 'Tôi chấm câu trả lời của bạn đạt'} ${data.overallScore} ${isEn ? 'points' : 'điểm'}. ${data.feedback}`;
                        if (data.followUpQuestion) {
                            spokenSummary += ` ${isEn ? 'Here is a follow-up challenge for you:' : 'Tôi có thêm một câu hỏi xoáy cho bạn:'} ${data.followUpQuestion}`;
                        }

                        AiVoice.speak(spokenSummary, null, () => {
                            if (statusEl) statusEl.innerText = `${this.persona === 'sarah' ? 'Sarah' : 'Alex'} ${isEn ? 'is ready for the next question.' : 'sẵn sàng cho câu hỏi tiếp theo.'}`;
                            if (data.followUpQuestion) {
                                this.startListening();
                            }
                        });
                    } else {
                        alert(isEn ? 'Unable to evaluate answer.' : 'Không thể đánh giá câu trả lời.');
                    }
                } catch (err) {
                    console.error(err);
                    alert(isEn ? 'Error connecting to AI Interviewer.' : 'Lỗi kết nối với AI Interviewer.');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = `<i class="bi bi-send-fill"></i> <span>${isEn ? 'Submit' : 'Gửi Trả Lời'}</span>`;
                }
            },

            replayFeedback: function () {
                const evalData = this.evaluations[this.currentIndex];
                if (!evalData) return;
                this.stopListening();
                let spoken = `${evalData.feedback}`;
                if (evalData.followUpQuestion) {
                    spoken += `. ${evalData.followUpQuestion}`;
                }
                AiVoice.speak(spoken);
            },

            nextQuestion: function () {
                if (this.currentIndex < mockQuestions.length - 1) {
                    this.loadQuestion(this.currentIndex + 1);
                } else {
                    this.endCall();
                }
            },

            endCall: function () {
                CallAudio.playHangup();
                AiVoice.stop();
                this.stopListening();
                if (this.timerInterval) clearInterval(this.timerInterval);
                this.isActive = false;

                if (this.modalInstance) {
                    this.modalInstance.hide();
                }

                setTimeout(() => {
                    submitFullMockInterview();
                }, 500);
            },

            close: function () {
                AiVoice.stop();
                this.stopListening();
                if (this.timerInterval) clearInterval(this.timerInterval);
                this.isActive = false;
                CallAudio.playHangup();
            }
        };

        // Window-scoped wrapper functions for button events
        function launchVoiceCall() { VoiceCallManager.startCall(); }
        function closeVoiceCall() { VoiceCallManager.close(); }
        function selectCallPersona(personaKey) { VoiceCallManager.setPersona(personaKey); }
        function toggleCallMic() { VoiceCallManager.toggleMic(); }
        function toggleCallSpeaker() { VoiceCallManager.toggleSpeaker(); }
        function cycleCallSpeed() { VoiceCallManager.cycleSpeed(); }
        function submitCallAnswer() { VoiceCallManager.submitAnswer(); }
        function nextCallQuestion() { VoiceCallManager.nextQuestion(); }
        function endVoiceCall() { VoiceCallManager.endCall(); }
        function replayCallQuestion() { VoiceCallManager.replayQuestion(); }
        function replayAiFeedback() { VoiceCallManager.replayFeedback(); }

        startTimer();
    </script>
}
