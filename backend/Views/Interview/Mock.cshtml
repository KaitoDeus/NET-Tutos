        // Full Mock Interview Submission
        async function submitFullMockInterview() {
            if (timerInterval) clearInterval(timerInterval);

            const btnFinish = document.getElementById('btnFinishMock');
            btnFinish.disabled = true;
            btnFinish.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> ${isEn ? 'Generating Comprehensive AI Report...' : 'Đang Tổng Hợp Báo Cáo Năng Lực AI...'}`;

            const blocks = document.querySelectorAll('.mock-question-block');
            const items = [];

            blocks.forEach(b => {
                const qId = parseInt(b.getAttribute('data-question-id'), 10);
                const qTopic = b.getAttribute('data-question-topic') || '';
                const qText = document.getElementById(`questionText-${qId}`)?.innerText || '';
                const textarea = document.getElementById(`answerInput-${qId}`);
                const answer = textarea ? textarea.value.trim() : '';

                let score = 70;
                if (evaluatedScores[qId] !== undefined) {
                    score = evaluatedScores[qId];
                } else {
                    const selectedRadio = b.querySelector(`input[name="score_${qId}"]:checked`);
                    score = selectedRadio ? parseInt(selectedRadio.value, 10) : (answer ? 65 : 40);
                }

                items.push({
                    FlashcardId: qId,
                    Question: qText,
                    Topic: qTopic,
                    CandidateAnswer: answer,
                    Score: score
                });
            });

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const res = await fetch('/Interview/SubmitAiMockReport', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        Items: items,
                        TimeSpentSeconds: timeSpent
                    })
                });

                if (res.ok) {
                    const data = await res.json();
                    showComprehensiveResults(data);
                } else {
                    alert(isEn ? "Error submitting mock interview." : "Lỗi khi nộp bài phỏng vấn thử.");
                    btnFinish.disabled = false;
                    btnFinish.innerHTML = `<i class="bi bi-send-check-fill me-2"></i> ${isEn ? 'Finish & Get AI Evaluation Report' : 'Hoàn Thành & Xuất Báo Cáo Năng Lực AI'}`;
                }
            } catch (err) {
                console.error(err);
                alert(isEn ? "Network error. Please try again." : "Lỗi kết nối mạng.");
                btnFinish.disabled = false;
                btnFinish.innerHTML = `<i class="bi bi-send-check-fill me-2"></i> ${isEn ? 'Finish & Get AI Evaluation Report' : 'Hoàn Thành & Xuất Báo Cáo Năng Lực AI'}`;
            }
        }

