        function closeAiPanel() {
            const container = document.getElementById('playgroundContainer');
            const panel = document.getElementById('offcanvasAiTutor');
            const backdrop = document.getElementById('playgroundMobileBackdrop');
            if (container) {
                container.classList.remove('ai-open');
            }
            if (panel) {
                panel.classList.remove('show-mobile');
            }
            if (backdrop) {
                backdrop.classList.add('d-none');
            }
            if (editorInstance) {
                setTimeout(() => editorInstance.layout(), 220);
            }
        }

        function toggleAiPanel() {
            const container = document.getElementById('playgroundContainer');
            const panel = document.getElementById('offcanvasAiTutor');
            const isOpen = window.innerWidth >= 1200
                ? container?.classList.contains('ai-open')
                : panel?.classList.contains('show-mobile');

            if (isOpen) {
                closeAiPanel();
            } else {
                openAiOffcanvas();
            }
        }

