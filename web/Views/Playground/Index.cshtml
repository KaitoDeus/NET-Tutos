                                    <button type="button" class="btn btn-xs btn-success rounded-pill py-0 px-2" style="font-size: 0.7rem;" onclick="applyCodeToEditor(decodeURIComponent('${encodeURIComponent(data.generatedTestCode)}'))"><i class="bi bi-magic"></i> ${isEn ? 'Apply' : 'Áp dụng'}</button>
                                </div>
                            </div>
                            <pre class="m-0 text-light" style="white-space: pre-wrap; font-family: inherit;"><code>${escapeHtml(data.generatedTestCode)}</code></pre>
                        </div>
                    `;
                } else {
                    box.innerHTML = `<div class="alert alert-warning small">${isEn ? 'Unable to generate unit tests.' : 'Không thể tạo bộ kiểm thử lúc này.'}</div>`;
                }
            } catch (e) {
                box.innerHTML = `<div class="alert alert-danger small">${isEn ? 'Error generating unit tests.' : 'Lỗi khi tạo bộ kiểm thử AI.'}</div>`;
            }
        }

        async function explainSelectedCode() {
            if (!editorInstance) return;
            openAiOffcanvas();

            const selection = editorInstance.getSelection();
            const selectedText = (selection && !selection.isEmpty()) 
                ? editorInstance.getModel().getValueInRange(selection).trim()
                : '';

            const codeToAnalyze = selectedText || editorInstance.getValue().trim();
            if (!codeToAnalyze) {
                showToastNotification(isEn ? 'Please write or select code to explain.' : 'Vui lòng viết hoặc bôi đen đoạn mã cần giải thích.');
                return;
            }

            const prompt = isEn 
                ? `Please explain in detail how this C# code works, including design rationale, potential bugs, or performance implications:\n\`\`\`csharp\n${codeToAnalyze}\n\`\`\``
                : `Hãy giải thích chi tiết cách thức hoạt động của đoạn mã C# sau, bao gồm nguyên lý hoạt động, các bẫy tiềm ẩn hoặc lưu ý hiệu năng:\n\`\`\`csharp\n${codeToAnalyze}\n\`\`\``;

            const box = document.getElementById('aiTutorResponseBox');
            box.innerHTML = `<div class="p-3 text-center text-muted small"><div class="spinner-border spinner-border-sm text-primary mb-2"></div><div>${isEn ? 'Analyzing selected code with AI Mentor...' : 'Đang phân tích đoạn mã được chọn với AI Mentor...'}</div></div>`;

            try {
                const res = await fetch('/AiTutor/Chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: prompt })
                });

                const data = await res.json();
                if (data && data.responseMarkdown) {
                    box.innerHTML = `
                        <div class="card border-primary-subtle bg-primary-subtle p-2.5 rounded-3 mb-2">
                            <span class="badge bg-primary text-white rounded-pill align-self-start mb-1">${isEn ? 'Code Explanation (Ctrl+I)' : 'Giải thích mã nguồn (Ctrl+I)'}</span>
                            <div class="small text-muted font-monospace text-truncate">${escapeHtml(codeToAnalyze.slice(0, 100))}...</div>
                        </div>
                        <div class="p-3 rounded-3 bg-body border text-body small mb-3">
                            <div class="fw-bold text-primary mb-2"><i class="bi bi-robot me-1"></i>AI Mentor:</div>
                            <div class="lh-base">${escapeHtml(data.responseMarkdown).replace(/\n/g, '<br/>')}</div>
                        </div>
                    `;
                }
            } catch (e) {
                box.innerHTML = `<div class="alert alert-danger small">${isEn ? 'Error explaining code.' : 'Lỗi khi kết nối đến AI Mentor.'}</div>`;
            }
        }

        function applyCodeToEditor(code) {
            if (!editorInstance || !code) return;
            const selection = editorInstance.getSelection();
            if (selection && !selection.isEmpty()) {
                editorInstance.executeEdits('ai-mentor', [{
                    range: selection,
                    text: code,
                    forceMoveMarkers: true
                }]);
            } else {
                editorInstance.setValue(code);
            }
            editorInstance.focus();
            showToastNotification(isEn ? 'Code applied to editor!' : 'Đã áp dụng mã vào trình soạn thảo!');
        }

        async function copyCodeToClipboard(code, btn) {
            if (!code) return;
            try {
                await navigator.clipboard.writeText(code);
                if (btn) {
                    const originalHtml = btn.innerHTML;
                    btn.innerHTML = `<i class="bi bi-check2"></i> ${isEn ? 'Copied!' : 'Đã chép!'}`;
                    btn.classList.add('btn-success');
                    btn.classList.remove('btn-outline-light');
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-outline-light');
                    }, 2000);
                }
                showToastNotification(isEn ? 'Copied code snippet to clipboard!' : 'Đã sao chép đoạn mã vào bộ nhớ tạm!');
            } catch (err) {
                console.error('Copy failed: ', err);
            }
        }

        function showToastNotification(msg) {
            if (typeof showGenericNotificationToast === 'function') {
                showGenericNotificationToast('AI Mentor', msg, 'success');
            } else {
                alert(msg);
            }
        }

        function escapeAttr(text) {
            if (!text) return '';
            return text.toString()
                .replace(/\\/g, '\\\\')
                .replace(/'/g, "\\'")
                .replace(/"/g, '&quot;')
                .replace(/\r/g, '')
                .replace(/\n/g, '\\n');
        }
    </script>
}
