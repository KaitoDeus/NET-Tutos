            const box = document.getElementById('aiTutorResponseBox');
            box.innerHTML += `<div class="p-2.5 rounded-3 bg-primary text-white text-end small mb-2 mt-2">${escapeHtml(q)}</div>`;
            input.value = '';

            const loadingId = 'loading_' + Date.now();
            box.innerHTML += `<div id="${loadingId}" class="p-2 text-muted small"><div class="spinner-border spinner-border-sm text-primary me-1"></div>${isEn ? 'Thinking...' : 'Đang suy nghĩ...'}</div>`;
