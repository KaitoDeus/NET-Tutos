@model NET_Tutos.Models.ViewModels.PlaygroundIndexViewModel
@{
    bool isEn = Context.IsEnglish();
    var title = Model.ActiveChallenge != null 
        ? (isEn ? $"Challenge: {Model.ActiveChallenge.GetChallengeTitle(true)}" : $"Thử thách: {Model.ActiveChallenge.Title}")
        : (isEn ? "C# Code Playground" : "Thực hành Code C# Playground");
    ViewData["Title"] = title;
}

@section Styles {
    <style>
        /* Responsive Workbench Layout Scaling */
        .playground-wrapper {
            max-width: 1840px;
            margin: 0 auto;
        }

        @@media (min-width: 1200px) {
            .playground-workbench-container {
                height: @(Model.ActiveChallenge == null ? "calc(100vh - 185px)" : "660px");
                min-height: 560px;
                max-height: 980px;
                display: flex;
                align-items: stretch;
                gap: 1rem;
                transition: gap 0.2s ease;
            }

            .playground-main-area {
                flex: 1 1 0%;
                min-width: 0;
                height: 100%;
                transition: flex 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            }

            /* Integrated Docked AI Tutor Split Pane */
            .playground-ai-panel {
                width: 390px;
                flex: 0 0 390px;
                height: 100%;
                display: none;
                transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .playground-workbench-container.ai-open .playground-ai-panel {
                display: flex !important;
                flex-direction: column;
                animation: aiDockSlideIn 0.2s ease-out;
            }
        }

        @@media (max-width: 1199.98px) {
            .playground-workbench-container {
                height: auto;
            }
            .playground-main-area {
                width: 100%;
            }
            .monaco-container {
                height: 440px !important;
            }
            .console-terminal {
                min-height: 220px !important;
                max-height: 380px !important;
            }

            /* Offcanvas Slide-in Drawer on Tablet & Mobile (Never covers top navbar) */
            .playground-ai-panel {
                position: fixed !important;
                top: 57px !important;
                right: 0 !important;
                bottom: 0 !important;
                width: min(440px, 94vw) !important;
                height: calc(100vh - 57px) !important;
                z-index: 1045 !important;
                display: none;
                box-shadow: -6px 0 24px rgba(0, 0, 0, 0.25) !important;
                border-radius: 0 !important;
            }

            .playground-ai-panel.show-mobile {
                display: flex !important;
                flex-direction: column;
                animation: aiDrawerSlideIn 0.25s ease-out;
            }
        }

        @@media (max-width: 767.98px) {
            .monaco-container {
                height: 350px !important;
            }
            .console-terminal {
                font-size: 0.82rem;
                min-height: 160px !important;
                max-height: 300px !important;
                padding: 0.75rem;
            }
        }

        /* Monaco Container & Terminal Fluid Heights */
        .monaco-container {
            width: 100%;
            height: 100%;
            min-height: 380px;
            border-radius: var(--radius-md);
            overflow: hidden;
            border: 1px solid var(--bs-border-color);
        }

        .console-terminal {
            background-color: #1e1e1e;
            color: #d4d4d4;
            font-family: var(--font-mono);
            font-size: 0.88rem;
            flex: 1 1 0;
            min-height: 220px;
            height: 100%;
            overflow-y: auto;
            border-radius: var(--radius-md);
            padding: 0.85rem 1rem;
            line-height: 1.5;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .console-terminal .text-success { color: #4ade80 !important; }
        .console-terminal .text-danger { color: #f87171 !important; }
        .console-terminal .text-warning { color: #fbbf24 !important; }
        .console-terminal .text-muted { color: #9ca3af !important; }

        .challenge-instruction {
            max-height: 380px;
            overflow-y: auto;
        }

        /* Mobile Drawer Backdrop */
        .playground-mobile-backdrop {
            position: fixed;
            top: 57px;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(2px);
            z-index: 1040;
        }

        @@keyframes aiDockSlideIn {
            from { opacity: 0; transform: translateX(20px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @@keyframes aiDrawerSlideIn {
            from { transform: translateX(100%); }
            to { transform: translateX(0); }
        }
    </style>
}

<div class="container-fluid px-3 px-xl-4 py-3 playground-wrapper">
    <!-- Header Title & Mode Switcher -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle border border-primary-subtle rounded-pill px-3 py-1 fw-bold">
                    <i class="bi bi-terminal-fill me-1"></i> Interactive C# Runner (.NET 10)
                </span>
                @if (Model.ActiveChallenge != null)
                {
                    <span class="badge bg-warning-subtle border border-warning-subtle rounded-pill px-3 py-1 fw-bold">
                        ⚡ @(isEn ? $"LeetCode-style Challenge (+{Model.ActiveChallenge.XpReward} XP)" : $"Thử thách LeetCode-style (+{Model.ActiveChallenge.XpReward} XP)")
                    </span>
                }
            </div>
            <h3 class="fw-bold mb-0">
                @(Model.ActiveChallenge != null ? Model.ActiveChallenge.GetChallengeTitle(isEn) : (isEn ? "Online C# Code Playground" : "Trình Thực Hành Code C# Trực Tuyến"))
            </h3>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="Challenges" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-list-task me-1"></i> @(isEn ? $"Challenge Bank ({Model.Challenges.Count} tasks)" : $"Kho thử thách ({Model.Challenges.Count} bài)")
            </a>
            @if (Model.ActiveChallenge != null)
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2">
                    <i class="bi bi-code-slash me-1"></i> @(isEn ? "Free Sandbox" : "Playground tự do")
                </a>
            }
        </div>
    </div>

    <!-- Active Challenge Description Card (If in Challenge mode) -->
    @if (Model.ActiveChallenge != null)
    {
        <div class="card border-0 shadow-sm rounded-4 bg-body mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold fs-5">@(isEn ? "Problem Description" : "Mô tả bài toán")</span>
                        <span class="badge bg-primary-subtle border border-primary-subtle rounded-pill px-2.5 py-1">
                            @LocalizationHelper.GetDifficultyName(Model.ActiveChallenge.Difficulty, isEn)
                        </span>
                    </div>
                    @if (Model.LastSubmission != null && Model.LastSubmission.IsPassed)
                    {
                        <span class="badge bg-success-subtle border border-success-subtle rounded-pill px-3 py-1.5 fw-bold">
                            <i class="bi bi-check-circle-fill me-1"></i> @(isEn ? $"You have completed this challenge (+{Model.LastSubmission.XpEarned} XP)" : $"Bạn đã hoàn thành thử thách này (+{Model.LastSubmission.XpEarned} XP)")
                        </span>
                    }
                </div>

                <div class="challenge-instruction tutorial-markdown-content mb-3">
                    <p class="lead fs-6 mb-3">@Model.ActiveChallenge.GetChallengeShortDesc(isEn)</p>
                    <div class="p-3 bg-body-tertiary rounded-3">
                        <pre class="mb-0 bg-transparent p-0 text-body" style="white-space: pre-wrap; font-family: inherit;">@Model.ActiveChallenge.GetChallengeInstructions(isEn)</pre>
                    </div>
                </div>

                <!-- Public Test Cases preview -->
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="small fw-bold text-body-secondary text-uppercase me-2">@(isEn ? "Sample test cases:" : "Test cases mẫu:")</span>
                    @foreach (var tc in Model.ActiveChallenge.TestCases.Where(t => !t.IsHidden))
                    {
                        <div class="badge bg-body-tertiary text-body border rounded-3 p-2 font-monospace text-start">
                            <span class="text-body-secondary">Input:</span> @tc.InputParameters <br />
                            <span class="text-success fw-bold">Output:</span> @tc.ExpectedOutput
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- IDE Workbench Container (Responsive Flex Layout with Docked AI Split Pane) -->
    <div class="playground-workbench-container d-flex flex-column flex-xl-row gap-3" id="playgroundContainer">
        <!-- Main Area: Monaco Editor + Output Console -->
        <div class="playground-main-area flex-grow-1 min-w-0" id="playgroundMainArea">
            <div class="row g-3 h-100">
                <!-- Monaco Editor Column -->
                <div class="col-12 col-lg-7 h-100 d-flex flex-column" id="colEditor">
                    <div class="card border rounded-3 bg-body shadow-sm h-100 d-flex flex-column overflow-hidden">
                        <div class="card-header bg-transparent border-bottom py-2.5 px-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <!-- Template selector (in free mode) or Reset Button -->
                                @if (Model.ActiveChallenge == null)
                                {
                                    <div class="d-flex align-items-center gap-1.5 min-w-0">
                                        <label class="small text-body-secondary fw-semibold text-nowrap d-none d-sm-inline" style="font-size: var(--text-xs);">@(isEn ? "Template:" : "Mẫu code:")</label>
                                        <select id="templateSelector" class="form-select form-select-sm rounded-2 font-monospace" style="max-width: 210px; font-size: var(--text-xs);">
                                            @foreach (var t in Model.Templates)
                                            {
                                                <option value="@t.Id">@t.Title</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <span class="small fw-semibold text-primary font-monospace" style="font-size: var(--text-xs);">
                                        <i class="bi bi-file-earmark-code me-1"></i> Solution.cs
                                    </span>
                                }

                                <!-- Action Toolbar (Compact, Scalable, Zero Multiline Overflows) -->
                                <div class="d-flex align-items-center gap-1.5 flex-nowrap ms-auto">
                                    <!-- AI Mentor Toggle Button -->
                                    <button type="button" id="btnOpenAiDrawer" class="btn btn-sm btn-outline-primary rounded-2 px-2.5 py-1.5 fw-semibold shadow-none d-flex align-items-center gap-1.5 text-nowrap" onclick="toggleAiPanel()" title="@(isEn ? "Open AI Code Mentor" : "Mở Trợ lý AI C#")" style="font-size: var(--text-nav);">
                                        <i class="bi bi-robot fs-6 text-primary"></i> <span class="d-none d-sm-inline">@(isEn ? "AI Mentor" : "Trợ lý AI")</span>
                                    </button>

                                    <!-- AI Utilities Dropdown -->
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-2 py-1.5 d-flex align-items-center gap-1 text-nowrap shadow-none" data-bs-toggle="dropdown" aria-expanded="false" title="@(isEn ? "AI Code Utilities" : "Công cụ AI")" style="font-size: var(--text-nav);">
                                            <i class="bi bi-stars text-info"></i>
                                            <span class="d-none d-md-inline" style="font-size: var(--text-xs);">@(isEn ? "Tools" : "Công cụ")</span>
                                            <i class="bi bi-chevron-down" style="font-size: 0.65rem;"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border p-1 rounded-2" style="font-size: var(--text-xs); min-width: 210px;">
                                            <li>
                                                <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-1.5 px-2.5 rounded-1" onclick="requestAiReview()">
                                                    <i class="bi bi-stars text-info"></i>
                                                    <span>@(isEn ? "Clean & Optimize Code" : "Tối ưu hóa Code")</span>
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-1.5 px-2.5 rounded-1" onclick="requestAiComplexity()">
                                                    <i class="bi bi-speedometer2 text-success"></i>
                                                    <span>@(isEn ? "Big-O Complexity" : "Đo độ phức tạp Big-O")</span>
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-1.5 px-2.5 rounded-1" onclick="requestAiUnitTest()">
                                                    <i class="bi bi-patch-check text-primary"></i>
                                                    <span>@(isEn ? "Generate xUnit Tests" : "Tạo bộ test xUnit")</span>
                                                </button>
                                            </li>
                                            @if (Model.ActiveChallenge != null)
                                            {
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-1.5 px-2.5 rounded-1 text-warning-emphasis" onclick="requestAiHint()">
                                                        <i class="bi bi-lightbulb-fill text-warning"></i>
                                                        <span>@(isEn ? "Algorithmic Hint" : "Gợi ý thuật toán")</span>
                                                    </button>
                                                </li>
                                            }
                                        </ul>
                                    </div>

                                    <!-- Editor Settings Dropdown -->
                                    <div class="dropdown">
                                        <button type="button" id="btnEditorSettings" class="btn btn-sm btn-outline-secondary rounded-2 px-2 py-1.5 shadow-none d-flex align-items-center" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="@(isEn ? "IDE & Editor Settings" : "Tùy biến IDE & Trình soạn thảo")" style="font-size: var(--text-nav);">
                                            <i class="bi bi-gear-fill"></i>
                                        </button>
                                        <div class="dropdown-menu dropdown-menu-end editor-settings-dropdown p-3 border shadow-lg rounded-3" style="min-width: 300px;">
                                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                                <h6 class="fw-bold mb-0 text-body" style="font-size: var(--text-sm);"><i class="bi bi-sliders me-1 text-primary"></i> @(isEn ? "IDE Settings" : "Tùy biến Editor")</h6>
                                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-muted" id="btnResetEditorSettings" style="font-size: var(--text-xs);">@(isEn ? "Default" : "Mặc định")</button>
                                            </div>
                                            <div class="mb-2.5">
                                                <label class="form-label text-muted small fw-semibold mb-1" for="cfgEditorFontFamily">@(isEn ? "Font Family" : "Phông chữ")</label>
                                                <select id="cfgEditorFontFamily" class="form-select form-select-sm rounded-2">
                                                    <option value="'Fira Code', monospace">Fira Code</option>
                                                    <option value="'JetBrains Mono', monospace">JetBrains Mono</option>
                                                    <option value="'Cascadia Code', Consolas, monospace">Cascadia Code</option>
                                                    <option value="Consolas, 'Courier New', monospace">Consolas</option>
                                                </select>
                                            </div>
                                            <div class="row g-2 mb-2.5">
                                                <div class="col-6">
                                                    <label class="form-label text-muted small fw-semibold mb-1" for="cfgEditorFontSize">@(isEn ? "Font Size" : "Cỡ chữ")</label>
                                                    <select id="cfgEditorFontSize" class="form-select form-select-sm rounded-2">
                                                        <option value="12">12px</option>
                                                        <option value="13">13px</option>
                                                        <option value="14" selected>14px</option>
                                                        <option value="16">16px</option>
                                                        <option value="18">18px</option>
                                                        <option value="20">20px</option>
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label text-muted small fw-semibold mb-1" for="cfgEditorTabSize">@(isEn ? "Tab Size" : "Khoảng cách Tab")</label>
                                                    <select id="cfgEditorTabSize" class="form-select form-select-sm rounded-2">
                                                        <option value="2">2 spaces</option>
                                                        <option value="4" selected>4 spaces</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="mb-2.5">
                                                <label class="form-label text-muted small fw-semibold mb-1" for="cfgEditorTheme">@(isEn ? "Theme Mode" : "Chủ đề màu")</label>
                                                <select id="cfgEditorTheme" class="form-select form-select-sm rounded-2">
                                                    <option value="auto">@(isEn ? "Auto (Follow App)" : "Tự động (Theo ứng dụng)")</option>
                                                    <option value="vs-dark">Visual Studio Dark</option>
                                                    <option value="vs">Visual Studio Light</option>
                                                    <option value="hc-black">High Contrast</option>
                                                </select>
                                            </div>
                                            <div class="form-check form-switch mb-2">
                                                <input class="form-check-input" type="checkbox" role="switch" id="cfgEditorLigatures" checked>
                                                <label class="form-check-label small fw-medium" for="cfgEditorLigatures">@(isEn ? "Font Ligatures (=>, !=, ==)" : "Ký tự kết hợp (Ligatures)")</label>
                                            </div>
                                            <div class="form-check form-switch mb-2">
                                                <input class="form-check-input" type="checkbox" role="switch" id="cfgEditorMinimap">
                                                <label class="form-check-label small fw-medium" for="cfgEditorMinimap">@(isEn ? "Code Minimap" : "Bản đồ mã nguồn (Minimap)")</label>
                                            </div>
                                            <div class="form-check form-switch mb-3">
                                                <input class="form-check-input" type="checkbox" role="switch" id="cfgEditorWordWrap">
                                                <label class="form-check-label small fw-medium" for="cfgEditorWordWrap">@(isEn ? "Word Wrap" : "Tự xuống dòng (Word Wrap)")</label>
                                            </div>
                                            <div class="p-2 rounded-2 bg-body-tertiary border text-muted" style="font-size: 0.72rem;">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <span>@(isEn ? "Run Code:" : "Chạy mã:")</span>
                                                    <kbd class="px-1 py-0.5">Ctrl + Enter</kbd>
                                                </div>
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <span>@(isEn ? "Auto-format code:" : "Định dạng mã:")</span>
                                                    <kbd class="px-1 py-0.5">Ctrl + S</kbd>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Reset Button -->
                                    <button type="button" id="btnResetCode" class="btn btn-sm btn-outline-secondary rounded-2 px-2 py-1.5 shadow-none" title="@(isEn ? "Reset code to default" : "Đặt lại code ban đầu")" style="font-size: var(--text-nav);">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>

                                    <!-- Run Code Button -->
                                    <button type="button" id="btnRunCode" class="btn btn-sm btn-success rounded-2 px-3 py-1.5 fw-bold shadow-xs d-flex align-items-center gap-1.5" title="@(isEn ? "Shortcut: Ctrl + Enter" : "Phím tắt: Ctrl + Enter")" style="font-size: var(--text-nav);">
                                        <i class="bi bi-play-fill fs-6"></i>
                                        <span>@(isEn ? "Run" : "Chạy mã")</span>
                                        <kbd class="d-none d-xl-inline-block bg-dark bg-opacity-25 text-white border-0 py-0 px-1 font-monospace" style="font-size: 0.65rem;">Ctrl+↵</kbd>
                                    </button>

                                    @if (Model.ActiveChallenge != null)
                                    {
                                        <button type="button" id="btnSubmitChallenge" class="btn btn-sm btn-primary rounded-2 px-3 py-1.5 fw-bold shadow-xs d-flex align-items-center gap-1" style="font-size: var(--text-nav);">
                                            <i class="bi bi-cloud-upload-fill"></i> <span class="d-none d-sm-inline">@(isEn ? "Submit" : "Nộp bài")</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0 flex-grow-1 min-h-0 position-relative">
                            <div id="monacoEditor" class="monaco-container w-100 h-100"></div>
                        </div>
                    </div>
                </div>

                <!-- Terminal & Test Results Column -->
                <div class="col-12 col-lg-5 h-100 d-flex flex-column" id="colTerminal">
                    <div class="card border rounded-3 bg-body shadow-sm h-100 d-flex flex-column overflow-hidden">
                        <div class="card-header bg-transparent border-bottom py-2.5 px-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-terminal fs-6 text-primary"></i>
                                    <span class="fw-bold" style="font-size: var(--text-sm);">@(isEn ? "Output & Console" : "Cửa sổ Output & Console")</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span id="execTimerBadge" class="badge bg-secondary-subtle border border-secondary-subtle rounded-1 font-monospace small d-none" style="font-size: var(--text-2xs);">
                                        <i class="bi bi-stopwatch me-1"></i><span id="execTimerVal">0ms</span>
                                    </span>
                                    <button type="button" id="btnClearTerminal" class="btn btn-sm btn-link p-0 text-decoration-none text-body-secondary small" title="@(isEn ? "Clear console" : "Xóa màn hình console")" style="font-size: var(--text-xs);">
                                        <i class="bi bi-trash"></i> @(isEn ? "Clear" : "Xóa")
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-3 flex-grow-1 min-h-0 d-flex flex-column">
                            <!-- AI Error Assistance Banner -->
                            <div id="aiErrorHelperBar" class="alert alert-danger py-2 px-3 mb-2 rounded-2 d-none align-items-center justify-content-between shadow-xs">
                                <div class="d-flex align-items-center gap-2 small">
                                    <i class="bi bi-robot fs-5 text-danger flex-shrink-0"></i>
                                    <span class="fw-medium" style="font-size: var(--text-xs);">@(isEn ? "Compiler Error! Click to analyze with AI." : "Phát hiện lỗi! Nhờ AI giải thích và sửa.")</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-danger rounded-2 px-2.5 py-1 small fw-bold d-flex align-items-center gap-1 shadow-xs" onclick="explainCurrentError()" style="font-size: var(--text-xs);">
                                    <i class="bi bi-magic"></i> <span>@(isEn ? "Explain" : "Giải thích lỗi")</span>
                                </button>
                            </div>

                            <!-- Terminal Console Box -->
                            <div id="terminalOutput" class="console-terminal flex-grow-1"><span class="text-muted">@(isEn ? "// Click \"Run\" (or Ctrl+Enter) to execute C# script...\n// Console.WriteLine() outputs will appear here." : "// Bấm \"Chạy mã\" (hoặc nhấn Ctrl+Enter) để thực thi C# script...\n// Kết quả Console.WriteLine() sẽ xuất hiện tại đây.")</span></div>

                            <!-- Challenge Test Cases Evaluation Box (Appears after submission) -->
                            <div id="challengeEvaluationBox" class="mt-3 d-none">
                                <div class="p-3 rounded-2 border" id="evalSummaryCard">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <h6 class="fw-bold mb-0" id="evalSummaryTitle" style="font-size: var(--text-sm);">@(isEn ? "Evaluation Results" : "Kết quả chấm điểm")</h6>
                                        <span class="badge rounded-1 fw-bold" id="evalSummaryBadge" style="font-size: var(--text-2xs);"></span>
                                    </div>
                                    <div class="small mb-2" id="evalSummaryText" style="font-size: var(--text-xs);"></div>
                                    
                                    <!-- Test details table -->
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered align-middle mb-0 font-monospace" style="font-size: 0.8rem;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Test</th>
                                                    <th>Input</th>
                                                    <th>@(isEn ? "Output" : "Kết quả")</th>
                                                    <th>@(isEn ? "Expected" : "Kỳ vọng")</th>
                                                    <th>@(isEn ? "Status" : "Trạng thái")</th>
                                                </tr>
                                            </thead>
                                            <tbody id="evalTestCasesBody"></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- AI Tutor Panel: Integrated Docked Split Pane on >= 1200px, Offcanvas Drawer on < 1200px -->
        <div class="card border rounded-3 bg-body shadow-sm playground-ai-panel d-flex flex-column overflow-hidden" id="offcanvasAiTutor" tabindex="-1">
            <div class="card-header border-bottom bg-body-tertiary p-2.5 px-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-2 bg-primary text-white d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="bi bi-robot fs-6"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0" style="font-size: var(--text-sm);">@(isEn ? "AI .NET Code Mentor" : "Trợ Lý AI Gia Sư .NET")</h6>
                        <span class="text-muted font-monospace" style="font-size: var(--text-2xs);">@(isEn ? "Diagnostics • Hints • Review" : "Chẩn đoán • Gợi ý • Tối ưu")</span>
                    </div>
                </div>
                <button type="button" class="btn-close" id="btnCloseAiDrawer" aria-label="Close" onclick="closeAiPanel()"></button>
            </div>
            <div class="card-body p-3 d-flex flex-column flex-grow-1 overflow-hidden" id="offcanvasAiBody">
                <!-- Quick Action Buttons -->
                <div class="d-flex flex-wrap gap-1 mb-2.5">
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-1 flex-fill py-1 small fw-semibold" onclick="requestAiReview()" style="font-size: var(--text-xs);"><i class="bi bi-stars me-1 text-primary"></i>@(isEn ? "Review" : "Tối ưu")</button>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-1 flex-fill py-1 small fw-semibold" onclick="requestAiComplexity()" style="font-size: var(--text-xs);"><i class="bi bi-speedometer2 me-1 text-success"></i>@(isEn ? "Big-O" : "Độ phức tạp")</button>
                    @if (Model.ActiveChallenge != null)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-1 flex-fill py-1 small fw-semibold text-body" onclick="requestAiHint()" style="font-size: var(--text-xs);"><i class="bi bi-lightbulb me-1 text-warning"></i>@(isEn ? "Hint" : "Gợi ý")</button>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-1 flex-fill py-1 small fw-semibold" onclick="requestAiUnitTest()" style="font-size: var(--text-xs);"><i class="bi bi-patch-check me-1 text-primary"></i>@(isEn ? "Unit Test" : "xUnit Test")</button>
                </div>

                <!-- Dynamic AI Content Output (Scrollable) -->
                <div id="aiTutorResponseBox" class="flex-grow-1 overflow-y-auto mb-2.5 pe-1" style="max-height: 100%;">
                    <div class="p-3 rounded-2 bg-body-tertiary border text-body small" id="aiDefaultBox">
                        <div class="fw-bold text-primary mb-1 d-flex align-items-center gap-1.5" style="font-size: var(--text-sm);">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>@(isEn ? "AI Assistant Ready" : "Trợ lý AI sẵn sàng hỗ trợ")</span>
                        </div>
                        <p class="text-muted mb-0" style="font-size: var(--text-xs);">
                            @(isEn
                                ? "Run your code to test. If you encounter errors, I will analyze them and suggest fixes. You can also request hints or code optimization anytime!"
                                : "Hãy chạy thử code của bạn. Nếu gặp lỗi, tôi sẽ phân tích và hướng dẫn sửa chi tiết. Bạn cũng có thể yêu cầu gợi ý thuật toán hoặc tối ưu code bất cứ lúc nào!")
                        </p>
                    </div>
                </div>

                <!-- Mini Question Input Bar in AI Panel -->
                <div class="pt-2 border-top mt-auto">
                    <div class="input-group input-group-sm rounded-2 overflow-hidden bg-body border">
                        <input type="text" id="drawerAiInput" class="form-control border-0 px-2.5" style="font-size: var(--text-xs);" placeholder="@(isEn ? "Ask a question about this code..." : "Hỏi về đoạn code C# này...")" onkeydown="if(event.key==='Enter') sendDrawerAiChat()">
                        <button type="button" class="btn btn-primary px-3" onclick="sendDrawerAiChat()"><i class="bi bi-send-fill"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

        <!-- Mobile Drawer Backdrop Overlay -->
    <div id="playgroundMobileBackdrop" class="playground-mobile-backdrop d-none" onclick="closeAiPanel()"></div>
</div>

@section Scripts {
    <!-- Monaco Editor Loader from CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>
    <script>
        const isEn = @(isEn ? "true" : "false");
        // Data Templates
        const templates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Templates.ToDictionary(t => t.Id, t => t.Code)));
        const activeChallengeId = @(Model.ActiveChallenge != null ? Model.ActiveChallenge.Id : 0);
        const initialChallengeCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActiveChallenge?.InitialCode ?? ""));

        let editorInstance = null;

        const defaultEditorSettings = {
            fontFamily: "'Fira Code', monospace",
            fontSize: 14,
            tabSize: 4,
            theme: 'auto',
            ligatures: true,
            minimap: false,
            wordWrap: false
        };

        function getSavedEditorSettings() {
            try {
                const saved = localStorage.getItem('nettutos_editor_settings');
                return saved ? Object.assign({}, defaultEditorSettings, JSON.parse(saved)) : Object.assign({}, defaultEditorSettings);
            } catch (e) {
                return Object.assign({}, defaultEditorSettings);
            }
        }

        function saveEditorSettings(settings) {
            try {
                localStorage.setItem('nettutos_editor_settings', JSON.stringify(settings));
            } catch (e) {}
        }

        function getEffectiveTheme(themeSetting) {
            if (themeSetting === 'auto') {
                return document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'vs-dark' : 'vs';
            }
            return themeSetting;
        }

        function syncSettingsUI(settings) {
            const fontEl = document.getElementById('cfgEditorFontFamily');
            const sizeEl = document.getElementById('cfgEditorFontSize');
            const tabEl = document.getElementById('cfgEditorTabSize');
            const themeEl = document.getElementById('cfgEditorTheme');
            const ligEl = document.getElementById('cfgEditorLigatures');
            const minimapEl = document.getElementById('cfgEditorMinimap');
            const wrapEl = document.getElementById('cfgEditorWordWrap');

            if (fontEl) fontEl.value = settings.fontFamily;
            if (sizeEl) sizeEl.value = String(settings.fontSize);
            if (tabEl) tabEl.value = String(settings.tabSize);
            if (themeEl) themeEl.value = settings.theme;
            if (ligEl) ligEl.checked = !!settings.ligatures;
            if (minimapEl) minimapEl.checked = !!settings.minimap;
            if (wrapEl) wrapEl.checked = !!settings.wordWrap;
        }

        function applyEditorSettings(settings) {
            if (!editorInstance) return;
            monaco.editor.setTheme(getEffectiveTheme(settings.theme));
            editorInstance.updateOptions({
                fontFamily: settings.fontFamily,
                fontSize: parseInt(settings.fontSize, 10),
                tabSize: parseInt(settings.tabSize, 10),
                fontLigatures: !!settings.ligatures,
                minimap: { enabled: !!settings.minimap },
                wordWrap: settings.wordWrap ? 'on' : 'off'
            });
        }

        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs' } });

        require(['vs/editor/editor.main'], function () {
            const currentSettings = getSavedEditorSettings();
            syncSettingsUI(currentSettings);

            let defaultCode = "";
            if (activeChallengeId > 0 && initialChallengeCode) {
                defaultCode = initialChallengeCode;
            } else {
                defaultCode = templates['hello-world'] || (isEn ? '// Enter C# code here\nConsole.WriteLine("Hello C#!");' : '// Nhập mã C# tại đây\nConsole.WriteLine("Xin chào C#!");');
            }

            editorInstance = monaco.editor.create(document.getElementById('monacoEditor'), {
                value: defaultCode,
                language: 'csharp',
                theme: getEffectiveTheme(currentSettings.theme),
                fontSize: parseInt(currentSettings.fontSize, 10),
                fontFamily: currentSettings.fontFamily,
                fontLigatures: !!currentSettings.ligatures,
                tabSize: parseInt(currentSettings.tabSize, 10),
                automaticLayout: true,
                minimap: { enabled: !!currentSettings.minimap },
                wordWrap: currentSettings.wordWrap ? 'on' : 'off',
                scrollBeyondLastLine: false,
                lineNumbers: 'on',
                roundedSelection: true,
                padding: { top: 12, bottom: 12 }
            });

            // Keyboard shortcut Ctrl + Enter to run code
            editorInstance.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.Enter, function () {
                document.getElementById('btnRunCode').click();
            });

            // Keyboard shortcut Ctrl + S to auto-format document
            editorInstance.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyS, function () {
                editorInstance.getAction('editor.action.formatDocument')?.run();
            });

            // Keyboard shortcut Ctrl + I to ask AI Mentor
            editorInstance.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyI, function () {
                explainSelectedCode();
            });

            // Monaco Context Menu: AI Explain Selected Code
            editorInstance.addAction({
                id: 'ai-explain-selection',
                label: isEn ? '🤖 AI Mentor: Explain Selection (Ctrl+I)' : '🤖 AI Mentor: Giải thích đoạn mã đã chọn (Ctrl+I)',
                contextMenuGroupId: 'navigation',
                contextMenuOrder: 1.5,
                run: function () {
                    explainSelectedCode();
                }
            });

            // Monaco Context Menu: AI Big-O Complexity
            editorInstance.addAction({
                id: 'ai-analyze-complexity',
                label: isEn ? '⚡ AI Mentor: Analyze Big-O Complexity' : '⚡ AI Mentor: Đo độ phức tạp Big-O',
                contextMenuGroupId: 'navigation',
                contextMenuOrder: 1.6,
                run: function () {
                    requestAiComplexity();
                }
            });

            // Monaco Context Menu: AI Generate xUnit Tests
            editorInstance.addAction({
                id: 'ai-generate-xunit-tests',
                label: isEn ? '🧪 AI Mentor: Generate xUnit Tests' : '🧪 AI Mentor: Tạo bộ kiểm thử xUnit',
                contextMenuGroupId: 'navigation',
                contextMenuOrder: 1.7,
                run: function () {
                    requestAiUnitTest();
                }
            });

            // Watch for theme toggle button on page
            const themeBtn = document.getElementById('themeToggleBtn');
            if (themeBtn) {
                themeBtn.addEventListener('click', function () {
                    setTimeout(() => {
                        const settings = getSavedEditorSettings();
                        if (settings.theme === 'auto') {
                            const newTheme = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'vs-dark' : 'vs';
                            monaco.editor.setTheme(newTheme);
                        }
                    }, 50);
                });
            }

            // Bind change listeners to Settings controls
            const bindSettingChange = (elId, key, isCheckbox, isInt) => {
                const el = document.getElementById(elId);
                if (!el) return;
                el.addEventListener('change', () => {
                    const settings = getSavedEditorSettings();
                    let val = isCheckbox ? el.checked : el.value;
                    if (isInt) val = parseInt(val, 10);
                    settings[key] = val;
                    saveEditorSettings(settings);
                    applyEditorSettings(settings);
                });
            };

            bindSettingChange('cfgEditorFontFamily', 'fontFamily', false, false);
            bindSettingChange('cfgEditorFontSize', 'fontSize', false, true);
            bindSettingChange('cfgEditorTabSize', 'tabSize', false, true);
            bindSettingChange('cfgEditorTheme', 'theme', false, false);
            bindSettingChange('cfgEditorLigatures', 'ligatures', true, false);
            bindSettingChange('cfgEditorMinimap', 'minimap', true, false);
            bindSettingChange('cfgEditorWordWrap', 'wordWrap', true, false);

            const btnResetSettings = document.getElementById('btnResetEditorSettings');
            if (btnResetSettings) {
                btnResetSettings.addEventListener('click', () => {
                    const reset = Object.assign({}, defaultEditorSettings);
                    saveEditorSettings(reset);
                    syncSettingsUI(reset);
                    applyEditorSettings(reset);
                });
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            const templateSelector = document.getElementById('templateSelector');
            const btnResetCode = document.getElementById('btnResetCode');
            const btnRunCode = document.getElementById('btnRunCode');
            const btnSubmitChallenge = document.getElementById('btnSubmitChallenge');
            const btnClearTerminal = document.getElementById('btnClearTerminal');
            const terminalOutput = document.getElementById('terminalOutput');
            const execTimerBadge = document.getElementById('execTimerBadge');
            const execTimerVal = document.getElementById('execTimerVal');

            const challengeEvaluationBox = document.getElementById('challengeEvaluationBox');
            const evalSummaryCard = document.getElementById('evalSummaryCard');
            const evalSummaryTitle = document.getElementById('evalSummaryTitle');
            const evalSummaryBadge = document.getElementById('evalSummaryBadge');
            const evalSummaryText = document.getElementById('evalSummaryText');
            const evalTestCasesBody = document.getElementById('evalTestCasesBody');

            // Template Switcher
            if (templateSelector) {
                templateSelector.addEventListener('change', function () {
                    const selectedId = this.value;
                    if (templates[selectedId] && editorInstance) {
                        editorInstance.setValue(templates[selectedId]);
                    }
                });
            }

            // Reset Code
            btnResetCode.addEventListener('click', function () {
                if (!editorInstance) return;
                if (activeChallengeId > 0 && initialChallengeCode) {
                    editorInstance.setValue(initialChallengeCode);
                } else if (templateSelector && templates[templateSelector.value]) {
                    editorInstance.setValue(templates[templateSelector.value]);
                }
            });

            // Clear Terminal
            btnClearTerminal.addEventListener('click', function () {
                terminalOutput.innerHTML = '<span class="text-muted">' + (isEn ? '// Console output cleared.' : '// Cửa sổ console đã được xóa sạch.') + '</span>';
                execTimerBadge.classList.add('d-none');
                if (challengeEvaluationBox) challengeEvaluationBox.classList.add('d-none');
            });

            // Execute Code (Run Code)
            btnRunCode.addEventListener('click', async function () {
                if (!editorInstance) return;
                const code = editorInstance.getValue();

                btnRunCode.disabled = true;
                btnRunCode.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> ' + (isEn ? 'Running...' : 'Đang chạy...');
                terminalOutput.innerHTML = '<span class="text-warning">' + (isEn ? '// Compiling source code and starting sandbox...' : '// Đang biên dịch mã nguồn và khởi chạy sandbox...') + '</span>';

                try {
                    const response = await fetch('/Playground/Execute', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ code: code })
                    });

                    const data = await response.json();

                    execTimerVal.innerText = `${data.executionTimeMs}ms`;
                    execTimerBadge.classList.remove('d-none');

                    if (data.isSuccess) {
                        terminalOutput.innerHTML = `<span class="text-success">[${isEn ? 'Execution successful in' : 'Thực thi thành công trong'} ${data.executionTimeMs}ms]</span>\n\n${escapeHtml(data.output)}`;
                        hideAiErrorBanner();
                    } else {
                        terminalOutput.innerHTML = `<span class="text-danger">[${isEn ? 'Execution Error' : 'Gặp lỗi'}]</span>\n\n<span class="text-danger">${escapeHtml(data.error || (isEn ? 'Unknown error' : 'Lỗi không xác định'))}</span>`;
                        showAiErrorBanner(data.error);
                    }
                } catch (err) {
                    terminalOutput.innerHTML = `<span class="text-danger">${isEn ? 'Server connection error:' : 'Lỗi kết nối máy chủ:'} ${escapeHtml(err.message)}</span>`;
                } finally {
                    btnRunCode.disabled = false;
                    btnRunCode.innerHTML = '<i class="bi bi-play-fill fs-6"></i> ' + (isEn ? 'Run Code' : 'Chạy mã');
                }
            });

            // Submit Challenge (Judge Engine)
            if (btnSubmitChallenge) {
                btnSubmitChallenge.addEventListener('click', async function () {
                    if (!editorInstance || activeChallengeId <= 0) return;
                    const code = editorInstance.getValue();

                    btnSubmitChallenge.disabled = true;
                    btnSubmitChallenge.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> ' + (isEn ? 'Evaluating...' : 'Đang chấm...');
                    terminalOutput.innerHTML = '<span class="text-warning">' + (isEn ? '// Testing across Test Cases...' : '// Đang kiểm thử qua các Test Cases...') + '</span>';

                    try {
                        const response = await fetch('/Playground/SubmitChallenge', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ challengeId: activeChallengeId, code: code })
                        });

                        const data = await response.json();

                        challengeEvaluationBox.classList.remove('d-none');
                        evalTestCasesBody.innerHTML = '';

                        execTimerVal.innerText = `${data.executionTimeMs}ms`;
                        execTimerBadge.classList.remove('d-none');

                        if (data.compileError) {
                            terminalOutput.innerHTML = `<span class="text-danger">[${isEn ? 'Compilation error on submission' : 'Lỗi biên dịch khi nộp bài'}]</span>\n\n${escapeHtml(data.compileError)}`;
                            evalSummaryCard.className = 'p-3 rounded-3 border border-danger-subtle bg-danger-subtle';
                            evalSummaryTitle.innerText = isEn ? 'Compilation Failed' : 'Biên dịch thất bại';
                            evalSummaryBadge.className = 'badge bg-danger text-white rounded-pill';
                            evalSummaryBadge.innerText = isEn ? 'Error' : 'Lỗi';
                            evalSummaryText.innerText = data.compileError;
                            showAiErrorBanner(data.compileError);
                        } else {
                            hideAiErrorBanner();
                            if (data.allPassed) {
                                terminalOutput.innerHTML = `<span class="text-success">🎉 ${isEn ? 'EXCELLENT! YOU PASSED ALL' : 'TUYỆT VỜI! BẠN ĐÃ VƯỢT QUA TOÀN BỘ'} ${data.totalTestsCount}/${data.totalTestsCount} TEST CASES!</span>\n` +
                                    (data.xpEarned > 0 ? `<span class="text-warning">⚡ +${data.xpEarned} XP ${isEn ? 'added to your account!' : 'đã được cộng vào tài khoản của bạn!'}</span>` : `<span class="text-muted">(${isEn ? 'You already completed this challenge previously' : 'Thử thách này bạn đã vượt qua trước đó'})</span>`);

                                evalSummaryCard.className = 'p-3 rounded-3 border border-success-subtle bg-success-subtle';
                                evalSummaryTitle.innerText = isEn ? 'Accepted' : 'Chấp thuận (Accepted)';
                                evalSummaryBadge.className = 'badge bg-success text-white rounded-pill px-3 py-1';
                                evalSummaryBadge.innerText = `${data.passedTestsCount}/${data.totalTestsCount} Passed`;
                                evalSummaryText.innerHTML = `${isEn ? 'Congratulations! Your algorithm met all criteria in' : 'Chúc mừng! Thuật toán của bạn đạt chuẩn tuyệt đối trong'} <strong>${data.executionTimeMs}ms</strong>.` +
                                    (data.xpEarned > 0 ? ` ${isEn ? 'You earned' : 'Bạn nhận được'} <strong>+${data.xpEarned} XP</strong>.` : '');
                            } else {
                                terminalOutput.innerHTML = `<span class="text-danger">❌ ${isEn ? 'Did not pass all Test Cases:' : 'Chưa vượt qua toàn bộ Test Cases:'} ${data.passedTestsCount}/${data.totalTestsCount} ${isEn ? 'Passed' : 'Tests đạt chuẩn'}.</span>`;

                                evalSummaryCard.className = 'p-3 rounded-3 border border-warning-subtle bg-warning-subtle';
                                evalSummaryTitle.innerText = isEn ? 'Wrong Answer' : 'Kết quả sai (Wrong Answer)';
                                evalSummaryBadge.className = 'badge bg-danger text-white rounded-pill px-3 py-1';
                                evalSummaryBadge.innerText = `${data.passedTestsCount}/${data.totalTestsCount} Passed`;
                                evalSummaryText.innerText = isEn ? 'Some test cases did not match expected output. Please check your algorithm logic.' : 'Một số trường hợp kiểm thử cho kết quả không khớp với kỳ vọng. Hãy kiểm tra lại logic thuật toán.';
                            }

                            // Render test rows
                            if (data.details) {
                                data.details.forEach(item => {
                                    const tr = document.createElement('tr');
                                    tr.innerHTML = `
                                        <td>#${item.testIndex}</td>
                                        <td><code>${escapeHtml(item.input)}</code></td>
                                        <td><span class="${item.passed ? 'text-success' : 'text-danger'} fw-bold">${escapeHtml(item.actual)}</span></td>
                                        <td><code>${escapeHtml(item.expected)}</code></td>
                                        <td>
                                            ${item.passed 
                                                ? '<span class="badge bg-success-subtle border border-success-subtle text-success rounded-pill px-2.5 py-1">' + (isEn ? 'Pass' : 'Đạt') + '</span>' 
                                                : `<div class="d-flex align-items-center gap-1.5">
                                                     <span class="badge bg-danger-subtle border border-danger-subtle text-danger rounded-pill px-2 py-1">${isEn ? 'Fail' : 'Sai'}</span>
                                                     <button type="button" class="btn btn-xs btn-outline-danger rounded-pill px-2 py-0.5 fw-semibold d-inline-flex align-items-center gap-1 shadow-xs" style="font-size: 0.72rem;" onclick="diagnoseSpecificFailure(${item.testIndex}, '${escapeAttr(item.input)}', '${escapeAttr(item.expected)}', '${escapeAttr(item.actual)}')">
                                                         <i class="bi bi-robot"></i> <span>${isEn ? 'AI Fix' : 'AI Chẩn đoán'}</span>
                                                     </button>
                                                   </div>`}
                                        </td>
                                    `;
                                    evalTestCasesBody.appendChild(tr);
                                });
                            }
                        }
                    } catch (err) {
                        terminalOutput.innerHTML = `<span class="text-danger">${isEn ? 'Connection error while submitting:' : 'Lỗi kết nối khi nộp bài:'} ${escapeHtml(err.message)}</span>`;
                    } finally {
                        btnSubmitChallenge.disabled = false;
                        btnSubmitChallenge.innerHTML = '<i class="bi bi-cloud-upload-fill me-1"></i> ' + (isEn ? 'Submit' : 'Nộp bài');
                    }
                });
            }

            function escapeHtml(text) {
                if (!text) return '';
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return text.toString().replace(/[&<>"']/g, m => map[m]);
            }
        });

        // AI Tutor Global Helpers
        let lastReportedError = '';
        let currentHintLevel = 1;

        function showAiErrorBanner(err) {
            lastReportedError = err || '';
            const bar = document.getElementById('aiErrorHelperBar');
            if (bar) {
                bar.classList.remove('d-none');
                bar.classList.add('d-flex');
            }
        }

        function hideAiErrorBanner() {
            const bar = document.getElementById('aiErrorHelperBar');
            if (bar) {
                bar.classList.add('d-none');
                bar.classList.remove('d-flex');
            }
        }

        function openAiOffcanvas() {
            const container = document.getElementById('playgroundContainer');
            const panel = document.getElementById('offcanvasAiTutor');
            const backdrop = document.getElementById('playgroundMobileBackdrop');
            if (window.innerWidth >= 1200) {
                if (container) {
                    container.classList.add('ai-open');
                }
            } else {
                if (panel) {
                    panel.classList.add('show-mobile');
                }
