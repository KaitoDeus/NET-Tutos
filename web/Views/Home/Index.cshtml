@model NET_Tutos.Models.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Localization
@using NET_Tutos.Services
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Home" : "Trang chủ";
}

<!-- Minimalist Hero Section (Developer Tool Standard) -->
<section class="py-4 py-md-5 border-bottom">
    <div class="container">
        <!-- Punchy, Direct Header (No Clutter, No Sub-labels) -->
        <div class="text-center mb-4">
            <h1 class="hero-title fw-extrabold mb-2 text-body-emphasis">
                @(isEn ? "Modern .NET & C# Engineering" : "Lập Trình .NET & C# Hiện Đại")
            </h1>
            <p class="text-body-secondary mx-auto mb-3" style="max-width: 580px; font-size: 1.05rem;">
                @(isEn ? "Hands-on tutorials, in-browser Roslyn sandbox, and production roadmaps." : "Khóa học chuẩn hóa, sân chơi Roslyn trực tuyến và bài tập thực chiến.")
            </p>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
                <a asp-controller="Tutorials" asp-action="Index" class="btn btn-primary rounded-2 px-3 py-2 fw-semibold">
                    @(isEn ? "Start Learning" : "Bắt đầu học ngay") <i class="bi bi-arrow-right ms-1"></i>
                </a>
                <a asp-controller="Playground" asp-action="Index" class="btn btn-outline-secondary rounded-2 px-3 py-2 fw-semibold font-monospace">
                    <i class="bi bi-terminal me-1"></i> Playground
                </a>
            </div>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="row justify-content-center mb-3">
                <div class="col-xl-10">
                    <div class="d-flex align-items-center justify-content-between p-2.5 px-3 rounded-2 border bg-body-tertiary">
                        <div class="d-flex align-items-center gap-2">
                            <span class="status-indicator-dot"></span>
                            <span class="small fw-semibold text-body-emphasis">@(isEn ? "Welcome back" : "Xin chào"), @(User.Identity.Name?.Split('@')[0])!</span>
                            <span class="text-muted small">· @(Model.CompletedLessonsCount ?? 0) @(isEn ? "lessons completed" : "bài hoàn thành")</span>
                        </div>
                        @if (Model.LastAccessedTutorial != null)
                        {
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@Model.LastAccessedTutorial.GetSlug(isEn)" 
                               class="btn btn-xs btn-outline-primary rounded-1 px-2.5 py-1 small fw-semibold text-truncate" style="max-width: 280px;">
                                <i class="bi bi-play-fill"></i> @(isEn ? "Resume:" : "Học tiếp:") @Model.LastAccessedTutorial.GetTitle(isEn)
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Interactive C# 14 Code Terminal Showcase -->
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="dev-code-window">
                    <div class="dev-code-window-header">
                        <div class="dev-code-dots">
                            <span class="dev-code-dot close"></span>
                            <span class="dev-code-dot minimize"></span>
                            <span class="dev-code-dot maximize"></span>
                        </div>
                        <span class="dev-code-title">Program.cs</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="dev-code-pill">C# 14 · .NET 10</span>
                            <a asp-controller="Playground" asp-action="Index" class="btn btn-xs btn-outline-light rounded-1 px-2 py-0.5 font-monospace" style="font-size: 0.725rem;">
                                <i class="bi bi-play-fill text-success"></i> Run (Ctrl+Enter)
                            </a>
                        </div>
                    </div>
                    <pre class="dev-code-body mb-0"><code><span class="text-primary">var</span> curriculum = <span class="text-primary">new</span> <span class="text-warning">Curriculum</span>(Name: <span class="text-success">"Enterprise .NET"</span>, Stages: 4);

<span class="text-primary">await foreach</span> (<span class="text-primary">var</span> stage <span class="text-primary">in</span> curriculum.GetTracksAsync())
{
    Console.WriteLine($<span class="text-success">"[{stage.Index}] {stage.Title} -> {stage.LessonsCount} lessons"</span>);
}

<span class="text-secondary">// Output:</span>
<span class="text-success">// [1] C# & .NET Cơ bản -> 25 lessons</span>
<span class="text-success">// [2] OOP & C# Nâng cao -> 30 lessons</span>
<span class="text-success">// [3] Entity Framework Core -> 22 lessons</span>
<span class="text-success">// [4] ASP.NET Core & Web API -> 24 lessons</span></code></pre>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sleek Roadmap Stage Grid (Minimal, No Description Clutter) -->
<section class="container py-4 my-2">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold mb-0 text-body-emphasis">
            @(isEn ? "Curriculum Roadmap" : "Lộ Trình Học")
        </h2>
        <a asp-controller="Roadmap" asp-action="Index" class="small text-muted text-decoration-none">
            @(isEn ? "View all tracks" : "Xem tất cả") <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <div class="row g-2.5">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-md-6 col-lg-3">
                <a asp-controller="Tutorials" asp-action="Index" asp-route-category="@cat.GetSlug(isEn)" 
                   class="card h-100 rounded-2 border p-3 bg-body text-decoration-none hover-border-primary transition-colors d-flex flex-column justify-content-between">
                    <div class="d-flex align-items-center gap-2.5 mb-2">
                        <div class="text-primary fs-5">
                            <i class="bi @cat.IconClass"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-body-emphasis">@cat.GetTitle(isEn)</h6>
                    </div>
                    <div class="d-flex align-items-center justify-content-between text-muted small pt-2 border-top">
                        <span class="font-monospace" style="font-size: 0.8rem;">@cat.Tutorials.Count @(isEn ? "lessons" : "bài học")</span>
                        <i class="bi bi-arrow-right text-primary"></i>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- Featured Technical Guides (Minimal Card Grid) -->
<section class="container py-4 my-2">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h5 fw-bold mb-0 text-body-emphasis">
            @(isEn ? "Featured Guides" : "Bài Hướng Dẫn Nổi Bật")
        </h2>
        <a asp-controller="Tutorials" asp-action="Index" class="small text-muted text-decoration-none">
            @(isEn ? "All 101 lessons" : "Tất cả 101 bài") <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <div class="row g-2.5">
        @foreach (var item in Model.FeaturedTutorials)
        {
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" 
                   class="card h-100 rounded-2 border p-3 bg-body text-decoration-none hover-border-primary transition-colors d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between text-muted small mb-1.5" style="font-size: 0.775rem;">
                            <span class="text-primary font-monospace">@item.Category.GetTitle(isEn)</span>
                            <span>@item.EstimatedReadingMinutes @(isEn ? "min read" : "phút đọc")</span>
                        </div>
                        <h6 class="fw-bold mb-1.5 text-body-emphasis">@item.GetTitle(isEn)</h6>
                        <p class="text-body-secondary small mb-0 text-truncate-2" style="font-size: 0.825rem; line-height: 1.5;">
                            @item.GetSummary(isEn)
                        </p>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- Recent Community Activity (Compact List, No Clutter) -->
@if (Model.RecentActivities.Any())
{
    <section class="container py-3 my-2 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2.5">
            <h2 class="h6 fw-bold mb-0 text-body-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                <i class="bi bi-activity text-primary me-1"></i> @(isEn ? "Recent Activity" : "Hoạt Động Gần Đây")
            </h2>
            <a asp-controller="Activity" asp-action="Index" class="small text-muted text-decoration-none" style="font-size: 0.775rem;">
                @(isEn ? "View all" : "Xem tất cả") <i class="bi bi-chevron-right"></i>
            </a>
        </div>
        <div class="border rounded-2 bg-body overflow-hidden">
            @foreach (var act in Model.RecentActivities.Take(4))
            {
                <div class="d-flex align-items-center justify-content-between p-2.5 px-3 border-bottom last-border-0 gap-2">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <i class="bi @act.IconClass text-primary small"></i>
                        <span class="small fw-semibold text-body-emphasis text-truncate">@act.UserDisplayName</span>
                        <span class="small text-muted text-truncate d-none d-sm-inline">@act.GetActivityTitle(isEn)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        @if (act.XpEarned > 0)
                        {
                            <span class="text-warning-emphasis font-monospace small" style="font-size: 0.75rem;">+@act.XpEarned XP</span>
                        }
                        <span class="text-muted font-monospace small" style="font-size: 0.725rem;">@act.GetActivityTimeAgo(isEn)</span>
                    </div>
                </div>
            }
        </div>
    </section>
}
