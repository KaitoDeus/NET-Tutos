@model NET_Tutos.Models.ViewModels.StudentProfileViewModel
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Student Dashboard" : "Góc học tập";
    string rankTitle = isEn
        ? (Model.User.ExperiencePoints >= 200 ? ".NET Master" :
           Model.User.ExperiencePoints >= 100 ? "Intermediate Developer" :
           Model.User.ExperiencePoints >= 40 ? "Junior Developer" : "NET Rookie")
        : (Model.User.ExperiencePoints >= 200 ? ".NET Master" :
           Model.User.ExperiencePoints >= 100 ? "Lập trình viên Trung cấp" :
           Model.User.ExperiencePoints >= 40 ? "Lập trình viên Tập sự" : "Tân binh .NET");
}

<div class="container py-5">
    <!-- Student Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-body mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-auto text-center text-md-start">
                <div class="position-relative d-inline-block">
                    <div class="rounded-circle bg-gradient-dotnet text-white d-flex align-items-center justify-content-center shadow-lg"
                         style="width: 88px; height: 88px; font-size: 2.2rem; font-weight: bold;">
                        @(string.IsNullOrEmpty(Model.User.FullName) ? "U" : Model.User.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success p-1.5" title="@(isEn ? "Active" : "Đang hoạt động")">
                        <span class="visually-hidden">Online</span>
                    </span>
                </div>
            </div>

            <div class="col-md">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <h2 class="fw-bold mb-0 text-body-emphasis">@Model.User.FullName</h2>
                    <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill fw-semibold">
                        <i class="bi bi-award-fill me-1"></i> @rankTitle
                    </span>
                    <span class="badge bg-primary px-3 py-1.5 rounded-pill fw-semibold">
                        <i class="bi bi-lightning-charge-fill me-1"></i> @Model.User.ExperiencePoints XP
                    </span>
                </div>
                <p class="text-muted small mb-0">
                    <i class="bi bi-envelope me-1"></i> @Model.User.Email &nbsp;•&nbsp; 
                    <i class="bi bi-calendar-check me-1"></i> @(isEn ? "Joined:" : "Tham gia:") @Model.User.CreatedAt.ToString(isEn ? "MMM dd, yyyy" : "dd/MM/yyyy")
                </p>
            </div>

                <div class="col-md-auto text-center text-md-end">
                    @if (Model.LastAccessedTutorial != null)
                    {
                        <span class="small text-muted d-block mb-1">@(isEn ? "Recently viewed lesson:" : "Bài học xem gần nhất:")</span>
                        <div class="d-flex gap-2 justify-content-center justify-content-md-end flex-wrap">
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@Model.LastAccessedTutorial.Slug" 
                               class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
                                <i class="bi bi-play-circle-fill me-1"></i> @(isEn ? "Continue learning" : "Tiếp tục học")
                            </a>
                            <a asp-controller="Project" asp-action="MyProjects" class="btn btn-outline-primary rounded-pill px-3 shadow-sm fw-semibold">
                                <i class="bi bi-folder-check me-1"></i> @(isEn ? "My Capstones" : "Đồ án của tôi")
                            </a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Project" asp-action="MyProjects" class="btn btn-outline-primary rounded-pill px-3 shadow-sm fw-semibold">
                            <i class="bi bi-folder-check me-1"></i> @(isEn ? "My Capstones" : "Đồ án của tôi")
                        </a>
                    }
                </div>
            </div>
        </div>

    <!-- Public Portfolio & Developer Showcase Banner -->
    <div class="card border-0 shadow-sm rounded-4 p-3.5 p-md-4 mb-4 bg-gradient-dotnet text-white">
        <div class="row align-items-center g-3">
            <div class="col-md">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-white text-primary rounded-pill px-2.5 py-1 fw-bold small">
                        <i class="bi bi-briefcase-fill me-1"></i>PORTFOLIO
                    </span>
                    <h5 class="fw-bold mb-0 text-white">@(isEn ? "Your Public Developer Portfolio is Live!" : "Hồ Sơ Năng Lực & Portfolio Của Bạn Đã Sẵn Sàng!")</h5>
                </div>
                <p class="text-white text-opacity-80 small mb-0">
                    @(isEn 
                        ? $"Share your verifiable resume link '/u/{User.Identity?.Name?.Split('@')[0]}' with recruiters, featuring your verified certificates, Capstone projects, and skill matrix." 
                        : $"Chia sẻ liên kết hồ sơ chuyên nghiệp '/u/{User.Identity?.Name?.Split('@')[0]}' tới nhà tuyển dụng kèm chứng chỉ số đã cấp, đồ án thực tế và ma trận kỹ năng.")
                </p>
            </div>
            <div class="col-md-auto d-flex flex-wrap gap-2">
                <a href="/u/@(User.Identity?.Name?.Split('@')[0])" class="btn btn-light rounded-pill px-3.5 py-2 fw-semibold text-primary shadow-sm">
                    <i class="bi bi-box-arrow-up-right me-1.5"></i> @(isEn ? "View Public Portfolio" : "Xem Portfolio công khai")
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-body h-100 card-hover">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">@(isEn ? "Overall Progress" : "Tiến độ tổng thể")</span>
                    <span class="fs-4 text-primary"><i class="bi bi-pie-chart-fill"></i></span>
                </div>
                <div class="display-6 fw-bold text-primary mb-2">@Model.OverallProgressPercentage%</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.OverallProgressPercentage%" aria-valuenow="@Model.OverallProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <span class="small text-muted mt-2 d-block">@(isEn ? $"Completed {Model.TotalCompletedLessons}/{Model.TotalLessons} lessons" : $"Hoàn thành {Model.TotalCompletedLessons}/{Model.TotalLessons} bài")</span>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-body h-100 card-hover">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">@(isEn ? "Completed Lessons" : "Bài học hoàn tất")</span>
                    <span class="fs-4 text-success"><i class="bi bi-check-circle-fill"></i></span>
                </div>
                <div class="display-6 fw-bold text-success mb-2">@Model.TotalCompletedLessons</div>
                <span class="small text-muted d-block">@(isEn ? "+20 XP per completed lesson" : "+20 XP cho mỗi bài học")</span>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-body h-100 card-hover" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#streakModal" title="@(isEn ? "Click to view learning streak details" : "Bấm để xem chi tiết chuỗi học tập")">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">@(isEn ? "Learning Streak" : "Chuỗi ngày học")</span>
                    <span class="fs-4 text-danger"><i class="bi bi-fire"></i></span>
                </div>
                <div class="display-6 fw-bold text-danger mb-1">
                    @Model.User.CurrentStreak <span class="fs-6 text-muted">@(isEn ? "days" : "ngày")</span>
                </div>
                <span class="small text-muted d-block">
                    @(isEn ? $"Record: {Model.User.LongestStreak} days · Check-in" : $"Kỷ lục: {Model.User.LongestStreak} ngày · Điểm danh")
                </span>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 bg-body h-100 card-hover">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">@(isEn ? "Course Certificate" : "Chứng chỉ khóa học")</span>
                    <span class="fs-4 text-warning"><i class="bi bi-award"></i></span>
                </div>
                <div class="display-6 fw-bold text-warning mb-2">
                    @(Model.OverallProgressPercentage >= 100 ? "1" : "0")
                </div>
                <span class="small text-muted d-block">
                    @(Model.OverallProgressPercentage >= 100 ? (isEn ? "Eligible for certificate!" : "Đủ điều kiện cấp chứng chỉ!") : (isEn ? "Reach 100% to unlock" : "Đạt 100% để mở khóa"))
                </span>
            </div>
        </div>
    </div>

    <!-- Category Progress Breakdown -->
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-body h-100">
                <h4 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-bar-chart-steps text-primary me-2"></i> @(isEn ? "Progress by Topic" : "Tiến độ theo chuyên đề")
                </h4>

                <div class="d-flex flex-column gap-4">
                    @foreach (var prog in Model.CategoryProgresses)
                    {
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold">
                                    <i class="bi @prog.Category.IconClass text-@prog.Category.BadgeColor me-2"></i>
                                    @prog.Category.GetTitle(isEn)
                                </span>
                                <span class="badge bg-@prog.Category.BadgeColor bg-opacity-10 text-@prog.Category.BadgeColor">
                                    @prog.CompletedCount / @prog.TotalCount @(isEn ? "lessons" : "bài") (@prog.Percentage%)
                                </span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-@prog.Category.BadgeColor" role="progressbar" style="width: @prog.Percentage%" aria-valuenow="@prog.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-body h-100">
                <h4 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-clock-history text-info me-2"></i> @(isEn ? "Recently Completed Lessons" : "Bài học vừa hoàn thành")
                </h4>

                @if (!Model.RecentCompletedLessons.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-journal-x fs-1 d-block mb-2"></i>
                        <span>@(isEn ? "You haven't completed any lessons yet. Start learning now!" : "Bạn chưa hoàn thành bài học nào. Hãy bắt đầu ngay nhé!")</span>
                        <div class="mt-3">
                            <a asp-controller="Roadmap" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">
                                @(isEn ? "Explore Roadmap" : "Khám phá lộ trình")
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.RecentCompletedLessons)
                        {
                            <div class="list-group-item bg-transparent px-0 py-2.5 d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2 text-truncate me-2">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.Tutorial?.GetSlug(isEn)" 
                                       class="text-decoration-none text-body-emphasis small fw-medium text-truncate">
                                        @item.Tutorial?.GetTitle(isEn)
                                    </a>
                                </div>
                                <span class="text-muted small" style="white-space:nowrap">
                                    @(item.CompletedAt?.ToString("dd/MM") ?? "")
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Certificates & Exam History Section -->
    <div class="row g-4 mt-2">
        <!-- Certificates -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-body h-100">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h4 class="fw-bold mb-0 d-flex align-items-center">
                        <i class="bi bi-award-fill text-warning me-2"></i> @(isEn ? "My Digital Certificates" : "Chứng chỉ số của tôi")
                    </h4>
                    <a asp-controller="Exam" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">
                        <i class="bi bi-plus-circle me-1"></i> @(isEn ? "Take Exam for New Certificate" : "Thi lấy chứng chỉ mới")
                    </a>
                </div>

                @if (!Model.Certificates.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-award fs-1 d-block mb-2 text-warning opacity-50"></i>
                        <span>@(isEn ? "No certificates earned yet. Complete the course and score 80%+ on the exam to receive your certificate!" : "Bạn chưa có chứng chỉ nào. Hoàn thành khóa học và thi đạt từ 80% để nhận chứng chỉ nhé!")</span>
                        <div class="mt-3">
                            <a asp-controller="Exam" asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-3">
                                @(isEn ? "View Exam Catalog" : "Xem danh sách kỳ thi")
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var cert in Model.Certificates)
                        {
                            <div class="col-12">
                                <div class="card border border-warning-subtle bg-warning bg-opacity-10 rounded-4 p-3">
                                    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                                        <div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bi bi-patch-check-fill text-warning fs-5"></i>
                                                <h6 class="fw-bold mb-0">@(isEn ? "ASP.NET Core & C# Full-Stack Certification" : cert.CourseTitle)</h6>
                                            </div>
                                            <p class="text-muted small mb-0">
                                                @(isEn ? "Code:" : "Mã số:") <code>@cert.CertificateCode</code> • @(isEn ? "Score:" : "Điểm thi:") <strong class="text-success">@cert.FinalScore.ToString("F1")%</strong> • @(isEn ? "Issued:" : "Ngày cấp:") @cert.IssuedAt.ToString("dd/MM/yyyy")
                                            </p>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <a asp-controller="Certificate" asp-action="DownloadPdf" asp-route-code="@cert.CertificateCode" class="btn btn-sm btn-outline-primary rounded-pill">
                                                <i class="bi bi-file-earmark-pdf"></i> @(isEn ? "Download PDF" : "Tải PDF")
                                            </a>
                                            <a asp-controller="Certificate" asp-action="Verify" asp-route-code="@cert.CertificateCode" class="btn btn-sm btn-primary rounded-pill">
                                                @(isEn ? "Verify" : "Xác thực")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Exam History -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-body h-100">
                <h4 class="fw-bold mb-4 d-flex align-items-center">
                    <i class="bi bi-ui-checks text-success me-2"></i> @(isEn ? "Recent Exam History" : "Lịch sử thi gần đây")
                </h4>

                @if (!Model.RecentQuizAttempts.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-clipboard-x fs-1 d-block mb-2 opacity-50"></i>
                        <span>@(isEn ? "You haven't taken any exams yet." : "Bạn chưa tham gia kỳ thi nào.")</span>
                        <div class="mt-3">
                            <a asp-controller="Exam" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill">
                                @(isEn ? "Take an Exam Now" : "Thử sức làm bài thi")
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush small">
                        @foreach (var attempt in Model.RecentQuizAttempts)
                        {
                            <div class="list-group-item bg-transparent px-0 py-2.5 d-flex align-items-center justify-content-between">
                                <div class="text-truncate me-2">
                                    <div class="fw-semibold text-truncate">@(isEn && attempt.ExamTitle.Contains("Bài thi tổng kết") ? "Graduation Certification Exam: Full-Stack ASP.NET Core & C#" : attempt.ExamTitle)</div>
                                    <div class="text-muted" style="font-size:0.75rem">
                                        @attempt.CompletedAt.ToString("dd/MM/yyyy HH:mm") • @(attempt.DurationSeconds / 60)m @(attempt.DurationSeconds % 60)s
                                    </div>
                                </div>
                                <span class="badge @(attempt.IsPassed ? "bg-success" : "bg-danger") rounded-pill">
                                    @attempt.ScorePercentage.ToString("F1")%
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
