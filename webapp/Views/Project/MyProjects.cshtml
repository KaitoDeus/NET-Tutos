@model NET_Tutos.Models.ViewModels.MyProjectsViewModel
@using NET_Tutos.Models.Entities
@using NET_Tutos.Services
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "My Projects - NET-Tutos" : "Đồ Án Của Tôi - NET-Tutos";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">@(isEn ? "Home" : "Trang chủ")</a></li>
            <li class="breadcrumb-item"><a asp-controller="Project" asp-action="Index" class="text-decoration-none">@(isEn ? "Capstone Projects" : "Đồ án thực chiến")</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(isEn ? "My Projects" : "Đồ án của tôi")</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-collection-fill text-primary me-2"></i> @(isEn ? "Capstone Project Portfolio" : "Hồ Sơ Đồ Án Thực Chiến")
            </h2>
            <p class="text-body-secondary mb-0">@(isEn ? "Track submission status, score benchmarks, and instructor code review feedback for your submitted projects." : "Theo dõi trạng thái, điểm số và nhận xét Code Review của Giảng viên cho các đồ án bạn đã nộp.")</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold btn-sm">
            <i class="bi bi-plus-circle me-1"></i> @(isEn ? "Explore New Projects" : "Khám phá thêm đề tài mới")
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 bg-body p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-folder-check fs-4"></i>
                    </div>
                    <div>
                        <div class="text-body-secondary small fw-semibold">@(isEn ? "SUBMITTED" : "ĐÃ NỘP BÀI")</div>
                        <h3 class="fw-bold mb-0">@Model.TotalSubmissions</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 bg-body p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success">
                        <i class="bi bi-patch-check-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-body-secondary small fw-semibold">@(isEn ? "APPROVED" : "ĐÃ ĐẠT CHUẨN")</div>
                        <h3 class="fw-bold mb-0 text-success">@Model.ApprovedCount</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card border-0 shadow-sm rounded-4 bg-body p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-body-secondary small fw-semibold">@(isEn ? "TOTAL XP EARNED" : "TỔNG XP NHẬN ĐƯỢC")</div>
                        <h3 class="fw-bold mb-0 text-primary">+@Model.TotalXpEarned XP</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Submissions List -->
    @if (!Model.Submissions.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 bg-body text-center p-5">
            <div class="rounded-circle bg-body-tertiary p-4 d-inline-block mx-auto mb-3">
                <i class="bi bi-folder-plus text-body-secondary" style="font-size: 3rem;"></i>
            </div>
            <h5 class="fw-bold">@(isEn ? "You have not submitted any projects yet" : "Bạn chưa nộp đồ án nào")</h5>
            <p class="text-body-secondary mb-4" style="max-width: 500px; margin: auto;">
                @(isEn ? "Select a capstone project that fits your skills and start building production-ready .NET solutions!" : "Hãy chọn một đề tài thực chiến phù hợp với khả năng của bạn để bắt đầu thực hành viết mã nguồn chất lượng cao!")
            </p>
            <div>
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold">
                    @(isEn ? "Browse Capstone Projects" : "Xem danh sách đồ án thực chiến")
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var sub in Model.Submissions)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 bg-body p-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-@sub.Project?.Category?.BadgeColor bg-opacity-10 text-@sub.Project?.Category?.BadgeColor border rounded-pill px-2.5 py-1 small">
                                        @sub.Project?.Category?.GetTitle(isEn)
                                    </span>
                                    <span class="text-body-secondary small">
                                        @(isEn ? "Submitted:" : "Nộp ngày:") @sub.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <h5 class="fw-bold mb-0">
                                    <a asp-action="Details" asp-route-slug="@sub.Project?.GetSlug(isEn)" class="text-decoration-none text-body-emphasis">
                                        @sub.Project?.GetTitle(isEn)
                                    </a>
                                </h5>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                @if (sub.Status == ProjectSubmissionStatus.Approved)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 fw-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i> @(isEn ? "Approved:" : "Đạt chuẩn:") @sub.Score/100
                                    </span>
                                    <span class="badge bg-primary text-white rounded-pill px-2.5 py-1.5 fw-bold">
                                        +@sub.XpAwarded XP
                                    </span>
                                }
                                else if (sub.Status == ProjectSubmissionStatus.NeedsImprovement)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-2 fw-semibold">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> @(isEn ? "Needs Revision" : "Cần sửa lại")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-3 py-2 fw-semibold">
                                        <i class="bi bi-hourglass-split me-1"></i> @(isEn ? "Pending Review" : "Đang chờ chấm")
                                    </span>
                                }

                                <a asp-action="Details" asp-route-slug="@sub.Project?.GetSlug(isEn)" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                    @(isEn ? "View Details" : "Xem chi tiết")
                                </a>
                            </div>
                        </div>

                        <!-- Repo links & Notes -->
                        <div class="p-3 rounded-3 bg-body-tertiary mb-2 small">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <span class="text-body-secondary d-block">GitHub Repository:</span>
                                    <a href="@sub.GitHubRepoUrl" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold text-decoration-none">
                                        <i class="bi bi-github me-1"></i> @sub.GitHubRepoUrl
                                    </a>
                                </div>
                                @if (!string.IsNullOrEmpty(sub.LiveDemoUrl))
                                {
                                    <div class="col-md-6">
                                        <span class="text-body-secondary d-block">Live Demo:</span>
                                        <a href="@sub.LiveDemoUrl" target="_blank" rel="noopener noreferrer" class="text-truncate d-block fw-semibold text-decoration-none">
                                            <i class="bi bi-globe me-1"></i> @sub.LiveDemoUrl
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Reviewer Feedback (if any) -->
                        @if (!string.IsNullOrEmpty(sub.ReviewerFeedback))
                        {
                            <div class="alert @(sub.Status == ProjectSubmissionStatus.Approved ? "alert-success" : "alert-warning") border-0 rounded-3 p-3 mb-0 small">
                                <div class="fw-bold mb-1">
                                    <i class="bi bi-chat-quote-fill me-1"></i> @(isEn ? "Feedback from Instructor / Reviewer:" : "Nhận xét từ Giảng viên / Reviewer:")
                                </div>
                                <div style="white-space: pre-line; line-height: 1.5;">@sub.ReviewerFeedback</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
