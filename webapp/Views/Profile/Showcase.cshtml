/* Print Optimization for Resume / CV */
@@media print {
    header, footer, .d-print-none, .floating-ai-container, #notificationToastContainer {
        display: none !important;
    }
    .developer-portfolio-page {
        padding: 0 !important;
    }
    .portfolio-cover-bg {
        background: #1e1b4b !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }
    .card {
        border: 1px solid #ddd !important;
        box-shadow: none !important;
        break-inside: avoid;
    }
    body {
        background: white !important;
        color: black !important;
    }
}
</style>

@section Scripts {
    <script>
        function copyPortfolioUrl() {
            const url = window.location.href;
            navigator.clipboard.writeText(url).then(() => {
                const isEn = @(isEn ? "true" : "false");
                const msg = isEn ? 'Portfolio link copied to clipboard! Ready to share with recruiters.' : 'Đã sao chép liên kết Portfolio vào khay nhớ tạm! Sẵn sàng chia sẻ cho nhà tuyển dụng.';
                alert(msg);
            }).catch(err => {
                console.error('Could not copy link:', err);
            });
        }

        const formUpdate = document.getElementById('formUpdatePortfolio');
        if (formUpdate) {
            formUpdate.addEventListener('submit', async function (e) {
                e.preventDefault();
                const btnSave = document.getElementById('btnSavePortfolio');
                const spinner = document.getElementById('saveSpinner');

                btnSave.disabled = true;
                if (spinner) spinner.classList.remove('d-none');

                try {
                    const formData = new FormData(this);
                    // Ensure boolean unchecked states are accounted for
                    if (!document.getElementById('checkIsPublic').checked) {
                        formData.set('IsPublic', 'false');
                    }
                    if (!document.getElementById('checkShowEmail').checked) {
                        formData.set('ShowEmail', 'false');
                    }

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const response = await fetch('/Profile/UpdateProfile', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    const res = await response.json();
                    if (res.success) {
                        window.location.reload();
                    } else {
                        alert(res.message || '@(isEn ? "Error updating profile!" : "Lỗi khi cập nhật hồ sơ!")');
                    }
                } catch (err) {
                    console.error(err);
                    alert('@(isEn ? "Server connection error!" : "Lỗi kết nối máy chủ!")');
                } finally {
                    btnSave.disabled = false;
                    if (spinner) spinner.classList.add('d-none');
                }
            });
        }
    </script>
}
