@model NET_Tutos.Models.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Localization
@using NET_Tutos.Services
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Home" : "Trang chủ";
}

@section Styles {
    <style>
        .featured-card {
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .featured-card:hover {
            transform: translateY(-4px);
            border-color: var(--bs-primary) !important;
            box-shadow: 0 10px 24px -4px rgba(13, 110, 253, 0.12), 0 4px 8px -2px rgba(0, 0, 0, 0.04) !important;
        }
        .featured-card .btn-outline-primary:hover {
            color: #fff !important;
        }
        .activity-item-hover {
            transition: background-color 0.15s ease;
        }
        .activity-item-hover:hover {
            background-color: var(--bs-tertiary-bg) !important;
        }
    </style>
}

<!-- Minimalist Hero Section with Prominent Cinematic Video Showcase -->
<section class="py-4 py-md-5 border-bottom">
    <div class="container">
        <!-- Punchy, Direct Header (Strict Typographic Standard) -->
        <div class="text-center mb-4">
            <h1 class="hero-title mb-0">
                @(isEn ? "Modern .NET & C# Engineering" : "Lập Trình .NET & C# Hiện Đại")
            </h1>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="row justify-content-center mb-3">
                <div class="col-xl-10">
                    <div class="d-flex align-items-center justify-content-between p-2.5 px-3 rounded-2 border bg-body-tertiary">
                        <div class="d-flex align-items-center gap-2">
                            <span class="status-indicator-dot"></span>
                            <span class="fw-semibold text-body-emphasis" style="font-size: var(--text-sm);">@(isEn ? "Welcome back" : "Xin chào"), @(User.Identity.Name?.Split('@')[0])!</span>
                            <span class="text-muted" style="font-size: var(--text-xs);">· @(Model.CompletedLessonsCount ?? 0) @(isEn ? "lessons completed" : "bài hoàn thành")</span>
                        </div>
                        @if (Model.LastAccessedTutorial != null)
                        {
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@Model.LastAccessedTutorial.GetSlug(isEn)" 
                               class="btn btn-xs btn-outline-primary rounded-1 px-2.5 py-1 fw-semibold text-truncate" style="max-width: 280px; font-size: var(--text-xs);">
                                <i class="bi bi-play-fill"></i> @(isEn ? "Resume:" : "Học tiếp:") @Model.LastAccessedTutorial.GetTitle(isEn)
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Cinematic Video Showcase Card (Full Center Video Front and Center) -->
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="card border rounded-4 p-2 p-md-3 bg-body shadow-sm">
                    <!-- Embedded YouTube Video Player Covering Main Area -->
                    <div class="ratio ratio-16x9 rounded-3 overflow-hidden border bg-dark shadow-xs mb-0">
                        <iframe src="https://www.youtube-nocookie.com/embed/6BcPIvVfVAw" 
                                title="@(isEn ? "What is .NET? (Microsoft Official Guide)" : ".NET là gì? (Tài liệu Microsoft)")" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Technical Guides -->
<section class="container py-4 my-2">
    <div class="d-flex align-items-center justify-content-between mb-3.5">
        <div>
            <h2 class="h4 fw-bold mb-0 text-body-emphasis">
                @(isEn ? "Featured Lessons" : "Bài Học Tiêu Biểu")
            </h2>
        </div>
        <a asp-controller="Tutorials" asp-action="Index" class="text-muted text-decoration-none fw-medium d-flex align-items-center gap-1" style="font-size: var(--text-xs);">
            @(isEn ? $"All {Model.TotalTutorials} lessons" : $"Tất cả {Model.TotalTutorials} bài") <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <div class="row g-3">
        @foreach (var item in Model.FeaturedTutorials)
        {
            var badgeColor = item.Category?.BadgeColor ?? "primary";
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 rounded-4 border bg-body shadow-xs featured-card d-flex flex-column">
                    <div class="card-body p-4 d-flex flex-column">
                        <!-- Top Meta: Category Badge & Reading Time -->
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                            <span class="badge bg-@badgeColor-subtle text-@badgeColor border border-@badgeColor-subtle rounded-pill px-2.5 py-1.5 font-monospace fw-semibold d-inline-flex align-items-center gap-1.5" style="font-size: var(--text-2xs);">
                                <i class="bi @(item.Category?.IconClass ?? "bi-journal-code")"></i>
                                <span>@(item.Category.GetShortTitle(isEn))</span>
                            </span>
                            <span class="text-muted font-monospace small d-flex align-items-center gap-1.5 text-nowrap" style="font-size: var(--text-xs);">
                                <i class="bi bi-clock"></i>
                                <span>@item.EstimatedReadingMinutes @(isEn ? "min read" : "phút đọc")</span>
                            </span>
                        </div>

                        <!-- Title -->
                        <h3 class="fw-bold mb-2 text-body-emphasis" style="font-size: 1.05rem; line-height: 1.45; min-height: 3rem;">
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="text-body-emphasis text-decoration-none hover-text-primary">
                                @item.GetTitle(isEn)
                            </a>
                        </h3>

                        <!-- Summary -->
                        <p class="text-body-secondary mb-3 flex-grow-1" style="font-size: var(--text-sm); line-height: 1.6; min-height: 2.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.GetSummary(isEn)
                        </p>

                        <!-- Bottom Action Bar -->
                        <div class="d-flex align-items-center justify-content-between pt-3 mt-auto border-top">
                            <span class="badge bg-body-tertiary text-secondary border rounded-pill px-2.5 py-1 font-monospace" style="font-size: var(--text-2xs);">
                                @(item.Difficulty switch {
                                    DifficultyLevel.Beginner => isEn ? "Beginner" : "Cơ bản",
                                    DifficultyLevel.Intermediate => isEn ? "Intermediate" : "Trung cấp",
                                    DifficultyLevel.Advanced => isEn ? "Advanced" : "Nâng cao",
                                    _ => isEn ? "Beginner" : "Cơ bản"
                                })
                            </span>
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1.5" style="font-size: var(--text-xs);">
                                <span>@(isEn ? "Read lesson" : "Khám phá bài học")</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Compact Community Activity Strip -->
@if (Model.RecentActivities.Any())
{
    <section class="container py-4 my-2 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="section-label d-flex align-items-center gap-2 fw-bold text-body-emphasis" style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.05em;">
                <i class="bi bi-activity text-primary"></i> @(isEn ? "Recent Community Activity" : "Hoạt Động Cộng Đồng Gần Đây")
            </span>
            <a asp-controller="Activity" asp-action="Index" class="text-muted text-decoration-none fw-medium d-flex align-items-center gap-1" style="font-size: var(--text-xs);">
                @(isEn ? "View all" : "Xem tất cả") <i class="bi bi-chevron-right"></i>
            </a>
        </div>
        <div class="card border rounded-4 bg-body shadow-xs overflow-hidden">
            <div class="list-group list-group-flush">
                @foreach (var act in Model.RecentActivities.Take(4))
                {
                    var color = string.IsNullOrEmpty(act.TypeBadgeColor) ? "primary" : act.TypeBadgeColor;
                    <div class="list-group-item d-flex align-items-center justify-content-between py-3.5 px-3 px-md-4 border-bottom last-border-0 gap-3 bg-transparent activity-item-hover">
                        <div class="d-flex align-items-center gap-3 min-w-0 flex-grow-1">
                            <div class="rounded-3 bg-@color-subtle text-@color d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px; font-size: 1.15rem;">
                                <i class="bi @act.IconClass"></i>
                            </div>
                            <div class="min-w-0 d-flex flex-wrap align-items-center gap-1.5">
                                <span class="fw-bold text-body-emphasis" style="font-size: var(--text-sm);">@act.UserDisplayName</span>
                                <span class="text-body-secondary" style="font-size: var(--text-sm);">@act.GetActivityTitle(isEn)</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2.5 flex-shrink-0">
                            @if (act.XpEarned > 0)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 font-monospace fw-semibold" style="font-size: var(--text-2xs);">
                                    <i class="bi bi-lightning-charge-fill me-0.5"></i>+@act.XpEarned XP
                                </span>
                            }
                            <span class="text-muted font-monospace d-flex align-items-center gap-1" style="font-size: var(--text-xs);">
                                <i class="bi bi-clock-history text-secondary"></i>
                                <span>@act.GetActivityTimeAgo(isEn)</span>
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
