@model NET_Tutos.Models.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Localization
@using NET_Tutos.Services
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Home" : "Trang chủ";
}

@section Styles {
    <style>
        .curriculum-scroll-list::-webkit-scrollbar {
            width: 4px;
        }
        .curriculum-scroll-list::-webkit-scrollbar-track {
            background: transparent;
        }
        .curriculum-scroll-list::-webkit-scrollbar-thumb {
            background-color: var(--bs-border-color);
            border-radius: 4px;
        }
        .curriculum-scroll-list::-webkit-scrollbar-thumb:hover {
            background-color: var(--bs-primary);
        }
        .featured-card {
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .featured-card:hover {
            transform: translateY(-2px);
            border-color: var(--bs-primary) !important;
            box-shadow: 0 4px 14px rgba(13, 110, 253, 0.08) !important;
        }
        .curriculum-item {
            transition: all 0.15s ease;
        }
        .curriculum-item:hover {
            border-color: var(--bs-primary) !important;
            background-color: var(--bs-primary-bg-subtle) !important;
        }
    </style>
}

<!-- Minimalist Hero Section with Prominent Video Showcase -->
<section class="py-4 py-md-5 border-bottom">
    <div class="container">
        <!-- Punchy, Direct Header (Strict Typographic Standard) -->
        <div class="text-center mb-4">
            <h1 class="hero-title mb-0">
                @(isEn ? "Modern .NET & C# Engineering" : "Lập Trình .NET & C# Hiện Đại")
            </h1>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="row justify-content-center mb-3">
                <div class="col-xl-11">
                    <div class="d-flex align-items-center justify-content-between p-2.5 px-3 rounded-2 border bg-body-tertiary">
                        <div class="d-flex align-items-center gap-2">
                            <span class="status-indicator-dot"></span>
                            <span class="fw-semibold text-body-emphasis" style="font-size: var(--text-sm);">@(isEn ? "Welcome back" : "Xin chào"), @(User.Identity.Name?.Split('@')[0])!</span>
                            <span class="text-muted" style="font-size: var(--text-xs);">· @(Model.CompletedLessonsCount ?? 0) @(isEn ? "lessons completed" : "bài hoàn thành")</span>
                        </div>
                        @if (Model.LastAccessedTutorial != null)
                        {
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@Model.LastAccessedTutorial.GetSlug(isEn)" 
                               class="btn btn-xs btn-outline-primary rounded-1 px-2.5 py-1 fw-semibold text-truncate" style="max-width: 280px; font-size: var(--text-xs);">
                                <i class="bi bi-play-fill"></i> @(isEn ? "Resume:" : "Học tiếp:") @Model.LastAccessedTutorial.GetTitle(isEn)
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Video Player & Roadmap Showcase (Video Front and Center, Minimal Text) -->
        <div class="row justify-content-center">
            <div class="col-xl-11">
                <div class="card border rounded-3 p-3 p-md-3.5 bg-body shadow-sm">
                    <div class="row g-3 g-lg-4 align-items-stretch">
                        <!-- Left: Embedded YouTube Video Player + Highlights -->
                        <div class="col-lg-7 d-flex flex-column justify-content-between">
                            <div class="ratio ratio-16x9 rounded-2 overflow-hidden border bg-dark">
                                <iframe src="https://www.youtube-nocookie.com/embed/6BcPIvVfVAw" 
                                        title="@(isEn ? "What is .NET? (Microsoft Official Guide)" : ".NET là gì? (Tài liệu Microsoft)")" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowfullscreen></iframe>
                            </div>

                            <div class="row g-2 mt-2.5">
                                <div class="col-4">
                                    <div class="p-2 rounded-2 border bg-body-tertiary text-center">
                                        <div class="fw-bold text-primary font-monospace" style="font-size: var(--text-xs);">.NET 10 & C# 13</div>
                                        <div class="text-muted text-truncate" style="font-size: 0.68rem;">@(isEn ? "Modern Standard" : "Chuẩn công nghệ")</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 rounded-2 border bg-body-tertiary text-center">
                                        <div class="fw-bold text-success font-monospace" style="font-size: var(--text-xs);">@(Model.TotalTutorials) @(isEn ? "Lessons" : "Bài học")</div>
                                        <div class="text-muted text-truncate" style="font-size: 0.68rem;">@(isEn ? $"{Model.TotalCategories} Senior Tracks" : $"{Model.TotalCategories} Chặng chuyên sâu")</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="p-2 rounded-2 border bg-body-tertiary text-center">
                                        <div class="fw-bold text-info font-monospace" style="font-size: var(--text-xs);">AI Copilot</div>
                                        <div class="text-muted text-truncate" style="font-size: 0.68rem;">@(isEn ? "Interactive Runner" : "Gợi ý code & Chấm điểm")</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Clean, Direct Curriculum Navigation (Standardized Type Scale) -->
                        <div class="col-lg-5 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                    <span class="section-label fw-bold text-primary text-uppercase" style="font-size: var(--text-xs); letter-spacing: 0.04em;">
                                        <i class="bi bi-compass me-1"></i>@(isEn ? $"Curriculum Roadmap ({Model.TotalCategories} Tracks)" : $"Lộ Trình {Model.TotalCategories} Chặng Chuyên Sâu")
                                    </span>
                                    <a asp-controller="Roadmap" asp-action="Index" class="text-muted text-decoration-none fw-medium d-flex align-items-center gap-1" style="font-size: var(--text-xs);">
                                        @(isEn ? "Full roadmap" : "Chi tiết") <i class="bi bi-chevron-right"></i>
                                    </a>
                                </div>

                                <div class="d-flex flex-column gap-1.5 mb-3 curriculum-scroll-list pe-1" style="max-height: 295px; overflow-y: auto;">
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <a asp-controller="Tutorials" asp-action="Index" asp-route-category="@cat.GetSlug(isEn)" 
                                           class="d-flex align-items-center justify-content-between p-2 px-2.5 rounded-2 border bg-body-tertiary text-decoration-none curriculum-item gap-2"
                                           title="@cat.GetTitle(isEn)">
                                            <div class="d-flex align-items-center gap-2 min-w-0" style="flex: 1 1 0%;">
                                                <i class="bi @cat.IconClass text-primary flex-shrink-0" style="font-size: 0.92rem;"></i>
                                                <span class="fw-semibold text-body-emphasis text-truncate" style="font-size: var(--text-sm);">@cat.GetTitle(isEn)</span>
                                            </div>
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill font-monospace flex-shrink-0" style="font-size: var(--text-2xs);">
                                                @(cat.Tutorials?.Count ?? 0) @(isEn ? "lessons" : "bài")
                                            </span>
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="d-flex gap-2 pt-2 border-top mt-auto">
                                <a asp-controller="Tutorials" asp-action="Index" class="btn btn-sm btn-primary rounded-2 px-3 py-2 fw-semibold flex-grow-1 d-flex align-items-center justify-content-center gap-1" style="font-size: var(--text-nav);">
                                    <span>@(isEn ? "Start Learning" : "Bắt đầu học ngay")</span> <i class="bi bi-arrow-right"></i>
                                </a>
                                <a asp-controller="Playground" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-2 px-3 py-2 fw-semibold font-monospace d-flex align-items-center gap-1" style="font-size: var(--text-nav);">
                                    <i class="bi bi-terminal"></i> <span>Playground</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Technical Guides (Strict Typographic Scale) -->
<section class="container py-4 my-2">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-2">
            <h2 class="h4 fw-bold mb-0 text-body-emphasis">
                @(isEn ? "Featured Lessons" : "Bài Học Tiêu Biểu")
            </h2>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-monospace" style="font-size: var(--text-2xs);">
                @(isEn ? "Handpicked" : "Tuyển chọn")
            </span>
        </div>
        <a asp-controller="Tutorials" asp-action="Index" class="text-muted text-decoration-none fw-medium" style="font-size: var(--text-xs);">
            @(isEn ? $"All {Model.TotalTutorials} lessons" : $"Tất cả {Model.TotalTutorials} bài") <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <div class="row g-3">
        @foreach (var item in Model.FeaturedTutorials)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 rounded-3 border bg-body shadow-xs featured-card d-flex flex-column">
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-monospace fw-semibold text-truncate" style="max-width: 65%; font-size: var(--text-2xs);" title="@(item.Category?.GetTitle(isEn) ?? "")">
                                <i class="bi @(item.Category?.IconClass ?? "bi-journal-code") me-1"></i>@(item.Category?.GetTitle(isEn) ?? "")
                            </span>
                            <span class="text-muted flex-shrink-0 font-monospace text-nowrap d-flex align-items-center gap-1" style="font-size: var(--text-xs);">
                                <i class="bi bi-clock"></i> @item.EstimatedReadingMinutes @(isEn ? "min read" : "phút đọc")
                            </span>
                        </div>
                        <h3 class="h6 fw-bold mb-2 text-body-emphasis" style="font-size: var(--text-base); line-height: 1.45; min-height: 2.8rem;">
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="text-body-emphasis text-decoration-none">
                                @item.GetTitle(isEn)
                            </a>
                        </h3>
                        <p class="text-body-secondary mb-3 text-truncate-2" style="font-size: var(--text-sm); line-height: 1.55;">
                            @item.GetSummary(isEn)
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-2.5 mt-auto border-top text-primary fw-medium" style="font-size: var(--text-xs);">
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="text-primary text-decoration-none d-flex align-items-center justify-content-between w-100">
                                <span>@(isEn ? "Read lesson" : "Khám phá bài học")</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Compact Community Activity Strip -->
@if (Model.RecentActivities.Any())
{
    <section class="container py-3 my-2 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2.5">
            <span class="section-label d-flex align-items-center gap-1.5 fw-bold text-body-emphasis" style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em;">
                <i class="bi bi-activity text-primary"></i> @(isEn ? "Recent Community Activity" : "Hoạt Động Cộng Đồng Gần Đây")
            </span>
            <a asp-controller="Activity" asp-action="Index" class="text-muted text-decoration-none" style="font-size: var(--text-xs);">
                @(isEn ? "View all" : "Xem tất cả") <i class="bi bi-chevron-right"></i>
            </a>
        </div>
        <div class="border rounded-3 bg-body shadow-xs overflow-hidden">
            @foreach (var act in Model.RecentActivities.Take(4))
            {
                <div class="d-flex align-items-center justify-content-between p-2.5 px-3 border-bottom last-border-0 gap-2">
                    <div class="d-flex align-items-center gap-2 min-w-0" style="flex: 1 1 0%;">
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 0.8rem;">
                            <i class="bi @act.IconClass"></i>
                        </div>
                        <span class="fw-semibold text-body-emphasis text-truncate" style="font-size: var(--text-sm);">@act.UserDisplayName</span>
                        <span class="text-muted text-truncate d-none d-sm-inline" style="font-size: var(--text-sm);">@act.GetActivityTitle(isEn)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        @if (act.XpEarned > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace" style="font-size: var(--text-2xs);">+@act.XpEarned XP</span>
                        }
                        <span class="text-muted font-monospace" style="font-size: var(--text-xs);">@act.GetActivityTimeAgo(isEn)</span>
                    </div>
                </div>
            }
        </div>
    </section>
}
