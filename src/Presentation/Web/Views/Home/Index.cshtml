@model NET_Tutos.Models.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Localization
@using NET_Tutos.Services
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Home" : "Trang chủ";
}

@section Styles {
    <style>
        .track-card, .featured-card {
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .track-card:hover, .featured-card:hover {
            transform: translateY(-3px);
            border-color: var(--bs-primary) !important;
            box-shadow: 0 6px 18px rgba(13, 110, 253, 0.09) !important;
        }
    </style>
}

<!-- Minimalist Hero Section with Prominent Cinematic Video Showcase -->
<section class="py-4 py-md-5 border-bottom">
    <div class="container">
        <!-- Punchy, Direct Header (Strict Typographic Standard) -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-primary-subtle text-primary border border-primary-subtle small fw-semibold mb-2">
                <i class="bi bi-patch-check-fill"></i> .NET 10 & C# 13 Enterprise Engineering
            </div>
            <h1 class="hero-title mb-2">
                @(isEn ? "Modern .NET & C# Engineering" : "Lập Trình .NET & C# Hiện Đại")
            </h1>
            <p class="text-muted mx-auto mb-0" style="max-width: 720px; font-size: var(--text-base);">
                @(isEn 
                    ? "From C# core fundamentals to Senior Software Architecture, Distributed Microservices, and High-Performance .NET Systems."
                    : "Lộ trình chuẩn hóa từ nền tảng C# vững chắc đến kiến trúc Microservices phân tán, tối ưu hiệu năng cao và luyện thi phỏng vấn Senior Engineer.")
            </p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="row justify-content-center mb-3">
                <div class="col-xl-10">
                    <div class="d-flex align-items-center justify-content-between p-2.5 px-3 rounded-2 border bg-body-tertiary">
                        <div class="d-flex align-items-center gap-2">
                            <span class="status-indicator-dot"></span>
                            <span class="fw-semibold text-body-emphasis" style="font-size: var(--text-sm);">@(isEn ? "Welcome back" : "Xin chào"), @(User.Identity.Name?.Split('@')[0])!</span>
                            <span class="text-muted" style="font-size: var(--text-xs);">· @(Model.CompletedLessonsCount ?? 0) @(isEn ? "lessons completed" : "bài hoàn thành")</span>
                        </div>
                        @if (Model.LastAccessedTutorial != null)
                        {
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@Model.LastAccessedTutorial.GetSlug(isEn)" 
                               class="btn btn-xs btn-outline-primary rounded-1 px-2.5 py-1 fw-semibold text-truncate" style="max-width: 280px; font-size: var(--text-xs);">
                                <i class="bi bi-play-fill"></i> @(isEn ? "Resume:" : "Học tiếp:") @Model.LastAccessedTutorial.GetTitle(isEn)
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Cinematic Video Showcase Card (Full Center Video Front and Center) -->
        <div class="row justify-content-center">
            <div class="col-xl-10">
                <div class="card border rounded-4 p-3 p-md-4 bg-body shadow-sm">
                    <!-- Embedded YouTube Video Player Covering Main Area -->
                    <div class="ratio ratio-16x9 rounded-3 overflow-hidden border bg-dark shadow-xs mb-3">
                        <iframe src="https://www.youtube-nocookie.com/embed/6BcPIvVfVAw" 
                                title="@(isEn ? "What is .NET? (Microsoft Official Guide)" : ".NET là gì? (Tài liệu Microsoft)")" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                allowfullscreen></iframe>
                    </div>

                    <!-- Bottom Bar: Highlights & Action CTAs -->
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 pt-2">
                        <!-- Key Stats / Highlights -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="badge bg-body-tertiary text-body border rounded-pill px-3 py-2 font-monospace small">
                                <i class="bi bi-cpu text-primary me-1"></i> .NET 10 LTS
                            </span>
                            <span class="badge bg-body-tertiary text-body border rounded-pill px-3 py-2 font-monospace small">
                                <i class="bi bi-layers text-success me-1"></i> @(Model.TotalCategories) @(isEn ? "Senior Tracks" : "Chặng chuyên sâu")
                            </span>
                            <span class="badge bg-body-tertiary text-body border rounded-pill px-3 py-2 font-monospace small">
                                <i class="bi bi-book text-info me-1"></i> @(Model.TotalTutorials) @(isEn ? "Curated Lessons" : "Bài học chuẩn")
                            </span>
                            <span class="badge bg-body-tertiary text-body border rounded-pill px-3 py-2 font-monospace small">
                                <i class="bi bi-stars text-warning me-1"></i> AI Copilot
                            </span>
                        </div>

                        <!-- Main CTAs -->
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <a asp-controller="Roadmap" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3.5 py-2 fw-semibold d-flex align-items-center gap-1.5" style="font-size: var(--text-nav);">
                                <i class="bi bi-compass"></i> <span>@(isEn ? "Roadmap" : "Lộ trình")</span>
                            </a>
                            <a asp-controller="Playground" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3.5 py-2 fw-semibold font-monospace d-flex align-items-center gap-1.5" style="font-size: var(--text-nav);">
                                <i class="bi bi-terminal"></i> <span>Playground</span>
                            </a>
                            <a asp-controller="Tutorials" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-xs d-flex align-items-center gap-1.5" style="font-size: var(--text-nav);">
                                <span>@(isEn ? "Start Learning" : "Bắt đầu học ngay")</span> <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Comprehensive Curriculum Tracks (8 Senior Tracks Showcase) -->
<section class="container py-4 my-2">
    <div class="d-flex align-items-center justify-content-between mb-3.5">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="section-label fw-bold text-primary text-uppercase" style="font-size: var(--text-xs); letter-spacing: 0.05em;">
                    <i class="bi bi-compass me-1"></i>@(isEn ? "Learning Tracks" : "Chuyên Đề Đào Tạo")
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-monospace" style="font-size: var(--text-2xs);">
                    @(Model.TotalCategories) @(isEn ? "Tracks" : "Chặng")
                </span>
            </div>
            <h2 class="h4 fw-bold mb-0 text-body-emphasis">
                @(isEn ? "Senior .NET Engineer Curriculum" : "Lộ Trình 8 Chặng Chuyên Sâu")
            </h2>
        </div>
        <a asp-controller="Roadmap" asp-action="Index" class="text-muted text-decoration-none fw-medium d-flex align-items-center gap-1" style="font-size: var(--text-xs);">
            @(isEn ? "View full visual roadmap" : "Xem toàn bộ lộ trình chi tiết") <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <!-- 8 Tracks Grid (4 columns on lg, 2 on md/sm, 1 on xs) -->
    <div class="row g-3 mb-4">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-12 col-sm-6 col-lg-3">
                <a asp-controller="Tutorials" asp-action="Index" asp-route-category="@cat.GetSlug(isEn)" 
                   class="card h-100 rounded-3 border bg-body shadow-xs p-3 text-decoration-none track-card d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2.5">
                            <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; font-size: 1.15rem;">
                                <i class="bi @cat.IconClass"></i>
                            </div>
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill font-monospace" style="font-size: var(--text-2xs);">
                                @(cat.Tutorials?.Count ?? 0) @(isEn ? "lessons" : "bài học")
                            </span>
                        </div>
                        <h3 class="h6 fw-bold mb-1.5 text-body-emphasis" style="font-size: var(--text-sm); line-height: 1.45; min-height: 2.5rem;">
                            @cat.GetTitle(isEn)
                        </h3>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 mt-2 border-top text-primary small fw-semibold" style="font-size: var(--text-xs);">
                        <span>@(isEn ? "Explore track" : "Khám phá chặng")</span>
                        <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- Featured Technical Guides (Handpicked Lessons) -->
<section class="container py-4 my-2 border-top">
    <div class="d-flex align-items-center justify-content-between mb-3.5">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="section-label fw-bold text-success text-uppercase" style="font-size: var(--text-xs); letter-spacing: 0.05em;">
                    <i class="bi bi-stars me-1"></i>@(isEn ? "Recommended" : "Tuyển Chọn")
                </span>
            </div>
            <h2 class="h4 fw-bold mb-0 text-body-emphasis">
                @(isEn ? "Featured Lessons" : "Bài Học Tiêu Biểu")
            </h2>
        </div>
        <a asp-controller="Tutorials" asp-action="Index" class="text-muted text-decoration-none fw-medium d-flex align-items-center gap-1" style="font-size: var(--text-xs);">
            @(isEn ? $"All {Model.TotalTutorials} lessons" : $"Tất cả {Model.TotalTutorials} bài") <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <div class="row g-3">
        @foreach (var item in Model.FeaturedTutorials)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 rounded-3 border bg-body shadow-xs featured-card d-flex flex-column">
                    <div class="p-3.5 d-flex flex-column flex-grow-1">
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill font-monospace fw-semibold text-truncate" style="max-width: 65%; font-size: var(--text-2xs);" title="@(item.Category?.GetTitle(isEn) ?? "")">
                                <i class="bi @(item.Category?.IconClass ?? "bi-journal-code") me-1"></i>@(item.Category?.GetTitle(isEn) ?? "")
                            </span>
                            <span class="text-muted flex-shrink-0 font-monospace text-nowrap d-flex align-items-center gap-1" style="font-size: var(--text-xs);">
                                <i class="bi bi-clock"></i> @item.EstimatedReadingMinutes @(isEn ? "min read" : "phút đọc")
                            </span>
                        </div>
                        <h3 class="h6 fw-bold mb-2 text-body-emphasis" style="font-size: var(--text-base); line-height: 1.45; min-height: 2.8rem;">
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="text-body-emphasis text-decoration-none hover-text-primary">
                                @item.GetTitle(isEn)
                            </a>
                        </h3>
                        <p class="text-body-secondary mb-3 text-truncate-2" style="font-size: var(--text-sm); line-height: 1.55;">
                            @item.GetSummary(isEn)
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-2.5 mt-auto border-top text-primary fw-medium" style="font-size: var(--text-xs);">
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="text-primary text-decoration-none d-flex align-items-center justify-content-between w-100">
                                <span>@(isEn ? "Read lesson" : "Khám phá bài học")</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Compact Community Activity Strip -->
@if (Model.RecentActivities.Any())
{
    <section class="container py-3 my-2 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2.5">
            <span class="section-label d-flex align-items-center gap-1.5 fw-bold text-body-emphasis" style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.04em;">
                <i class="bi bi-activity text-primary"></i> @(isEn ? "Recent Community Activity" : "Hoạt Động Cộng Đồng Gần Đây")
            </span>
            <a asp-controller="Activity" asp-action="Index" class="text-muted text-decoration-none" style="font-size: var(--text-xs);">
                @(isEn ? "View all" : "Xem tất cả") <i class="bi bi-chevron-right"></i>
            </a>
        </div>
        <div class="border rounded-3 bg-body shadow-xs overflow-hidden">
            @foreach (var act in Model.RecentActivities.Take(4))
            {
                <div class="d-flex align-items-center justify-content-between p-2.5 px-3 border-bottom last-border-0 gap-2">
                    <div class="d-flex align-items-center gap-2 min-w-0" style="flex: 1 1 0%;">
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 0.8rem;">
                            <i class="bi @act.IconClass"></i>
                        </div>
                        <span class="fw-semibold text-body-emphasis text-truncate" style="font-size: var(--text-sm);">@act.UserDisplayName</span>
                        <span class="text-muted text-truncate d-none d-sm-inline" style="font-size: var(--text-sm);">@act.GetActivityTitle(isEn)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        @if (act.XpEarned > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle font-monospace" style="font-size: var(--text-2xs);">+@act.XpEarned XP</span>
                        }
                        <span class="text-muted font-monospace" style="font-size: var(--text-xs);">@act.GetActivityTimeAgo(isEn)</span>
                    </div>
                </div>
            }
        </div>
    </section>
}
