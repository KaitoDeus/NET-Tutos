@model NET_Tutos.Models.ViewModels.TutorialDetailViewModel
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = Model.Tutorial.GetTitle(isEn);
    ViewData["SeoTutorial"] = Model.Tutorial;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">@(isEn ? "Home" : "Trang chủ")</a></li>
            <li class="breadcrumb-item"><a asp-controller="Tutorials" asp-action="Index" class="text-decoration-none">@(isEn ? "Tutorials" : "Bài học")</a></li>
            @if (Model.Tutorial.Category != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Tutorials" asp-action="Index" asp-route-category="@Model.Tutorial.Category.GetSlug(isEn)" class="text-decoration-none">
                        @Model.Tutorial.Category.GetTitle(isEn)
                    </a>
                </li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Tutorial.GetTitle(isEn)</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Main Content Column -->
        <div class="col-lg-8 col-xl-9">
            <article class="card border-0 shadow-sm rounded-4 p-3 p-sm-4 p-md-5 bg-body">
                <!-- Article Header -->
                <header class="border-bottom pb-4 mb-4">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <span class="badge bg-@Model.Tutorial.Category?.BadgeColor px-3 py-1.5 rounded-pill text-truncate d-inline-block"
                              style="max-width: min(100%, 420px);"
                              title="@Model.Tutorial.Category?.GetTitle(isEn)">
                            @Model.Tutorial.Category?.GetTitle(isEn)
                        </span>
                        <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill text-nowrap flex-shrink-0">
                            @LocalizationHelper.GetDifficultyName(Model.Tutorial.Difficulty, isEn)
                        </span>
                        <span class="text-muted small ms-sm-auto text-nowrap flex-shrink-0">
                            <i class="bi bi-clock me-1"></i>~@Model.Tutorial.EstimatedReadingMinutes @(isEn ? "mins read" : "phút đọc")
                        </span>
                        <span class="text-muted small text-nowrap flex-shrink-0">
                            <i class="bi bi-eye me-1"></i>@Model.Tutorial.ViewCount @(isEn ? "views" : "lượt xem")
                        </span>
                        <span id="headerBadgeWrapper">
                            @if (Model.IsLocked)
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1.5 rounded-pill">
                                    <i class="bi bi-lock-fill me-1"></i> @(isEn ? "Stage Locked" : "Đang khóa")
                                </span>
                            }
                            else if (User.Identity?.IsAuthenticated == true && Model.IsCompletedByCurrentUser)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> @(isEn ? "Completed" : "Đã hoàn thành")
                                </span>
                            }
                        </span>
                        @if (!Model.IsLocked)
                        {
                            <!-- Save for Offline Reading Button -->
                            <button type="button" id="btnSaveOffline" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1.5 shadow-none" title="@(isEn ? "Save offline for reading without Internet" : "Lưu đọc ngoại tuyến khi không có mạng")">
                                <i class="bi bi-cloud-arrow-down" id="offlineSaveIcon"></i>
                                <span id="offlineSaveText">@(isEn ? "Save Offline" : "Lưu ngoại tuyến")</span>
                            </button>
                        }
                    </div>

                    <h1 class="h2 fw-extrabold text-body-emphasis mb-3">@Model.Tutorial.GetTitle(isEn)</h1>
                    <p class="lead text-muted">@Model.Tutorial.GetSummary(isEn)</p>
                </header>

                @if (Model.IsLocked)
                {
                    var st = Model.CurrentStageStatus;
                    string blockerTitle = isEn
                        ? (st?.BlockingStageTitleEn ?? "Previous Stage")
                        : (st?.BlockingStageTitleVi ?? "Giai đoạn trước");
                    int remaining = st?.BlockingRemainingLessons ?? 0;
                    string? nextPrereqSlug = st?.NextPrerequisiteTutorialSlug;
                    string? nextPrereqRouteSlug = !string.IsNullOrEmpty(nextPrereqSlug)
                        ? new Tutorial { Slug = nextPrereqSlug }.GetSlug(isEn)
                        : null;

                    <div id="lessonLockedGate" class="card border border-warning-subtle bg-body-tertiary rounded-4 p-4 p-md-5 text-center my-3">
                        <div class="mx-auto rounded-circle bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center mb-3" style="width: 68px; height: 68px;">
                            <i class="bi bi-lock-fill fs-2"></i>
                        </div>
                        <h3 class="fw-bold mb-2 text-body-emphasis">
                            @(isEn ? "This Stage Is Currently Locked" : "Chặng Học Này Đang Được Khóa")
                        </h3>
                        <p class="text-muted mx-auto mb-4" style="max-width: 560px;">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @(isEn
                                    ? $"To unlock this lesson, please complete 100% of {blockerTitle} ({remaining} remaining lessons)."
                                    : $"Để mở khóa bài học này, bạn cần hoàn thành 100% {blockerTitle} (còn {remaining} bài học chưa hoàn thành).")
                            }
                            else
                            {
                                @(isEn
                                    ? $"Sign in and complete 100% of {blockerTitle} to unlock subsequent stages automatically."
                                    : $"Hãy đăng nhập và hoàn thành 100% {blockerTitle} để hệ thống tự động mở khóa các giai đoạn tiếp theo.")
                            }
                        </p>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            @if (!string.IsNullOrEmpty(nextPrereqRouteSlug))
                            {
                                <a asp-action="Details" asp-route-slug="@nextPrereqRouteSlug" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                    <i class="bi bi-play-circle-fill me-1"></i>
                                    @(isEn ? $"Continue {blockerTitle}" : $"Tiếp tục học {blockerTitle}")
                                </a>
                            }
                            else
                            {
                                <a asp-action="Index" asp-route-category="@st?.BlockingCategorySlug" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                                    <i class="bi bi-collection-play me-1"></i>
                                    @(isEn ? $"Go to {blockerTitle}" : $"Mở {blockerTitle}")
                                </a>
                            }
                            @if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    @(isEn ? "Sign In" : "Đăng nhập")
                                </a>
                            }
                            <a asp-controller="Roadmap" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                                <i class="bi bi-signpost-split me-1"></i>
                                @(isEn ? "View Learning Roadmap" : "Xem lộ trình mở khóa")
                            </a>
                        </div>
                    </div>
                }
                else
                {
                <!-- Markdown Content Rendered to HTML -->
                <div class="markdown-body">
                    @Html.Raw(Model.RenderedHtmlContent)
                </div>

                <!-- Interactive Quiz Section for this Lesson -->
                @if (Model.Tutorial.QuizQuestions.Any())
                {
                    <section class="mt-5 pt-4 border-top">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h3 class="fw-bold mb-0">
                                <i class="bi bi-patch-question text-success me-2"></i>@(isEn ? "Quick Knowledge Quiz" : "Trắc Nghiệm Ôn Tập Nhanh")
                            </h3>
                            <a asp-controller="Quiz" asp-action="Take" asp-route-tutorialId="@Model.Tutorial.Id" class="btn btn-sm btn-outline-success">
                                @(isEn ? "Take quiz" : "Làm bài thi trắc nghiệm") <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                        <p class="text-muted small mb-4">@(isEn ? "Consolidate your knowledge immediately with these practice questions:" : "Củng cố ngay kiến thức vừa đọc với các câu hỏi kiểm tra sau đây:")</p>

                        <div class="accordion" id="quizAccordion">
                            @for (int i = 0; i < Model.Tutorial.QuizQuestions.Count; i++)
                            {
                                var q = Model.Tutorial.QuizQuestions.ElementAt(i);
                                <div class="accordion-item border rounded-3 mb-3 overflow-hidden">
                                    <h2 class="accordion-header" id="heading_@q.Id">
                                        <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@q.Id" aria-expanded="false" aria-controls="collapse_@q.Id">
                                            <span class="badge bg-primary me-2">@(isEn ? $"Question {i + 1}" : $"Câu {i + 1}")</span> @q.GetQuestionText(isEn)
                                        </button>
                                    </h2>
                                    <div id="collapse_@q.Id" class="accordion-collapse collapse" aria-labelledby="heading_@q.Id" data-bs-parent="#quizAccordion">
                                        <div class="accordion-body bg-body-tertiary">
                                            <div class="list-group mb-3">
                                                <div class="list-group-item @(q.CorrectOption == "A" ? "list-group-item-success fw-bold" : "")">
                                                    <strong>A.</strong> @q.GetOptionA(isEn) @(q.CorrectOption == "A" ? (isEn ? "✓ (Correct answer)" : "✓ (Đáp án chính xác)") : "")
                                                </div>
                                                <div class="list-group-item @(q.CorrectOption == "B" ? "list-group-item-success fw-bold" : "")">
                                                    <strong>B.</strong> @q.GetOptionB(isEn) @(q.CorrectOption == "B" ? (isEn ? "✓ (Correct answer)" : "✓ (Đáp án chính xác)") : "")
                                                </div>
                                                <div class="list-group-item @(q.CorrectOption == "C" ? "list-group-item-success fw-bold" : "")">
                                                    <strong>C.</strong> @q.GetOptionC(isEn) @(q.CorrectOption == "C" ? (isEn ? "✓ (Correct answer)" : "✓ (Đáp án chính xác)") : "")
                                                </div>
                                                <div class="list-group-item @(q.CorrectOption == "D" ? "list-group-item-success fw-bold" : "")">
                                                    <strong>D.</strong> @q.GetOptionD(isEn) @(q.CorrectOption == "D" ? (isEn ? "✓ (Correct answer)" : "✓ (Đáp án chính xác)") : "")
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(q.Explanation))
                                            {
                                                <div class="alert alert-info py-2 small mb-0">
                                                    <i class="bi bi-info-circle-fill me-1"></i><strong>@(isEn ? "Explanation:" : "Giải thích:")</strong> @q.GetExplanation(isEn)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }
                <!-- Lesson Completion Box -->
                <div class="card border-0 bg-body-tertiary rounded-4 p-4 mt-5 mb-4 text-center text-md-start">
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle p-3 @(Model.IsCompletedByCurrentUser ? "bg-success-subtle text-success" : "bg-primary-subtle text-primary")" id="completeIconWrapper">
                                <i class="bi @(Model.IsCompletedByCurrentUser ? "bi-check-circle-fill" : "bi-bookmark-check") fs-3" id="completeIcon"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1" id="completeTitle">
                                    @(Model.IsCompletedByCurrentUser ? (isEn ? "You have completed this lesson! 🎉" : "Bạn đã hoàn thành bài học này! 🎉") : (isEn ? "Finished reading this lesson?" : "Đã đọc xong bài học này?"))
                                </h5>
                                <p class="text-muted small mb-0" id="completeDesc">
                                    @(Model.IsCompletedByCurrentUser ? (isEn ? "Great job! You earned +20 XP towards your learning progress." : "Tuyệt vời! Bạn đã nhận được +20 XP cho tiến trình học tập.") : (isEn ? "Mark as complete to record progress on your profile and earn +20 XP." : "Đánh dấu để ghi nhận tiến độ vào hồ sơ và tích lũy +20 XP điểm kinh nghiệm."))
                                </p>
                            </div>
                        </div>
                        <div>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <button type="button" id="btnToggleComplete" 
                                        class="btn @(Model.IsCompletedByCurrentUser ? "btn-outline-success" : "btn-primary") px-4 py-2 fw-semibold rounded-pill shadow-sm"
                                        data-tutorial-id="@Model.Tutorial.Id">
                                    <span class="spinner-border spinner-border-sm d-none me-1" id="completeSpinner"></span>
                                    <span id="btnCompleteText">@(Model.IsCompletedByCurrentUser ? (isEn ? "✓ Completed (Click to undo)" : "✓ Đã hoàn thành (Bấm để hủy)") : (isEn ? "Mark as Completed (+20 XP)" : "Đánh dấu đã hoàn thành (+20 XP)"))</span>
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-primary px-4 py-2 fw-semibold rounded-pill">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> @(isEn ? "Login to save progress" : "Đăng nhập để lưu tiến độ")
                                </a>
                            }
                        </div>
                    </div>
                </div>
                }
                @* Unlocked Lesson Navigation *@

                <!-- Previous / Next Navigation -->
                <nav class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 mt-5 pt-4 border-top">
                    <div class="flex-grow-1 flex-sm-grow-0">
                        @if (Model.PreviousTutorial != null)
                        {
                            <a id="prevLessonLink" asp-action="Details" asp-route-slug="@Model.PreviousTutorial.GetSlug(isEn)" class="btn btn-outline-secondary text-start w-100 w-sm-auto" title="@(isEn ? "Previous lesson (Alt + ←)" : "Bài trước (Alt + ←)")">
                                <small class="d-flex align-items-center justify-content-between text-muted">
                                    <span>@(isEn ? "← Previous lesson" : "← Bài trước")</span>
                                    <kbd class="small ms-2 border-0 bg-secondary bg-opacity-25 px-1 py-0.5">Alt ←</kbd>
                                </small>
                                <span class="fw-semibold">@Model.PreviousTutorial.GetTitle(isEn)</span>
                            </a>
                        }
                    </div>
                    <div class="text-start text-sm-end flex-grow-1 flex-sm-grow-0">
                        @if (Model.NextTutorial != null)
                        {
                            <a id="nextLessonLink" asp-action="Details" asp-route-slug="@Model.NextTutorial.GetSlug(isEn)" class="btn @(Model.IsNextTutorialLocked ? "btn-outline-secondary" : "btn-primary") text-start text-sm-end w-100 w-sm-auto" title="@(isEn ? "Next lesson (Alt + →)" : "Bài tiếp theo (Alt + →)")">
                                <small class="d-flex align-items-center justify-content-between opacity-75">
                                    <kbd class="small me-2 border-0 @(Model.IsNextTutorialLocked ? "bg-secondary bg-opacity-25" : "bg-white bg-opacity-25 text-white") px-1 py-0.5">Alt →</kbd>
                                    <span>
                                        @if (Model.IsNextTutorialLocked)
                                        {
                                            <i class="bi bi-lock-fill me-1"></i>
                                        }
                                        @(isEn ? "Next lesson →" : "Bài tiếp theo →")
                                    </span>
                                </small>
                                <span class="fw-semibold">@Model.NextTutorial.GetTitle(isEn)</span>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Roadmap" asp-action="Index" class="btn btn-success w-100 w-sm-auto">
                                <i class="bi bi-trophy me-1"></i> @(isEn ? "Complete roadmap!" : "Hoàn thành lộ trình!")
                            </a>
                        }
                    </div>
                </nav>

                <!-- Real-Time Community Discussion & Q&A -->
                @if (Model.Discussion != null && !Model.IsLocked)
                {
                    <partial name="_DiscussionSection" model="Model.Discussion" />
                }
            </article>
        </div>

        <!-- Sidebar Column -->
        <div class="col-lg-4 col-xl-3">
            <aside class="sticky-sidebar">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-body mb-3">
                    <h6 class="fw-bold mb-3 d-flex align-items-center text-primary">
                        <i class="bi bi-list-nested me-2"></i> @(isEn ? "Lessons in this Topic" : "Bài trong chuyên đề này")
                    </h6>
                    <div class="list-group list-group-flush small">
                        @if (Model.Tutorial.Category?.Tutorials != null)
                        {
                            @foreach (var tut in Model.Tutorial.Category.Tutorials.OrderBy(t => t.OrderIndex))
                            {
                                bool isTutCompleted = Model.CompletedTutorialIds.Contains(tut.Id);
                                bool isCurrent = tut.Id == Model.Tutorial.Id;
                                <a asp-action="Details" asp-route-slug="@tut.GetSlug(isEn)"
                                   class="list-group-item list-group-item-action py-2.5 px-2 rounded-2 mb-1 @(isCurrent ? "active fw-semibold" : "")"
                                   data-tutorial-item-id="@tut.Id">
                                    <i class="bi @(Model.IsLocked ? "bi-lock-fill text-secondary" : (isTutCompleted ? "bi-check-circle-fill text-success" : (isCurrent ? "bi-play-circle-fill" : "bi-circle text-muted"))) me-2 opacity-75"></i>
                                    @tut.GetTitle(isEn)
                                </a>
                            }
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 p-3 bg-body">
                    <h6 class="fw-bold mb-2"><i class="bi bi-lightbulb text-warning me-2"></i>@(isEn ? "Learning Tools" : "Công cụ học tập")</h6>
                    <p class="small text-muted mb-3">@(isEn ? "Make the most of our supporting tools:" : "Tận dụng tối đa các công cụ bổ trợ:")</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="CheatSheet" asp-action="Index" class="btn btn-sm btn-outline-info text-start">
                            <i class="bi bi-code-square me-2"></i> @(isEn ? "Search Code Snippets" : "Tra cứu Code Snippets")
                        </a>
                        <a asp-controller="Quiz" asp-action="Index" class="btn btn-sm btn-outline-success text-start">
                            <i class="bi bi-patch-question me-2"></i> @(isEn ? ".NET Knowledge Quizzes" : "Thi trắc nghiệm .NET")
                        </a>
                        <a asp-controller="Roadmap" asp-action="Index" class="btn btn-sm btn-outline-primary text-start">
                            <i class="bi bi-signpost-split me-2"></i> @(isEn ? "Full .NET Roadmap" : "Toàn bộ lộ trình .NET")
                        </a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const isEnUi = @(isEn ? "true" : "false");
            const codeBlocks = document.querySelectorAll('.markdown-body pre > code');
            codeBlocks.forEach((codeEl, idx) => {
                const rawCode = (codeEl.textContent || '').trim();
                if (!rawCode || rawCode.length < 12) return;
                const preEl = codeEl.parentElement;
                if (!preEl || preEl.dataset.inlineLabBound === '1') return;
                preEl.dataset.inlineLabBound = '1';

                const labContainer = document.createElement('div');
                labContainer.className = 'inline-code-lab border rounded-3 bg-body-tertiary p-2 mb-4 mt-1';
                labContainer.innerHTML = `
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">
                            <i class="bi bi-terminal-fill me-1"></i>C# 14 Inline Sandbox #${idx + 1}
                        </span>
                        <div class="d-flex flex-wrap gap-1.5">
                            <button type="button" class="btn btn-xs btn-primary px-2.5 py-1 fw-semibold btn-run-inline">
                                <i class="bi bi-play-fill"></i> ${isEnUi ? 'Run Code' : 'Chạy thử'}
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary px-2.5 py-1 btn-edit-inline">
                                <i class="bi bi-pencil-square"></i> ${isEnUi ? 'Edit Inline' : 'Sửa code'}
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-info px-2.5 py-1 btn-analyze-inline">
                                <i class="bi bi-cpu"></i> ${isEnUi ? 'Big-O AI' : 'Phân tích Big-O'}
                            </button>
                        </div>
                    </div>
                    <div class="inline-editor-wrap d-none mt-2">
                        <textarea class="form-control font-monospace small bg-dark text-light border-secondary" rows="6" spellcheck="false"></textarea>
                    </div>
                    <div class="inline-output-wrap d-none mt-2 p-2.5 rounded-2 bg-dark text-light font-monospace small"></div>
                `;
                preEl.insertAdjacentElement('afterend', labContainer);

                const editorWrap = labContainer.querySelector('.inline-editor-wrap');
                const textarea = labContainer.querySelector('textarea');
                const outputWrap = labContainer.querySelector('.inline-output-wrap');
                const btnRun = labContainer.querySelector('.btn-run-inline');
                const btnEdit = labContainer.querySelector('.btn-edit-inline');
                const btnAnalyze = labContainer.querySelector('.btn-analyze-inline');
                textarea.value = rawCode;

                btnEdit.addEventListener('click', () => {
                    editorWrap.classList.toggle('d-none');
                });

                btnRun.addEventListener('click', async () => {
                    const sourceToRun = editorWrap.classList.contains('d-none') ? rawCode : textarea.value;
                    outputWrap.classList.remove('d-none');
                    outputWrap.innerHTML = `<span class="text-info"><span class="spinner-border spinner-border-sm me-1"></span>${isEnUi ? 'Compiling & running in Roslyn Sandbox...' : 'Đang biên dịch & chạy trên Roslyn Sandbox...'}</span>`;
                    btnRun.disabled = true;
                    try {
                        const resp = await fetch('/Playground/Execute', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ code: sourceToRun })
                        });
                        const data = await resp.json();
                        if (data.isSuccess) {
                            outputWrap.innerHTML = `<div class="d-flex justify-content-between text-success border-bottom border-secondary pb-1 mb-1"><span>✓ ${isEnUi ? 'Execution Succeeded' : 'Thực thi thành công'}</span><span>${data.executionTimeMs || 0} ms</span></div><pre class="mb-0 text-light" style="white-space:pre-wrap;">${(data.output || '').replace(/</g, '&lt;')}</pre>`;
                        } else {
                            outputWrap.innerHTML = `<div class="text-danger fw-bold mb-1">✗ ${isEnUi ? 'Compilation / Runtime Error' : 'Lỗi biên dịch / thực thi'}</div><pre class="mb-0 text-warning" style="white-space:pre-wrap;">${(data.error || '').replace(/</g, '&lt;')}</pre>`;
                        }
                    } catch (err) {
                        outputWrap.innerHTML = `<span class="text-danger">${isEnUi ? 'Sandbox connection error.' : 'Lỗi kết nối máy chủ Sandbox.'}</span>`;
                    } finally {
                        btnRun.disabled = false;
                    }
                });

                btnAnalyze.addEventListener('click', async () => {
                    const sourceToAnalyze = editorWrap.classList.contains('d-none') ? rawCode : textarea.value;
                    outputWrap.classList.remove('d-none');
                    outputWrap.innerHTML = `<span class="text-info"><span class="spinner-border spinner-border-sm me-1"></span>${isEnUi ? 'Atus AI analyzing Big-O complexity...' : 'Trợ lý AI Atus đang phân tích độ phức tạp Big-O...'}</span>`;
                    btnAnalyze.disabled = true;
                    try {
                        const resp = await fetch('/AiTutor/AnalyzeComplexity', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ code: sourceToAnalyze, language: isEnUi ? 'en' : 'vi' })
                        });
                        const data = await resp.json();
                        outputWrap.innerHTML = `<div class="d-flex flex-wrap gap-2 align-items-center border-bottom border-secondary pb-1 mb-1"><span class="badge bg-info text-dark">Time: ${data.timeComplexity || 'O(1)'}</span><span class="badge bg-secondary">Space: ${data.spaceComplexity || 'O(1)'}</span><span class="badge bg-success">Score: ${data.efficiencyScore ?? 95}/100</span></div><div class="text-light">${(data.explanation || '').replace(/</g, '&lt;')}</div>`;
                    } catch (err) {
                        outputWrap.innerHTML = `<span class="text-danger">${isEnUi ? 'AI Tutor service unavailable.' : 'Không thể kết nối dịch vụ AI Tutor.'}</span>`;
                    } finally {
                        btnAnalyze.disabled = false;
                    }
                });
            });
            const btn = document.getElementById('btnToggleComplete');
            if (!btn) return;

            btn.addEventListener('click', async function () {
                const tutorialId = btn.getAttribute('data-tutorial-id');
                const spinner = document.getElementById('completeSpinner');
                const btnText = document.getElementById('btnCompleteText');
                const title = document.getElementById('completeTitle');
                const desc = document.getElementById('completeDesc');
                const icon = document.getElementById('completeIcon');
                const iconWrap = document.getElementById('completeIconWrapper');
                const headerBadgeWrapper = document.getElementById('headerBadgeWrapper');

                btn.disabled = true;
                if (spinner) spinner.classList.remove('d-none');

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    const formData = new FormData();
                    formData.append('tutorialId', tutorialId);
                    formData.append('__RequestVerificationToken', token);

                    const response = await fetch('/Account/ToggleLesson', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    if (response.status === 401) {
                        window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        return;
                    }

                    const isEnLang = @(isEn ? "true" : "false");
                    const res = await response.json();
                    if (res.success) {
                        const sidebarItem = document.querySelector(`[data-tutorial-item-id="${tutorialId}"] i`);
                        if (res.isCompleted) {
                            btn.className = 'btn btn-outline-success px-4 py-2 fw-semibold rounded-pill shadow-sm';
                            btnText.innerText = isEnLang ? '✓ Completed (Click to undo)' : '✓ Đã hoàn thành (Bấm để hủy)';
                            title.innerText = isEnLang ? 'You have completed this lesson! 🎉' : 'Bạn đã hoàn thành bài học này! 🎉';
                            desc.innerText = isEnLang ? 'Great job! You earned +20 XP towards your learning progress.' : 'Tuyệt vời! Bạn đã nhận được +20 XP cho tiến trình học tập.';
                            icon.className = 'bi bi-check-circle-fill fs-3';
                            iconWrap.className = 'rounded-circle p-3 bg-success-subtle text-success';
                            if (headerBadgeWrapper) {
                                headerBadgeWrapper.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i> ' + (isEnLang ? 'Completed' : 'Đã hoàn thành') + '</span>';
                            }
                            if (sidebarItem) {
                                sidebarItem.className = 'bi bi-check-circle-fill text-success me-2 opacity-75';
                            }
                        } else {
                            btn.className = 'btn btn-primary px-4 py-2 fw-semibold rounded-pill shadow-sm';
                            btnText.innerText = isEnLang ? 'Mark as Completed (+20 XP)' : 'Đánh dấu đã hoàn thành (+20 XP)';
                            title.innerText = isEnLang ? 'Finished reading this lesson?' : 'Đã đọc xong bài học này?';
                            desc.innerText = isEnLang ? 'Mark as complete to record progress on your profile and earn +20 XP.' : 'Đánh dấu để ghi nhận tiến độ vào hồ sơ và tích lũy +20 XP điểm kinh nghiệm.';
                            icon.className = 'bi bi-bookmark-check fs-3';
                            iconWrap.className = 'rounded-circle p-3 bg-primary-subtle text-primary';
                            if (headerBadgeWrapper) {
                                headerBadgeWrapper.innerHTML = '';
                            }
                            if (sidebarItem) {
                                sidebarItem.className = 'bi bi-play-circle-fill me-2 opacity-75';
                            }
                        }
                    } else {
                        alert(res.message || (isEnLang ? 'An error occurred, please try again.' : 'Có lỗi xảy ra, vui lòng thử lại.'));
                    }
                } catch (e) {
                    console.error(e);
                    alert(isEnLang ? 'Server connection error!' : 'Lỗi kết nối máy chủ!');
                } finally {
                    btn.disabled = false;
                    if (spinner) spinner.classList.add('d-none');
                }
            });
        });
    </script>
}

