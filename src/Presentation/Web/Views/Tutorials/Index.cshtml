@model NET_Tutos.Models.ViewModels.TutorialListViewModel
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Tutorials" : "Bài học";
}

<div class="container py-4">
    <!-- Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h1 class="fw-bold mb-1">
                @if (Model.CurrentCategory != null)
                {
                    <span>@Model.CurrentCategory.GetTitle(isEn)</span>
                }
                else
                {
                    <span>@(isEn ? "All .NET Tutorials" : "Tất Cả Bài Học .NET")</span>
                }
            </h1>
            <p class="text-muted mb-0">
                @if (isEn)
                {
                    <span>Found <strong>@Model.TotalCount</strong> comprehensive step-by-step tutorials from basic to advanced</span>
                }
                else
                {
                    <span>Tìm thấy <strong>@Model.TotalCount</strong> bài hướng dẫn chi tiết từ cơ bản đến nâng cao</span>
                }
            </p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a asp-controller="Roadmap" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-signpost-split me-1"></i> @(isEn ? "View by Learning Roadmap" : "Xem theo lộ trình học")
            </a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-body">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <!-- Category Select -->
                <div class="col-md-4">
                    <select name="category" class="form-select" onchange="this.form.submit()">
                        <option value="">@(isEn ? "-- All Topics --" : "-- Tất cả chuyên đề --")</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.GetSlug(isEn)" selected="@(Model.CurrentCategorySlug == cat.Slug || Model.CurrentCategorySlug == cat.GetSlug(true))">
                                @cat.GetTitle(isEn)
                            </option>
                        }
                    </select>
                </div>

                <!-- Difficulty Select -->
                <div class="col-md-3">
                    <select name="level" class="form-select" onchange="this.form.submit()">
                        <option value="">@(isEn ? "-- All Levels --" : "-- Mọi cấp độ --")</option>
                        <option value="Beginner" selected="@(Model.CurrentDifficulty == DifficultyLevel.Beginner)">@(isEn ? "Beginner" : "Cơ bản (Beginner)")</option>
                        <option value="Intermediate" selected="@(Model.CurrentDifficulty == DifficultyLevel.Intermediate)">@(isEn ? "Intermediate" : "Trung cấp (Intermediate)")</option>
                        <option value="Advanced" selected="@(Model.CurrentDifficulty == DifficultyLevel.Advanced)">@(isEn ? "Advanced" : "Nâng cao (Advanced)")</option>
                    </select>
                </div>

                <!-- Search Input -->
                <div class="col-md-4">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="@(isEn ? "Search keywords..." : "Từ khóa tìm kiếm...")" value="@Model.SearchQuery" />
                        <button type="submit" class="btn btn-primary" title="@(isEn ? "Search" : "Tìm kiếm")">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>

                <!-- Reset Button -->
                <div class="col-md-1 text-center">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100" title="@(isEn ? "Reset filter" : "Đặt lại bộ lọc")">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stage Unlock Progression Strip -->
    @if (Model.StageProgression?.StagesByCategoryId.Any() == true)
    {
        <div class="card border-0 shadow-xs rounded-4 mb-4 bg-body">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                    <span class="small fw-bold text-uppercase text-muted">
                        <i class="bi bi-unlock2-fill text-primary me-1"></i>
                        @(isEn ? "Stage-by-Stage Unlock Path" : "Lộ trình mở khóa từng chặng")
                    </span>
                    <span class="small text-muted">
                        @if (Model.BypassStageLocks)
                        {
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill">Admin Preview</span>
                        }
                        else
                        {
                            @(isEn ? "Complete 100% of each stage to unlock the next stage" : "Hoàn thành 100% bài học của chặng trước để mở khóa chặng tiếp theo")
                        }
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var stage in Model.StageProgression.StagesByCategoryId.Values.OrderBy(s => s.OrderIndex))
                    {
                        bool isActiveCat = Model.CurrentCategory?.Id == stage.CategoryId;
                        string pillClass = stage.IsCompleted
                            ? "bg-success-subtle text-success border-success-subtle"
                            : stage.IsUnlocked
                                ? "bg-primary-subtle text-primary border-primary-subtle"
                                : "bg-secondary-subtle text-secondary border-secondary-subtle";
                        string iconClass = stage.IsCompleted
                            ? "bi-check-circle-fill text-success"
                            : stage.IsUnlocked
                                ? "bi-unlock-fill text-primary"
                                : "bi-lock-fill text-secondary";
                        string shortName = LocalizationHelper.GetShortTitle(
                            Model.Categories.FirstOrDefault(c => c.Id == stage.CategoryId), isEn);

                        <a asp-action="Index"
                           asp-route-category="@stage.Slug"
                           class="badge @pillClass border rounded-pill px-2.5 py-1.5 text-decoration-none d-inline-flex align-items-center gap-1.5 @(isActiveCat ? "ring-2 border-2 fw-bold" : "fw-medium")"
                           title="@(isEn ? stage.TitleEn : stage.TitleVi)">
                            <i class="bi @iconClass"></i>
                            <span>@stage.OrderIndex. @shortName</span>
                            <span class="opacity-75">(@stage.CompletedCount/@stage.TotalCount)</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Tutorials Grid -->
    @if (!Model.Tutorials.Any())
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-search"></i></div>
            <h4>@(isEn ? "No matching tutorials found" : "Không tìm thấy bài học nào phù hợp")</h4>
            <p class="text-muted">@(isEn ? "Please try searching with different keywords or reset your filters." : "Vui lòng thử lại với từ khóa khác hoặc đặt lại bộ lọc tìm kiếm.")</p>
            <a asp-action="Index" class="btn btn-primary mt-2">@(isEn ? "View all tutorials" : "Xem tất cả bài học")</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Tutorials)
            {
                var badgeColor = item.Category?.BadgeColor ?? "primary";
                NET_Tutos.Models.ViewModels.StageUnlockStatus? stageStatus = null;
                if (Model.StageProgression?.StagesByCategoryId != null && item.CategoryId > 0)
                {
                    Model.StageProgression.StagesByCategoryId.TryGetValue(item.CategoryId, out stageStatus);
                }
                bool isLocked = stageStatus != null && !stageStatus.IsUnlocked;
                bool isCompleted = Model.StageProgression?.CompletedTutorialIds.Contains(item.Id) ?? false;
                string blockerTitle = isEn
                    ? (stageStatus?.BlockingStageTitleEn ?? "previous stage")
                    : (stageStatus?.BlockingStageTitleVi ?? "giai đoạn trước");

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 card-hover rounded-4 bg-body @(isLocked ? "border-secondary-subtle opacity-90" : "")">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                <span class="badge bg-@badgeColor-subtle text-@badgeColor-emphasis border border-@badgeColor-subtle text-truncate d-inline-block"
                                      style="min-width: 0; max-width: 68%;"
                                      title="@item.Category?.GetTitle(isEn)">
                                    @(item.Category?.OrderIndex > 0 ? $"{item.Category.OrderIndex}. " : "")@item.Category.GetShortTitle(isEn)
                                </span>
                                <span class="text-muted small d-inline-flex align-items-center gap-1 text-nowrap flex-shrink-0 ms-auto">
                                    <i class="bi bi-clock"></i>
                                    <span>@(isEn ? $"{item.EstimatedReadingMinutes} mins" : $"{item.EstimatedReadingMinutes} phút")</span>
                                </span>
                            </div>

                            <h5 class="card-title fw-bold my-2 d-flex align-items-start gap-1.5">
                                @if (isLocked)
                                {
                                    <i class="bi bi-lock-fill text-secondary mt-1 flex-shrink-0" title="@(isEn ? "Locked" : "Đang khóa")"></i>
                                }
                                else if (isCompleted)
                                {
                                    <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0" title="@(isEn ? "Completed" : "Đã hoàn thành")"></i>
                                }
                                <a asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="text-decoration-none text-body-emphasis">
                                    @item.GetTitle(isEn)
                                </a>
                            </h5>

                            <p class="card-text text-muted small flex-grow-1">
                                @item.GetSummary(isEn)
                            </p>

                            @if (isLocked)
                            {
                                <div class="alert alert-secondary py-2 px-3 small rounded-3 mb-2 border-0 bg-body-tertiary">
                                    <i class="bi bi-lock-fill me-1 text-warning"></i>
                                    @(isEn
                                        ? $"Complete {blockerTitle} ({stageStatus!.BlockingRemainingLessons} left) to unlock."
                                        : $"Hoàn thành {blockerTitle} (còn {stageStatus!.BlockingRemainingLessons} bài) để mở khóa.")
                                </div>
                            }

                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-3 gap-2">
                                <span class="badge bg-secondary-subtle text-secondary small text-nowrap">
                                    <i class="bi bi-eye me-1"></i>@(isEn ? $"{item.ViewCount} views" : $"{item.ViewCount} lượt xem")
                                </span>
                                @if (isLocked)
                                {
                                    <a asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="btn btn-sm btn-outline-secondary rounded-pill px-3 text-nowrap">
                                        <i class="bi bi-lock-fill me-1"></i>@(isEn ? "Locked" : "Đã khóa")
                                    </a>
                                }
                                else if (isCompleted)
                                {
                                    <a asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="btn btn-sm btn-outline-success rounded-pill px-3 text-nowrap">
                                        <i class="bi bi-check2-circle me-1"></i>@(isEn ? "Review Lesson" : "Ôn lại bài")
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="btn btn-sm btn-primary rounded-pill px-3 text-nowrap">
                                        @(isEn ? "Start Lesson" : "Học bài này") <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

