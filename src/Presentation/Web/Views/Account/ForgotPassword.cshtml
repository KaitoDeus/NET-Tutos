@model NET_Tutos.Models.ViewModels.ForgotPasswordViewModel
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Forgot Password | NET-Tutos" : "Quên mật khẩu | NET-Tutos";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border shadow-lg rounded-4 overflow-hidden bg-body">
                <div class="card-header bg-gradient-dotnet text-white p-4 text-center">
                    <div class="rounded-circle bg-white bg-opacity-20 d-inline-flex p-3 mb-2">
                        <i class="bi bi-key-fill text-white fs-3"></i>
                    </div>
                    <h4 class="fw-bold mb-1">@(isEn ? "Reset Your Password" : "Khôi Phục Mật Khẩu")</h4>
                    <p class="small opacity-90 mb-0">
                        @(isEn ? "Enter your email address and we'll generate a secure password reset link for you." : "Nhập địa chỉ email tài khoản học viên để nhận liên kết đặt lại mật khẩu.")
                    </p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form method="post" asp-action="ForgotPassword">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 rounded-3"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold small">@(isEn ? "Email Address" : "Địa chỉ Email đã đăng ký")</label>
                            <div class="input-group input-group-auth">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-pill fw-semibold shadow-sm mb-3 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-send-fill fs-6"></i>
                            <span>@(isEn ? "Send Reset Link" : "Gửi Hướng Dẫn Đặt Lại Mật Khẩu")</span>
                        </button>
                    </form>

                    <div class="text-center pt-3 border-top">
                        <a asp-action="Login" class="fw-semibold text-primary text-decoration-none small d-inline-flex align-items-center gap-1">
                            <i class="bi bi-arrow-left"></i> @(isEn ? "Back to Sign In" : "Quay lại Đăng nhập")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
