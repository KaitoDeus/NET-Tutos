@model NET_Tutos.Models.ViewModels.AiTutorIndexViewModel
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Atus — AI .NET Mentor | NET-Tutos" : "Atus — Trợ Lý AI Gia Sư .NET | NET-Tutos";
    var activeConv = Model.ActiveConversation;
    var activeConvId = Model.ActiveConversationId?.ToString() ?? "";
}

@Html.AntiForgeryToken()

<div class="aitutor-viewport position-relative d-flex overflow-hidden bg-body border-top">
    <!-- Mobile Sidebar Dimmed Backdrop -->
    <div class="aitutor-sidebar-backdrop d-none d-lg-none" id="chatSidebarBackdrop" onclick="closeSidebarOnMobile()"></div>

    <!-- LEFT SIDEBAR: CHAT HISTORY (ChatGPT-Style) -->
    <aside class="aitutor-sidebar d-flex flex-column border-end bg-body-tertiary flex-shrink-0" id="chatSidebar">
        <!-- Sidebar Header: New Chat Button + Mobile Close -->
        <div class="p-2.5 p-sm-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-primary flex-grow-1 rounded-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm" onclick="startNewChat()">
                    <i class="bi bi-plus-lg fs-6"></i>
                    <span>@(isEn ? "New Chat" : "Đoạn chat mới")</span>
                </button>
                <button type="button" id="closeSidebarBtn" class="btn btn-outline-secondary d-lg-none rounded-3 px-2.5 py-2 flex-shrink-0" onclick="closeSidebarOnMobile()" aria-label="@(isEn ? "Close sidebar" : "Đóng thanh bên")" title="@(isEn ? "Close sidebar" : "Đóng thanh bên")">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="input-group input-group-sm mt-2">
                <span class="input-group-text bg-body border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control bg-body border-start-0 ps-0 shadow-none" id="searchChatInput" placeholder="@(isEn ? "Search conversations..." : "Tìm đoạn chat...")" oninput="filterConversations(this.value)">
            </div>
        </div>

        <!-- Sidebar Body: Conversation History List -->
        <div class="aitutor-history-list flex-grow-1 overflow-y-auto px-2 py-2" id="conversationsContainer">
            @if (!Model.IsAuthenticated)
            {
                <div class="p-3 text-center text-muted">
                    <i class="bi bi-clock-history fs-3 d-block mb-2 opacity-50"></i>
                    <p class="small mb-2">@(isEn ? "Sign in to save and sync your chat history across devices." : "Đăng nhập để lưu và đồng bộ lịch sử hội thoại của bạn.")</p>
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/AiTutor" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        @(isEn ? "Sign In" : "Đăng nhập ngay")
                    </a>
                </div>
            }
            else if (Model.Conversations.Count == 0)
            {
                <div class="p-3 text-center text-muted small" id="noConversationsMsg">
                    <i class="bi bi-chat-square-text fs-3 d-block mb-2 opacity-50"></i>
                    <span>@(isEn ? "No conversations yet. Start a new chat!" : "Chưa có đoạn chat nào. Bắt đầu ngay!")</span>
                </div>
            }
            else
            {
                var grouped = Model.Conversations.GroupBy(c => c.TimeGroup).ToList();
                foreach (var group in grouped)
                {
                    <div class="conv-group-header text-uppercase text-muted fw-bold px-2.5 pt-2 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                        @group.Key
                    </div>
                    <div class="conv-group-items d-flex flex-column gap-1 mb-2">
                        @foreach (var c in group)
                        {
                            bool isActive = activeConv != null && activeConv.Id == c.Id;
                            <div class="conv-item rounded-3 px-2.5 py-2 d-flex align-items-center justify-content-between position-relative @(isActive ? "active bg-primary bg-opacity-10 text-primary fw-semibold" : "text-body")"
                                 data-id="@c.Id" data-title="@c.Title" data-pinned="@(c.IsPinned ? "true" : "false")" onclick="selectConversation(this)">
                                <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1 me-2">
                                    <i class="bi @(c.IsPinned ? "bi-pin-fill text-warning" : (isActive ? "bi-chat-dots-fill text-primary" : "bi-chat-left-text text-secondary")) flex-shrink-0" style="font-size: 0.85rem;"></i>
                                    <span class="conv-title text-truncate small">@c.Title</span>
                                </div>
                                <div class="conv-actions d-flex align-items-center gap-1 flex-shrink-0">
                                    <button type="button" class="btn btn-icon btn-sm p-0 text-muted hover-icon" title="@(isEn ? "Rename" : "Đổi tên")" onclick="event.stopPropagation(); renameConversationPrompt(this)">
                                        <i class="bi bi-pencil" style="font-size: 0.75rem;"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm p-0 text-muted hover-icon" title="@(c.IsPinned ? (isEn ? "Unpin" : "Bỏ ghim") : (isEn ? "Pin" : "Ghim"))" onclick="event.stopPropagation(); togglePinConversation(this)">
                                        <i class="bi @(c.IsPinned ? "bi-pin-angle-fill text-warning" : "bi-pin-angle")" style="font-size: 0.75rem;"></i>
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm p-0 text-muted hover-icon text-hover-danger" title="@(isEn ? "Delete" : "Xóa")" onclick="event.stopPropagation(); deleteConversationConfirm(this)">
                                        <i class="bi bi-trash3" style="font-size: 0.75rem;"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <!-- Sidebar Footer: User Status & Navigation -->
        <div class="p-2.5 border-top bg-body">
            @if (Model.IsAuthenticated)
            {
                <div class="d-flex align-items-center justify-content-between p-1.5 rounded-3">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentUserAvatar))
                        {
                            <img src="@Model.CurrentUserAvatar" alt="Avatar" class="rounded-circle flex-shrink-0" style="width: 32px; height: 32px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                @(Model.CurrentUserName?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                        }
                        <div class="overflow-hidden">
                            <div class="fw-semibold small text-truncate">@Model.CurrentUserName</div>
                            <div class="text-muted" style="font-size: 0.68rem;"><i class="bi bi-check-circle-fill text-success me-1"></i>@(isEn ? "Pro Member" : "Học viên NET-Tutos")</div>
                        </div>
                    </div>
                    <a asp-controller="Playground" asp-action="Index" class="btn btn-sm btn-outline-secondary p-1" title="@(isEn ? "C# Sandbox" : "Mở C# Sandbox")">
                        <i class="bi bi-terminal" style="font-size: 0.85rem;"></i>
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex gap-2">
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/AiTutor" class="btn btn-sm btn-primary flex-fill rounded-3 fw-semibold">
                        <i class="bi bi-box-arrow-in-right me-1"></i>@(isEn ? "Sign In" : "Đăng nhập")
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-outline-secondary flex-fill rounded-3">
                        @(isEn ? "Register" : "Đăng ký")
                    </a>
                </div>
            }
        </div>
    </aside>

    <!-- RIGHT WORKSPACE: MAIN CHAT AREA (ChatGPT-Style) -->
    <main class="aitutor-main d-flex flex-column flex-grow-1 position-relative overflow-hidden bg-body">
        <!-- Top Navbar in Chat -->
        <header class="aitutor-navbar d-flex align-items-center justify-content-between gap-2 px-2 px-sm-3 py-2 border-bottom bg-body z-2">
            <div class="d-flex align-items-center gap-2 overflow-hidden min-w-0 flex-grow-1">
                <button type="button" class="btn btn-sm btn-outline-secondary border-0 p-1.5 rounded-3 flex-shrink-0" id="toggleSidebarBtn" onclick="toggleSidebar()" title="@(isEn ? "Toggle sidebar" : "Ẩn/hiện thanh bên")">
                    <i class="bi bi-layout-sidebar-inset fs-5"></i>
                </button>
                <div class="d-flex align-items-center gap-2 overflow-hidden min-w-0">
                    <span class="fw-bold text-truncate" id="currentChatTitle">@(activeConv != null ? activeConv.Title : (isEn ? "New Chat" : "Đoạn chat mới"))</span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 d-none d-sm-inline-flex align-items-center gap-1 flex-shrink-0" style="font-size: 0.7rem;">
                        <span class="status-dot-pulse"></span>
                        <span>Atus</span>
                    </span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                <a asp-controller="Interview" asp-action="Mock" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1 d-none d-lg-inline-flex align-items-center gap-1" style="font-size: 0.78rem;" title="@(isEn ? "AI Mock Technical Interview" : "Phỏng vấn kỹ thuật với Atus")">
                    <i class="bi bi-robot"></i>
                    <span>@(isEn ? "AI Mock Interview" : "Phỏng vấn thử")</span>
                </a>
                <a asp-controller="Playground" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 d-none d-md-inline-flex align-items-center gap-1" style="font-size: 0.78rem;">
                    <i class="bi bi-terminal-fill"></i>
                    <span>@(isEn ? "C# Sandbox" : "C# Sandbox")</span>
                </a>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1 d-inline-flex align-items-center justify-content-center" onclick="startNewChat()" title="@(isEn ? "New conversation" : "Tạo đoạn chat mới")" style="font-size: 0.78rem;">
                    <i class="bi bi-plus-lg me-sm-1"></i><span class="d-none d-sm-inline">@(isEn ? "New Chat" : "Mới")</span>
                </button>
            </div>
        </header>

        <!-- Messages Feed (Scrollable) -->
        <div class="aitutor-messages-feed flex-grow-1 overflow-y-auto px-2 px-sm-3 py-3 py-sm-4" id="messagesContainer">
            <div class="chat-max-width mx-auto">
                <!-- If No active conversation or no messages, show Hero Starter View -->
                <div id="heroStarterView" class="@(activeConv != null && activeConv.Messages.Count > 0 ? "d-none" : "")">
                    <div class="text-center py-2 py-sm-4 my-1 my-sm-2">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center p-2.5 p-sm-3 mb-2 mb-sm-3 shadow-xs hero-atus-avatar" style="width: 60px; height: 60px;">
                            <i class="bi bi-robot fs-2"></i>
                        </div>
                        <h4 class="fw-bold mb-2">@(isEn ? "Meet Atus — Your .NET AI Mentor" : "Gặp gỡ Atus — Trợ Lý AI Gia Sư .NET")</h4>
                        <p class="text-muted small mx-auto" style="max-width: 580px;">
                            @(isEn
                                ? "Ask architectural concepts, paste compiler error codes to diagnose, review Clean Code, or brainstorm .NET 10 solutions with Atus (Agent + Tutos)."
                                : "Hỏi đáp kiến trúc chuyên sâu, dán mã lỗi biên dịch để nhận chẩn đoán, tối ưu Clean Code, đồng hành cùng Atus (kết hợp từ Agent + Tutos) chinh phục C# & .NET 10.")
                        </p>
                    </div>

                    <!-- Prompt Starter Cards -->
                    <div class="row g-2 g-sm-3 mb-3 mb-sm-4">
                        <div class="col-md-6">
                            <div class="starter-card p-3 rounded-4 border bg-body-tertiary h-100 cursor-pointer hover-card shadow-xs" onclick="useStarterPrompt('Làm thế nào để tối ưu hóa truy vấn Entity Framework Core bằng AsNoTracking và AsSplitQuery?')">
                                <div class="d-flex align-items-center gap-2 mb-1.5 text-primary">
                                    <i class="bi bi-funnel-fill"></i>
                                    <span class="fw-bold small">@(isEn ? "LINQ & EF Core Performance" : "Làm chủ LINQ & EF Core")</span>
                                </div>
                                <div class="text-muted small lh-base" style="font-size: 0.8rem;">
                                    @(isEn ? "How to optimize queries using AsNoTracking and AsSplitQuery?" : "Làm thế nào để tối ưu truy vấn EF Core bằng AsNoTracking và AsSplitQuery?")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="starter-card p-3 rounded-4 border bg-body-tertiary h-100 cursor-pointer hover-card shadow-xs" onclick="useStarterPrompt('Giải thích cơ chế giải phóng thread của Async/Await và ThreadPool trong .NET 10')">
                                <div class="d-flex align-items-center gap-2 mb-1.5 text-success">
                                    <i class="bi bi-cpu-fill"></i>
                                    <span class="fw-bold small">@(isEn ? "Async/Await & Concurrency" : "Bất đồng bộ Async/Await & ThreadPool")</span>
                                </div>
                                <div class="text-muted small lh-base" style="font-size: 0.8rem;">
                                    @(isEn ? "Deep dive into thread release and state machines in modern .NET." : "Cơ chế giải phóng luồng non-blocking và State Machine bên dưới Task.")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="starter-card p-3 rounded-4 border bg-body-tertiary h-100 cursor-pointer hover-card shadow-xs" onclick="useStarterPrompt('Phân biệt AddScoped, AddTransient, AddSingleton và giải thích lỗi Captive Dependency')">
                                <div class="d-flex align-items-center gap-2 mb-1.5 text-info">
                                    <i class="bi bi-diagram-3-fill"></i>
                                    <span class="fw-bold small">@(isEn ? "Dependency Injection Lifetimes" : "3 Vòng đời Dependency Injection")</span>
                                </div>
                                <div class="text-muted small lh-base" style="font-size: 0.8rem;">
                                    @(isEn ? "Scoped vs Transient vs Singleton and the Captive Dependency anti-pattern." : "Phân biệt Scoped, Transient, Singleton và cách né bẫy Captive Dependency.")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="starter-card p-3 rounded-4 border bg-body-tertiary h-100 cursor-pointer hover-card shadow-xs" onclick="useStarterPrompt('Tôi đang gặp lỗi CS0103 The name does not exist in current context, hãy giải thích cách sửa.')">
                                <div class="d-flex align-items-center gap-2 mb-1.5 text-danger">
                                    <i class="bi bi-shield-x"></i>
                                    <span class="fw-bold small">@(isEn ? "Compiler Diagnostic Assistant" : "Khắc phục Lỗi Biên Dịch C#")</span>
                                </div>
                                <div class="text-muted small lh-base" style="font-size: 0.8rem;">
                                    @(isEn ? "Diagnose CS0103, CS0029, or NullReferenceException instantly." : "Chẩn đoán nguyên nhân và đề xuất phương án sửa lỗi CS0103, CS0029, NullReference.")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Messages Render Area -->
                <div id="messagesList" class="d-flex flex-column gap-4">
                    @if (activeConv != null && activeConv.Messages.Count > 0)
                    {
                        foreach (var msg in activeConv.Messages)
                        {
                            if (msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase))
                            {
                                <!-- USER MESSAGE -->
                                <div class="d-flex justify-content-end msg-row user-msg">
                                    <div class="d-flex flex-column align-items-end user-msg-col">
                                        <div class="user-bubble p-2.5 p-sm-3 rounded-4 bg-primary text-white shadow-xs">
                                            <div class="message-text">@msg.Content</div>
                                            @if (!string.IsNullOrWhiteSpace(msg.CodeSnippet))
                                            {
                                                <div class="mt-2 p-2 rounded-3 bg-dark bg-opacity-25 small font-monospace overflow-x-auto">
                                                    <code>@msg.CodeSnippet</code>
                                                </div>
                                            }
                                        </div>
                                        <span class="text-muted small pe-2 mt-1" style="font-size: 0.68rem;">@msg.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- AI MODEL MESSAGE -->
                                <div class="d-flex gap-2 gap-sm-3 msg-row ai-msg">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0 ai-avatar-badge" style="width: 36px; height: 36px;">
                                        <i class="bi bi-robot fs-5"></i>
                                    </div>
                                    <div class="d-flex flex-column flex-grow-1 overflow-hidden ai-msg-col">
                                        <div class="ai-bubble p-3 p-sm-3.5 rounded-4 bg-body-tertiary border shadow-xs">
                                            <div class="fw-bold mb-1 text-primary small d-flex align-items-center gap-2">
                                                <span>Atus</span>
                                                <span class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">AI Agent</span>
                                            </div>
                                            <div class="markdown-body small lh-lg">
                                                @Html.Raw(msg.Content)
                                            </div>

                                        </div>
                                        <span class="text-muted small ps-2 mt-1" style="font-size: 0.68rem;">@msg.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                <!-- Thinking Wave Animation -->
                <div class="d-flex gap-3 msg-row ai-msg d-none mt-3" id="typingIndicator">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px;">
                        <i class="bi bi-robot fs-5"></i>
                    </div>
                    <div class="p-3 rounded-4 bg-body-tertiary border shadow-xs d-inline-flex align-items-center gap-2">
                        <div class="typing-wave">
                            <span></span><span></span><span></span>
                        </div>
                        <span class="text-muted small" style="font-size: 0.8rem;">@(isEn ? "Atus is analyzing & coding..." : "Atus đang suy nghĩ & phân tích...")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Floating Bottom Input Bar (ChatGPT-Style) -->
        <div class="aitutor-input-area p-2 p-sm-3 border-top bg-body z-2">
            <div class="chat-max-width mx-auto">
                @if (!Model.IsAuthenticated)
                {
                    <div class="p-2.5 p-sm-3 rounded-4 bg-primary bg-opacity-10 border border-primary-subtle text-center">
                        <div class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center justify-content-between gap-2.5 gap-sm-3">
                            <div class="text-start">
                                <div class="fw-bold text-primary small d-flex align-items-center gap-1.5">
                                    <i class="bi bi-lock-fill"></i>
                                    <span>@(isEn ? "Sign in required to chat" : "Yêu cầu đăng nhập để trò chuyện")</span>
                                </div>
                                <div class="text-muted small" style="font-size: 0.78rem;">
                                    @(isEn
                                        ? "Sign in to chat with Atus and save your conversational history."
                                        : "Vui lòng đăng nhập tài khoản để trò chuyện cùng Atus và lưu trữ lịch sử cuộc hội thoại của bạn.")
                                </div>
                            </div>
                            <div class="d-flex gap-2 w-100 w-sm-auto flex-shrink-0">
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/AiTutor" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold flex-fill flex-sm-grow-0 text-nowrap">
                                    @(isEn ? "Sign In" : "Đăng nhập ngay")
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-outline-secondary rounded-pill px-3 flex-fill flex-sm-grow-0 text-nowrap">
                                    @(isEn ? "Register" : "Tạo tài khoản")
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- File Attachment Preview Area -->
                    <div id="attachedFileContainer" class="d-none mb-2">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-3 bg-body-tertiary border shadow-xs" id="attachedFileBadge">
                            <i class="bi bi-file-earmark-code-fill text-primary fs-5"></i>
                            <div class="small">
                                <div class="fw-semibold text-truncate" id="attachedFileName" style="max-width: 240px;">file.cs</div>
                                <div class="text-muted" id="attachedFileSize" style="font-size: 0.68rem;">0 KB</div>
                            </div>
                            <button type="button" class="btn btn-sm btn-icon p-0 ms-2 text-muted text-hover-danger" onclick="removeAttachedFile()" title="@(isEn ? "Remove file" : "Gỡ bỏ tệp")">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Input Box Card -->
                    <div class="input-card border rounded-4 p-2 bg-body shadow-sm d-flex align-items-end gap-2 focus-ring-card position-relative" id="chatDropZone">
                        <input type="file" id="chatFileInput" class="d-none" accept=".cs,.txt,.log,.json,.md,.xml,.sql,.yaml,.yml" onchange="handleFileSelected(event)">
                        
                        <button type="button" class="btn btn-outline-secondary border-0 rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;" onclick="document.getElementById('chatFileInput').click()" title="@(isEn ? "Attach C# or log file" : "Đính kèm tệp C# hoặc log lỗi")">
                            <i class="bi bi-paperclip fs-5"></i>
                        </button>

                        <textarea class="form-control border-0 bg-transparent shadow-none p-2 resize-none" id="chatMessageInput" rows="1"
                                  placeholder="@(isEn ? "Message Atus (Press Enter to send, Shift + Enter for new line)..." : "Nhắn tin cho Atus (Enter để gửi, Shift + Enter để xuống dòng)...")"
                                  oninput="autoResizeTextarea(this)" onkeydown="handleInputKeydown(event)"></textarea>
                        
                        <button type="button" class="btn btn-primary rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0 send-btn" id="sendMessageBtn" onclick="sendMessage()" title="@(isEn ? "Send message" : "Gửi tin nhắn")">
                            <i class="bi bi-arrow-up fs-5"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </main>
</div>

<!-- Rename Conversation Modal -->
<div class="modal fade" id="renameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h6 class="modal-title fw-bold">@(isEn ? "Rename Chat" : "Đổi tên đoạn chat")</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <input type="hidden" id="renameConvId">
                <input type="text" class="form-control rounded-3" id="renameConvTitle" placeholder="@(isEn ? "Enter title..." : "Nhập tiêu đề mới...")">
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">@(isEn ? "Cancel" : "Hủy")</button>
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" onclick="submitRename()">@(isEn ? "Save" : "Lưu")</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Conversation Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow text-center p-3">
            <div class="modal-body p-2">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center p-3 mb-2" style="width: 52px; height: 52px;">
                    <i class="bi bi-trash3 fs-4"></i>
                </div>
                <h6 class="fw-bold mb-1">@(isEn ? "Delete Chat?" : "Xóa đoạn chat?")</h6>
                <p class="text-muted small mb-3" style="font-size: 0.8rem;">
                    @(isEn ? "This conversation and all its messages will be removed permanently." : "Cuộc trò chuyện này và toàn bộ tin nhắn sẽ bị xóa vĩnh viễn.")
                </p>
                <input type="hidden" id="deleteConvId">
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">@(isEn ? "Cancel" : "Hủy")</button>
                    <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold" onclick="submitDeleteConversation()">@(isEn ? "Delete" : "Xác nhận xóa")</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const isEn = @(isEn ? "true" : "false");
    const isAuthenticated = @(Model.IsAuthenticated ? "true" : "false");
    let currentConversationId = '@activeConvId';
    let isWaitingResponse = false;
    let currentAttachedFile = null;

    // Auto-scroll messages container to bottom
    function scrollToBottom() {
        const feed = document.getElementById('messagesContainer');
        if (feed) {
            feed.scrollTop = feed.scrollHeight;
        }
    }

    // Auto-resize textarea up to 180px
    function autoResizeTextarea(el) {
        el.style.height = 'auto';
        el.style.height = Math.min(el.scrollHeight, 180) + 'px';
    }

    function handleInputKeydown(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendMessage();
        }
    }

    // Sync dimmed backdrop visibility with mobile sidebar drawer state
    function syncSidebarBackdrop() {
        const sidebar = document.getElementById('chatSidebar');
        const backdrop = document.getElementById('chatSidebarBackdrop');
        if (!sidebar || !backdrop) return;
        const isMobile = window.innerWidth < 992;
        if (isMobile && !sidebar.classList.contains('collapsed')) {
            backdrop.classList.remove('d-none');
        } else {
            backdrop.classList.add('d-none');
        }
    }

    function closeSidebarOnMobile() {
        if (window.innerWidth >= 992) return;
        const sidebar = document.getElementById('chatSidebar');
        if (sidebar && !sidebar.classList.contains('collapsed')) {
            sidebar.classList.add('collapsed');
            syncSidebarBackdrop();
        }
    }

    // Toggle Sidebar collapse
    function toggleSidebar() {
        const sidebar = document.getElementById('chatSidebar');
        if (sidebar) {
            sidebar.classList.toggle('collapsed');
            if (window.innerWidth >= 992) {
                localStorage.setItem('nettutos_chat_sidebar_collapsed', sidebar.classList.contains('collapsed'));
            }
            syncSidebarBackdrop();
        }
    }

    // Restore sidebar state cleanly by viewport breakpoint and move modals to body
    document.addEventListener('DOMContentLoaded', () => {
        const sidebar = document.getElementById('chatSidebar');
        if (sidebar) {
            if (window.innerWidth < 992) {
                // Keep chat workspace uncluttered on initial mobile/tablet load
                sidebar.classList.add('collapsed');
            } else if (localStorage.getItem('nettutos_chat_sidebar_collapsed') === 'true') {
                sidebar.classList.add('collapsed');
            }
            syncSidebarBackdrop();
        }

        window.addEventListener('resize', () => {
            syncSidebarBackdrop();
        });

        // Relocate Bootstrap modals to body to prevent overflow:hidden clipping & backdrop issues
        const renameModal = document.getElementById('renameModal');
        const deleteModal = document.getElementById('deleteModal');
        if (renameModal && renameModal.parentElement !== document.body) {
            document.body.appendChild(renameModal);
        }
        if (deleteModal && deleteModal.parentElement !== document.body) {
            document.body.appendChild(deleteModal);
        }

        // Setup drag & drop on chat box
        setupChatDropZone();

        scrollToBottom();
    });

    // File Attachment & Drag & Drop Handling
    function setupChatDropZone() {
        const dropZone = document.getElementById('chatDropZone');
        if (!dropZone) return;

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropZone.classList.add('chat-drag-over');
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropZone.classList.remove('chat-drag-over');
            });
        });

        dropZone.addEventListener('drop', (e) => {
            const dt = e.dataTransfer;
            if (dt && dt.files && dt.files.length > 0) {
                processFileAttachment(dt.files[0]);
            }
        });
    }

    function handleFileSelected(event) {
        const file = event.target.files && event.target.files[0];
        if (file) {
            processFileAttachment(file);
        }
    }

    function processFileAttachment(file) {
        if (!file) return;

        // Size check: Max 2MB
        const maxBytes = 2 * 1024 * 1024;
        if (file.size > maxBytes) {
            alert(isEn ? "File size exceeds 2MB limit. Please choose a smaller code or log file." : "Kích thước tệp vượt quá 2MB. Vui lòng chọn tệp nhỏ hơn.");
            return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
            currentAttachedFile = {
                name: file.name,
                size: file.size,
                content: e.target.result
            };

            const container = document.getElementById('attachedFileContainer');
            const nameEl = document.getElementById('attachedFileName');
            const sizeEl = document.getElementById('attachedFileSize');

            if (nameEl) nameEl.innerText = file.name;
            if (sizeEl) sizeEl.innerText = (file.size / 1024).toFixed(1) + ' KB';
            if (container) container.classList.remove('d-none');
        };
        reader.readAsText(file);
    }

    function removeAttachedFile() {
        currentAttachedFile = null;
        const container = document.getElementById('attachedFileContainer');
        if (container) container.classList.add('d-none');
        const input = document.getElementById('chatFileInput');
        if (input) input.value = '';
    }

    // Start New Chat session
    function startNewChat() {
        if (!isAuthenticated) {
            window.location.href = '/Account/Login?returnUrl=/AiTutor';
            return;
        }

        currentConversationId = '';
        const titleEl = document.getElementById('currentChatTitle');
        if (titleEl) titleEl.innerText = isEn ? 'New Chat' : 'Đoạn chat mới';
        
        const list = document.getElementById('messagesList');
        if (list) list.innerHTML = '';
        
        const hero = document.getElementById('heroStarterView');
        if (hero) hero.classList.remove('d-none');
        
        document.querySelectorAll('.conv-item').forEach(el => {
            el.classList.remove('active', 'bg-primary', 'bg-opacity-10', 'text-primary', 'fw-semibold');
            const icon = el.querySelector('.bi-chat-dots-fill');
            if (icon) icon.className = 'bi bi-chat-left-text text-secondary flex-shrink-0';
        });

        if (window.history && window.history.pushState) {
            window.history.pushState(null, '', '/AiTutor');
        }

        removeAttachedFile();
        closeSidebarOnMobile();

        const input = document.getElementById('chatMessageInput');
        if (input) {
            input.value = '';
            input.focus();
        }
    }

    // Select existing conversation
    async function selectConversation(target) {
        if (!isAuthenticated) {
            window.location.href = '/Account/Login?returnUrl=/AiTutor';
            return;
        }

        let convId = '';
        if (typeof target === 'string') {
            convId = target;
        } else if (target && target.closest) {
            const item = target.closest('.conv-item');
            if (item) convId = item.dataset.id;
        }

        if (!convId || currentConversationId === convId) return;

        try {
            const res = await fetch(`/AiTutor/Conversations/${convId}`);
            if (!res.ok) throw new Error('Failed to load conversation');
            const data = await res.json();

            if (data.success && data.conversation) {
                const conv = data.conversation;
                currentConversationId = conv.id;
                
                const titleEl = document.getElementById('currentChatTitle');
                if (titleEl) titleEl.innerText = conv.title || (isEn ? 'New Chat' : 'Đoạn chat mới');

                if (window.history && window.history.pushState) {
                    window.history.pushState(null, '', `/AiTutor?id=${conv.id}`);
                }

                document.querySelectorAll('.conv-item').forEach(el => {
                    if (el.dataset.id === convId) {
                        el.classList.add('active', 'bg-primary', 'bg-opacity-10', 'text-primary', 'fw-semibold');
                        const icon = el.querySelector('.bi-chat-left-text');
                        if (icon) icon.className = 'bi bi-chat-dots-fill text-primary flex-shrink-0';
                    } else {
                        el.classList.remove('active', 'bg-primary', 'bg-opacity-10', 'text-primary', 'fw-semibold');
                        const icon = el.querySelector('.bi-chat-dots-fill');
                        if (icon) icon.className = 'bi bi-chat-left-text text-secondary flex-shrink-0';
                    }
                });

                const list = document.getElementById('messagesList');
                list.innerHTML = '';

                if (conv.messages && conv.messages.length > 0) {
                    document.getElementById('heroStarterView')?.classList.add('d-none');
                    conv.messages.forEach(m => {
                        const timeStr = formatTime(m.createdAt);
                        if (m.role.toLowerCase() === 'user') {
                            appendUserMessageToDOM(m.content, m.codeSnippet, timeStr);
                        } else {
                            appendAiMessageToDOM(m.content, m.codeSnippet, timeStr);
                        }
                    });
                } else {
                    document.getElementById('heroStarterView')?.classList.remove('d-none');
                }

                scrollToBottom();
                closeSidebarOnMobile();
            }
        } catch (err) {
            // Handled silently
        }
    }

    // Starter Prompt clicked
    function useStarterPrompt(prompt) {
        if (!isAuthenticated) {
            window.location.href = '/Account/Login?returnUrl=/AiTutor';
            return;
        }
        const input = document.getElementById('chatMessageInput');
        if (input) {
            input.value = prompt;
            sendMessage();
        }
    }

    // Send Message with Real-Time SSE Streaming
    async function sendMessage() {
        if (!isAuthenticated) {
            window.location.href = '/Account/Login?returnUrl=/AiTutor';
            return;
        }

        const input = document.getElementById('chatMessageInput');
        const text = input ? input.value.trim() : '';
        const attached = currentAttachedFile;

        if ((!text && !attached) || isWaitingResponse) return;

        // Hide starter view
        document.getElementById('heroStarterView')?.classList.add('d-none');

        // Append user message
        const nowStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const userSnippet = attached ? `[${isEn ? 'Attached File' : 'Tệp đính kèm'}: ${attached.name}]` : null;
        appendUserMessageToDOM(text || (isEn ? 'Sent attached file.' : 'Đã gửi tệp đính kèm.'), userSnippet, nowStr);

        // Reset input and attachment immediately
        input.value = '';
        input.style.height = 'auto';
        removeAttachedFile();

        // Lock send state
        isWaitingResponse = true;
        scrollToBottom();

        // Prepare streaming AI placeholder bubble
        const aiMsgId = 'ai-stream-msg-' + Date.now();
        const list = document.getElementById('messagesList');
        const aiHtml = `
            <div class="d-flex gap-2 gap-sm-3 msg-row ai-msg" id="${aiMsgId}">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0 ai-avatar-badge" style="width: 36px; height: 36px;">
                    <i class="bi bi-robot fs-5"></i>
                </div>
                <div class="d-flex flex-column flex-grow-1 overflow-hidden ai-msg-col">
                    <div class="ai-bubble p-3 p-sm-3.5 rounded-4 bg-body-tertiary border shadow-xs">
                        <div class="fw-bold mb-1 text-primary small d-flex align-items-center gap-2">
                            <span>Atus</span>
                            <span class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">AI Agent</span>
                        </div>
                        <div class="markdown-body small lh-lg text-container"><span class="streaming-cursor"></span></div>
                    </div>
                    <span class="text-muted small ps-2 mt-1" style="font-size: 0.68rem;">${nowStr}</span>
                </div>
            </div>`;
        list.insertAdjacentHTML('beforeend', aiHtml);
        scrollToBottom();

        const currentAiRow = document.getElementById(aiMsgId);
        const textContainer = currentAiRow?.querySelector('.text-container');

        let accumulatedMarkdown = '';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const payload = {
                message: text || (isEn ? 'Analyze this attached file' : 'Hãy phân tích nội dung tệp đính kèm này'),
                conversationId: currentConversationId || null,
                attachedFileName: attached ? attached.name : null,
                attachedFileContent: attached ? attached.content : null
            };

            const response = await fetch('/AiTutor/ChatStream', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            if (response.status === 401) {
                window.location.href = '/Account/Login?returnUrl=/AiTutor';
                return;
            }

            if (!response.ok || !response.body) {
                throw new Error('Stream connection failed');
            }

            const reader = response.body.getReader();
            const decoder = new TextDecoder('utf-8');
            let buffer = '';

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const lines = buffer.split('\n');
                buffer = lines.pop(); // Keep partial line in buffer

                for (const line of lines) {
                    const trimmed = line.trim();
                    if (!trimmed || !trimmed.startsWith('data:')) continue;

                    const jsonStr = trimmed.substring(5).trim();
                    try {
                        const eventObj = JSON.parse(jsonStr);

                        if (eventObj.type === 'init') {
                            if (eventObj.conversationId) {
                                currentConversationId = eventObj.conversationId;
                            }
                        } else if (eventObj.type === 'chunk') {
                            accumulatedMarkdown += (eventObj.text || '');
                            if (textContainer) {
                                textContainer.innerHTML = formatSimpleMarkdown(accumulatedMarkdown) + '<span class="streaming-cursor"></span>';
                            }
                            scrollToBottom();
                        } else if (eventObj.type === 'done') {
                            if (eventObj.conversationId) {
                                currentConversationId = eventObj.conversationId;
                                if (window.history && window.history.pushState) {
                                    window.history.pushState(null, '', `/AiTutor?id=${currentConversationId}`);
                                }
                            }
                            if (eventObj.title) {
                                const titleEl = document.getElementById('currentChatTitle');
                                if (titleEl) titleEl.innerText = eventObj.title;
                            }
                            await reloadConversationsList();
                        } else if (eventObj.type === 'error') {
                            accumulatedMarkdown += `\n\n> ⚠️ *${escapeHtml(eventObj.message || 'Lỗi xử lý')}*`;
                            if (textContainer) {
                                textContainer.innerHTML = formatSimpleMarkdown(accumulatedMarkdown);
                            }
                        }
                    } catch (e) {
                        // In case of non-json data line
                    }
                }
            }

            // Remove streaming cursor at end of response
            if (textContainer) {
                textContainer.innerHTML = formatSimpleMarkdown(accumulatedMarkdown);
            }
        } catch (err) {
            if (textContainer) {
                textContainer.innerHTML = formatSimpleMarkdown(accumulatedMarkdown || (isEn ? "Network error connecting to Atus. Please try again." : "Lỗi kết nối tới Atus. Vui lòng thử lại sau."));
            }
        } finally {
            isWaitingResponse = false;
            scrollToBottom();
        }
    }

    // Inline Code Execution (Roslyn C# Runner)
    async function runInlineCode(btn) {
        const wrapper = btn.closest('.code-toolbar-wrapper');
        if (!wrapper) return;

        const pre = wrapper.querySelector('pre code');
        if (!pre) return;

        const codeText = pre.innerText.trim();
        if (!codeText) return;

        const terminal = wrapper.querySelector('.inline-code-terminal');
        const terminalBody = wrapper.querySelector('.inline-terminal-body');
        const timeBadge = wrapper.querySelector('.inline-terminal-time');
        const statusBadge = wrapper.querySelector('.inline-terminal-status');

        if (!terminal || !terminalBody) return;

        terminal.classList.remove('d-none');
        terminalBody.innerHTML = `
            <div class="d-flex align-items-center gap-2 text-warning py-1">
                <span class="spinner-border spinner-border-sm" role="status"></span>
                <span>${isEn ? 'Compiling and executing via Roslyn engine...' : 'Đang biên dịch & thực thi qua Roslyn engine...'}</span>
            </div>`;
        if (timeBadge) timeBadge.innerText = '...';
        if (statusBadge) statusBadge.innerHTML = `<span class="badge bg-warning-subtle text-warning">${isEn ? 'Running' : 'Đang chạy'}</span>`;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('/Playground/Execute', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ code: codeText })
            });

            const data = await res.json();

            if (timeBadge) timeBadge.innerText = (data.executionTimeMs || 0) + ' ms';

            if (data.isSuccess) {
                if (statusBadge) statusBadge.innerHTML = `<span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle-fill me-1"></i>${isEn ? 'Success' : 'Thành công'}</span>`;
                const outText = data.output && data.output.trim() ? data.output : (isEn ? '(No console output)' : '(Không có dữ liệu xuất Console)');
                terminalBody.innerHTML = `<pre class="text-success mb-0 overflow-x-auto font-monospace" style="white-space: pre-wrap; font-size: 0.78rem;">${escapeHtml(outText)}</pre>`;
            } else {
                if (statusBadge) statusBadge.innerHTML = `<span class="badge bg-danger-subtle text-danger"><i class="bi bi-x-circle-fill me-1"></i>${isEn ? 'Build / Runtime Error' : 'Lỗi biên dịch / Runtime'}</span>`;
                const errText = data.error || (isEn ? 'Compilation failed.' : 'Biên dịch thất bại.');
                terminalBody.innerHTML = `<pre class="text-danger mb-0 overflow-x-auto font-monospace" style="white-space: pre-wrap; font-size: 0.78rem;">${escapeHtml(errText)}</pre>`;
            }
        } catch (e) {
            if (statusBadge) statusBadge.innerHTML = `<span class="badge bg-danger-subtle text-danger">Error</span>`;
            terminalBody.innerHTML = `<div class="text-danger small">${isEn ? 'Failed to connect to code runner service.' : 'Lỗi kết nối tới máy chủ Roslyn Runner.'}</div>`;
        }
    }

    function closeInlineTerminal(btn) {
        const wrapper = btn.closest('.code-toolbar-wrapper');
        const terminal = wrapper?.querySelector('.inline-code-terminal');
        if (terminal) terminal.classList.add('d-none');
    }

    // Reload sidebar conversations list via AJAX
    async function reloadConversationsList() {
        if (!isAuthenticated) return;
        try {
            const res = await fetch('/AiTutor/Conversations');
            if (!res.ok) return;
            const data = await res.json();
            if (data.success && data.conversations) {
                renderSidebarConversations(data.conversations);
            }
        } catch (e) {
            // Handled silently
        }
    }

    function renderSidebarConversations(convs) {
        const container = document.getElementById('conversationsContainer');
        if (!container) return;

        if (convs.length === 0) {
            container.innerHTML = `<div class="p-3 text-center text-muted small"><i class="bi bi-chat-square-text fs-3 d-block mb-2 opacity-50"></i><span>${isEn ? 'No conversations yet.' : 'Chưa có đoạn chat nào.'}</span></div>`;
            return;
        }

        const groups = {};
        convs.forEach(c => {
            const groupKey = c.timeGroup || (isEn ? 'Recent' : 'Gần đây');
            if (!groups[groupKey]) groups[groupKey] = [];
            groups[groupKey].push(c);
        });

        let html = '';
        for (const [groupName, items] of Object.entries(groups)) {
            html += `<div class="conv-group-header text-uppercase text-muted fw-bold px-2.5 pt-2 pb-1" style="font-size: 0.68rem; letter-spacing: 0.5px;">${escapeHtml(groupName)}</div><div class="conv-group-items d-flex flex-column gap-1 mb-2">`;
            items.forEach(c => {
                const isActive = currentConversationId === c.id;
                html += `
                    <div class="conv-item rounded-3 px-2.5 py-2 d-flex align-items-center justify-content-between position-relative ${isActive ? 'active bg-primary bg-opacity-10 text-primary fw-semibold' : 'text-body'}"
                         data-id="${c.id}" data-title="${escapeHtml(c.title)}" data-pinned="${c.isPinned ? 'true' : 'false'}" onclick="selectConversation(this)">
                        <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1 me-2">
                            <i class="bi ${c.isPinned ? 'bi-pin-fill text-warning' : (isActive ? 'bi-chat-dots-fill text-primary' : 'bi-chat-left-text text-secondary')} flex-shrink-0" style="font-size: 0.85rem;"></i>
                            <span class="conv-title text-truncate small">${escapeHtml(c.title)}</span>
                        </div>
                        <div class="conv-actions d-flex align-items-center gap-1 flex-shrink-0">
                            <button type="button" class="btn btn-icon btn-sm p-0 text-muted hover-icon" title="${isEn ? 'Rename' : 'Đổi tên'}" onclick="event.stopPropagation(); renameConversationPrompt(this)">
                                <i class="bi bi-pencil" style="font-size: 0.75rem;"></i>
                            </button>
                            <button type="button" class="btn btn-icon btn-sm p-0 text-muted hover-icon" title="${c.isPinned ? (isEn ? 'Unpin' : 'Bỏ ghim') : (isEn ? 'Pin' : 'Ghim')}" onclick="event.stopPropagation(); togglePinConversation(this)">
                                <i class="bi ${c.isPinned ? 'bi-pin-angle-fill text-warning' : 'bi-pin-angle'}" style="font-size: 0.75rem;"></i>
                            </button>
                            <button type="button" class="btn btn-icon btn-sm p-0 text-muted hover-icon text-hover-danger" title="${isEn ? 'Delete' : 'Xóa'}" onclick="event.stopPropagation(); deleteConversationConfirm(this)">
                                <i class="bi bi-trash3" style="font-size: 0.75rem;"></i>
                            </button>
                        </div>
                    </div>`;
            });
            html += `</div>`;
        }
        container.innerHTML = html;
    }

    // Filter conversations in real time
    function filterConversations(query) {
        const q = (query || '').toLowerCase().trim();
        const groups = document.querySelectorAll('.conv-group-items');

        groups.forEach(group => {
            let hasVisibleChild = false;
            const items = group.querySelectorAll('.conv-item');
            items.forEach(el => {
                const title = (el.dataset.title || '').toLowerCase();
                if (!q || title.includes(q)) {
                    el.classList.remove('d-none');
                    hasVisibleChild = true;
                } else {
                    el.classList.add('d-none');
                }
            });

            const header = group.previousElementSibling;
            if (header && header.classList.contains('conv-group-header')) {
                if (hasVisibleChild) {
                    header.classList.remove('d-none');
                    group.classList.remove('d-none');
                } else {
                    header.classList.add('d-none');
                    group.classList.add('d-none');
                }
            }
        });
    }

    // Rename prompt & modal handling
    function renameConversationPrompt(btn) {
        const item = btn ? btn.closest('.conv-item') : null;
        if (!item) return;

        const convId = item.dataset.id;
        const currentTitle = item.dataset.title || '';

        document.getElementById('renameConvId').value = convId;
        const input = document.getElementById('renameConvTitle');
        input.value = currentTitle;

        const modalEl = document.getElementById('renameModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        setTimeout(() => {
            input.focus();
            input.select();
        }, 150);
    }

    // Submit Rename
    async function submitRename() {
        const id = document.getElementById('renameConvId').value;
        const titleInput = document.getElementById('renameConvTitle');
        const title = titleInput ? titleInput.value.trim() : '';
        if (!id || !title) return;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch(`/AiTutor/Conversations/${id}/Title`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ title })
            });

            if (res.ok) {
                const modalEl = document.getElementById('renameModal');
                bootstrap.Modal.getInstance(modalEl)?.hide();

                if (currentConversationId === id) {
                    const titleEl = document.getElementById('currentChatTitle');
                    if (titleEl) titleEl.innerText = title;
                }

                const item = document.querySelector(`.conv-item[data-id="${id}"]`);
                if (item) {
                    item.dataset.title = title;
                    const span = item.querySelector('.conv-title');
                    if (span) span.innerText = title;
                }

                await reloadConversationsList();
            }
        } catch (e) {
            // Handled silently
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('renameConvTitle')?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitRename();
            }
        });
    });

    // Toggle Pin
    async function togglePinConversation(btn) {
        const item = btn ? btn.closest('.conv-item') : null;
        if (!item) return;

        const convId = item.dataset.id;
        const currentlyPinned = item.dataset.pinned === 'true';
        const newPinnedState = !currentlyPinned;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch(`/AiTutor/Conversations/${convId}/Pin`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ isPinned: newPinnedState })
            });

            if (res.ok) {
                item.dataset.pinned = newPinnedState ? 'true' : 'false';
                await reloadConversationsList();
            }
        } catch (e) {
            // Handled silently
        }
    }

    // Delete Conversation Confirmation
    function deleteConversationConfirm(btn) {
        const item = btn ? btn.closest('.conv-item') : null;
        if (!item) return;

        const convId = item.dataset.id;
        document.getElementById('deleteConvId').value = convId;
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteModal'));
        modal.show();
    }

    // Submit Delete Conversation
    async function submitDeleteConversation() {
        const convId = document.getElementById('deleteConvId').value;
        if (!convId) return;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch(`/AiTutor/Conversations/${convId}/Delete`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                }
            });

            if (res.ok) {
                const modalEl = document.getElementById('deleteModal');
                bootstrap.Modal.getInstance(modalEl)?.hide();

                if (currentConversationId === convId) {
                    startNewChat();
                }

                await reloadConversationsList();
            }
        } catch (e) {
            // Handled silently
        }
    }

    // Helper DOM builders
    function appendUserMessageToDOM(content, codeSnippet, timeStr) {
        const list = document.getElementById('messagesList');
        const snippetHtml = codeSnippet ? `<div class="mt-2 p-2 rounded-3 bg-dark bg-opacity-25 small font-monospace overflow-x-auto"><code>${escapeHtml(codeSnippet)}</code></div>` : '';
        const html = `
            <div class="d-flex justify-content-end msg-row user-msg">
                <div class="d-flex flex-column align-items-end user-msg-col">
                    <div class="user-bubble p-2.5 p-sm-3 rounded-4 bg-primary text-white shadow-xs">
                        <div class="message-text">${escapeHtml(content).replace(/\n/g, '<br>')}</div>
                        ${snippetHtml}
                    </div>
                    <span class="text-muted small pe-2 mt-1" style="font-size: 0.68rem;">${timeStr}</span>
                </div>
            </div>`;
        list.insertAdjacentHTML('beforeend', html);
    }

    function appendAiMessageToDOM(markdown, codeSnippet, timeStr) {
        const list = document.getElementById('messagesList');
        let formatted = formatSimpleMarkdown(markdown);

        const html = `
            <div class="d-flex gap-2 gap-sm-3 msg-row ai-msg">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center flex-shrink-0 ai-avatar-badge" style="width: 36px; height: 36px;">
                    <i class="bi bi-robot fs-5"></i>
                </div>
                <div class="d-flex flex-column flex-grow-1 overflow-hidden ai-msg-col">
                    <div class="ai-bubble p-3 p-sm-3.5 rounded-4 bg-body-tertiary border shadow-xs">
                        <div class="fw-bold mb-1 text-primary small d-flex align-items-center gap-2">
                            <span>Atus</span>
                            <span class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">AI Agent</span>
                        </div>
                        <div class="markdown-body small lh-lg">${formatted}</div>
                    </div>
                    <span class="text-muted small ps-2 mt-1" style="font-size: 0.68rem;">${timeStr}</span>
                </div>
            </div>`;
        list.insertAdjacentHTML('beforeend', html);
    }

    function formatTime(isoStr) {
        if (!isoStr) return '';
        const d = new Date(isoStr);
        return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function escapeHtml(text) {
        if (!text) return '';
        return text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function copyCodeToClipboard(btn) {
        const pre = btn.closest('.code-toolbar-wrapper').querySelector('pre code');
        if (pre) {
            navigator.clipboard.writeText(pre.innerText).then(() => {
                const original = btn.innerHTML;
                btn.innerHTML = `<i class="bi bi-check2 text-success"></i> ${isEn ? 'Copied' : 'Đã sao chép'}`;
                setTimeout(() => { btn.innerHTML = original; }, 2000);
            });
        }
    }

    function openInSandbox(btn) {
        const pre = btn.closest('.code-toolbar-wrapper').querySelector('pre code');
        if (pre) {
            sessionStorage.setItem('nettutos_sandbox_code', pre.innerText);
            window.open('/Playground', '_blank');
        }
    }

    function formatSimpleMarkdown(text) {
        if (!text) return '';

        // Code blocks with syntax toolbar: [▶ Chạy trực tiếp], [Sao chép], [C# Sandbox] + Mini Terminal
        text = text.replace(/```(?:csharp|cs)?\n([\s\S]*?)```/gi, function(match, code) {
            const trimmedCode = code.trim();
            return `
                <div class="code-toolbar-wrapper my-3 rounded-3 overflow-hidden border shadow-xs">
                    <div class="d-flex align-items-center justify-content-between px-3 py-1.5 bg-dark text-white border-bottom border-secondary border-opacity-25" style="font-size: 0.72rem;">
                        <span class="fw-semibold text-info d-flex align-items-center gap-1.5">
                            <i class="bi bi-filetype-cs"></i>
                            <span>C# (.NET 10)</span>
                        </span>
                        <div class="d-flex gap-1.5 align-items-center">
                            <button type="button" class="btn btn-sm btn-success py-0 px-2 fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 0.68rem;" onclick="runInlineCode(this)" title="${isEn ? 'Execute code directly' : 'Chạy trực tiếp mã nguồn'}">
                                <i class="bi bi-play-fill"></i>
                                <span>${isEn ? 'Run' : 'Chạy trực tiếp'}</span>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-light py-0 px-2" style="font-size: 0.68rem;" onclick="copyCodeToClipboard(this)">
                                <i class="bi bi-clipboard me-1"></i>${isEn ? 'Copy' : 'Sao chép'}
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info py-0 px-2" style="font-size: 0.68rem;" onclick="openInSandbox(this)" title="${isEn ? 'Open in full sandbox' : 'Mở trong Sandbox'}">
                                <i class="bi bi-box-arrow-up-right me-1"></i>${isEn ? 'Sandbox' : 'Sandbox'}
                            </button>
                        </div>
                    </div>
                    <pre class="bg-dark text-light p-3 mb-0 overflow-x-auto font-monospace" style="font-size: 0.8rem; line-height: 1.55;"><code>${escapeHtml(trimmedCode)}</code></pre>
                    
                    <!-- Inline Code Execution Terminal Output Area -->
                    <div class="inline-code-terminal d-none border-top border-secondary border-opacity-25 bg-black p-2.5 font-monospace" style="font-size: 0.75rem;">
                        <div class="d-flex align-items-center justify-content-between pb-1.5 mb-1.5 border-bottom border-secondary border-opacity-25">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-1.5 py-0.5" style="font-size: 0.65rem;">TERMINAL</span>
                                <span class="inline-terminal-status"></span>
                            </div>
                            <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 0.7rem;">
                                <span><i class="bi bi-stopwatch me-1"></i><span class="inline-terminal-time">0 ms</span></span>
                                <button type="button" class="btn btn-sm btn-icon p-0 text-muted text-hover-light" onclick="closeInlineTerminal(this)" title="${isEn ? 'Close terminal' : 'Đóng terminal'}">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                        <div class="inline-terminal-body"></div>
                    </div>
                </div>`;
        });

        // Headers
        text = text.replace(/^### (.*$)/gim, '<h5 class="fw-bold mt-3 mb-2 text-primary">$1</h5>');
        text = text.replace(/^## (.*$)/gim, '<h4 class="fw-bold mt-3 mb-2">$1</h4>');
        text = text.replace(/^# (.*$)/gim, '<h3 class="fw-bold mt-4 mb-2">$1</h3>');

        // Bold & Italic
        text = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        text = text.replace(/\*(.*?)\*/g, '<em>$1</em>');

        // Inline code
        text = text.replace(/`([^`]+)`/g, '<code class="bg-body-secondary px-1.5 py-0.5 rounded text-primary" style="font-size: 0.85em;">$1</code>');

        // Blockquotes
        text = text.replace(/^> (.*$)/gim, '<blockquote class="border-start border-3 border-warning ps-3 py-1 my-2 text-muted fst-italic bg-warning bg-opacity-10 rounded-end">$1</blockquote>');

        // Bullet lists
        text = text.replace(/^\s*[-*]\s+(.*$)/gim, '<li class="ms-3 mb-1">$1</li>');
        text = text.replace(/(<li class="ms-3 mb-1">.*<\/li>)/gs, '<ul class="ps-1 my-2">$1</ul>');

        // Links
        text = text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-decoration-none text-primary fw-semibold" target="_blank">$1 <i class="bi bi-box-arrow-up-right small" style="font-size: 0.7em;"></i></a>');

        // Newlines to <br> for regular paragraphs
        text = text.replace(/\n\n+/g, '</p><p class="mb-2">');
        return `<p class="mb-2">${text}</p>`;
    }
</script>

