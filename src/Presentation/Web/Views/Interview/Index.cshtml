@model NET_Tutos.Models.ViewModels.InterviewIndexViewModel
@using NET_Tutos.Models.Entities
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? ".NET Interview Prep & Flashcards" : "Luyện Phỏng Vấn .NET & Thẻ Ghi Nhớ";
    var activeTopic = Model.CurrentTopic;
    var activeDiff = Model.CurrentDifficulty;
}

<div class="container py-4 py-md-5">
    <!-- Header Banner -->
    <div class="card border-0 rounded-4 shadow-sm bg-gradient-primary-subtle p-4 p-md-5 mb-4 position-relative overflow-hidden">
        <div class="position-absolute end-0 top-50 translate-middle-y opacity-10 pe-4 d-none d-lg-block">
            <i class="bi bi-mortarboard-fill text-primary" style="font-size: 14rem;"></i>
        </div>
        <div class="position-relative" style="max-width: 820px;">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-semibold">
                    <i class="bi bi-lightning-charge-fill me-1"></i> @(isEn ? "INTERVIEW MASTERY" : "CHINH PHỤC PHỎNG VẤN")
                </span>
                <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-30 rounded-pill px-3 py-1.5 fw-semibold">
                    <i class="bi bi-clock-history me-1"></i> Spaced Repetition (Leitner)
                </span>
            </div>
            <h1 class="display-6 fw-bold text-body-emphasis mb-2">
                @(isEn ? ".NET Interview Prep & Smart Flashcards" : "Bộ Câu Hỏi Phỏng Vấn .NET & Thẻ Ghi Nhớ")
            </h1>
            <p class="text-body-secondary lead fs-6 mb-4">
                @(isEn 
                    ? "Master core C#, CLR internals, async/await, EF Core query tuning, and Clean Architecture with spaced repetition. Never blank out in a technical interview again."
                    : "Làm chủ kiến thức cốt lõi C#, cơ chế hoạt động của CLR, async/await, tối ưu EF Core và Clean Architecture với phương pháp lặp lại ngắt quãng. Tự tin chinh phục mọi câu hỏi kỹ thuật từ Junior đến Senior.")
            </p>
            <div class="d-flex flex-wrap gap-2.5">
                <a asp-action="Study" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm">
                    <i class="bi bi-play-circle-fill me-2"></i> @(isEn ? $"Study Now ({Model.DueTodayCount} due)" : $"Bắt đầu Ôn tập ({Model.DueTodayCount} thẻ đến hạn)")
                </a>
                <a asp-action="Mock" class="btn btn-outline-primary rounded-pill px-4 py-2.5 fw-bold bg-body d-inline-flex align-items-center gap-1.5 shadow-xs">
                    <i class="bi bi-robot text-primary"></i> @(isEn ? "AI Mock Interview (10 mins)" : "Phỏng Vấn Giả Lập AI (10 phút)")
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-xs mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats Cards Row -->
    <div class="row g-3 mb-4 pb-2">
        <div class="col-6 col-lg-3">
            <div class="card border rounded-4 p-3 h-100 shadow-xs bg-body transition-hover">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-warning bg-opacity-15 text-warning fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-bell-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-body-emphasis">@Model.DueTodayCount</div>
                        <div class="text-body-secondary small">@(isEn ? "Due For Review" : "Cần ôn hôm nay")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border rounded-4 p-3 h-100 shadow-xs bg-body transition-hover">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-success bg-opacity-15 text-success fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-circle-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-body-emphasis">@Model.MasteredCards <span class="fs-6 fw-normal text-muted">/ @Model.TotalCards</span></div>
                        <div class="text-body-secondary small">@(isEn ? "Mastered (Box 4-5)" : "Đã nắm vững")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border rounded-4 p-3 h-100 shadow-xs bg-body transition-hover">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-15 text-primary fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-collection-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-body-emphasis">@Model.OverallMasteryPercentage%</div>
                        <div class="text-body-secondary small">@(isEn ? "Overall Mastery" : "Tỷ lệ thông thạo")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border rounded-4 p-3 h-100 shadow-xs bg-body transition-hover">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-danger bg-opacity-15 text-danger fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-fire fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-body-emphasis">@Model.CurrentStreak <span class="fs-6 fw-normal text-muted">@(isEn ? "days" : "ngày")</span></div>
                        <div class="text-body-secondary small">@(isEn ? "Learning Streak" : "Chuỗi học liên tục")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Adaptive Learning Insights Panel (Hydrated via Kafka Telemetry + Semantic RAG) -->
    <div id="adaptiveLearningPanel" class="card border rounded-4 shadow-xs bg-body p-4 mb-5 d-none">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem;">
                        <i class="bi bi-cpu-fill me-1"></i> @(isEn ? "ADAPTIVE LEARNING ENGINE (ATUS + KAFKA RAG)" : "LỘ TRÌNH THÍCH ỨNG THÔNG MINH (ATUS + KAFKA RAG)")
                    </span>
                    <span id="adaptiveSuggestedLevelBadge" class="badge bg-info bg-opacity-10 text-info rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;"></span>
                </div>
                <h5 class="fw-bold mb-0 text-body-emphasis">
                    @(isEn ? "Recommended Next Lessons Based on Your Progress" : "Bài Học Đề Xuất Cá Nhân Hóa Dựa Trên Năng Lực Thực Tế")
                </h5>
            </div>
            <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold" id="btnGenerateAdaptiveChallenge" onclick="openAdaptiveChallenge(defaultAdaptiveTopic)">
                    <i class="bi bi-code-slash me-1"></i> @(isEn ? "Generate Practice Code" : "Sinh Bài Tập Code")
                </button>
                <a asp-action="Mock" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                    <i class="bi bi-lightning-fill me-1"></i> @(isEn ? "Test Readiness with Atus" : "Đo trình độ với Atus")
                </a>
            </div>
        </div>
        <div id="adaptiveWeakSpotsRow" class="d-flex flex-wrap gap-2 mb-3 d-none"></div>
        <div id="adaptiveLessonsGrid" class="row g-3"></div>
    </div>

    <!-- Topics Grid Section -->
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h4 class="fw-bold mb-0 text-body-emphasis">
                <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i> @(isEn ? "Key Interview Topics" : "Chuyên Đề Phỏng Vấn Trọng Tâm")
            </h4>
            <span class="text-muted small">6 @(isEn ? "core tracks" : "chuyên đề tuyển dụng")</span>
        </div>

        <div class="row g-3">
            @foreach (var top in Model.Topics)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border rounded-4 p-3.5 h-100 shadow-xs bg-body transition-hover d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="rounded-3 bg-@top.ColorClass bg-opacity-10 text-@top.ColorClass p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                    <i class="bi @top.IconClass fs-5"></i>
                                </div>
                                <span class="badge bg-body-secondary text-body-secondary rounded-pill px-2.5 py-1 small fw-semibold">
                                    @top.TotalCards @(isEn ? "questions" : "câu hỏi")
                                </span>
                            </div>
                            <h5 class="fw-bold mb-1.5 text-body-emphasis">@top.Name</h5>
                            <p class="text-body-secondary small mb-3" style="line-height: 1.55; min-height: 48px;">
                                @top.Description
                            </p>
                        </div>
                        <div>
                            <div class="d-flex justify-content-between align-items-center small text-muted mb-1.5">
                                <span>@(isEn ? "Mastery" : "Đã thuộc"): @top.MasteredCards/@top.TotalCards</span>
                                <span class="fw-bold text-body-emphasis">@top.MasteryPercentage%</span>
                            </div>
                            <div class="progress rounded-pill mb-3" style="height: 6px;">
                                <div class="progress-bar bg-@top.ColorClass" role="progressbar" style="width: @top.MasteryPercentage%" aria-valuenow="@top.MasteryPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Study" asp-route-topic="@top.Topic" class="btn btn-sm btn-@top.ColorClass rounded-pill flex-grow-1 fw-semibold py-1.5">
                                    <i class="bi bi-play-fill me-1"></i> @(isEn ? "Practice Cards" : "Luyện Thẻ")
                                </a>
                                <a asp-action="Index" asp-route-topic="@top.Topic" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1.5" title="@(isEn ? "Browse all" : "Xem danh sách")">
                                    <i class="bi bi-list-ul"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Flashcard Question Explorer Section -->
    <div class="mb-4 pt-2">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 pb-2 border-bottom">
            <div>
                <h4 class="fw-bold mb-1 text-body-emphasis">
                    <i class="bi bi-card-checklist text-primary me-2"></i> @(isEn ? "Question Explorer" : "Ngân Hàng Câu Hỏi Phỏng Vấn")
                </h4>
                <p class="text-muted small mb-0">@(isEn ? "Browse questions, view detailed answers, and read interviewer insider tips." : "Khám phá danh sách câu hỏi, đọc câu trả lời chi tiết và các bẫy phỏng vấn thường gặp.")</p>
            </div>

            <!-- Search form -->
            <form method="get" asp-action="Index" class="d-flex gap-2" style="max-width: 320px; width: 100%;">
                @if (activeTopic.HasValue) { <input type="hidden" name="topic" value="@activeTopic.Value" /> }
                @if (activeDiff.HasValue) { <input type="hidden" name="difficulty" value="@activeDiff.Value" /> }
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control rounded-start-pill" placeholder="@(isEn ? "Search questions..." : "Tìm kiếm câu hỏi...")" value="@Model.SearchQuery" />
                    <button class="btn btn-primary rounded-end-pill px-3" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>

        <!-- Filter pills -->
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
            <span class="small fw-bold text-muted me-1">@(isEn ? "Topic:" : "Chủ đề:")</span>
            <a asp-action="Index" asp-route-difficulty="@activeDiff" asp-route-search="@Model.SearchQuery" 
               class="badge rounded-pill text-decoration-none px-3 py-1.5 @(!activeTopic.HasValue ? "bg-primary text-white" : "bg-body-secondary text-body-secondary")">
                @(isEn ? "All Topics" : "Tất cả")
            </a>
            @foreach (FlashcardTopic t in Enum.GetValues<FlashcardTopic>())
            {
                <a asp-action="Index" asp-route-topic="@t" asp-route-difficulty="@activeDiff" asp-route-search="@Model.SearchQuery"
                   class="badge rounded-pill text-decoration-none px-3 py-1.5 @(activeTopic == t ? "bg-primary text-white" : "bg-body-secondary text-body-secondary")">
                    @t
                </a>
            }

            <span class="small fw-bold text-muted ms-md-3 me-1">@(isEn ? "Level:" : "Cấp độ:")</span>
            <a asp-action="Index" asp-route-topic="@activeTopic" asp-route-search="@Model.SearchQuery"
               class="badge rounded-pill text-decoration-none px-3 py-1.5 @(!activeDiff.HasValue ? "bg-dark text-white" : "bg-body-secondary text-body-secondary")">
                @(isEn ? "All Levels" : "Tất cả")
            </a>
            <a asp-action="Index" asp-route-topic="@activeTopic" asp-route-difficulty="@DifficultyLevel.Beginner" asp-route-search="@Model.SearchQuery"
               class="badge rounded-pill text-decoration-none px-3 py-1.5 @(activeDiff == DifficultyLevel.Beginner ? "bg-info text-dark" : "bg-body-secondary text-body-secondary")">
                Junior
            </a>
            <a asp-action="Index" asp-route-topic="@activeTopic" asp-route-difficulty="@DifficultyLevel.Intermediate" asp-route-search="@Model.SearchQuery"
               class="badge rounded-pill text-decoration-none px-3 py-1.5 @(activeDiff == DifficultyLevel.Intermediate ? "bg-primary text-white" : "bg-body-secondary text-body-secondary")">
                Middle
            </a>
            <a asp-action="Index" asp-route-topic="@activeTopic" asp-route-difficulty="@DifficultyLevel.Advanced" asp-route-search="@Model.SearchQuery"
               class="badge rounded-pill text-decoration-none px-3 py-1.5 @(activeDiff == DifficultyLevel.Advanced ? "bg-danger text-white" : "bg-body-secondary text-body-secondary")">
                Senior
            </a>
        </div>

        <!-- Cards List -->
        <div class="row g-3">
            @if (Model.RecentCards.Any())
            {
                @foreach (var card in Model.RecentCards)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border rounded-4 p-3.5 h-100 shadow-xs bg-body transition-hover d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                    <span class="badge bg-@card.TopicBadgeClass bg-opacity-10 text-@card.TopicBadgeClass rounded-pill px-2.5 py-1 small fw-semibold">
                                        <i class="bi @card.TopicIconClass me-1"></i>@card.TopicName
                                    </span>
                                    <span class="badge bg-@card.DifficultyBadgeClass bg-opacity-15 text-@card.DifficultyBadgeClass rounded-pill px-2 py-0.5 small">
                                        @card.DifficultyName
                                    </span>
                                </div>
                                <h6 class="fw-bold mb-2 text-body-emphasis" style="line-height: 1.5; min-height: 52px;">
                                    <a asp-action="QuestionDetail" asp-route-slug="@card.Slug" class="text-decoration-none text-body-emphasis hover-primary">
                                        @card.Question
                                    </a>
                                </h6>
                                @if (!string.IsNullOrEmpty(card.QuickHint))
                                {
                                    <div class="small text-muted mb-3 p-2 bg-body-tertiary rounded-3" style="font-size: 0.82rem;">
                                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>@card.QuickHint
                                    </div>
                                }
                            </div>
                            <div class="border-top pt-2.5 mt-2 d-flex align-items-center justify-content-between">
                                <div>
                                    @if (card.IsMastered)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                            <i class="bi bi-patch-check-fill me-1"></i>@(isEn ? "Mastered" : "Đã nắm vững")
                                        </span>
                                    }
                                    else if (card.ReviewCount > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill small">
                                            <i class="bi bi-arrow-repeat me-1"></i>Box @card.BoxLevel (@(isEn ? "Learning" : "Đang học"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill small">
                                            @(isEn ? "New Card" : "Chưa học")
                                        </span>
                                    }
                                </div>
                                <a asp-action="QuestionDetail" asp-route-slug="@card.Slug" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 small fw-semibold">
                                    @(isEn ? "View Answer" : "Xem đáp án") <i class="bi bi-chevron-right small ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-clipboard-x display-4 text-muted mb-3 d-block opacity-50"></i>
                    <h5 class="fw-bold">@(isEn ? "No questions match your filter" : "Không tìm thấy câu hỏi phù hợp")</h5>
                    <p class="text-muted small">@(isEn ? "Try adjusting your search query or reset filters." : "Hãy thử thay đổi từ khóa tìm kiếm hoặc đặt lại bộ lọc.")</p>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3">@(isEn ? "Reset filters" : "Đặt lại bộ lọc")</a>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4 pt-2 d-flex justify-content-center" aria-label="Flashcards pagination">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-start-pill px-3" asp-action="Index" 
                           asp-route-page="@(Model.CurrentPage - 1)" asp-route-topic="@activeTopic" asp-route-difficulty="@activeDiff" asp-route-search="@Model.SearchQuery">
                            <i class="bi bi-chevron-left me-1"></i> @(isEn ? "Previous" : "Trước")
                        </a>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link px-3 text-muted">
                            @(isEn ? $"Page {Model.CurrentPage} of {Model.TotalPages}" : $"Trang {Model.CurrentPage} / {Model.TotalPages}")
                        </span>
                    </li>
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link rounded-end-pill px-3" asp-action="Index" 
                           asp-route-page="@(Model.CurrentPage + 1)" asp-route-topic="@activeTopic" asp-route-difficulty="@activeDiff" asp-route-search="@Model.SearchQuery">
                            @(isEn ? "Next" : "Tiếp") <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>


@section Scripts {
<!-- Adaptive Challenge Practice Modal -->
<div class="modal fade" id="adaptiveChallengeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom px-4 py-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-0.5 small fw-bold">
                            <i class="bi bi-cpu-fill me-1"></i> Atus Adaptive Sandbox
                        </span>
                        <span id="adaptiveChallengeTopicBadge" class="badge bg-info bg-opacity-10 text-info rounded-pill px-2.5 py-0.5 small"></span>
                    </div>
                    <h5 class="modal-title fw-bold mb-0" id="adaptiveChallengeTitle">@(isEn ? "Generating practice exercise..." : "Đang khởi tạo bài luyện tập...")</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="adaptiveChallengeLoading" class="text-center py-5">
                    <div class="spinner-border text-primary mb-2" role="status"></div>
                    <div class="text-muted small">@(isEn ? "Atus is crafting a personalized C# debugging exercise..." : "Atus đang thiết kế bài tập C# đúng trọng tâm điểm yếu của bạn...")</div>
                </div>
                <div id="adaptiveChallengeContent" class="d-none">
                    <p id="adaptiveChallengeDesc" class="text-body-secondary small mb-3"></p>
                    <div class="mb-2 d-flex justify-content-between align-items-center">
                        <label class="small fw-bold text-primary mb-0"><i class="bi bi-filetype-cs me-1"></i>C# (.NET 10) Editor</label>
                        <span class="small text-muted" id="adaptiveExpectedOutLabel"></span>
                    </div>
                    <textarea id="adaptiveCodeEditor" class="form-control bg-dark text-light font-monospace rounded-3 p-3 mb-3 border-secondary" rows="9" style="font-size: 0.82rem; line-height: 1.5;" spellcheck="false"></textarea>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <button type="button" class="btn btn-sm btn-success rounded-pill px-3.5 fw-semibold" id="btnRunAdaptiveCode" onclick="runAdaptiveCode()">
                            <i class="bi bi-play-fill me-1"></i> @(isEn ? "Run in Roslyn Sandbox" : "Chạy thử (Roslyn Sandbox)")
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold" onclick="toggleAdaptiveHint()">
                            <i class="bi bi-lightbulb me-1"></i> @(isEn ? "Hint" : "Gợi ý")
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" onclick="loadAdaptiveSolution()">
                            <i class="bi bi-code-square me-1"></i> @(isEn ? "Load Reference Solution" : "Nạp lời giải chuẩn")
                        </button>
                    </div>
                    <div id="adaptiveHintAlert" class="alert alert-warning rounded-3 small py-2 mb-3 d-none"></div>
                    <div id="adaptiveTerminalBox" class="rounded-3 bg-dark text-light p-3 font-monospace small d-none" style="font-size: 0.8rem;">
                        <div class="d-flex justify-content-between text-muted border-bottom border-secondary pb-1 mb-2" style="font-size: 0.72rem;">
                            <span>Roslyn Output</span>
                            <span id="adaptiveExecTime">0 ms</span>
                        </div>
                        <pre id="adaptiveTerminalOutput" class="mb-0" style="white-space: pre-wrap;"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let defaultAdaptiveTopic = 'Async/Await & ThreadPool';
    let currentAdaptiveChallenge = null;
    let adaptiveModalInstance = null;

    function escHtml(str) {
        if (!str) return '';
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    async function openAdaptiveChallenge(topic) {
        const isEn = @(isEn ? "true" : "false");
        const modalEl = document.getElementById('adaptiveChallengeModal');
        if (!modalEl) return;

        if (!adaptiveModalInstance) {
            adaptiveModalInstance = new bootstrap.Modal(modalEl);
        }
        adaptiveModalInstance.show();

        document.getElementById('adaptiveChallengeLoading')?.classList.remove('d-none');
        document.getElementById('adaptiveChallengeContent')?.classList.add('d-none');
        document.getElementById('adaptiveHintAlert')?.classList.add('d-none');
        document.getElementById('adaptiveTerminalBox')?.classList.add('d-none');
        document.getElementById('adaptiveChallengeTopicBadge').innerText = topic || 'Modern C#';

        try {
            const resp = await fetch('/api/adaptive/challenge', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ topic: topic || 'Async/Await & ThreadPool', difficulty: 'Intermediate' })
            });
            const data = await resp.json();
            if (data && data.success) {
                currentAdaptiveChallenge = data;
                document.getElementById('adaptiveChallengeTitle').innerText = data.title;
                document.getElementById('adaptiveChallengeDesc').innerText = data.problemStatementMarkdown;
                document.getElementById('adaptiveCodeEditor').value = data.starterCode || '';
                document.getElementById('adaptiveExpectedOutLabel').innerText = data.expectedOutput
                    ? ((isEn ? 'Expected: ' : 'Kỳ vọng: ') + data.expectedOutput)
                    : '';
                document.getElementById('adaptiveChallengeLoading')?.classList.add('d-none');
                document.getElementById('adaptiveChallengeContent')?.classList.remove('d-none');
            }
        } catch (err) {
            console.warn('Error loading adaptive challenge:', err);
        }
    }

    async function runAdaptiveCode() {
        const isEn = @(isEn ? "true" : "false");
        const code = document.getElementById('adaptiveCodeEditor').value;
        const btn = document.getElementById('btnRunAdaptiveCode');
        const box = document.getElementById('adaptiveTerminalBox');
        const outEl = document.getElementById('adaptiveTerminalOutput');
        const timeEl = document.getElementById('adaptiveExecTime');

        btn.disabled = true;
        box.classList.remove('d-none');
        outEl.className = 'mb-0 text-warning';
        outEl.innerText = isEn ? 'Compiling & running in Roslyn Sandbox...' : 'Đang biên dịch & chạy trên Roslyn Sandbox...';

        try {
            const resp = await fetch('/Playground/Execute', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code: code })
            });
            const res = await resp.json();
            timeEl.innerText = (res.executionTimeMs || 0) + ' ms';

            if (res.isSuccess) {
                const actual = (res.output || '').trim();
                const expected = (currentAdaptiveChallenge?.expectedOutput || '').trim();
                const matched = expected && actual.includes(expected);
                outEl.className = 'mb-0 text-success';
                outEl.innerText = actual + (matched ? (isEn ? '\n\n✅ PASSED! Matched expected output.' : '\n\n✅ XUẤT SẮC! Khớp hoàn toàn với kết quả kỳ vọng.') : '');
            } else {
                outEl.className = 'mb-0 text-danger';
                outEl.innerText = res.error || (isEn ? 'Execution error.' : 'Lỗi thực thi.');
            }
        } catch (e) {
            outEl.className = 'mb-0 text-danger';
            outEl.innerText = isEn ? 'Failed connecting to Sandbox.' : 'Lỗi kết nối Sandbox.';
        } finally {
            btn.disabled = false;
        }
    }

    function toggleAdaptiveHint() {
        const alertEl = document.getElementById('adaptiveHintAlert');
        if (!alertEl || !currentAdaptiveChallenge) return;
        alertEl.innerText = currentAdaptiveChallenge.hint || '';
        alertEl.classList.toggle('d-none');
    }

    function loadAdaptiveSolution() {
        if (!currentAdaptiveChallenge?.solutionCode) return;
        document.getElementById('adaptiveCodeEditor').value = currentAdaptiveChallenge.solutionCode;
    }

    (function () {
        const isEn = @(isEn ? "true" : "false");

        fetch('/api/adaptive/recommendations')
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data || !data.recommendedLessons || data.recommendedLessons.length === 0) return;

                const panel = document.getElementById('adaptiveLearningPanel');
                const badge = document.getElementById('adaptiveSuggestedLevelBadge');
                const weakRow = document.getElementById('adaptiveWeakSpotsRow');
                const grid = document.getElementById('adaptiveLessonsGrid');

                if (badge && data.suggestedInterviewLevel) {
                    badge.textContent = (isEn ? 'Target: ' : 'Mục tiêu: ') + data.suggestedInterviewLevel;
                }

                if (data.detectedWeakSpots && data.detectedWeakSpots.length > 0) {
                    defaultAdaptiveTopic = data.detectedWeakSpots[0].topic;
                    if (weakRow) {
                        weakRow.classList.remove('d-none');
                        weakRow.innerHTML = `<span class="small text-muted fw-semibold align-self-center">${isEn ? 'Click weak spot to practice:' : 'Bấm điểm yếu để luyện code ngay:'}</span>` +
                            data.detectedWeakSpots.slice(0, 4).map(w =>
                                `<button type="button" onclick="openAdaptiveChallenge('${escHtml(w.topic).replace(/'/g, "\\'")}')" class="btn btn-sm badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 rounded-pill px-2.5 py-1 fw-medium" style="font-size: 0.72rem;">
                                    <i class="bi bi-code-slash text-warning me-1"></i>${escHtml(w.topic)} (${w.lowestScore}/100)
                                </button>`
                            ).join('');
                    }
                } else if (data.trendingQuestions && data.trendingQuestions.length > 0) {
                    defaultAdaptiveTopic = data.trendingQuestions[0];
                }

                if (grid) {
                    grid.innerHTML = data.recommendedLessons.slice(0, 3).map(lesson => `
                        <div class="col-md-4">
                            <div class="card border h-100 rounded-3 p-3 bg-body-tertiary shadow-xs d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-1.5">
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-0.5" style="font-size: 0.68rem;">${escHtml(lesson.category)}</span>
                                    ${lesson.recommendedDifficulty ? `<span class="small text-muted fw-semibold" style="font-size: 0.68rem;">${escHtml(lesson.recommendedDifficulty)}</span>` : ''}
                                </div>
                                <div class="fw-bold text-body-emphasis small mb-1">${escHtml(lesson.title)}</div>
                                <div class="text-muted small mb-3 flex-grow-1" style="font-size: 0.76rem;">${escHtml(lesson.reason)}</div>
                                <a href="${escHtml(lesson.url)}" class="btn btn-sm btn-outline-primary rounded-pill py-1 fw-semibold text-center">
                                    ${isEn ? 'Review Lesson' : 'Học ngay'} <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    `).join('');
                }

                panel?.classList.remove('d-none');
            })
            .catch(() => { });
    })();
</script>
}
