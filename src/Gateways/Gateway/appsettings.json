{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "runner-route": {
        "ClusterId": "coderunner-cluster",
        "RateLimiterPolicy": "runner-policy",
        "Match": {
          "Path": "/api/v1/runner/{**catch-all}"
        }
      },
      "gamification-route": {
        "ClusterId": "gamification-cluster",
        "Match": {
          "Path": "/api/v1/gamification/{**catch-all}"
        }
      },
      "web-route": {
        "ClusterId": "web-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "coderunner-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://coderunner:8080"
          }
        }
      },
      "gamification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://gamification:8080"
          }
        }
      },
      "web-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://web:5000"
          }
        }
      }
    }
  }
}
