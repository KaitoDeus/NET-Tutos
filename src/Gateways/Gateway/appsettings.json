{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "runner-route": {
        "ClusterId": "coderunner-cluster",
        "RateLimiterPolicy": "runner-policy",
        "Match": {
          "Path": "/api/v1/runner/{**catch-all}"
        }
      },
      "gamification-route": {
        "ClusterId": "gamification-cluster",
        "Match": {
          "Path": "/api/v1/gamification/{**catch-all}"
        }
      },
      "aitutor-route": {
        "ClusterId": "aitutor-cluster",
        "Match": {
          "Path": "/api/v1/aitutor/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/v1/catalog/{**catch-all}"
        }
      },
      "web-route": {
        "ClusterId": "web-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "coderunner-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://coderunner:8080"
          }
        }
      },
      "gamification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://gamification:8080"
          }
        }
      },
      "aitutor-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://aitutor:8080"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog:8080"
          }
        }
      },
      "web-cluster": {
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "Cookie",
          "FailurePolicy": "Redistribute",
          "AffinityKeyName": ".YARP.WebAffinity"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://web:5000"
          }
        }
      }
    }
  }
}
