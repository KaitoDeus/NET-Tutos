@model NET_Tutos.Models.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Localization
@using NET_Tutos.Services
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Home" : "Trang chủ";
}

<!-- Minimalist Hero Section with Prominent Video Showcase -->
<section class="py-4 py-md-5 border-bottom">
    <div class="container">
        <!-- Punchy, Direct Header (Strict Typographic Standard) -->
        <div class="text-center mb-4">
            <h1 class="hero-title mb-0">
                @(isEn ? "Modern .NET & C# Engineering" : "Lập Trình .NET & C# Hiện Đại")
            </h1>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="row justify-content-center mb-3">
                <div class="col-xl-11">
                    <div class="d-flex align-items-center justify-content-between p-2.5 px-3 rounded-2 border bg-body-tertiary">
                        <div class="d-flex align-items-center gap-2">
                            <span class="status-indicator-dot"></span>
                            <span class="fw-semibold text-body-emphasis" style="font-size: var(--text-sm);">@(isEn ? "Welcome back" : "Xin chào"), @(User.Identity.Name?.Split('@')[0])!</span>
                            <span class="text-muted" style="font-size: var(--text-xs);">· @(Model.CompletedLessonsCount ?? 0) @(isEn ? "lessons completed" : "bài hoàn thành")</span>
                        </div>
                        @if (Model.LastAccessedTutorial != null)
                        {
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@Model.LastAccessedTutorial.GetSlug(isEn)" 
                               class="btn btn-xs btn-outline-primary rounded-1 px-2.5 py-1 fw-semibold text-truncate" style="max-width: 280px; font-size: var(--text-xs);">
                                <i class="bi bi-play-fill"></i> @(isEn ? "Resume:" : "Học tiếp:") @Model.LastAccessedTutorial.GetTitle(isEn)
                            </a>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Video Player & Roadmap Showcase (Video Front and Center, Minimal Text) -->
        <div class="row justify-content-center">
            <div class="col-xl-11">
                <div class="card border rounded-3 p-3 p-md-3.5 bg-body shadow-sm">
                    <div class="row g-3 g-lg-4 align-items-center">
                        <!-- Left: Embedded YouTube Video Player -->
                        <div class="col-lg-7">
                            <div class="ratio ratio-16x9 rounded-2 overflow-hidden border bg-dark">
                                <iframe src="https://www.youtube-nocookie.com/embed/6BcPIvVfVAw" 
                                        title="@(isEn ? "What is .NET? (Microsoft Official Guide)" : ".NET là gì? (Tài liệu Microsoft)")" 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                        allowfullscreen></iframe>
                            </div>
                        </div>

                        <!-- Right: Clean, Direct Curriculum Navigation (Standardized Type Scale) -->
                        <div class="col-lg-5">
                            <div class="d-flex flex-column justify-content-between h-100">
                                <div>
                                    <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                        <span class="section-label">
                                            @(isEn ? "Curriculum Roadmap" : "Lộ Trình 4 Chặng")
                                        </span>
                                        <a asp-controller="Roadmap" asp-action="Index" class="text-muted text-decoration-none" style="font-size: var(--text-xs);">
                                            @(isEn ? "Full roadmap" : "Chi tiết") <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </div>

                                    <div class="d-flex flex-column gap-2 mb-3">
                                        @foreach (var cat in Model.Categories)
                                        {
                                            <a asp-controller="Tutorials" asp-action="Index" asp-route-category="@cat.GetSlug(isEn)" 
                                               class="d-flex align-items-center justify-content-between p-2 px-2.5 rounded-2 border bg-body-tertiary text-decoration-none hover-border-primary transition-colors">
                                                <div class="d-flex align-items-center gap-2 min-w-0">
                                                    <i class="bi @cat.IconClass text-primary"></i>
                                                    <span class="fw-semibold text-body-emphasis text-truncate" style="font-size: var(--text-sm);">@cat.GetTitle(isEn)</span>
                                                </div>
                                                <span class="text-muted font-monospace flex-shrink-0" style="font-size: var(--text-xs);">@cat.Tutorials.Count @(isEn ? "lessons" : "bài")</span>
                                            </a>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top">
                                    <a asp-controller="Tutorials" asp-action="Index" class="btn btn-sm btn-primary rounded-2 px-3 py-2 fw-semibold flex-grow-1" style="font-size: var(--text-nav);">
                                        @(isEn ? "Start Learning" : "Bắt đầu học ngay") <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                    <a asp-controller="Playground" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-2 px-3 py-2 fw-semibold font-monospace" style="font-size: var(--text-nav);">
                                        <i class="bi bi-terminal me-1"></i> Playground
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Technical Guides (Strict Typographic Scale) -->
<section class="container py-4 my-2">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h4 fw-bold mb-0 text-body-emphasis">
            @(isEn ? "Featured Lessons" : "Bài Học Tiêu Biểu")
        </h2>
        <a asp-controller="Tutorials" asp-action="Index" class="text-muted text-decoration-none" style="font-size: var(--text-xs);">
            @(isEn ? "All 101 lessons" : "Tất cả 101 bài") <i class="bi bi-chevron-right"></i>
        </a>
    </div>

    <div class="row g-2.5">
        @foreach (var item in Model.FeaturedTutorials)
        {
            <div class="col-md-6 col-lg-4">
                <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" 
                   class="card h-100 rounded-2 border p-3 bg-body text-decoration-none hover-border-primary transition-colors d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between text-muted mb-1.5" style="font-size: var(--text-xs);">
                            <span class="text-primary font-monospace fw-medium">@item.Category.GetTitle(isEn)</span>
                            <span>@item.EstimatedReadingMinutes @(isEn ? "min read" : "phút đọc")</span>
                        </div>
                        <h3 class="h6 fw-semibold mb-1 text-body-emphasis" style="font-size: var(--text-base);">@item.GetTitle(isEn)</h3>
                        <p class="text-body-secondary mb-0 text-truncate-2" style="font-size: var(--text-sm); line-height: 1.55;">
                            @item.GetSummary(isEn)
                        </p>
                    </div>
                </a>
            </div>
        }
    </div>
</section>

<!-- Compact Community Activity Strip -->
@if (Model.RecentActivities.Any())
{
    <section class="container py-3 my-2 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-2.5">
            <span class="section-label">
                <i class="bi bi-activity text-primary me-1"></i> @(isEn ? "Recent Activity" : "Hoạt Động Gần Đây")
            </span>
            <a asp-controller="Activity" asp-action="Index" class="text-muted text-decoration-none" style="font-size: var(--text-xs);">
                @(isEn ? "View all" : "Xem tất cả") <i class="bi bi-chevron-right"></i>
            </a>
        </div>
        <div class="border rounded-2 bg-body overflow-hidden">
            @foreach (var act in Model.RecentActivities.Take(4))
            {
                <div class="d-flex align-items-center justify-content-between p-2.5 px-3 border-bottom last-border-0 gap-2">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <i class="bi @act.IconClass text-primary small"></i>
                        <span class="fw-semibold text-body-emphasis text-truncate" style="font-size: var(--text-sm);">@act.UserDisplayName</span>
                        <span class="text-muted text-truncate d-none d-sm-inline" style="font-size: var(--text-sm);">@act.GetActivityTitle(isEn)</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        @if (act.XpEarned > 0)
                        {
                            <span class="text-warning-emphasis font-monospace" style="font-size: var(--text-xs);">+@act.XpEarned XP</span>
                        }
                        <span class="text-muted font-monospace" style="font-size: var(--text-xs);">@act.GetActivityTimeAgo(isEn)</span>
                    </div>
                </div>
            }
        </div>
    </section>
}
