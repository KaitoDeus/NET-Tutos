<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NET_Tutos.Mobile.ViewModels"
             xmlns:models="clr-namespace:NET_Tutos.Mobile.Models"
             x:Class="NET_Tutos.Mobile.Views.FlashcardsPage"
             x:DataType="vm:FlashcardsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1120}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="16,18,16,20" RowSpacing="12">
        
        <!-- ROW 0: Top Navigation Bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
            <!-- Back Button -->
            <Button Grid.Column="0"
                    Text="← Quay lại"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                    BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                    BorderWidth="1"
                    TextColor="{AppThemeBinding Light=#4338CA, Dark=#A5B4FC}"
                    FontSize="12"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="38"
                    Padding="14,0" />

            <!-- Page Title -->
            <Label Grid.Column="1"
                   Text="Thẻ Phỏng Vấn .NET"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                   FontSize="17"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <!-- Progress Counter Badge -->
            <Border Grid.Column="2"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                    Padding="10,6"
                    VerticalOptions="Center">
                <Label Text="{Binding ProgressText}"
                       TextColor="{AppThemeBinding Light=#4338CA, Dark=#A5B4FC}"
                       FontSize="11"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- ROW 1: Topic Filter Horizontal Scroll -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Topics}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:FlashcardTopicItem">
                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="{Binding ChipBorderColor}"
                                BackgroundColor="{Binding ChipBgColor}"
                                Padding="14,7">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FlashcardsViewModel}}, Path=SelectTopicCommand}"
                                                      CommandParameter="{Binding Topic}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name}"
                                   TextColor="{Binding ChipTextColor}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- ROW 2: Progress Bar & Status Toast -->
        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <ProgressBar Progress="{Binding ProgressFraction}"
                         ProgressColor="#6366F1"
                         HeightRequest="4" />

            <!-- Notification Toast Message -->
            <Border IsVisible="{Binding HasStatusMessage}"
                    StrokeShape="RoundRectangle 10"
                    Stroke="#059669"
                    BackgroundColor="#064E3B"
                    Padding="12,6">
                <Label Text="{Binding StatusMessage}"
                       TextColor="#A7F3D0"
                       FontSize="11"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </Border>
        </VerticalStackLayout>

        <!-- ROW 3: Interactive Flashcard Display -->
        <Grid Grid.Row="3">
            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#6366F1"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <!-- Empty State -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 Spacing="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="Không có thẻ câu hỏi nào trong chủ đề này."
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                       FontSize="14"
                       HorizontalOptions="Center" />
                <Button Text="Tải lại tất cả"
                        Command="{Binding LoadDataCommand}"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="40"
                        Padding="16,0"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Active Card Container -->
            <ScrollView IsVisible="{Binding HasCards}">
                <Border StrokeShape="RoundRectangle 24"
                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                        StrokeThickness="1.5"
                        Padding="20"
                        Margin="0,4,0,8"
                        MaximumWidthRequest="500">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{AppThemeBinding Light=#FFFFFF, Dark=#141E33}" Offset="0.0" />
                            <GradientStop Color="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FlipCardCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="16">
                        <!-- Top Meta Badges -->
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{Binding CurrentCard.TopicBgColor}"
                                        Padding="8,4">
                                    <Label Text="{Binding CurrentCard.TopicName}"
                                           TextColor="{Binding CurrentCard.TopicAccentColor}"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{Binding CurrentCard.DifficultyBgColor}"
                                        Padding="8,4">
                                    <Label Text="{Binding CurrentCard.DifficultyText}"
                                           TextColor="{Binding CurrentCard.DifficultyColor}"
                                           FontSize="10"
                                           FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>

                            <!-- Leitner Box Level Badge -->
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{Binding CurrentCard.BoxBadgeBgColor}"
                                    Padding="10,4">
                                <Label Text="{Binding CurrentCard.BoxLevelText}"
                                       TextColor="{Binding CurrentCard.BoxBadgeTextColor}"
                                       FontSize="10"
                                       FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <!-- SIDE 1: Question (When Not Revealed) -->
                        <VerticalStackLayout Spacing="14" IsVisible="{Binding CurrentCard.IsQuestionSide, FallbackValue=True}">
                            <Border StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}"
                                    Padding="8,3"
                                    HorizontalOptions="Start">
                                <Label Text="CÂU HỎI PHỎNG VẤN"
                                       TextColor="#818CF8"
                                       FontSize="10"
                                       FontAttributes="Bold" />
                            </Border>

                            <Label Text="{Binding CurrentCard.QuestionVi}"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   LineHeight="1.35" />

                            <Label Text="{Binding CurrentCard.QuestionEn}"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                   FontSize="13"
                                   FontAttributes="Italic"
                                   LineHeight="1.3" />

                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                    BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#111827}"
                                    Padding="12,8"
                                    Margin="0,8,0,0">
                                <Label Text="Chạm vào thẻ để xem đáp án chuẩn Senior"
                                       TextColor="{AppThemeBinding Light=#4F46E5, Dark=#A5B4FC}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- SIDE 2: Answer (When Revealed) -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding CurrentCard.IsAnswerRevealed, FallbackValue=False}">
                            <Border StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#064E3B"
                                    Padding="8,3"
                                    HorizontalOptions="Start">
                                <Label Text="ĐÁP ÁN CHUẨN SENIOR"
                                       TextColor="#6EE7B7"
                                       FontSize="10"
                                       FontAttributes="Bold" />
                            </Border>

                            <Label Text="{Binding CurrentCard.AnswerMarkdownVi}"
                                   TextColor="{AppThemeBinding Light=#1E293B, Dark=#E2E8F0}"
                                   FontSize="14"
                                   LineHeight="1.5" />

                            <!-- Interview Tip Box -->
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="#D97706"
                                    BackgroundColor="#451A03"
                                    Padding="12,10"
                                    Margin="0,4,0,0">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Mẹo phỏng vấn từ Tech Lead:"
                                           TextColor="#FDE68A"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding CurrentCard.InterviewTipVi}"
                                           TextColor="#FEF3C7"
                                           FontSize="12"
                                           LineHeight="1.3" />
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="Chạm vào thẻ để lật lại câu hỏi"
                                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                   FontSize="11"
                                   HorizontalOptions="Center"
                                   Margin="0,4,0,0" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </ScrollView>
        </Grid>

        <!-- ROW 4: Action & Evaluation Bar -->
        <VerticalStackLayout Grid.Row="4" Spacing="10">
            <!-- Leitner Rating Buttons (Active when Answer is Revealed) -->
            <VerticalStackLayout Spacing="6" IsVisible="{Binding CurrentCard.IsAnswerRevealed, FallbackValue=False}">
                <Label Text="Đánh giá mức độ ghi nhớ:"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}"
                       FontSize="11"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0"
                            Text="Chưa nhớ"
                            Command="{Binding ReviewCardCommand}"
                            CommandParameter="1"
                            BackgroundColor="#450A0A"
                            BorderColor="#DC2626"
                            BorderWidth="1"
                            TextColor="#FCA5A5"
                            FontSize="10"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="36"
                            Padding="2,0" />

                    <Button Grid.Column="1"
                            Text="Hơi khó"
                            Command="{Binding ReviewCardCommand}"
                            CommandParameter="2"
                            BackgroundColor="#451A03"
                            BorderColor="#EA580C"
                            BorderWidth="1"
                            TextColor="#FDBA74"
                            FontSize="10"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="36"
                            Padding="2,0" />

                    <Button Grid.Column="2"
                            Text="Nhớ tốt"
                            Command="{Binding ReviewCardCommand}"
                            CommandParameter="3"
                            BackgroundColor="#064E3B"
                            BorderColor="#059669"
                            BorderWidth="1"
                            TextColor="#6EE7B7"
                            FontSize="10"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="36"
                            Padding="2,0" />

                    <Button Grid.Column="3"
                            Text="Thành thạo"
                            Command="{Binding ReviewCardCommand}"
                            CommandParameter="4"
                            BackgroundColor="#1E1B4B"
                            BorderColor="#6366F1"
                            BorderWidth="1"
                            TextColor="#A5B4FC"
                            FontSize="10"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="36"
                            Padding="2,0" />
                </Grid>
            </VerticalStackLayout>

            <!-- Previous / Next Card Controls -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="← Thẻ trước"
                        Command="{Binding PreviousCardCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                        BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                        BorderWidth="1"
                        TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}"
                        FontSize="12"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="42" />

                <Button Grid.Column="1"
                        Text="Thẻ tiếp theo →"
                        Command="{Binding NextCardCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        FontSize="12"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="42" />
            </Grid>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
