@model NET_Tutos.Models.ViewModels.ExamSessionViewModel
@{
    ViewData["Title"] = "Làm bài thi: " + Model.ExamTitle;
}

<div class="container py-4">
    <!-- Sticky Header with Countdown Timer & Progress -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-body mb-4 sticky-top" style="top: 70px; z-index: 1020;">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <span class="badge bg-primary px-3 py-1.5 rounded-pill mb-1">Kỳ thi Đánh giá Năng lực</span>
                <h4 class="fw-bold mb-0">@Model.ExamTitle</h4>
            </div>

            <!-- Countdown Timer & Controls -->
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 border px-3 py-2 rounded-pill bg-body-tertiary">
                    <i class="bi bi-stopwatch text-danger fs-5"></i>
                    <span class="fw-extrabold fs-5 font-monospace" id="countdownTimer">--:--</span>
                </div>

                <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm" id="btnSubmitExamTop" data-bs-toggle="modal" data-bs-target="#confirmSubmitModal">
                    <i class="bi bi-send-check-fill me-1"></i> Nộp bài thi
                </button>
            </div>
        </div>

        <!-- Progress Indicator -->
        <div class="progress mt-3" style="height: 6px;">
            <div class="progress-bar bg-primary" id="examProgressBar" role="progressbar" style="width: 0%;"></div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Questions Column -->
        <div class="col-lg-8 col-xl-9">
            <form id="examForm">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];
                    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-body mb-4 question-block" id="question_block_@(i+1)">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="badge bg-primary rounded-pill px-3 py-1.5">Câu @(i + 1) / @Model.Questions.Count</span>
                            <span class="text-muted small">Chọn 1 đáp án chính xác nhất</span>
                        </div>

                        <h5 class="fw-bold mb-3">@q.Question</h5>

                        @if (!string.IsNullOrWhiteSpace(q.CodeSnippet))
                        {
                            <pre class="rounded-3 p-3 mb-3 bg-dark text-white"><code class="language-csharp">@q.CodeSnippet</code></pre>
                        }

                        <div class="d-flex flex-column gap-2 mt-3">
                            <label class="p-3 border rounded-3 d-flex align-items-center gap-3 option-label cursor-pointer" for="q_@(q.Id)_A">
                                <input class="form-check-input mt-0 answer-radio" type="radio" name="answer_@q.Id" id="q_@(q.Id)_A" value="A" data-question-index="@(i+1)" data-question-id="@q.Id">
                                <span><strong>A.</strong> @q.OptionA</span>
                            </label>

                            <label class="p-3 border rounded-3 d-flex align-items-center gap-3 option-label cursor-pointer" for="q_@(q.Id)_B">
                                <input class="form-check-input mt-0 answer-radio" type="radio" name="answer_@q.Id" id="q_@(q.Id)_B" value="B" data-question-index="@(i+1)" data-question-id="@q.Id">
                                <span><strong>B.</strong> @q.OptionB</span>
                            </label>

                            <label class="p-3 border rounded-3 d-flex align-items-center gap-3 option-label cursor-pointer" for="q_@(q.Id)_C">
                                <input class="form-check-input mt-0 answer-radio" type="radio" name="answer_@q.Id" id="q_@(q.Id)_C" value="C" data-question-index="@(i+1)" data-question-id="@q.Id">
                                <span><strong>C.</strong> @q.OptionC</span>
                            </label>

                            <label class="p-3 border rounded-3 d-flex align-items-center gap-3 option-label cursor-pointer" for="q_@(q.Id)_D">
                                <input class="form-check-input mt-0 answer-radio" type="radio" name="answer_@q.Id" id="q_@(q.Id)_D" value="D" data-question-index="@(i+1)" data-question-id="@q.Id">
                                <span><strong>D.</strong> @q.OptionD</span>
                            </label>
                        </div>
                    </div>
                }

                <div class="text-center py-4">
                    <button type="button" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow" data-bs-toggle="modal" data-bs-target="#confirmSubmitModal">
                        <i class="bi bi-send-check-fill me-2"></i> Hoàn thành & Nộp bài thi
                    </button>
                </div>
            </form>
        </div>

        <!-- Right Side: Question Navigation Palette -->
        <div class="col-lg-4 col-xl-3">
            <aside class="sticky-sidebar" style="top: 190px;">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-body mb-3">
                    <h6 class="fw-bold mb-3 d-flex align-items-center">
                        <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i> Danh Sách Câu Hỏi
                    </h6>
                    <div class="d-flex flex-wrap gap-2">
                        @for (int i = 1; i <= Model.Questions.Count; i++)
                        {
                            <a href="#question_block_@i" class="btn btn-sm btn-outline-secondary rounded-3 fw-semibold palette-btn" id="palette_@i" style="width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center;">
                                @i
                            </a>
                        }
                    </div>

                    <div class="border-top mt-3 pt-3 small text-muted">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success rounded-pill" style="width:12px;height:12px;padding:0;"> </span>
                            <span>Đã chọn đáp án</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge border bg-body rounded-pill" style="width:12px;height:12px;padding:0;"> </span>
                            <span>Chưa trả lời</span>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

<!-- Confirm Submit Modal -->
<div class="modal fade" id="confirmSubmitModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="confirmModalLabel">Xác nhận nộp bài thi?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted mb-3" id="submitStatsText">
                    Bạn đã trả lời được <strong id="answeredCountText">0</strong> / @Model.Questions.Count câu hỏi.
                </p>
                <div class="alert alert-info py-2 small mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i> Sau khi nộp, hệ thống sẽ chấm điểm tức thì và xét cấp chứng chỉ số nếu bạn đạt từ 80% trở lên.
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Làm tiếp</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold" id="btnConfirmSubmit">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="submitSpinner"></span>
                    Nộp bài ngay
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Styles {
    <style>
        .cursor-pointer { cursor: pointer; }
        .option-label:hover {
            background-color: var(--bs-tertiary-bg);
            border-color: var(--bs-primary) !important;
        }
        .option-label:has(input:checked) {
            background-color: rgba(81, 43, 212, 0.08);
            border-color: #512bd4 !important;
            font-weight: 600;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const totalQuestions = @Model.Questions.Count;
            const durationMinutes = @Model.DurationMinutes;
            let timeRemaining = durationMinutes * 60;
            const startTime = Date.now();

            const timerEl = document.getElementById('countdownTimer');
            const progressBar = document.getElementById('examProgressBar');
            const answeredCountText = document.getElementById('answeredCountText');
            const submitStatsText = document.getElementById('submitStatsText');
            const btnConfirmSubmit = document.getElementById('btnConfirmSubmit');
            const submitSpinner = document.getElementById('submitSpinner');

            // Format mm:ss
            function updateTimerDisplay() {
                const minutes = Math.floor(timeRemaining / 60);
                const seconds = timeRemaining % 60;
                timerEl.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

                if (timeRemaining <= 120) {
                    timerEl.classList.add('text-danger');
                }
            }

            updateTimerDisplay();

            // Countdown interval
            const timerInterval = setInterval(function () {
                timeRemaining--;
                updateTimerDisplay();

                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    alert('Hết giờ làm bài! Hệ thống sẽ tự động nộp bài của bạn.');
                    doSubmitExam();
                }
            }, 1000);

            // Track radio choices
            const radios = document.querySelectorAll('.answer-radio');
            radios.forEach(radio => {
                radio.addEventListener('change', function () {
                    const qIndex = this.getAttribute('data-question-index');
                    const paletteBtn = document.getElementById(`palette_${qIndex}`);
                    if (paletteBtn) {
                        paletteBtn.classList.remove('btn-outline-secondary');
                        paletteBtn.classList.add('btn-success', 'text-white');
                    }
                    updateProgress();
                });
            });

            function updateProgress() {
                const answered = document.querySelectorAll('.answer-radio:checked').length;
                const percent = (answered / totalQuestions) * 100;
                progressBar.style.width = `${percent}%`;
                if (answeredCountText) answeredCountText.innerText = answered;
            }

            // Submit logic
            btnConfirmSubmit.addEventListener('click', function () {
                doSubmitExam();
            });

            async function doSubmitExam() {
                clearInterval(timerInterval);
                btnConfirmSubmit.disabled = true;
                if (submitSpinner) submitSpinner.classList.remove('d-none');

                const answers = {};
                document.querySelectorAll('.answer-radio:checked').forEach(r => {
                    const qId = parseInt(r.getAttribute('data-question-id'));
                    answers[qId] = r.value;
                });

                const elapsedSeconds = Math.round((Date.now() - startTime) / 1000);
                const payload = {
                    categoryId: @(Model.CategoryId.HasValue ? Model.CategoryId.Value.ToString() : "null"),
                    examTitle: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExamTitle)),
                    elapsedSeconds: elapsedSeconds,
                    answers: answers
                };

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                try {
                    const response = await fetch('/Exam/Submit', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(payload)
                    });

                    const res = await response.json();
                    if (res.success && res.redirectUrl) {
                        window.location.href = res.redirectUrl;
                    } else {
                        alert(res.message || 'Có lỗi khi nộp bài thi.');
                        btnConfirmSubmit.disabled = false;
                        if (submitSpinner) submitSpinner.classList.add('d-none');
                    }
                } catch (e) {
                    console.error(e);
                    alert('Lỗi kết nối máy chủ khi nộp bài.');
                    btnConfirmSubmit.disabled = false;
                    if (submitSpinner) submitSpinner.classList.add('d-none');
                }
            }
        });
    </script>
}
