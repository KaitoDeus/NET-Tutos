@model NET_Tutos.Models.ViewModels.ProjectListViewModel
@using NET_Tutos.Models.Entities
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Capstone Projects - NET-Tutos" : "Đồ Án Thực Chiến Capstone - NET-Tutos";
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="position-relative overflow-hidden p-4 p-md-5 mb-4 rounded-4 bg-gradient-primary-subtle border shadow-sm">
        <div class="position-absolute end-0 top-50 translate-middle-y opacity-10 pe-4 d-none d-lg-block">
            <i class="bi bi-folder-check text-primary" style="font-size: 14rem;"></i>
        </div>
        <div class="position-relative" style="max-width: 800px;">
            <div class="mb-2">
                <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-semibold">
                    <i class="bi bi-mortarboard-fill me-1"></i> @(isEn ? "CAPSTONE PROJECTS" : "ĐỒ ÁN THỰC CHIẾN CAPSTONE")
                </span>
            </div>
            <h1 class="display-6 fw-bold text-gradient-primary mb-2">
                @(isEn ? "Real-World .NET & C# Projects" : "Dự Án Thực Chiến .NET & C#")
            </h1>
            <p class="text-body-secondary lead fs-6 mb-3">
                @(isEn ? "Turn knowledge into enterprise-standard production applications. Design architectures, write Clean Code, submit GitHub repositories, and receive thorough code reviews." : "Hiện thực hóa kiến thức vào các sản phẩm thực tế chuẩn doanh nghiệp. Thiết kế kiến trúc, tổ chức mã nguồn sạch (Clean Code), nộp kho lưu trữ GitHub và nhận đánh giá Code Review chuyên sâu từ Giảng viên.")
            </p>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <span class="badge bg-body-tertiary text-body border rounded-pill px-3 py-1.5">
                    <i class="bi bi-folder me-1 text-primary"></i> @(isEn ? $"{Model.TotalProjects} Capstone projects" : $"{Model.TotalProjects} Đề tài thực chiến")
                </span>
                <span class="badge bg-body-tertiary text-body border rounded-pill px-3 py-1.5">
                    <i class="bi bi-award-fill me-1 text-warning"></i> @(isEn ? "Earn up to 350 XP / project" : "Thưởng lên tới 350 XP / Đồ án")
                </span>
                <span class="badge bg-body-tertiary text-body border rounded-pill px-3 py-1.5">
                    <i class="bi bi-patch-check-fill me-1 text-success"></i> @(isEn ? "Earn \".NET Architect\" badge" : "Nhận huy hiệu \"Kiến Trúc Sư .NET\"")
                </span>
            </div>
        </div>
    </div>

    <!-- Student Stats Bar (If authenticated) -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-body">
            <div class="card-body p-3 p-md-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-7">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center p-3" style="width: 52px; height: 52px;">
                                <i class="bi bi-person-workspace fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">@(isEn ? "Your Capstone Progress" : "Tiến Độ Làm Đồ Án Của Bạn")</h6>
                                <p class="text-body-secondary small mb-0">
                                    @(isEn ? "Completed" : "Đã hoàn thành") <strong class="text-success">@Model.UserCompletedCount</strong> @(isEn ? "projects • Pending review" : "đồ án • Đang chờ duyệt") <strong class="text-warning">@Model.UserPendingCount</strong> @(isEn ? "• Total earned" : "• Đã tích lũy") <strong class="text-primary">+@Model.UserTotalEarnedXp XP</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5 text-md-end">
                        <a asp-action="MyProjects" class="btn btn-outline-primary rounded-pill px-3 py-2 btn-sm fw-semibold">
                            <i class="bi bi-list-check me-1"></i> @(isEn ? "View my projects" : "Xem đồ án của tôi")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filter Pills -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 pb-2 border-bottom">
        <ul class="nav nav-pills gap-1.5 flex-nowrap overflow-x-auto pb-1" style="scrollbar-width: thin;">
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 small fw-semibold @(Model.SelectedCategoryId == null && Model.SelectedLevel == null ? "active" : "text-body-secondary")"
                   asp-action="Index">
                    @(isEn ? "All topics" : "Tất cả đề tài")
                </a>
            </li>
            @foreach (var cat in Model.Categories)
            {
                <li class="nav-item">
                    <a class="nav-link rounded-pill px-3 py-1.5 small fw-semibold @(Model.SelectedCategoryId == cat.Id ? "active" : "text-body-secondary")"
                       asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-level="@Model.SelectedLevel">
                        @cat.Name
                    </a>
                </li>
            }
        </ul>

        <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill px-3 py-1.5" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-funnel me-1"></i>
                @(Model.SelectedLevel switch
                {
                    DifficultyLevel.Beginner => isEn ? "Level: Beginner" : "Cấp độ: Cơ bản",
                    DifficultyLevel.Intermediate => isEn ? "Level: Intermediate" : "Cấp độ: Trung cấp",
                    DifficultyLevel.Advanced => isEn ? "Level: Advanced" : "Cấp độ: Nâng cao",
                    _ => isEn ? "Difficulty: All" : "Độ khó: Tất cả"
                })
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border rounded-3">
                <li><a class="dropdown-item" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId">@(isEn ? "All levels" : "Tất cả cấp độ")</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-level="@DifficultyLevel.Beginner">@(isEn ? "Beginner" : "Cơ bản (Beginner)")</a></li>
                <li><a class="dropdown-item" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-level="@DifficultyLevel.Intermediate">@(isEn ? "Intermediate" : "Trung cấp (Intermediate)")</a></li>
                <li><a class="dropdown-item" asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-level="@DifficultyLevel.Advanced">@(isEn ? "Advanced" : "Nâng cao (Advanced)")</a></li>
            </ul>
        </div>
    </div>

    <!-- Projects Grid -->
    @if (!Model.Projects.Any())
    {
        <div class="text-center py-5">
            <div class="rounded-circle bg-body-tertiary p-4 d-inline-block mb-3">
                <i class="bi bi-folder-x text-body-secondary" style="font-size: 3rem;"></i>
            </div>
            <h5 class="fw-bold">@(isEn ? "No matching projects found" : "Chưa tìm thấy đồ án phù hợp")</h5>
            <p class="text-body-secondary">@(isEn ? "Try selecting a different filter or return to all topics." : "Hãy thử chọn bộ lọc khác hoặc quay lại danh sách tất cả đề tài.")</p>
            <a asp-action="Index" class="btn btn-primary rounded-pill px-4">@(isEn ? "View all" : "Xem tất cả")</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model.Projects)
            {
                var levelBadgeClass = p.Level switch
                {
                    DifficultyLevel.Beginner => "bg-success bg-opacity-10 text-success border-success border-opacity-25",
                    DifficultyLevel.Intermediate => "bg-warning bg-opacity-10 text-warning border-warning border-opacity-25",
                    DifficultyLevel.Advanced => "bg-danger bg-opacity-10 text-danger border-danger border-opacity-25",
                    _ => "bg-secondary bg-opacity-10 text-secondary border-secondary border-opacity-25"
                };

                var levelText = p.Level switch
                {
                    DifficultyLevel.Beginner => isEn ? "Beginner" : "Cơ bản",
                    DifficultyLevel.Intermediate => isEn ? "Intermediate" : "Trung cấp",
                    DifficultyLevel.Advanced => isEn ? "Advanced" : "Nâng cao",
                    _ => isEn ? "All levels" : "Mọi cấp độ"
                };

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden d-flex flex-column bg-body transition-hover">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Top meta row -->
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                                <span class="badge border rounded-pill px-2.5 py-1 small fw-semibold @levelBadgeClass">
                                    <i class="bi bi-bar-chart-fill me-1"></i> @levelText
                                </span>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1 small fw-semibold">
                                    <i class="bi bi-award-fill me-1 text-warning"></i> +@p.RewardXp XP
                                </span>
                            </div>

                            <!-- Title -->
                            <h5 class="card-title fw-bold mb-2">
                                <a asp-action="Details" asp-route-slug="@p.Slug" class="text-decoration-none text-body-emphasis stretched-link-hover">
                                    @p.GetProjectTitle(isEn)
                                </a>
                            </h5>

                            <!-- Description -->
                            <p class="card-text text-body-secondary small flex-grow-1 mb-3" style="line-height: 1.6;">
                                @p.GetProjectShortDesc(isEn)
                            </p>

                            <!-- Tech Stack Pills -->
                            <div class="mb-3">
                                <div class="text-body-secondary small fw-semibold mb-1.5">
                                    <i class="bi bi-stack me-1"></i> @(isEn ? "Tech stack:" : "Công nghệ:")
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var tech in p.TechStack.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Take(4))
                                    {
                                        <span class="badge bg-body-tertiary text-body border rounded-2 px-2 py-1 small" style="font-size: 0.75rem;">
                                            @tech
                                        </span>
                                    }
                                </div>
                            </div>

                            <hr class="my-3 opacity-25">

                            <!-- Bottom Row: Submissions status & Time -->
                            <div class="d-flex align-items-center justify-content-between text-body-secondary small mb-3">
                                <span>
                                    <i class="bi bi-clock me-1 text-info"></i> @(isEn ? $"~{p.EstimatedHours} hours" : $"~{p.EstimatedHours} giờ làm")
                                </span>
                                <span>
                                    <i class="bi bi-people me-1"></i> @(isEn ? $"{p.TotalSubmissions} submissions" : $"{p.TotalSubmissions} lượt nộp")
                                </span>
                            </div>

                            <!-- Student Status Pill (if submitted) -->
                            @if (p.UserSubmissionStatus.HasValue)
                            {
                                <div class="mb-3">
                                    @if (p.UserSubmissionStatus == ProjectSubmissionStatus.Approved)
                                    {
                                        <div class="alert alert-success py-1.5 px-3 mb-0 rounded-3 small d-flex align-items-center justify-content-between border-0">
                                            <span><i class="bi bi-check-circle-fill me-1"></i> @(isEn ? "Passed" : "Đã đạt chuẩn")</span>
                                            <strong class="badge bg-success">@p.UserSubmissionScore / 100</strong>
                                        </div>
                                    }
                                    else if (p.UserSubmissionStatus == ProjectSubmissionStatus.NeedsImprovement)
                                    {
                                        <div class="alert alert-warning py-1.5 px-3 mb-0 rounded-3 small border-0">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @(isEn ? "Needs revision based on feedback" : "Cần sửa lại theo góp ý")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-info py-1.5 px-3 mb-0 rounded-3 small border-0">
                                            <i class="bi bi-hourglass-split me-1"></i> @(isEn ? "Pending instructor review" : "Đang chờ giảng viên chấm")
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Action button -->
                            <a asp-action="Details" asp-route-slug="@p.Slug" class="btn btn-outline-primary rounded-pill w-100 fw-semibold py-2">
                                <i class="bi bi-box-arrow-up-right me-1"></i> @(isEn ? "View details & Submit" : "Xem chi tiết & Nộp bài")
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
