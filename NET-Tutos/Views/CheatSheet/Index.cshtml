@model IEnumerable<NET_Tutos.Models.Entities.CodeSnippet>
@{
    ViewData["Title"] = "Tra cứu Code";
    var currentCat = ViewBag.SelectedCategory as string;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill fw-bold mb-2">Cheat Sheet & Snippets</span>
        <h1 class="display-5 fw-extrabold text-body-emphasis">Tra Cứu Cú Pháp C# & .NET Thực Chiến</h1>
        <p class="lead text-muted mx-auto" style="max-width: 700px;">
            Tổng hợp các đoạn code mẫu chuẩn mực thường gặp trong các dự án thực tế giúp bạn tra cứu nhanh và tái sử dụng khi lập trình.
        </p>
    </div>

    <!-- Filter Buttons -->
    <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
        <a asp-action="Index" class="btn btn-sm @(string.IsNullOrEmpty(currentCat) ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
            Tất cả
        </a>
        <a asp-action="Index" asp-route-category="C# Core" class="btn btn-sm @(currentCat == "C# Core" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
            C# Core & LINQ
        </a>
        <a asp-action="Index" asp-route-category="Entity Framework" class="btn btn-sm @(currentCat == "Entity Framework" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
            Entity Framework Core
        </a>
        <a asp-action="Index" asp-route-category="ASP.NET Core" class="btn btn-sm @(currentCat == "ASP.NET Core" ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
            ASP.NET Core & API
        </a>
    </div>

    <!-- Snippets Grid -->
    <div class="row g-4">
        @foreach (var snippet in Model)
        {
            <div class="col-lg-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 bg-body overflow-hidden">
                    <div class="card-header bg-body-tertiary d-flex align-items-center justify-content-between p-3 border-bottom">
                        <div>
                            <span class="badge bg-primary bg-opacity-10 text-primary border small me-2">@snippet.CategoryName</span>
                            <span class="fw-bold">@snippet.Title</span>
                        </div>
                        <span class="text-muted small font-monospace">@snippet.Language</span>
                    </div>
                    <div class="card-body p-3">
                        <p class="text-muted small mb-2">@snippet.Description</p>
                        <pre class="m-0 rounded-3"><code class="language-@snippet.Language">@snippet.Code</code></pre>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

