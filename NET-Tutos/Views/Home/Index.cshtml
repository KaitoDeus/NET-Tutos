@model NET_Tutos.Models.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Localization
@using NET_Tutos.Services
@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Home" : "Trang chủ";
}

<!-- Hero Section (Inspired by Microsoft Learn .NET) -->
<section class="hero-learn-dotnet mb-5">
    <div class="container">
        <!-- Top Centered Header -->
        <div class="text-center mb-4 mb-md-5">
            <h1 class="hero-title fw-extrabold text-gradient-purple mb-2 mb-md-3">
                @(isEn ? "Master Modern .NET" : "Học Lập Trình .NET")
            </h1>
            <p class="hero-lead text-body-secondary mx-auto" style="max-width: 820px;">
                @(isEn ? "Free tutorials, video guides, code sandboxes, and learning roadmaps from fundamentals to advanced enterprise architecture for all .NET developers." : "Kho khóa học, video, bài hướng dẫn và lộ trình học tập miễn phí từ cơ bản đến nâng cao dành cho mọi lập trình viên .NET.")
            </p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="row justify-content-center mb-4">
                <div class="col-xl-11">
                    <div class="card border-0 bg-primary bg-opacity-10 rounded-4 p-3 p-md-4 shadow-sm">
                        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-primary text-white p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                                    <i class="bi bi-mortarboard fs-4"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h5 class="fw-bold mb-0">@(isEn ? "Welcome" : "Xin chào"), @(User.Identity.Name?.Split('@')[0] ?? (isEn ? "Learner" : "Học viên"))! 👋</h5>
                                        <span class="badge bg-warning text-dark rounded-pill fw-semibold">
                                            <i class="bi bi-lightning-charge-fill text-danger me-1"></i>@(Model.UserExperiencePoints ?? 0) XP
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-0 mt-1">
                                        @(isEn ? "You have completed" : "Bạn đã hoàn thành") <strong>@(Model.CompletedLessonsCount ?? 0)</strong> @(isEn ? "lessons on the platform." : "bài học trên hệ thống.")
                                    </p>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (Model.LastAccessedTutorial != null)
                                {
                                    <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@Model.LastAccessedTutorial.GetSlug(isEn)" 
                                       class="btn btn-primary rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm text-truncate" style="max-width: 320px;">
                                        <i class="bi bi-play-circle-fill"></i>
                                        <span class="text-truncate">@(isEn ? "Continue:" : "Học tiếp:") @Model.LastAccessedTutorial.GetTitle(isEn)</span>
                                    </a>
                                }
                                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
                                    <i class="bi bi-person-lines-fill me-1"></i> @(isEn ? "Dashboard" : "Góc học tập")
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Spotlight Showcase Card -->
        <div class="row justify-content-center">
            <div class="col-xl-11">
                <div class="card spotlight-card rounded-4 overflow-hidden border">
                    <div class="card-body p-3 p-md-4 p-lg-5">
                        <div class="row g-4 g-lg-5 align-items-center">
                            <!-- Left: Video Thumbnail Card -->
                            <div class="col-lg-6">
                                <div class="video-preview-wrapper" data-bs-toggle="modal" data-bs-target="#videoModal" title="@(isEn ? "Watch .NET intro video" : "Xem video giới thiệu .NET")">
                                    <!-- High-tech Vector Graphic representing What is .NET video -->
                                    <svg viewBox="0 0 640 380" class="w-100 h-100" xmlns="http://www.w3.org/2000/svg">
                                        <!-- Background with subtle grid -->
                                        <rect width="640" height="380" fill="#f8f9fc" />
                                        <defs>
                                            <pattern id="grid" width="30" height="30" patternUnits="userSpaceOnUse">
                                                <path d="M 30 0 L 0 0 0 30" fill="none" stroke="#e6e8f0" stroke-width="0.8" />
                                            </pattern>
                                        </defs>
                                        <rect width="640" height="380" fill="url(#grid)" />

                                        <!-- Top Left Badge -->
                                        <rect x="36" y="32" width="60" height="24" rx="4" fill="#0d6efd" />
                                        <text x="66" y="48" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="bold" fill="#ffffff" text-anchor="middle">.NET</text>
                                        <text x="108" y="48" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="600" fill="#495057">@(isEn ? "What is .NET Video" : "Video giới thiệu .NET")</text>
                                        
                                        <rect x="36" y="62" width="@(isEn ? 115 : 135)" height="20" rx="4" fill="#512bd4" />
                                        <text x="@(isEn ? 93 : 103)" y="76" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="bold" fill="#ffffff" text-anchor="middle">@(isEn ? "FOR BEGINNERS" : "CHO NGƯỜI MỚI")</text>

                                        <!-- Main Title -->
                                        <text x="36" y="160" font-family="'Plus Jakarta Sans', sans-serif" font-size="44" font-weight="800" fill="#1e1e38" letter-spacing="-1">@(isEn ? "What is .NET?" : ".NET là gì?")</text>

                                        <!-- 3D Isometric .NET Cubes (Microsoft Style) -->
                                        <!-- Top Gold Cube -->
                                        <g transform="translate(460, 40)">
                                            <polygon points="40,25 75,5 110,25 75,45" fill="#fde68a" />
                                            <polygon points="40,25 75,45 75,85 40,65" fill="#f59e0b" />
                                            <polygon points="75,45 110,25 110,65 75,85" fill="#d97706" />
                                        </g>
                                        <!-- Big Purple Cube -->
                                        <g transform="translate(420, 105)">
                                            <polygon points="50,30 95,5 140,30 95,55" fill="#c084fc" />
                                            <polygon points="50,30 95,55 95,110 50,85" fill="#9333ea" />
                                            <polygon points="95,55 140,30 140,85 95,110" fill="#7e22ce" />
                                        </g>
                                        <!-- Left Indigo Cube -->
                                        <g transform="translate(350, 165)">
                                            <polygon points="35,20 65,5 95,20 65,35" fill="#818cf8" />
                                            <polygon points="35,20 65,35 65,70 35,55" fill="#4f46e5" />
                                            <polygon points="65,35 95,20 95,55 65,70" fill="#3730a3" />
                                        </g>
                                        <!-- Bottom Floating Cube -->
                                        <g transform="translate(380, 260)">
                                            <polygon points="30,18 55,5 80,18 55,31" fill="#a855f7" />
                                            <polygon points="30,18 55,31 55,60 30,47" fill="#7e22ce" />
                                            <polygon points="55,31 80,18 80,47 55,60" fill="#6b21a8" />
                                        </g>
                                    </svg>

                                    <!-- Dark YouTube-style Play Button -->
                                    <div class="video-play-btn">
                                        <i class="bi bi-play-fill"></i>
                                    </div>

                                    <!-- Speaker Avatar Tag -->
                                    <div class="speaker-badge">
                                        <span class="badge rounded-circle bg-primary p-1 text-white" style="width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;">
                                            <i class="bi bi-person-fill" style="font-size:11px"></i>
                                        </span>
                                        <span>@(isEn ? "Authored by .NET Tutos" : "Biên soạn bởi .NET Tutos")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Information & Action Links -->
                            <div class="col-lg-6">
                                <h2 class="h3 fw-extrabold text-body-emphasis mb-3">
                                    @(isEn ? "What is .NET?" : ".NET là gì?")
                                </h2>

                                <p class="lead text-body-secondary fs-6 mb-3">
                                    <strong>.NET</strong> @(isEn ? "is a free, cross-platform (runs smoothly on Windows, Linux, and macOS), open-source developer platform by Microsoft for building all types of high-quality applications." : "là nền tảng phát triển miễn phí, đa nền tảng (chạy mượt mà trên Windows, Linux và macOS) và mã nguồn mở của Microsoft để xây dựng mọi thể loại ứng dụng chất lượng cao.")
                                </p>

                                <p class="text-body-secondary small mb-4">
                                    @(isEn ? "With .NET, you can code in C#, leverage industry-standard tools like Visual Studio, VS Code, and a rich ecosystem to build Web, Mobile, Desktop, Cloud, Gaming, IoT, and AI applications." : "Với .NET, bạn có thể lập trình bằng C#, sử dụng các công cụ mạnh mẽ như Visual Studio, VS Code và kho thư viện đồ sộ để phát triển ứng dụng Web, Di động, Desktop, Đám mây, Game, IoT và Trí tuệ nhân tạo (AI).")
                                </p>

                                <div class="d-flex flex-column gap-2 mb-4">
                                    <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@(isEn ? "dotnet-ecosystem-overview-and-environment-setup" : "tong-quan-he-sinh-thai-dotnet-cai-dat-moi-truong")"
                                       class="hero-feature-link text-primary fw-bold text-decoration-none d-inline-flex align-items-center">
                                        <span>@(isEn ? "Start learning now with Lesson 1 (Overview & Setup)" : "Bắt đầu học ngay với Bài 1 (Tổng quan & Cài đặt)")</span>
                                        <i class="bi bi-arrow-right ms-2 fs-5"></i>
                                    </a>
                                    <a asp-controller="Roadmap" asp-action="Index"
                                       class="hero-feature-link text-body-secondary fw-semibold text-decoration-none d-inline-flex align-items-center">
                                        <span>@(isEn ? "Explore complete 4-Stage Learning Roadmap" : "Xem toàn bộ Lộ trình học 4 Giai đoạn")</span>
                                        <i class="bi bi-arrow-right ms-2"></i>
                                    </a>
                                    <a asp-controller="Quiz" asp-action="Index"
                                       class="hero-feature-link text-success fw-semibold text-decoration-none d-inline-flex align-items-center">
                                        <span>@(isEn ? "Take .NET Knowledge Assessment Quiz" : "Thi trắc nghiệm đánh giá kiến thức .NET")</span>
                                        <i class="bi bi-arrow-right ms-2"></i>
                                    </a>
                                </div>

                                <div class="pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2 text-muted small">
                                    <span class="d-inline-flex align-items-center gap-1.5">
                                        <i class="bi bi-database-check text-success"></i>
                                        <span>@(isEn ? "Database:" : "CSDL:") <strong class="text-body-emphasis">@Model.DatabaseProviderUsed</strong></span>
                                    </span>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Roadmap" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-signpost-split me-1"></i> @(isEn ? "Roadmap" : "Lộ trình")
                                        </a>
                                        <a asp-controller="CheatSheet" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-code-square me-1"></i> @(isEn ? "Code Reference" : "Tra cứu Code")
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Video Modal -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden bg-dark text-white">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="videoModalLabel">
                    <i class="bi bi-play-circle-fill text-danger me-2"></i>@(isEn ? "What is .NET? (Introduction to .NET for Beginners)" : ".NET là gì? (Nhập môn .NET cho người mới bắt đầu)")
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="ratio ratio-16x9 rounded-3 overflow-hidden">
                    <iframe id="videoIframe" src="https://www.youtube.com/embed/6BcPIvVfVAw?enablejsapi=1" title=".NET cho người mới bắt đầu" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 d-flex justify-content-between align-items-center">
                <a href="https://www.youtube.com/watch?v=6BcPIvVfVAw" target="_blank" rel="noopener noreferrer" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-youtube me-1"></i> @(isEn ? "Watch on YouTube" : "Xem trên YouTube")
                </a>
                <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@(isEn ? "dotnet-ecosystem-overview-and-environment-setup" : "tong-quan-he-sinh-thai-dotnet-cai-dat-moi-truong")" class="btn btn-primary fw-semibold">
                    @(isEn ? "Read Full Lesson 1" : "Đọc Bài 1 Đầy Đủ") <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Stats Bar -->
<div class="container mb-5">
    <div class="row g-4 text-center">
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-body-tertiary border">
                <div class="display-6 fw-bold text-primary mb-1">@Model.TotalCategories</div>
                <div class="text-muted small fw-semibold">@(isEn ? "Learning Topics" : "Chuyên đề học tập")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-body-tertiary border">
                <div class="display-6 fw-bold text-success mb-1">@Model.TotalTutorials</div>
                <div class="text-muted small fw-semibold">@(isEn ? "In-depth Tutorials" : "Bài học chi tiết")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-body-tertiary border">
                <div class="display-6 fw-bold text-warning mb-1">@Model.TotalQuizzes</div>
                <div class="text-muted small fw-semibold">@(isEn ? "Quiz Questions" : "Câu hỏi trắc nghiệm")</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 rounded-4 bg-body-tertiary border">
                <div class="display-6 fw-bold text-info mb-1">100%</div>
                <div class="text-muted small fw-semibold">@(isEn ? "Production Code" : "Mã nguồn thực tế")</div>
            </div>
        </div>
    </div>
</div>

<!-- Category Tracks Section -->
<section class="container mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">@(isEn ? "4 Stages to Master .NET" : "4 Giai Đoạn Làm Chủ .NET")</h2>
        <p class="text-muted">@(isEn ? "Engineered in clear modules to help you advance step-by-step with confidence" : "Được thiết kế theo cấu trúc module rõ ràng giúp bạn đi từng bước vững chắc")</p>
    </div>

    <div class="row g-4">
        @foreach (var cat in Model.Categories)
        {
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 card-hover rounded-4 p-3 bg-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge bg-@cat.BadgeColor p-2 px-3 rounded-pill">
                            @LocalizationHelper.GetDifficultyName(cat.Level, isEn)
                        </span>
                        <div class="fs-2 text-@cat.BadgeColor">
                            <i class="bi @cat.IconClass"></i>
                        </div>
                    </div>
                    <h5 class="fw-bold mb-2">@cat.GetTitle(isEn)</h5>
                    <p class="text-muted small flex-grow-1">@cat.GetDesc(isEn)</p>
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-2">
                        <span class="text-muted small">
                            <i class="bi bi-file-earmark-text me-1"></i> @cat.Tutorials.Count @(isEn ? "lessons" : "bài học")
                        </span>
                        <a asp-controller="Tutorials" asp-action="Index" asp-route-category="@cat.GetSlug(isEn)" class="btn btn-sm btn-outline-@cat.BadgeColor rounded-pill">
                            @(isEn ? "Start Learning" : "Vào học") <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Featured Tutorials -->
<section class="container mb-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">@(isEn ? "Featured Tutorials" : "Bài Học Tiêu Biểu")</h2>
            <p class="text-muted mb-0">@(isEn ? "Core guides you shouldn't miss" : "Các bài hướng dẫn cốt lõi bạn không nên bỏ lỡ")</p>
        </div>
        <a asp-controller="Tutorials" asp-action="Index" class="btn btn-outline-primary">
            @(isEn ? "View all tutorials" : "Xem tất cả bài học") <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model.FeaturedTutorials)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 card-hover rounded-4 bg-body">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-primary border small">@item.Category.GetTitle(isEn)</span>
                            <span class="text-muted small ms-auto">
                                <i class="bi bi-clock me-1"></i>@item.EstimatedReadingMinutes @(isEn ? "mins" : "phút")
                            </span>
                        </div>
                        <h5 class="card-title fw-bold mb-2">
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="text-decoration-none text-body-emphasis">
                                @item.GetTitle(isEn)
                            </a>
                        </h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @item.GetSummary(isEn)
                        </p>
                        <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-3">
                            <span class="badge bg-@item.Category?.BadgeColor bg-opacity-10 text-@item.Category?.BadgeColor">
                                @LocalizationHelper.GetDifficultyName(item.Difficulty, isEn)
                            </span>
                            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@item.GetSlug(isEn)" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold">
                                @(isEn ? "Read article" : "Đọc bài viết") <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Community Activity Pulse Section -->
@if (Model.RecentActivities.Any())
{
    <section class="container mb-5">
        <div class="card border-0 rounded-4 shadow-sm bg-body-tertiary p-4 p-md-4.5">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-activity fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">@(isEn ? "Community Learning Pulse" : "Hoạt Động Học Tập Cộng Đồng")</h4>
                        <span class="text-muted small">@(isEn ? "Real-time updates on learners' achievements" : "Cập nhật thời gian thực những bước tiến của học viên")</span>
                    </div>
                </div>
                <a asp-controller="Activity" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold">
                    @(isEn ? "View full activity feed" : "Xem toàn bộ bảng tin") <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            <div class="row g-3">
                @foreach (var act in Model.RecentActivities)
                {
                    <div class="col-md-6">
                        <div class="card border rounded-4 bg-body p-3 h-100 shadow-xs transition-hover">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle bg-@act.TypeBadgeColor bg-opacity-10 text-@act.TypeBadgeColor fw-bold d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width: 42px; height: 42px;">
                                    <i class="bi @act.IconClass fs-5"></i>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                        <div class="text-truncate">
                                            <strong class="text-body-emphasis">@act.UserDisplayName</strong>
                                            <span class="text-muted small">@act.Title</span>
                                        </div>
                                        <span class="text-muted small text-nowrap"><i class="bi bi-clock me-1"></i>@act.TimeAgo</span>
                                    </div>
                                    <div class="text-truncate mt-0.5">
                                        @if (!string.IsNullOrEmpty(act.TargetUrl))
                                        {
                                            <a href="@act.TargetUrl" class="text-decoration-none small fw-semibold text-primary">
                                                @act.Description
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@act.Description</span>
                                        }
                                    </div>
                                </div>
                                @if (act.XpEarned > 0)
                                {
                                    <span class="badge bg-warning bg-opacity-15 text-dark border border-warning border-opacity-25 rounded-pill px-2 py-1 small fw-bold">
                                        +@act.XpEarned XP
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Capstone Project Highlight Section -->
<section class="container mb-5">
    <div class="card border-0 rounded-4 shadow-sm bg-body overflow-hidden p-4 p-md-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-1.5 fw-semibold mb-3">
                    <i class="bi bi-mortarboard-fill me-1 text-warning"></i> @(isEn ? "CAPSTONE REAL-WORLD PROJECT" : "DỰ ÁN THỰC CHIẾN CAPSTONE")
                </span>
                <h2 class="display-6 fw-bold mb-3">@(isEn ? "Master Enterprise Architecture with Production Projects" : "Làm Chủ Kiến Trúc Doanh Nghiệp Với Đồ Án Thực Tế")</h2>
                <p class="text-body-secondary lead fs-6 mb-4">
                    @(isEn ? "Tackle production-grade scenarios: Build RESTful Web APIs, Clean Architecture & CQRS, and real-time systems with SignalR. Submit GitHub repos for direct Instructor Code Review and earn the .NET Architect badge." : "Thử sức với các đề tài chuẩn nghiệp vụ: Xây dựng RESTful Web API, Clean Architecture & CQRS, Hệ thống thời gian thực với SignalR. Nộp mã nguồn GitHub để Giảng viên Code Review trực tiếp và nhận huy hiệu Kiến Trúc Sư .NET.")
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Project" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                        <i class="bi bi-folder-check me-1.5"></i> @(isEn ? "Explore Capstone Topics" : "Khám phá các đề tài đồ án")
                    </a>
                    <a asp-controller="Leaderboard" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-semibold">
                        <i class="bi bi-trophy me-1.5"></i> @(isEn ? "Learner Hall of Fame" : "Bảng vinh danh học viên")
                    </a>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="p-4 rounded-4 bg-body-tertiary border d-inline-block text-start shadow-sm w-100" style="max-width: 420px;">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                        <span class="fw-bold small text-body-secondary"><i class="bi bi-patch-check-fill text-success me-1"></i> @(isEn ? "REVIEW STANDARDS" : "TIÊU CHUẨN REVIEW")</span>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill">100 @(isEn ? "pts" : "điểm")</span>
                    </div>
                    <div class="small mb-2 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-check2 text-primary me-1.5"></i> Clean Architecture & SOLID</span>
                        <strong class="text-primary">40%</strong>
                    </div>
                    <div class="small mb-2 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-check2 text-success me-1.5"></i> @(isEn ? "Business Logic & Entity Framework Core" : "Nghiệp vụ & Entity Framework Core")</span>
                        <strong class="text-success">30%</strong>
                    </div>
                    <div class="small mb-2 d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-check2 text-warning me-1.5"></i> @(isEn ? "Exception Handling & Security" : "Exception Handling & Bảo mật")</span>
                        <strong class="text-warning">15%</strong>
                    </div>
                    <div class="small d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-check2 text-info me-1.5"></i> Unit Testing & Swagger Docs</span>
                        <strong class="text-info">15%</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<div class="container mb-5">
    <div class="p-4 p-md-5 rounded-4 bg-gradient-dotnet text-white text-center shadow-lg">
        <h2 class="fs-2 fw-bold mb-3">@(isEn ? "Are You Ready to Master Modern .NET?" : "Bạn Đã Sẵn Sàng Trở Thành Lập Trình Viên .NET?")</h2>
        <p class="lead mb-4 opacity-90 mx-auto" style="max-width: 680px;">
            @(isEn ? "Start from your first C# lines of code and step-by-step master Microsoft's cutting-edge application platform." : "Hãy bắt đầu từ những dòng lệnh C# đầu tiên và từng bước làm chủ toàn bộ nền tảng phát triển ứng dụng hiện đại của Microsoft.")
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Tutorials" asp-action="Details" asp-route-slug="@(isEn ? "dotnet-ecosystem-overview-and-environment-setup" : "tong-quan-he-sinh-thai-dotnet-cai-dat-moi-truong")" class="btn btn-light btn-lg fw-bold text-primary px-4 shadow">
                <i class="bi bi-play-circle-fill me-2"></i> @(isEn ? "Start Lesson 1 Now" : "Bắt đầu Bài 1 ngay")
            </a>
            <a asp-controller="CheatSheet" asp-action="Index" class="btn btn-outline-light btn-lg fw-semibold px-4">
                <i class="bi bi-code-square me-2"></i> @(isEn ? "Syntax Cheatsheet" : "Bảng Tra Cứu Cú Pháp")
            </a>
        </div>
    </div>
</div>
