@model NET_Tutos.Models.ViewModels.TutorialEditViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa: {Model.Title}";
}

<div class="container-fluid px-3 px-xl-4 py-4">
    <partial name="_AdminNav" />

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Quản trị</a></li>
                    <li class="breadcrumb-item"><a asp-controller="AdminTutorials" asp-action="Index">Bài học</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
                </ol>
            </nav>
            <h3 class="fw-bold mb-0">Chỉnh sửa: @Model.Title</h3>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Tutorials" asp-action="Detail" asp-route-slug="@Model.Slug" target="_blank" class="btn btn-outline-primary rounded-pill px-3">
                <i class="bi bi-box-arrow-up-right me-1"></i> Xem trang bài học
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
            </a>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <partial name="_TutorialForm" model="Model" />
    </form>
</div>
