@model IEnumerable<NET_Tutos.Models.Entities.Tutorial>
@{
    ViewData["Title"] = "Quản lý Bài học CMS";
    var categories = ViewBag.Categories as IEnumerable<NET_Tutos.Models.Entities.Category> ?? Enumerable.Empty<NET_Tutos.Models.Entities.Category>();
    int? selectedCategory = ViewBag.SelectedCategory;
    string? search = ViewBag.Search;
}

<div class="container-fluid px-3 px-xl-4 py-4">
    <partial name="_AdminNav" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Actions & Filters -->
    <div class="card border-0 shadow-sm rounded-4 bg-body mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-md-5">
                    <form method="get" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-body-secondary border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo tiêu đề hoặc slug..." value="@search" />
                            @if (selectedCategory.HasValue)
                            {
                                <input type="hidden" name="categoryId" value="@selectedCategory.Value" />
                            }
                            <button type="submit" class="btn btn-primary">Tìm</button>
                        </div>
                        @if (!string.IsNullOrEmpty(search) || selectedCategory.HasValue)
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                    </form>
                </div>

                <div class="col-md-7 d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                    <!-- Category Filter Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle rounded-pill px-3 py-2 text-nowrap" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-funnel me-1"></i>
                            @(selectedCategory.HasValue 
                                ? categories.FirstOrDefault(c => c.Id == selectedCategory.Value)?.Name ?? "Chuyên đề" 
                                : "Tất cả chuyên đề")
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                            <li><a class="dropdown-item @(!selectedCategory.HasValue ? "active" : "")" asp-action="Index" asp-route-search="@search">Tất cả chuyên đề</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var cat in categories)
                            {
                                <li>
                                    <a class="dropdown-item @(selectedCategory == cat.Id ? "active" : "")" 
                                       asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-search="@search">
                                        @cat.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Soạn bài học mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tutorials Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-body">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-journal-richtext text-primary me-2"></i> Danh sách bài học (@Model.Count() bài)
            </h5>
        </div>
        <div class="card-body px-4 py-3">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-body-secondary">
                    <i class="bi bi-folder2-open display-4 d-block mb-3 opacity-50"></i>
                    <p class="mb-2">Không tìm thấy bài học nào phù hợp.</p>
                    <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3">Tạo bài học đầu tiên</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Tiêu đề & Đường dẫn (Slug)</th>
                                <th>Chuyên đề</th>
                                <th>Cấp độ</th>
                                <th>Thời lượng</th>
                                <th>Lượt đọc</th>
                                <th class="text-end" style="min-width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-body-secondary fw-semibold">@item.OrderIndex</td>
                                    <td>
                                        <div class="fw-bold d-flex align-items-center gap-2">
                                            <a asp-controller="Tutorials" asp-action="Detail" asp-route-slug="@item.Slug" target="_blank" class="text-decoration-none text-body hover-primary">
                                                @item.Title
                                            </a>
                                            @if (item.IsFeatured)
                                            {
                                                <span class="badge bg-warning bg-opacity-20 text-warning border border-warning-subtle rounded-pill small" title="Nổi bật trên trang chủ">
                                                    <i class="bi bi-star-fill"></i>
                                                </span>
                                            }
                                        </div>
                                        <div class="text-body-secondary small font-monospace">/@item.Slug</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill">
                                            @(item.Category?.Name ?? "Chưa phân loại")
                                        </span>
                                    </td>
                                    <td>
                                        @switch (item.Difficulty)
                                        {
                                            case NET_Tutos.Models.Entities.DifficultyLevel.Beginner:
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill">Cơ bản</span>
                                                break;
                                            case NET_Tutos.Models.Entities.DifficultyLevel.Intermediate:
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill">Trung cấp</span>
                                                break;
                                            case NET_Tutos.Models.Entities.DifficultyLevel.Advanced:
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill">Nâng cao</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-body-secondary small">
                                        <i class="bi bi-clock me-1"></i> @item.EstimatedReadingMinutes phút
                                    </td>
                                    <td class="text-body-secondary small">
                                        <i class="bi bi-eye me-1"></i> @item.ViewCount
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-start-pill px-2.5" title="Chỉnh sửa bài học">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="AdminQuizzes" asp-action="Index" asp-route-tutorialId="@item.Id" class="btn btn-outline-info px-2.5" title="Xem câu hỏi trắc nghiệm của bài học này">
                                                <i class="bi bi-patch-question"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger rounded-end-pill px-2.5" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id" title="Xóa bài học">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-danger">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa bài học
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-start py-3">
                                                        <p class="mb-1">Bạn có chắc chắn muốn xóa bài học sau không?</p>
                                                        <div class="p-3 bg-body-secondary rounded-3 my-2 fw-semibold">
                                                            @item.Title <br />
                                                            <span class="small text-body-secondary font-monospace">Slug: @item.Slug</span>
                                                        </div>
                                                        <small class="text-danger">Lưu ý: Dữ liệu bài học và các tiến độ học viên liên quan sẽ bị xóa vĩnh viễn.</small>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger rounded-pill px-3">Xác nhận xóa</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
