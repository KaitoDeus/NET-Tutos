@model NET_Tutos.Models.ViewModels.ActivityFeedPageViewModel
@{
    ViewData["Title"] = "Bảng tin Hoạt động Cộng đồng";
    var activeFilter = Model.CurrentFilter ?? "";
}

<div class="container py-4 py-md-5">
    <!-- Header Banner -->
    <div class="card border-0 rounded-4 shadow-sm bg-gradient-primary-subtle p-4 p-md-5 mb-4 position-relative overflow-hidden">
        <div class="position-absolute end-0 top-50 translate-middle-y opacity-10 pe-4 d-none d-lg-block">
            <i class="bi bi-activity text-primary" style="font-size: 14rem;"></i>
        </div>
        <div class="position-relative" style="max-width: 800px;">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary text-white rounded-pill px-3 py-1.5 fw-semibold">
                    <i class="bi bi-broadcast me-1"></i> THỜI GIAN THỰC
                </span>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1 small d-inline-flex align-items-center gap-1.5">
                    <span class="live-dot-pulse"></span> Trực tiếp
                </span>
            </div>
            <h1 class="display-6 fw-bold text-gradient-primary mb-2">
                Bảng Tin Hoạt Động Học Tập
            </h1>
            <p class="text-body-secondary lead fs-6 mb-0">
                Khám phá hành trình học tập sôi động của cộng đồng NET-Tutos: bài học vừa hoàn thành, thử thách thuật toán C# đã vượt qua, chuỗi ngọn lửa bùng cháy và chứng chỉ số vừa được cấp.
            </p>
        </div>
    </div>

    <!-- Filter Pills -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 pb-2 border-bottom">
        <ul class="nav nav-pills gap-1.5 flex-nowrap overflow-x-auto pb-1" style="scrollbar-width: thin;">
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 small fw-semibold @(string.IsNullOrEmpty(activeFilter) ? "active" : "text-body-secondary")"
                   asp-action="Index" asp-route-filter="">
                    <i class="bi bi-grid-fill me-1"></i> Tất cả
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 small fw-semibold @(activeFilter == "lesson" ? "active" : "text-body-secondary")"
                   asp-action="Index" asp-route-filter="lesson">
                    <i class="bi bi-journal-check me-1"></i> Bài học
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 small fw-semibold @(activeFilter == "challenge" ? "active" : "text-body-secondary")"
                   asp-action="Index" asp-route-filter="challenge">
                    <i class="bi bi-terminal-fill me-1"></i> Thuật toán
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 small fw-semibold @(activeFilter == "exam" ? "active" : "text-body-secondary")"
                   asp-action="Index" asp-route-filter="exam">
                    <i class="bi bi-patch-check-fill me-1"></i> Thi & Chứng chỉ
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 small fw-semibold @(activeFilter == "badge" ? "active" : "text-body-secondary")"
                   asp-action="Index" asp-route-filter="badge">
                    <i class="bi bi-fire me-1"></i> Huy hiệu & Streak
                </a>
            </li>
        </ul>
        <span class="text-muted small fw-medium">
            Tổng số: <strong>@Model.TotalCount</strong> hoạt động
        </span>
    </div>

    <!-- Feed Content -->
    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">
            <div id="activityFeedTimeline" class="timeline-container d-flex flex-column gap-3">
                @if (Model.Activities.Any())
                {
                    @foreach (var item in Model.Activities)
                    {
                        var initials = !string.IsNullOrWhiteSpace(item.UserDisplayName)
                            ? item.UserDisplayName.Substring(0, 1).ToUpper()
                            : "U";

                        <div class="card border rounded-4 shadow-sm p-3 p-md-3.5 activity-feed-card transition-hover" data-activity-id="@item.Id">
                            <div class="d-flex align-items-start gap-3">
                                <!-- User Avatar or Initials Circle -->
                                <div class="position-relative flex-shrink-0">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center fs-5 shadow-xs"
                                         style="width: 48px; height: 48px;">
                                        @initials
                                    </div>
                                    <span class="position-absolute bottom-0 end-0 translate-middle-y badge rounded-circle bg-@item.TypeBadgeColor text-white p-1 d-flex align-items-center justify-content-center"
                                          style="width: 20px; height: 20px; font-size: 0.65rem;" title="@item.TypeLabel">
                                        <i class="bi @item.IconClass"></i>
                                    </span>
                                </div>

                                <!-- Body -->
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-1">
                                        <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                            <span class="fw-bold text-body-emphasis">@item.UserDisplayName</span>
                                            <span class="text-body-secondary small">@item.Title</span>
                                            <span class="badge bg-@item.TypeBadgeColor bg-opacity-10 text-@item.TypeBadgeColor rounded-pill px-2 py-0.5 small fw-semibold">
                                                @item.TypeLabel
                                            </span>
                                        </div>
                                        <span class="text-muted small text-nowrap">
                                            <i class="bi bi-clock me-1"></i>@item.TimeAgo
                                        </span>
                                    </div>

                                    <!-- Description & Target Link -->
                                    <div class="mt-1">
                                        @if (!string.IsNullOrEmpty(item.TargetUrl))
                                        {
                                            <a href="@item.TargetUrl" class="text-decoration-none fw-semibold text-primary hover-underline">
                                                @item.Description <i class="bi bi-arrow-up-right small"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary fw-medium">@item.Description</span>
                                        }
                                    </div>
                                </div>

                                <!-- XP Reward Badge -->
                                @if (item.XpEarned > 0)
                                {
                                    <div class="flex-shrink-0 text-end">
                                        <span class="badge bg-warning bg-opacity-20 text-dark border border-warning border-opacity-50 rounded-pill px-2.5 py-1.5 fw-bold d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-lightning-charge-fill text-danger"></i> +@item.XpEarned XP
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card border-0 rounded-4 p-5 text-center bg-body-tertiary">
                        <div class="rounded-circle bg-body-secondary text-muted mx-auto mb-3 d-flex align-items-center justify-content-center"
                             style="width: 64px; height: 64px;">
                            <i class="bi bi-clock-history fs-2"></i>
                        </div>
                        <h5 class="fw-bold">Chưa có hoạt động nào trong danh mục này</h5>
                        <p class="text-muted small mb-3">Hãy hoàn thành một bài học hoặc giải thử thách C# để trở thành người đầu tiên xuất hiện tại đây!</p>
                        <div>
                            <a asp-controller="Tutorials" asp-action="Index" class="btn btn-sm btn-primary rounded-pill px-3 py-2 fw-semibold">
                                <i class="bi bi-book-half me-1"></i> Khám phá bài học
                            </a>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4 pt-2 d-flex justify-content-center" aria-label="Phân trang bảng tin">
                    <ul class="pagination pagination-sm">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-pill px-3" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-filter="@activeFilter">
                                <i class="bi bi-chevron-left me-1"></i> Trước
                            </a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link px-3 text-muted">
                                Trang @Model.CurrentPage / @Model.TotalPages
                            </span>
                        </li>
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-end-pill px-3" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-filter="@activeFilter">
                                Tiếp <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
