@model NET_Tutos.Models.ViewModels.LeaderboardViewModel
@{
    ViewData["Title"] = "Bảng Vinh Danh & Hệ Thống Huy Hiệu";
    var top1 = Model.TopUsers.FirstOrDefault(u => u.Rank == 1);
    var top2 = Model.TopUsers.FirstOrDefault(u => u.Rank == 2);
    var top3 = Model.TopUsers.FirstOrDefault(u => u.Rank == 3);
}

<div class="container py-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 fw-semibold mb-3">
            <i class="bi bi-trophy-fill me-1"></i> BẢNG XẾP HẠNG HỌC VIÊN
        </span>
        <h1 class="display-5 fw-bold mb-3">Bảng Vinh Danh & Thành Tựu</h1>
        <p class="lead text-muted mx-auto" style="max-width: 700px;">
            Tôn vinh những học viên xuất sắc nhất trên hành trình chinh phục .NET & C#. Tích lũy kinh nghiệm (XP) qua từng bài học, thử thách thuật toán và đóng góp giải pháp cho cộng đồng!
        </p>
    </div>

    <!-- Current User Status Card (if authenticated) -->
    @if (User.Identity?.IsAuthenticated == true && Model.CurrentUserItem != null)
    {
        <div class="card border-0 shadow-sm bg-primary text-white rounded-4 p-4 mb-5">
            <div class="row align-items-center g-3">
                <div class="col-md-7 d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 56px; height: 56px; font-size: 1.5rem;">
                        @(string.IsNullOrEmpty(Model.CurrentUserItem.FullName) ? "U" : Model.CurrentUserItem.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h4 class="fw-bold mb-0">@Model.CurrentUserItem.FullName</h4>
                            <span class="badge bg-warning text-dark rounded-pill fw-bold">Hạng #@Model.CurrentUserRank</span>
                        </div>
                        <p class="mb-0 text-white-50 small">
                            Tiếp tục hoàn thành bài học và giải thử thách thuật toán để bứt phá thứ hạng!
                        </p>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="row g-2 text-center">
                        <div class="col-4">
                            <div class="bg-white bg-opacity-10 rounded-3 py-2">
                                <div class="fs-4 fw-bold">@Model.CurrentUserItem.ExperiencePoints</div>
                                <div class="small text-white-50">Điểm XP</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white bg-opacity-10 rounded-3 py-2">
                                <div class="fs-4 fw-bold">@Model.CurrentUserItem.CompletedLessonsCount</div>
                                <div class="small text-white-50">Bài học</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white bg-opacity-10 rounded-3 py-2">
                                <div class="fs-4 fw-bold">@Model.CurrentUserItem.CompletedChallengesCount</div>
                                <div class="small text-white-50">Thuật toán</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Top 3 Podium (Bục Vinh Danh) -->
    @if (Model.TopUsers.Any())
    {
        <div class="row g-4 align-items-end justify-content-center mb-5 pt-3">
            <!-- Rank 2: Silver -->
            @if (top2 != null)
            {
                <div class="col-md-4 col-sm-6 order-2 order-md-1">
                    <div class="card border-0 shadow-sm bg-body rounded-4 p-4 text-center position-relative h-100 border-top border-4 border-secondary">
                        <div class="position-absolute top-0 start-50 translate-middle">
                            <span class="badge bg-secondary text-white rounded-pill px-3 py-2 shadow-sm fs-6">
                                <i class="bi bi-award-fill me-1"></i>Hạng 2
                            </span>
                        </div>
                        <div class="mt-3 mb-3">
                            <div class="rounded-circle bg-secondary-subtle text-secondary mx-auto d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 72px; height: 72px; font-size: 1.8rem;">
                                @(string.IsNullOrEmpty(top2.FullName) ? "U" : top2.FullName.Substring(0, 1).ToUpper())
                            </div>
                        </div>
                        <h5 class="fw-bold mb-1 text-truncate">@top2.FullName</h5>
                        <div class="text-primary fw-bold fs-4 mb-2">@top2.ExperiencePoints <span class="fs-6 text-muted">XP</span></div>
                        <div class="d-flex justify-content-center gap-2 small text-muted">
                            <span><i class="bi bi-book me-1"></i>@top2.CompletedLessonsCount bài</span>
                            <span>·</span>
                            <span><i class="bi bi-code-slash me-1"></i>@top2.CompletedChallengesCount code</span>
                        </div>
                    </div>
                </div>
            }

            <!-- Rank 1: Gold -->
            @if (top1 != null)
            {
                <div class="col-md-4 col-sm-8 order-1 order-md-2">
                    <div class="card border-0 shadow-lg bg-body rounded-4 p-4 text-center position-relative h-100 border-top border-4 border-warning scale-highlight podium-rank-1">
                        <div class="position-absolute top-0 start-50 translate-middle">
                            <span class="badge bg-warning text-dark rounded-pill px-4 py-2 shadow-sm fw-bold fs-6">
                                <i class="bi bi-trophy-fill me-1"></i>QUÁN QUÂN #1
                            </span>
                        </div>
                        <div class="mt-4 mb-3">
                            <div class="rounded-circle bg-warning text-dark mx-auto d-flex align-items-center justify-content-center fw-bold shadow" style="width: 88px; height: 88px; font-size: 2.2rem; border: 4px solid #fff;">
                                @(string.IsNullOrEmpty(top1.FullName) ? "U" : top1.FullName.Substring(0, 1).ToUpper())
                            </div>
                        </div>
                        <h4 class="fw-bold mb-1 text-truncate">@top1.FullName</h4>
                        <div class="text-warning-emphasis fw-bold fs-3 mb-2">@top1.ExperiencePoints <span class="fs-6 text-muted">XP</span></div>
                        <div class="d-flex justify-content-center gap-2 small text-muted mb-3">
                            <span><i class="bi bi-book me-1"></i>@top1.CompletedLessonsCount bài học</span>
                            <span>·</span>
                            <span><i class="bi bi-code-slash me-1"></i>@top1.CompletedChallengesCount thuật toán</span>
                        </div>
                        <div class="d-flex justify-content-center gap-1">
                            @foreach (var b in top1.Badges.Take(4))
                            {
                                <span class="badge bg-@b.ColorClass-subtle text-@b.ColorClass border border-@b.ColorClass-subtle rounded-pill" title="@b.Title: @b.Description">
                                    <i class="bi @b.IconClass"></i>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Rank 3: Bronze -->
            @if (top3 != null)
            {
                <div class="col-md-4 col-sm-6 order-3 order-md-3">
                    <div class="card border-0 shadow-sm bg-body rounded-4 p-4 text-center position-relative h-100 border-top border-4 border-danger">
                        <div class="position-absolute top-0 start-50 translate-middle">
                            <span class="badge bg-danger text-white rounded-pill px-3 py-2 shadow-sm fs-6">
                                <i class="bi bi-award-fill me-1"></i>Hạng 3
                            </span>
                        </div>
                        <div class="mt-3 mb-3">
                            <div class="rounded-circle bg-danger-subtle text-danger mx-auto d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 72px; height: 72px; font-size: 1.8rem;">
                                @(string.IsNullOrEmpty(top3.FullName) ? "U" : top3.FullName.Substring(0, 1).ToUpper())
                            </div>
                        </div>
                        <h5 class="fw-bold mb-1 text-truncate">@top3.FullName</h5>
                        <div class="text-primary fw-bold fs-4 mb-2">@top3.ExperiencePoints <span class="fs-6 text-muted">XP</span></div>
                        <div class="d-flex justify-content-center gap-2 small text-muted">
                            <span><i class="bi bi-book me-1"></i>@top3.CompletedLessonsCount bài</span>
                            <span>·</span>
                            <span><i class="bi bi-code-slash me-1"></i>@top3.CompletedChallengesCount code</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Full Ranking Table -->
    <div class="card border-0 shadow-sm bg-body rounded-4 overflow-hidden mb-5">
        <div class="card-header bg-transparent py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="fw-bold mb-0"><i class="bi bi-list-ol me-2 text-primary"></i>Bảng Tổng Sắp Học Viên</h5>
            <span class="text-muted small">Cập nhật thời gian thực</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">Hạng</th>
                        <th>Học viên</th>
                        <th class="text-center">Bài học</th>
                        <th class="text-center d-none d-sm-table-cell">Thuật toán</th>
                        <th class="text-center d-none d-lg-table-cell">Chứng chỉ</th>
                        <th class="d-none d-md-table-cell">Huy hiệu</th>
                        <th class="text-end pe-4">Tổng XP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.TopUsers)
                    {
                        var isCurrent = user.UserId == Model.CurrentUserItem?.UserId;
                        <tr class="@(isCurrent ? "table-primary fw-semibold" : "")">
                            <td class="ps-4">
                                @if (user.Rank == 1)
                                {
                                    <span class="badge bg-warning text-dark rounded-circle p-2 fs-6">🥇</span>
                                }
                                else if (user.Rank == 2)
                                {
                                    <span class="badge bg-secondary text-white rounded-circle p-2 fs-6">🥈</span>
                                }
                                else if (user.Rank == 3)
                                {
                                    <span class="badge bg-danger text-white rounded-circle p-2 fs-6">🥉</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-muted ps-2">#@user.Rank</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                        @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-semibold">
                                            @user.FullName
                                            @if (isCurrent)
                                            {
                                                <span class="badge bg-primary text-white ms-1">Bạn</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-body-tertiary text-body border rounded-pill px-2 py-1">
                                    <i class="bi bi-book text-primary me-1"></i>@user.CompletedLessonsCount
                                </span>
                            </td>
                            <td class="text-center d-none d-sm-table-cell">
                                <span class="badge bg-body-tertiary text-body border rounded-pill px-2 py-1">
                                    <i class="bi bi-code-slash text-warning me-1"></i>@user.CompletedChallengesCount
                                </span>
                            </td>
                            <td class="text-center d-none d-lg-table-cell">
                                <span class="badge bg-body-tertiary text-body border rounded-pill px-2 py-1">
                                    <i class="bi bi-award text-success me-1"></i>@user.CertificatesCount
                                </span>
                            </td>
                            <td class="d-none d-md-table-cell">
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (!user.Badges.Any())
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                    else
                                    {
                                        @foreach (var b in user.Badges)
                                        {
                                            <span class="badge bg-@b.ColorClass-subtle text-@b.ColorClass border border-@b.ColorClass-subtle rounded-pill" title="@b.Title: @b.Description">
                                                <i class="bi @b.IconClass me-1"></i>@b.Title
                                            </span>
                                        }
                                    }
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <span class="fw-bold text-primary fs-5">@user.ExperiencePoints</span>
                                <small class="text-muted ms-1">XP</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Badges Catalog Section -->
    <div class="mb-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold mb-2"><i class="bi bi-shield-check text-success me-2"></i>Hệ Thống Huy Hiệu Thành Tựu</h3>
            <p class="text-muted small">Mở khóa các danh hiệu danh giá bằng cách hoàn thành mục tiêu học tập và cống hiến cho cộng đồng.</p>
        </div>

        <div class="row g-3">
            @foreach (var b in Model.AllBadges)
            {
                var isEarned = Model.CurrentUserItem?.Badges.Any(ub => ub.BadgeCode == b.BadgeCode) == true;
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm bg-body rounded-4 p-3 h-100 @(isEarned ? "border-start border-4 border-success" : "opacity-75")">
                        <div class="d-flex align-items-start gap-3">
                            <div class="rounded-circle bg-@b.ColorClass-subtle text-@b.ColorClass border border-@b.ColorClass-subtle d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 48px; height: 48px; font-size: 1.4rem;">
                                <i class="bi @b.IconClass"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between mb-1">
                                    <h6 class="fw-bold mb-0">@b.Title</h6>
                                    @if (isEarned)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">✓ Đã đạt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill small">Chưa đạt</span>
                                    }
                                </div>
                                <p class="text-muted small mb-2">@b.Description</p>
                                <div class="small fw-semibold text-primary">
                                    <i class="bi bi-flag-fill me-1"></i>Điều kiện: @b.ConditionDescription
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
