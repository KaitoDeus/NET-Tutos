<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - .NET DevMaster (Học .NET từ Cơ Bản đến Nâng Cao)</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Prism.js Syntax Highlighting (VS Code Dark theme) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/toolbar/prism-toolbar.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Reading Progress Indicator -->
    <div id="readingProgressBar" class="progress-bar-top"></div>

    <!-- Navigation Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg border-bottom shadow-sm bg-body">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-controller="Home" asp-action="Index">
                    <span class="badge rounded-pill bg-gradient-dotnet text-white p-2">
                        <i class="bi bi-code-slash fs-5"></i>
                    </span>
                    <span class="brand-text">
                        <span class="text-primary fw-extrabold">.NET</span> DevMaster
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active fw-semibold" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roadmap" ? "active fw-semibold" : "")"
                               asp-controller="Roadmap" asp-action="Index">
                                <i class="bi bi-signpost-split me-1 text-warning"></i> Lộ trình học
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tutorials" ? "active fw-semibold" : "")"
                               asp-controller="Tutorials" asp-action="Index">
                                <i class="bi bi-book me-1 text-primary"></i> Khóa học & Bài viết
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Quiz" ? "active fw-semibold" : "")"
                               asp-controller="Quiz" asp-action="Index">
                                <i class="bi bi-patch-question me-1 text-success"></i> Trắc nghiệm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CheatSheet" ? "active fw-semibold" : "")"
                               asp-controller="CheatSheet" asp-action="Index">
                                <i class="bi bi-code-square me-1 text-info"></i> Tra cứu Code
                            </a>
                        </li>
                    </ul>

                    <!-- Search Box -->
                    <form class="d-flex me-3" asp-controller="Tutorials" asp-action="Index" method="get">
                        <div class="input-group input-group-sm search-group">
                            <input class="form-control" type="search" name="search" placeholder="Tìm bài học, LINQ, EF Core..." aria-label="Search" value="@Context.Request.Query["search"]">
                            <button class="btn btn-outline-primary" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- User Account / Auth Menu -->
                    <div class="d-flex align-items-center ms-lg-2 me-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center gap-2 rounded-pill px-3 py-1.5" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-6"></i>
                                    <span class="fw-semibold text-truncate" style="max-width: 140px;">@(User.Identity.Name?.Split('@')[0] ?? "Học viên")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2">
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-mortarboard text-primary"></i> Góc học tập (Dashboard)
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger">
                                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold d-none d-sm-inline-block">
                                    Đăng ký
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Theme Switcher -->
                    <div class="d-flex align-items-center">
                        <button id="themeToggleBtn" class="btn btn-sm btn-outline-secondary rounded-circle theme-btn" type="button" title="Chuyển chế độ Sáng / Tối">
                            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-4 bg-body-tertiary border-top">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-0">
                        <span class="badge bg-primary text-white p-1 px-2 rounded">.NET 10</span>
                        <span class="fw-bold">.NET DevMaster Portal</span>
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex justify-content-center justify-content-md-end gap-3 mb-2">
                        <a asp-controller="Home" asp-action="Index" class="text-decoration-none small text-body-secondary">Trang chủ</a>
                        <a asp-controller="Roadmap" asp-action="Index" class="text-decoration-none small text-body-secondary">Lộ trình</a>
                        <a asp-controller="Tutorials" asp-action="Index" class="text-decoration-none small text-body-secondary">Bài học</a>
                        <a asp-controller="Quiz" asp-action="Index" class="text-decoration-none small text-body-secondary">Trắc nghiệm</a>
                        <a asp-controller="Home" asp-action="About" class="text-decoration-none small text-body-secondary">Về dự án</a>
                    </div>
                    <p class="text-muted small mb-0">
                        © @DateTime.Now.Year .NET DevMaster. Xây dựng bằng ASP.NET Core MVC & Entity Framework Core.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Prism.js Syntax Highlighting & Copy Button -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-csharp.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/toolbar/prism-toolbar.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/copy-to-clipboard/prism-copy-to-clipboard.min.js"></script>

    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
