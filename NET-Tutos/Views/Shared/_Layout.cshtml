<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString()) || ViewData["Title"]?.ToString() == "Trang chủ" ? "NET-Tutos" : $"{ViewData["Title"]} | NET-Tutos")</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/csharp-logo.png" />
    <link rel="shortcut icon" type="image/png" href="~/images/csharp-logo.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Prism.js Syntax Highlighting (VS Code Dark theme) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/toolbar/prism-toolbar.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Reading Progress Indicator -->
    <div id="readingProgressBar" class="progress-bar-top"></div>

    <!-- Navigation Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg border-bottom shadow-sm bg-body">
            <div class="container-fluid px-3 px-xl-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-decoration-none py-1 me-2 me-sm-3" asp-controller="Home" asp-action="Index">
                    <img src="~/images/csharp-logo.png" alt="C# Logo" width="30" height="34" class="csharp-nav-logo" />
                    <span class="brand-text fw-extrabold fs-4"><span class="text-dotnet">.NET</span><span class="text-body-emphasis"> Tutos</span></span>
                </a>

                <!-- Mobile Quick Actions Bar (Theme Switch & Toggler) -->
                <div class="d-flex align-items-center gap-2 d-lg-none ms-auto">
                    <button class="btn btn-sm btn-outline-secondary rounded-circle theme-btn p-1.5" type="button" onclick="document.getElementById('themeToggleBtn').click()" title="Chuyển chế độ Sáng / Tối">
                        <i class="bi bi-moon-stars-fill mobile-theme-icon"></i>
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="btn btn-sm btn-outline-warning rounded-circle p-1 d-flex align-items-center justify-content-center mobile-streak-btn"
                                style="width: 32px; height: 32px;" type="button" data-bs-toggle="modal" data-bs-target="#streakModal" title="Chuỗi học tập hàng ngày">
                            <i class="bi bi-fire text-danger"></i>
                        </button>
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-primary rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Góc học tập">
                            <i class="bi bi-person-fill"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 small fw-semibold" title="Đăng nhập">
                            Đăng nhập
                        </a>
                    }
                    <button class="navbar-toggler border-0 p-1.5 rounded-3 shadow-none bg-body-tertiary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                            aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon" style="width: 1.25em; height: 1.25em;"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-2 gap-0 gap-xl-1 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active fw-semibold" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roadmap" ? "active fw-semibold" : "")"
                               asp-controller="Roadmap" asp-action="Index">
                                <i class="bi bi-signpost-split me-1 text-warning"></i> Lộ trình học
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tutorials" ? "active fw-semibold" : "")"
                               asp-controller="Tutorials" asp-action="Index">
                                <i class="bi bi-book me-1 text-primary"></i> Khóa học & Bài viết
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Quiz" ? "active fw-semibold" : "")"
                               asp-controller="Quiz" asp-action="Index">
                                <i class="bi bi-patch-question me-1 text-success"></i> Trắc nghiệm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Exam" ? "active fw-semibold" : "")"
                               asp-controller="Exam" asp-action="Index">
                                <i class="bi bi-mortarboard me-1 text-warning"></i> Thi & Chứng chỉ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Playground" ? "active fw-semibold" : "")"
                               asp-controller="Playground" asp-action="Index">
                                <i class="bi bi-terminal-fill me-1 text-danger"></i> Luyện Code C#
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CheatSheet" ? "active fw-semibold" : "")"
                               asp-controller="CheatSheet" asp-action="Index">
                                <i class="bi bi-code-square me-1 text-info"></i> Tra cứu Code
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Leaderboard" ? "active fw-semibold" : "")"
                               asp-controller="Leaderboard" asp-action="Index">
                                <i class="bi bi-trophy-fill me-1 text-warning"></i> Vinh danh
                            </a>
                        </li>
                    </ul>

                    <!-- Search Box -->
                    <form class="d-flex my-2 my-lg-0 me-lg-2 w-100 w-lg-auto" asp-controller="Tutorials" asp-action="Index" method="get">
                        <div class="input-group input-group-sm search-group w-100">
                            <input class="form-control" type="search" name="search" placeholder="Tìm bài học..." aria-label="Search" value="@Context.Request.Query["search"]">
                            <button class="btn btn-outline-primary" type="submit" title="Tìm kiếm">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    <!-- User Account / Auth Menu -->
                    <div class="d-flex align-items-center gap-2 me-lg-2 my-2 my-lg-0 mobile-nav-auth">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Streak Quick Badge Button -->
                            <button id="btnNavStreak" class="btn btn-sm btn-outline-warning rounded-pill px-2.5 py-1.5 d-flex align-items-center gap-1.5 text-nowrap fw-bold shadow-none"
                                    type="button" data-bs-toggle="modal" data-bs-target="#streakModal" title="Chuỗi học tập hàng ngày (Streak)">
                                <i class="bi bi-fire text-danger fs-6 streak-fire-icon"></i>
                                <span id="navStreakCountText">0 ngày</span>
                            </button>

                            <div class="dropdown w-100 w-lg-auto">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center justify-content-between justify-content-lg-start gap-2 rounded-pill px-3 py-1.5 text-nowrap w-100 w-lg-auto" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-circle fs-6"></i>
                                        <span class="fw-semibold text-truncate" style="max-width: 140px;">@(User.Identity.Name?.Split('@')[0] ?? "Học viên")</span>
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3 mt-2 w-100 w-lg-auto">
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-mortarboard text-primary"></i> Góc học tập (Dashboard)
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2 text-primary fw-semibold" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-speedometer2"></i> Quản trị LMS
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 text-danger">
                                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="auth-btn-group d-flex align-items-center w-100 w-lg-auto" style="gap: 8px;">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold text-nowrap flex-grow-1 flex-lg-grow-0 text-center">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-semibold text-nowrap flex-grow-1 flex-lg-grow-0 text-center">
                                    Đăng ký
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Desktop Theme Switcher -->
                    <div class="d-none d-lg-flex align-items-center">
                        <button id="themeToggleBtn" class="btn btn-sm btn-outline-secondary rounded-circle theme-btn" type="button" title="Chuyển chế độ Sáng / Tối">
                            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-4 bg-body-tertiary border-top">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-0">
                        <img src="~/images/csharp-logo.png" alt="C# Logo" width="24" height="27" style="object-fit: contain;" />
                        <span class="badge bg-primary text-white p-1 px-2 rounded">.NET 10</span>
                        <span class="fw-bold">.NET Tutos</span>
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="text-muted small mb-0">
                        © @DateTime.Now.Year .NET Tutos. Nền tảng học tập & thực hành lập trình .NET chất lượng cao.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Prism.js Syntax Highlighting & Copy Button -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-csharp.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/toolbar/prism-toolbar.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/copy-to-clipboard/prism-copy-to-clipboard.min.js"></script>

    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_StreakModal" />
    }
</body>
</html>
