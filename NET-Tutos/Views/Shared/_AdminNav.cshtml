@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}

<div class="card border-0 shadow-sm rounded-4 mb-4 bg-body">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                        <i class="bi bi-shield-lock-fill me-1"></i> Quản trị viên
                    </span>
                    <span class="text-body-secondary small">Hệ thống Quản lý Đào tạo .NET (LMS)</span>
                </div>
                <h4 class="fw-bold mb-0 mt-2">Bảng điều khiển Quản trị LMS</h4>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="AdminTutorials" asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3 py-2 fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Soạn bài học mới
                </a>
                <a asp-controller="AdminQuizzes" asp-action="Create" class="btn btn-sm btn-outline-success rounded-pill px-3 py-2 fw-semibold">
                    <i class="bi bi-patch-question me-1"></i> Thêm câu hỏi thi
                </a>
            </div>
        </div>

        <hr class="my-3 opacity-25">

        <!-- Nav tabs -->
        <ul class="nav nav-pills gap-1 flex-nowrap overflow-x-auto pb-1">
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 fw-semibold @(currentController == "Admin" ? "active" : "text-body")" 
                   asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-speedometer2 me-1"></i> Tổng quan KPI
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 fw-semibold @(currentController == "AdminTutorials" ? "active" : "text-body")" 
                   asp-controller="AdminTutorials" asp-action="Index">
                    <i class="bi bi-journal-richtext me-1"></i> Quản lý Bài học (CMS)
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 fw-semibold @(currentController == "AdminQuizzes" ? "active" : "text-body")" 
                   asp-controller="AdminQuizzes" asp-action="Index">
                    <i class="bi bi-patch-question me-1"></i> Ngân hàng Đề thi
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link rounded-pill px-3 py-1.5 fw-semibold @(currentController == "AdminUsers" ? "active" : "text-body")" 
                   asp-controller="AdminUsers" asp-action="Index">
                    <i class="bi bi-people me-1"></i> Học viên & Phân quyền
                </a>
            </li>
        </ul>
    </div>
</div>
