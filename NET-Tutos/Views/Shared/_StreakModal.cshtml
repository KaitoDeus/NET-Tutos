@inject NET_Tutos.Services.IStreakService StreakService
@using System.Security.Claims
@{
    bool isEn = Context.IsEnglish();
}

<div class="modal fade" id="streakModal" tabindex="-1" aria-labelledby="streakModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden bg-body">
            <!-- Modal Header -->
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1.5 fw-bold d-inline-flex align-items-center">
                        <i class="bi bi-fire text-danger me-2"></i> @(isEn ? "KEEP LEARNING STREAK" : "GIỮ LỬA HỌC TẬP")
                    </span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4 text-center">
                <!-- Large Animated Flame & Counter -->
                <div class="streak-flame-container my-2">
                    <div class="streak-flame-glow mx-auto mb-2">
                        <i class="bi bi-fire streak-huge-flame"></i>
                    </div>
                    <div class="display-3 fw-extrabold text-body-emphasis mb-0" id="modalStreakCount">0</div>
                    <div class="text-uppercase fw-bold text-muted small letter-spacing-1" id="modalStreakDaysLabel">@(isEn ? "Consecutive Days" : "Ngày Liên Tục")</div>
                </div>

                <p class="text-body-secondary small mt-2 mb-4 mx-auto" style="max-width: 360px;" id="modalStreakStatusText">
                    @(isEn ? "Maintain your daily .NET study habit to solidify skills and rise on the leaderboard!" : "Duy trì việc học .NET mỗi ngày để tạo thói quen vững chắc và bứt phá thứ hạng!")
                </p>

                <!-- Check-in Action Button -->
                <div class="mb-4">
                    <button id="btnDoCheckIn" class="btn btn-warning btn-lg rounded-pill fw-bold px-4 py-2.5 shadow w-100 d-inline-flex align-items-center justify-content-center gap-2" type="button">
                        <span class="spinner-border spinner-border-sm d-none me-2" id="checkInSpinner"></span>
                        <i class="bi bi-lightning-charge-fill text-danger fs-5 me-2" id="checkInIcon"></i>
                        <span id="btnCheckInText">@(isEn ? "Check in today (+20 XP)" : "Điểm danh hôm nay (+20 XP)")</span>
                    </button>
                    <div class="small text-muted mt-2 d-flex align-items-center justify-content-center" id="checkInSubtext">
                        <i class="bi bi-clock-history me-2"></i>@(isEn ? "Log in and check in daily to accumulate XP" : "Mỗi ngày đăng nhập và điểm danh để tích lũy XP")
                    </div>
                </div>

                <!-- Past 7 Days Visual Progress -->
                <div class="card border rounded-4 bg-body-tertiary p-3 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-body-secondary" id="modalPast7DaysTitle">@(isEn ? "Past 7 days progress" : "Tiến độ 7 ngày gần nhất")</span>
                        <span class="small text-primary fw-semibold" id="totalStreakXpText">@(isEn ? "+0 XP earned" : "+0 XP đã nhận")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center gap-1" id="past7DaysContainer">
                        <!-- Populated by JavaScript -->
                    </div>
                </div>

                <!-- Streak Milestones (Cột mốc thưởng) -->
                <div class="text-start">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2.5 d-flex align-items-center">
                        <i class="bi bi-trophy text-warning me-2"></i> @(isEn ? "Milestones & Record Badges" : "Mốc Thưởng & Huy Hiệu Kỷ Lục")
                    </h6>
                    <div class="list-group list-group-flush border rounded-3 overflow-hidden small" id="milestonesContainer">
                        <div class="list-group-item d-flex align-items-center justify-content-between py-2.5 bg-body">
                            <div class="d-flex align-items-center gap-2.5">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-circle p-2">
                                    <i class="bi bi-fire fs-6"></i>
                                </span>
                                <div>
                                    <div class="fw-bold">@(isEn ? "3-Day Streak: Persistent Flame" : "Chuỗi 3 Ngày: Ngọn Lửa Bền Bỉ")</div>
                                    <div class="text-muted small">@(isEn ? "Study for 3 consecutive days" : "Duy trì học 3 ngày liên tiếp")</div>
                                </div>
                            </div>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">+30 XP</span>
                        </div>
                        <div class="list-group-item d-flex align-items-center justify-content-between py-2.5 bg-body">
                            <div class="d-flex align-items-center gap-2.5">
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-circle p-2">
                                    <i class="bi bi-shield-check fs-6"></i>
                                </span>
                                <div>
                                    <div class="fw-bold">@(isEn ? "7-Day Streak: Disciplined Warrior" : "Chuỗi 7 Ngày: Chiến Binh Kỷ Luật")</div>
                                    <div class="text-muted small">@(isEn ? "Complete 1 full week without missing a day" : "Trọn vẹn 1 tuần không bỏ buổi nào")</div>
                                </div>
                            </div>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill">+70 XP</span>
                        </div>
                        <div class="list-group-item d-flex align-items-center justify-content-between py-2.5 bg-body">
                            <div class="d-flex align-items-center gap-2.5">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-circle p-2">
                                    <i class="bi bi-trophy-fill fs-6"></i>
                                </span>
                                <div>
                                    <div class="fw-bold">@(isEn ? "30-Day Streak: Unstoppable Legend" : "Chuỗi 30 Ngày: Huyền Thoại Bất Bại")</div>
                                    <div class="text-muted small">@(isEn ? "1 full month continuous learning record" : "Kỷ lục 1 tháng học tập liên tục")</div>
                                </div>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">+200 XP</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-0 pt-0 bg-body-tertiary d-flex justify-content-between align-items-center">
                <span class="small text-muted d-inline-flex align-items-center">
                    <i class="bi bi-info-circle me-2"></i>@(isEn ? "Reading lessons, coding in sandbox, or taking quizzes also counts as check-in!" : "Đọc bài, giải code hoặc thi quiz cũng tính điểm danh!")
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">@(isEn ? "Close" : "Đóng")</button>
            </div>
        </div>
    </div>
</div>
