@model IEnumerable<NET_Tutos.Models.Entities.QuizQuestion>
@{
    ViewData["Title"] = "Ngân hàng Đề thi & Trắc nghiệm";
    var categories = ViewBag.Categories as IEnumerable<NET_Tutos.Models.Entities.Category> ?? Enumerable.Empty<NET_Tutos.Models.Entities.Category>();
    var tutorials = ViewBag.Tutorials as IEnumerable<NET_Tutos.Models.Entities.Tutorial> ?? Enumerable.Empty<NET_Tutos.Models.Entities.Tutorial>();
    int? selectedCategory = ViewBag.SelectedCategory;
    int? selectedTutorial = ViewBag.SelectedTutorial;
    string? search = ViewBag.Search;
}

<div class="container-fluid px-3 px-xl-4 py-4">
    <partial name="_AdminNav" />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Actions & Filters -->
    <div class="card border-0 shadow-sm rounded-4 bg-body mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-center justify-content-between">
                <div class="col-md-5">
                    <form method="get" class="d-flex gap-2">
                        <div class="input-group">
                            <span class="input-group-text bg-body-secondary border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm kiếm nội dung câu hỏi..." value="@search" />
                            @if (selectedCategory.HasValue)
                            {
                                <input type="hidden" name="categoryId" value="@selectedCategory.Value" />
                            }
                            @if (selectedTutorial.HasValue)
                            {
                                <input type="hidden" name="tutorialId" value="@selectedTutorial.Value" />
                            }
                            <button type="submit" class="btn btn-primary">Tìm</button>
                        </div>
                        @if (!string.IsNullOrEmpty(search) || selectedCategory.HasValue || selectedTutorial.HasValue)
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                    </form>
                </div>

                <div class="col-md-7 d-flex flex-wrap justify-content-md-end align-items-center gap-2">
                    <!-- Category Filter Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle rounded-pill px-3 py-2 text-nowrap" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-funnel me-1"></i>
                            @(selectedCategory.HasValue 
                                ? categories.FirstOrDefault(c => c.Id == selectedCategory.Value)?.Name ?? "Chuyên đề" 
                                : "Tất cả chuyên đề")
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                            <li><a class="dropdown-item @(!selectedCategory.HasValue ? "active" : "")" asp-action="Index" asp-route-search="@search">Tất cả chuyên đề</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @foreach (var cat in categories)
                            {
                                <li>
                                    <a class="dropdown-item @(selectedCategory == cat.Id ? "active" : "")" 
                                       asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-search="@search">
                                        @cat.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <a asp-action="Create" class="btn btn-primary rounded-pill px-3 py-2 fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Thêm câu hỏi mới
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Questions Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-body">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-patch-question text-primary me-2"></i> Ngân hàng câu hỏi trắc nghiệm (@Model.Count() câu)
            </h5>
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill">
                Hệ thống thi tự động
            </span>
        </div>
        <div class="card-body px-4 py-3">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-body-secondary">
                    <i class="bi bi-question-circle display-4 d-block mb-3 opacity-50"></i>
                    <p class="mb-2">Không tìm thấy câu hỏi nào phù hợp với bộ lọc.</p>
                    <a asp-action="Create" class="btn btn-sm btn-primary rounded-pill px-3">Thêm câu hỏi đầu tiên</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Nội dung câu hỏi</th>
                                <th>Bài học / Chuyên đề</th>
                                <th>Đáp án đúng</th>
                                <th>Cấp độ</th>
                                <th class="text-end" style="min-width: 110px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int index = 1; }
                            @foreach (var q in Model)
                            {
                                <tr>
                                    <td class="text-body-secondary fw-semibold">@(index++)</td>
                                    <td>
                                        <div class="fw-semibold text-truncate" style="max-width: 450px;" title="@q.Question">
                                            @q.Question
                                        </div>
                                        <div class="text-body-secondary small mt-1">
                                            <span class="me-2 text-truncate d-inline-block" style="max-width: 140px;">A: @q.OptionA</span>
                                            <span class="me-2 text-truncate d-inline-block" style="max-width: 140px;">B: @q.OptionB</span>
                                            <span class="me-2 text-truncate d-inline-block" style="max-width: 140px;">C: @q.OptionC</span>
                                            <span class="text-truncate d-inline-block" style="max-width: 140px;">D: @q.OptionD</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (q.Tutorial != null)
                                        {
                                            <div class="fw-medium small text-truncate" style="max-width: 220px;" title="@q.Tutorial.Title">
                                                @q.Tutorial.Title
                                            </div>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border small">
                                                @(q.Tutorial.Category?.Name ?? "Chuyên đề")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-body-secondary text-body-secondary border">Chung</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle border border-success-subtle rounded-pill px-3 py-1.5 fw-bold">
                                            Đáp án @q.CorrectOption
                                        </span>
                                    </td>
                                    <td>
                                        @switch (q.Difficulty)
                                        {
                                            case NET_Tutos.Models.Entities.DifficultyLevel.Beginner:
                                                <span class="badge bg-success-subtle border border-success-subtle rounded-pill px-2.5 py-1">Cơ bản</span>
                                                break;
                                            case NET_Tutos.Models.Entities.DifficultyLevel.Intermediate:
                                                <span class="badge bg-primary-subtle border border-primary-subtle rounded-pill px-2.5 py-1">Trung cấp</span>
                                                break;
                                            case NET_Tutos.Models.Entities.DifficultyLevel.Advanced:
                                                <span class="badge bg-danger-subtle border border-danger-subtle rounded-pill px-2.5 py-1">Nâng cao</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@q.Id" class="btn btn-outline-primary rounded-start-pill px-2.5" title="Chỉnh sửa câu hỏi">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger rounded-end-pill px-2.5" data-bs-toggle="modal" data-bs-target="#deleteModal-@q.Id" title="Xóa câu hỏi">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Delete Modal -->
                                        <div class="modal fade" id="deleteModal-@q.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold text-danger">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i> Xác nhận xóa câu hỏi
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-start py-3">
                                                        <p class="mb-2">Bạn có chắc chắn muốn xóa câu hỏi trắc nghiệm này?</p>
                                                        <div class="p-3 bg-body-secondary rounded-3 text-break">
                                                            "@q.Question"
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                                                        <form asp-action="Delete" asp-route-id="@q.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger rounded-pill px-3">Xác nhận xóa</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
