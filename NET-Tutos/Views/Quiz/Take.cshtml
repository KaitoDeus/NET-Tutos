@model NET_Tutos.Models.ViewModels.QuizSubmissionViewModel
@{
    ViewData["Title"] = "Làm bài trắc nghiệm - " + (Model.TopicTitle ?? ".NET Quiz");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đề thi
                    </a>
                    <h2 class="fw-bold mb-0">@Model.TopicTitle</h2>
                    <p class="text-muted small mb-0">Tổng cộng: @Model.Questions.Count câu hỏi trắc nghiệm</p>
                </div>
            </div>

            <!-- Result Summary Card if Submitted -->
            @if (Model.IsSubmitted)
            {
                var percentage = Model.TotalQuestions > 0 ? (Model.Score * 100) / Model.TotalQuestions : 0;
                string alertClass = percentage >= 80 ? "alert-success" : (percentage >= 50 ? "alert-warning" : "alert-danger");
                string badgeClass = percentage >= 80 ? "bg-success" : (percentage >= 50 ? "bg-warning text-dark" : "bg-danger");

                <div class="alert @alertClass rounded-4 p-4 mb-4 shadow-sm">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div>
                            <h4 class="alert-heading fw-bold mb-1">
                                Kết Quả Bài Làm: <span class="badge @badgeClass">@Model.Score / @Model.TotalQuestions Điểm (@percentage%)</span>
                            </h4>
                            <p class="mb-0">
                                @if (percentage >= 80)
                                {
                                    <span>Xuất sắc! Bạn đã nắm rất vững kiến thức phần này.</span>
                                }
                                else if (percentage >= 50)
                                {
                                    <span>Khá tốt! Bạn đã vượt qua bài test, hãy xem lại các câu sai để hoàn thiện hơn nhé.</span>
                                }
                                else
                                {
                                    <span>Bạn cần ôn tập thêm lý thuyết bài này trước khi làm lại nhé!</span>
                                }
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Take" asp-route-tutorialId="@Model.TutorialId" class="btn btn-primary fw-semibold">
                                <i class="bi bi-arrow-repeat me-1"></i> Làm lại bài thi
                            </a>
                            <a asp-action="Index" class="btn btn-outline-dark fw-semibold">
                                Đề thi khác
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- Questions Form -->
            <form method="post" asp-action="Submit">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="TutorialId" />
                <input type="hidden" asp-for="TopicTitle" />

                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];
                    <input type="hidden" name="Questions[@i].QuestionId" value="@q.QuestionId" />
                    <input type="hidden" name="Questions[@i].Question" value="@q.Question" />
                    <input type="hidden" name="Questions[@i].OptionA" value="@q.OptionA" />
                    <input type="hidden" name="Questions[@i].OptionB" value="@q.OptionB" />
                    <input type="hidden" name="Questions[@i].OptionC" value="@q.OptionC" />
                    <input type="hidden" name="Questions[@i].OptionD" value="@q.OptionD" />
                    <input type="hidden" name="Questions[@i].CorrectOption" value="@q.CorrectOption" />
                    <input type="hidden" name="Questions[@i].Explanation" value="@q.Explanation" />

                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-body">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="badge bg-primary px-3 py-1.5 rounded-pill">Câu @(i + 1)</span>
                            @if (Model.IsSubmitted)
                            {
                                if (q.IsCorrect == true)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Đúng</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Sai</span>
                                }
                            }
                        </div>

                        <h5 class="fw-bold mb-4">@q.Question</h5>

                        <div class="d-flex flex-column gap-2 mb-3">
                            <!-- Option A -->
                            @{
                                string stateClassA = "";
                                if (Model.IsSubmitted)
                                {
                                    if (q.CorrectOption == "A") stateClassA = "quiz-correct";
                                    else if (q.SelectedOption == "A") stateClassA = "quiz-incorrect";
                                }
                            }
                            <div>
                                <input type="radio" class="btn-check quiz-option-input" name="Questions[@i].SelectedOption" id="q_@(i)_A" value="A"
                                       checked="@(q.SelectedOption == "A")" disabled="@Model.IsSubmitted" />
                                <label class="quiz-option-label @stateClassA" for="q_@(i)_A">
                                    <strong class="me-2">A.</strong> @q.OptionA
                                </label>
                            </div>

                            <!-- Option B -->
                            @{
                                string stateClassB = "";
                                if (Model.IsSubmitted)
                                {
                                    if (q.CorrectOption == "B") stateClassB = "quiz-correct";
                                    else if (q.SelectedOption == "B") stateClassB = "quiz-incorrect";
                                }
                            }
                            <div>
                                <input type="radio" class="btn-check quiz-option-input" name="Questions[@i].SelectedOption" id="q_@(i)_B" value="B"
                                       checked="@(q.SelectedOption == "B")" disabled="@Model.IsSubmitted" />
                                <label class="quiz-option-label @stateClassB" for="q_@(i)_B">
                                    <strong class="me-2">B.</strong> @q.OptionB
                                </label>
                            </div>

                            <!-- Option C -->
                            @{
                                string stateClassC = "";
                                if (Model.IsSubmitted)
                                {
                                    if (q.CorrectOption == "C") stateClassC = "quiz-correct";
                                    else if (q.SelectedOption == "C") stateClassC = "quiz-incorrect";
                                }
                            }
                            <div>
                                <input type="radio" class="btn-check quiz-option-input" name="Questions[@i].SelectedOption" id="q_@(i)_C" value="C"
                                       checked="@(q.SelectedOption == "C")" disabled="@Model.IsSubmitted" />
                                <label class="quiz-option-label @stateClassC" for="q_@(i)_C">
                                    <strong class="me-2">C.</strong> @q.OptionC
                                </label>
                            </div>

                            <!-- Option D -->
                            @{
                                string stateClassD = "";
                                if (Model.IsSubmitted)
                                {
                                    if (q.CorrectOption == "D") stateClassD = "quiz-correct";
                                    else if (q.SelectedOption == "D") stateClassD = "quiz-incorrect";
                                }
                            }
                            <div>
                                <input type="radio" class="btn-check quiz-option-input" name="Questions[@i].SelectedOption" id="q_@(i)_D" value="D"
                                       checked="@(q.SelectedOption == "D")" disabled="@Model.IsSubmitted" />
                                <label class="quiz-option-label @stateClassD" for="q_@(i)_D">
                                    <strong class="me-2">D.</strong> @q.OptionD
                                </label>
                            </div>
                        </div>

                        <!-- Explanation if submitted -->
                        @if (Model.IsSubmitted && !string.IsNullOrEmpty(q.Explanation))
                        {
                            <div class="alert alert-info py-2 px-3 small mb-0 rounded-3">
                                <i class="bi bi-info-circle-fill me-1"></i><strong>Giải thích chi tiết:</strong> @q.Explanation
                            </div>
                        }
                    </div>
                }

                @if (!Model.IsSubmitted)
                {
                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow fw-semibold">
                            <i class="bi bi-send-check me-2"></i> Nộp Bài & Xem Điểm
                        </button>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

