@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "AI .NET Tutor & Mentor | NET-Tutos" : "Trợ Lý AI Gia Sư .NET | NET-Tutos";
}

<div class="container py-4">
    <!-- Top Header Banner -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 p-4 rounded-4 shadow-sm border bg-body">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                <i class="bi bi-robot fs-2"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="fw-bold mb-0">@(isEn ? "AI .NET Tutor & Code Mentor" : "Trợ Lý AI Gia Sư .NET")</h3>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.72rem;">
                        <i class="bi bi-stars me-1 text-warning"></i>.NET 10 & C# 14
                    </span>
                </div>
                <p class="text-muted small mb-0">
                    @(isEn
                        ? "Interactive C# mentor: Ask concepts, explain compiler errors, receive challenge hints, and optimize code."
                        : "Gia sư lập trình tương tác: Giải thích lỗi biên dịch, gợi ý thuật toán, tối ưu hóa code và giải đáp kiến thức chuyên sâu.")
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Playground" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold d-flex align-items-center gap-1.5">
                <i class="bi bi-terminal-fill"></i>
                <span>@(isEn ? "Open C# Sandbox" : "Mở C# Sandbox")</span>
            </a>
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1.5" onclick="clearChatHistory()" title="@(isEn ? "Clear conversation" : "Làm mới hội thoại")">
                <i class="bi bi-arrow-clockwise me-1"></i>@(isEn ? "Reset" : "Làm mới")
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Sidebar: Quick Prompts & Knowledge Topics -->
        <div class="col-lg-4 col-xl-3">
            <div class="card border shadow-sm rounded-4 bg-body p-3 mb-3">
                <h6 class="fw-bold text-body-emphasis mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-warning"></i>
                    <span>@(isEn ? "Popular Topics" : "Chủ đề Thường Gặp")</span>
                </h6>

                <div class="d-flex flex-column gap-2">
                    <button type="button" class="btn btn-sm btn-light border text-start rounded-3 p-2.5 d-flex align-items-center gap-2 transition-hover text-body" onclick="sendPresetPrompt('linq')">
                        <i class="bi bi-funnel text-primary fs-6"></i>
                        <span class="small fw-semibold">@(isEn ? "Explain LINQ & Deferred Exec" : "Làm chủ LINQ & Deferred Exec")</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-start rounded-3 p-2.5 d-flex align-items-center gap-2 transition-hover text-body" onclick="sendPresetPrompt('async')">
                        <i class="bi bi-cpu text-success fs-6"></i>
                        <span class="small fw-semibold">@(isEn ? "Async/Await & Deadlocks" : "Bất đồng bộ Async/Await & Task")</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-start rounded-3 p-2.5 d-flex align-items-center gap-2 transition-hover text-body" onclick="sendPresetPrompt('di')">
                        <i class="bi bi-diagram-3 text-info fs-6"></i>
                        <span class="small fw-semibold">@(isEn ? "Scoped vs Transient vs Singleton" : "3 Vòng đời Dependency Injection")</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-start rounded-3 p-2.5 d-flex align-items-center gap-2 transition-hover text-body" onclick="sendPresetPrompt('record')">
                        <i class="bi bi-box-seam text-warning fs-6"></i>
                        <span class="small fw-semibold">@(isEn ? "Record vs Class vs Struct" : "Phân biệt Record, Class, Struct")</span>
                    </button>
                    <button type="button" class="btn btn-sm btn-light border text-start rounded-3 p-2.5 d-flex align-items-center gap-2 transition-hover text-body" onclick="sendPresetPrompt('null')">
                        <i class="bi bi-shield-check text-danger fs-6"></i>
                        <span class="small fw-semibold">@(isEn ? "Fix NullReferenceException" : "Khắc phục lỗi NullReference")</span>
                    </button>
                </div>
            </div>

            <!-- Features Info Box -->
            <div class="card border-0 rounded-4 p-3 bg-primary-subtle text-primary">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-info-circle-fill"></i>
                    <span class="fw-bold small">@(isEn ? "Smart Assistance" : "Hỗ trợ Đa năng")</span>
                </div>
                <p class="small mb-0 opacity-90 lh-base" style="font-size: 0.8rem;">
                    @(isEn
                        ? "You can paste compiler error messages or ask for code reviews directly in the chat box."
                        : "Bạn có thể dán mã lỗi biên dịch (vd: CS0103, CS0029) hoặc yêu cầu review code trực tiếp trong khung chat.")
                </p>
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="col-lg-8 col-xl-9">
            <div class="card border shadow-sm rounded-4 bg-body d-flex flex-column" style="height: 650px;">
                <!-- Chat Messages Scroll Container -->
                <div class="flex-grow-1 p-3 p-md-4 overflow-y-auto" id="chatMessagesContainer">
                    <!-- Initial Welcome Message from AI -->
                    <div class="d-flex gap-3 mb-4 ai-msg-item">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                            <i class="bi bi-robot fs-5"></i>
                        </div>
                        <div class="flex-grow-1" style="max-width: 90%;">
                            <div class="p-3 rounded-4 bg-body-tertiary border text-body shadow-xs">
                                <div class="fw-bold mb-1 text-primary small d-flex align-items-center gap-2">
                                    <span>NET-Tutos AI Mentor</span>
                                    <span class="badge bg-success-subtle text-success" style="font-size: 0.65rem;">Online</span>
                                </div>
                                <div class="markdown-body small lh-lg">
                                    <p class="mb-2">
                                        @(isEn
                                            ? "Hello! I am your AI .NET & C# Mentor. How can I assist your coding journey today?"
                                            : "Xin chào! Tôi là Trợ lý AI Gia Sư .NET của bạn. Hôm nay bạn đang gặp thử thách gì với C# hoặc ASP.NET Core?")
                                    </p>
                                    <p class="mb-0 text-muted">
                                        @(isEn
                                            ? "You can choose a suggested topic from the left sidebar or type any question below!"
                                            : "Bạn có thể chọn chủ đề gợi ý bên trái hoặc gõ bất kỳ câu hỏi nào bên dưới nhé!")
                                    </p>
                                </div>
                            </div>
                            <span class="text-muted small ps-2" style="font-size: 0.7rem;">@(DateTime.Now.ToString("HH:mm"))</span>
                        </div>
                    </div>
                </div>

                <!-- Typing indicator -->
                <div class="px-4 py-2 d-none" id="typingIndicator">
                    <div class="d-flex align-items-center gap-2 text-muted small">
                        <div class="spinner-grow spinner-grow-sm text-primary" role="status" style="width: 10px; height: 10px;"></div>
                        <span style="font-size: 0.8rem;">@(isEn ? "AI Tutor is analyzing..." : "AI Tutor đang suy nghĩ...")</span>
                    </div>
                </div>

                <!-- Chat Input Controls -->
                <div class="p-3 border-top bg-body-tertiary rounded-bottom-4">
                    <form id="chatForm" onsubmit="handleSendChat(event)">
                        <div class="input-group shadow-xs rounded-3 overflow-hidden bg-body border">
                            <textarea id="chatInput" class="form-control border-0 p-2.5 small" rows="2" placeholder="@(isEn ? "Ask a C#/.NET question or paste an error message... (Enter to send)" : "Hỏi về C#/.NET hoặc dán mã lỗi biên dịch... (Enter để gửi)")" style="resize: none;"></textarea>
                            <button type="submit" class="btn btn-primary px-4 d-flex align-items-center justify-content-center" id="btnSendChat" title="@(isEn ? "Send message" : "Gửi tin nhắn")">
                                <i class="bi bi-send-fill fs-5"></i>
                            </button>
                        </div>
                        <div class="d-flex align-items-center justify-content-between mt-2 px-1">
                            <span class="text-muted" style="font-size: 0.72rem;">
                                <i class="bi bi-keyboard me-1"></i>@(isEn ? "Press Enter to send, Shift+Enter for new line" : "Nhấn Enter để gửi, Shift+Enter để xuống dòng")
                            </span>
                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.7rem;">C# 14 • ASP.NET Core 10</span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const chatContainer = document.getElementById('chatMessagesContainer');
    const chatInput = document.getElementById('chatInput');
    const typingIndicator = document.getElementById('typingIndicator');
    const btnSendChat = document.getElementById('btnSendChat');
    const isEn = @(isEn ? "true" : "false");

    // Handle Enter to send
    chatInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            handleSendChat(e);
        }
    });

    async function handleSendChat(e) {
        if (e) e.preventDefault();
        const text = chatInput.value.trim();
        if (!text) return;

        // Render user message
        appendUserMessage(text);
        chatInput.value = '';
        chatInput.focus();

        // Show typing
        showTyping(true);

        try {
            const res = await fetch('/AiTutor/Chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            });

            const data = await res.json();
            showTyping(false);

            if (data && data.responseMarkdown) {
                appendAiMessage(data.responseMarkdown, data.suggestedFollowUps, data.codeSnippet);
            } else {
                appendAiMessage(isEn ? "Sorry, I could not process your query. Please try again." : "Rất tiếc, AI chưa thể xử lý yêu cầu này. Vui lòng thử lại câu hỏi khác nhé.");
            }
        } catch (err) {
            showTyping(false);
            appendAiMessage(isEn ? "Error connecting to AI Tutor service." : "Có lỗi kết nối đến máy chủ AI Tutor. Vui lòng kiểm tra lại kết nối mạng.");
        }
    }

    function sendPresetPrompt(type) {
        let msg = '';
        if (type === 'linq') msg = isEn ? 'Explain LINQ deferred execution with examples' : 'Giải thích LINQ và cơ chế Deferred Execution trong C#';
        if (type === 'async') msg = isEn ? 'How does async await work and how to prevent deadlocks?' : 'Cơ chế hoạt động của async await và cách phòng chống deadlock trong C#';
        if (type === 'di') msg = isEn ? 'What is the difference between Transient, Scoped, and Singleton in ASP.NET Core?' : 'Phân biệt AddTransient, AddScoped và AddSingleton trong ASP.NET Core';
        if (type === 'record') msg = isEn ? 'When should I use Record instead of Class in C#?' : 'Khi nào nên dùng Record thay vì Class trong C#?';
        if (type === 'null') msg = isEn ? 'How to fix and prevent NullReferenceException?' : 'Làm thế nào để sửa lỗi NullReferenceException trong C#?';

        chatInput.value = msg;
        handleSendChat();
    }

    function appendUserMessage(text) {
        const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const html = `
            <div class="d-flex gap-3 mb-4 justify-content-end user-msg-item">
                <div class="flex-grow-1 text-end" style="max-width: 85%;">
                    <div class="p-3 rounded-4 bg-primary text-white d-inline-block text-start shadow-xs">
                        <div class="small lh-base">${escapeHtml(text)}</div>
                    </div>
                    <div class="text-muted pe-2 mt-1" style="font-size: 0.7rem;">${timeStr}</div>
                </div>
                <div class="rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                    <i class="bi bi-person-fill fs-5"></i>
                </div>
            </div>`;
        chatContainer.insertAdjacentHTML('beforeend', html);
        scrollToBottom();
    }

    function appendAiMessage(markdown, followUps, codeSnippet) {
        const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        let formatted = formatSimpleMarkdown(markdown);

        let followUpsHtml = '';
        if (followUps && followUps.length > 0) {
            const chips = followUps.map(f => `<button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0.5 px-2.5 small me-1 mb-1" style="font-size: 0.75rem;" onclick="quickAsk('${escapeHtml(f)}')"><i class="bi bi-chat-dots me-1"></i>${escapeHtml(f)}</button>`).join('');
            followUpsHtml = `<div class="mt-3 pt-2 border-top"><div class="text-muted small mb-1" style="font-size: 0.72rem;">${isEn ? 'Suggested Follow-ups:' : 'Gợi ý câu hỏi tiếp theo:'}</div><div class="d-flex flex-wrap">${chips}</div></div>`;
        }

        const html = `
            <div class="d-flex gap-3 mb-4 ai-msg-item">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px;">
                    <i class="bi bi-robot fs-5"></i>
                </div>
                <div class="flex-grow-1" style="max-width: 90%;">
                    <div class="p-3 rounded-4 bg-body-tertiary border text-body shadow-xs">
                        <div class="fw-bold mb-1 text-primary small d-flex align-items-center gap-2">
                            <span>NET-Tutos AI Mentor</span>
                            <span class="badge bg-primary-subtle text-primary" style="font-size: 0.65rem;">C# Expert</span>
                        </div>
                        <div class="markdown-body small lh-lg">${formatted}</div>
                        ${followUpsHtml}
                    </div>
                    <span class="text-muted small ps-2 mt-1 d-inline-block" style="font-size: 0.7rem;">${timeStr}</span>
                </div>
            </div>`;

        chatContainer.insertAdjacentHTML('beforeend', html);
        scrollToBottom();

        // Highlight code
        if (window.Prism) {
            Prism.highlightAllUnder(chatContainer);
        }
    }

    function quickAsk(q) {
        chatInput.value = q;
        handleSendChat();
    }

    function showTyping(show) {
        if (show) {
            typingIndicator.classList.remove('d-none');
            btnSendChat.disabled = true;
        } else {
            typingIndicator.classList.add('d-none');
            btnSendChat.disabled = false;
        }
        scrollToBottom();
    }

    function scrollToBottom() {
        chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function clearChatHistory() {
        if (confirm(isEn ? "Reset conversation?" : "Làm mới cuộc trò chuyện?")) {
            location.reload();
        }
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function formatSimpleMarkdown(text) {
        if (!text) return '';
        let html = text
            .replace(/### (.*?)\n/g, '<h5 class="fw-bold text-primary mt-2 mb-2">$1</h5>')
            .replace(/#### (.*?)\n/g, '<h6 class="fw-bold mt-2 mb-1">$1</h6>')
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/```csharp\n([\s\S]*?)```/g, '<div class="position-relative my-2"><pre class="rounded-3 p-3 bg-dark text-light"><code class="language-csharp">$1</code></pre></div>')
            .replace(/```([\s\S]*?)```/g, '<div class="position-relative my-2"><pre class="rounded-3 p-3 bg-dark text-light"><code>$1</code></pre></div>')
            .replace(/`([^`]+)`/g, '<code class="bg-secondary-subtle px-1.5 py-0.5 rounded text-primary">$1</code>')
            .replace(/\n\n/g, '<br/><br/>')
            .replace(/\n/g, '<br/>');
        return html;
    }
</script>
}
