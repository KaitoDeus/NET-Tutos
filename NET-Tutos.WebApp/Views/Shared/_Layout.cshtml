@inject NET_Tutos.Data.AppDbContext DbContext
@using Microsoft.AspNetCore.Localization
@using Microsoft.EntityFrameworkCore
@using NET_Tutos.Services
@{
    bool isEn = Context.IsEnglish();
    var currentFlagPath = isEn ? "/images/flags/en.svg" : "/images/flags/vn.svg";
    var currentLangText = isEn ? "English" : "Tiếng Việt";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    List<NET_Tutos.Models.Entities.Category> navCategories = new();
    List<NET_Tutos.Models.Entities.Tutorial> searchTutorials = new();
    try
    {
        navCategories = DbContext.Categories.OrderBy(c => c.OrderIndex).ToList();
        searchTutorials = DbContext.Tutorials.Include(t => t.Category).OrderBy(t => t.OrderIndex).Take(150).ToList();
    }
    catch
    {
        // Safe fallback
    }

    var searchDataJson = System.Text.Json.JsonSerializer.Serialize(searchTutorials.Select(t => new {
        id = t.Id,
        title = t.GetTitle(isEn),
        slug = t.GetSlug(isEn),
        category = t.Category != null ? t.Category.GetTitle(isEn) : "",
        readingMinutes = t.EstimatedReadingMinutes,
        difficulty = LocalizationHelper.GetDifficultyName(t.Difficulty, isEn)
    }));

    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    bool isHomeActive = currentController == "Home" && currentAction == "Index";
    bool isCoursesActive = currentController == "Tutorials" || currentController == "Roadmap" || currentController == "CheatSheet" || currentController == "Curriculum" || currentController == "Planner";
    bool isPracticeActive = currentController == "Playground" || currentController == "Quiz" || currentController == "Exam" || currentController == "Project" || currentController == "Interview" || currentController == "AiTutor";
    bool isCommunityActive = currentController == "Leaderboard" || currentController == "Activity";
}
<!DOCTYPE html>
<html lang="@(isEn ? "en" : "vi")" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6366f1" />
    <title>@(string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString()) || ViewData["Title"]?.ToString() == "Trang chủ" ? (isEn ? "Home | NET-Tutos" : "Trang chủ | NET-Tutos") : $"{ViewData["Title"]} | NET-Tutos")</title>

    <!-- PWA Web App Manifest -->
    <link rel="manifest" href="/manifest.json" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/images/csharp-logo.png" />
    <link rel="shortcut icon" type="image/png" href="~/images/csharp-logo.png" />

    <!-- Google Fonts (Fira Code, JetBrains Mono, Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Prism.js Syntax Highlighting (VS Code Dark theme) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/toolbar/prism-toolbar.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Reading Progress Indicator -->
    <div id="readingProgressBar" class="progress-bar-top"></div>

    <!-- Navigation Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg border-bottom shadow-sm bg-body">
            <div class="container-fluid px-3 px-xl-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-decoration-none py-1 me-2 me-sm-3" asp-controller="Home" asp-action="Index">
                    <img src="~/images/csharp-logo.png" alt="C# Logo" width="30" height="34" class="csharp-nav-logo" />
                    <span class="brand-text fw-extrabold fs-4"><span class="text-dotnet">.NET</span><span class="text-body-emphasis"> Tutos</span></span>
                </a>

                <!-- Mobile Quick Actions Bar (Language Switch, Theme Switch & Toggler) -->
                <div class="d-flex align-items-center gap-2 d-lg-none ms-auto">
                    <!-- Mobile Language Switcher Dropdown -->
                    <div class="dropdown lang-dropdown-container">
                        <button class="btn btn-sm lang-switcher-btn rounded-circle p-0" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="@(isEn ? "Language" : "Ngôn ngữ")" style="width: 32px; height: 32px;">
                            <img src="@currentFlagPath" alt="@currentLangText" class="lang-flag-current" style="width: 22px; height: 22px;" />
                        </button>
                        <ul class="dropdown-menu shadow border-0 lang-dropdown-menu py-1.5 px-1 mt-1">
                            <li>
                                <a class="dropdown-item lang-item d-flex align-items-center gap-2 py-1.5 px-2.5 rounded-2 @(isEn ? "active fw-semibold" : "")"
                                   asp-controller="Language" asp-action="SetLanguage" asp-route-culture="en" asp-route-returnUrl="@returnUrl">
                                    <img src="/images/flags/en.svg" alt="English" class="lang-flag-option" width="20" height="20" />
                                    <span>English</span>
                                    @if (isEn) { <i class="bi bi-check2 ms-auto text-primary"></i> }
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item lang-item d-flex align-items-center gap-2 py-1.5 px-2.5 rounded-2 @(!isEn ? "active fw-semibold" : "")"
                                   asp-controller="Language" asp-action="SetLanguage" asp-route-culture="vi" asp-route-returnUrl="@returnUrl">
                                    <img src="/images/flags/vn.svg" alt="Tiếng Việt" class="lang-flag-option" width="20" height="20" />
                                    <span>Tiếng Việt</span>
                                    @if (!isEn) { <i class="bi bi-check2 ms-auto text-primary"></i> }
                                </a>
                            </li>
                        </ul>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary rounded-circle theme-btn p-1.5" type="button" onclick="document.getElementById('themeToggleBtn').click()" title="@(isEn ? "Toggle theme" : "Chuyển chế độ Sáng / Tối")">
                        <i class="bi bi-moon-stars-fill mobile-theme-icon"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary rounded-circle p-1.5" type="button" onclick="openCommandPaletteModal()" title="@(isEn ? "Search & Commands (Ctrl+K)" : "Tìm kiếm & Bảng lệnh (Ctrl+K)")" style="width: 32px; height: 32px;">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="btn btn-sm btn-outline-warning rounded-circle p-1 d-flex align-items-center justify-content-center mobile-streak-btn"
                                style="width: 32px; height: 32px;" type="button" data-bs-toggle="modal" data-bs-target="#streakModal" title="@(isEn ? "Daily Learning Streak" : "Chuỗi học tập hàng ngày")">
                            <i class="bi bi-fire text-danger"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary rounded-circle p-1 position-relative d-flex align-items-center justify-content-center"
                                style="width: 32px; height: 32px;" type="button" onclick="document.getElementById('btnNavNotification')?.click()" title="@(isEn ? "Notifications" : "Thông báo")">
                            <i class="bi bi-bell-fill"></i>
                            <span id="mobileNotificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.6rem;">0</span>
                        </button>
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-sm btn-outline-primary rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="@(isEn ? "Learning Dashboard" : "Góc học tập")">
                            <i class="bi bi-person-fill"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 small fw-semibold" title="@(isEn ? "Login" : "Đăng nhập")">
                            @(isEn ? "Login" : "Đăng nhập")
                        </a>
                    }
                    <button class="navbar-toggler border-0 p-1.5 rounded-3 shadow-none bg-body-tertiary" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                            aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon" style="width: 1.25em; height: 1.25em;"></span>
                    </button>
                </div>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-2 gap-1 gap-xl-1 align-items-lg-center">
                        <!-- 1. Trang chủ -->
                        <li class="nav-item">
                            <a class="nav-link text-nowrap @(isHomeActive ? "active fw-semibold" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> <span data-lang-key="nav_home">@(isEn ? "Home" : "Trang chủ")</span>
                            </a>
                        </li>

                        <!-- 2. Danh mục Khóa học & Lộ trình (Dropdown) -->
                        <li class="nav-item dropdown nav-category-dropdown">
                            <a class="nav-link dropdown-toggle text-nowrap @(isCoursesActive ? "active fw-semibold" : "")"
                               href="#" id="navCoursesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid-fill me-1 text-primary"></i> <span data-lang-key="nav_courses">@(isEn ? "Courses & Roadmap" : "Khóa học & Lộ trình")</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-start shadow-lg border-0 rounded-4 p-3 mt-0 nav-mega-dropdown" aria-labelledby="navCoursesDropdown">
                                <div class="mega-menu-grid">
                                    <!-- Cột 1: Danh mục chuyên đề -->
                                    <div class="mega-menu-col mega-menu-divider">
                                        <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                            <span class="text-uppercase fw-bold text-muted small" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                                <i class="bi bi-collection-play me-1 text-primary"></i> <span data-lang-key="nav_topics">@(isEn ? "Topic Categories" : "Danh mục chuyên đề")</span>
                                            </span>
                                            <a asp-controller="Tutorials" asp-action="Index" class="small text-primary text-decoration-none fw-semibold">
                                                <span data-lang-key="nav_view_all">@(isEn ? "View all" : "Xem tất cả")</span> <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            @if (navCategories.Any())
                                            {
                                                @foreach (var cat in navCategories)
                                                {
                                                    string levelBadge = cat.Level switch
                                                    {
                                                        DifficultyLevel.Beginner => isEn ? "Beginner" : "Cơ bản",
                                                        DifficultyLevel.Intermediate => isEn ? "Intermediate" : "Trung cấp",
                                                        DifficultyLevel.Advanced => isEn ? "Advanced" : "Nâng cao",
                                                        _ => isEn ? "Beginner" : "Cơ bản"
                                                    };
                                                    <a class="dropdown-item category-item-card p-2 rounded-3 @(currentController == "Tutorials" && (Context.Request.Query["category"] == cat.Slug || Context.Request.Query["category"] == cat.GetSlug(true)) ? "active" : "")"
                                                       asp-controller="Tutorials" asp-action="Index" asp-route-category="@cat.GetSlug(isEn)">
                                                        <div class="category-icon-box bg-@cat.BadgeColor-subtle text-@cat.BadgeColor">
                                                            <i class="bi @cat.IconClass"></i>
                                                        </div>
                                                        <div class="category-content-box">
                                                            <div class="d-flex align-items-center justify-content-between gap-1 mb-0.5">
                                                                <span class="category-text-title">@cat.GetTitle(isEn)</span>
                                                                <span class="badge bg-@cat.BadgeColor-subtle text-@cat.BadgeColor rounded-pill flex-shrink-0" style="font-size: 0.65rem;">
                                                                    @levelBadge
                                                                </span>
                                                            </div>
                                                            <span class="category-text-desc">@cat.GetDesc(isEn)</span>
                                                        </div>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <!-- Cột 2: Lối tắt học tập & Tra cứu -->
                                    <div class="mega-menu-col">
                                        <div class="d-flex align-items-center justify-content-between mb-2 pb-1 border-bottom">
                                            <span class="text-uppercase fw-bold text-muted small" style="font-size: 0.72rem; letter-spacing: 0.05em;">
                                                <i class="bi bi-compass me-1 text-warning"></i> <span data-lang-key="nav_shortcuts">@(isEn ? "Quick Learning" : "Lối tắt học tập")</span>
                                            </span>
                                        </div>
                                        <div class="d-flex flex-column gap-1">
                                            <a class="dropdown-item category-shortcut-card p-2 rounded-3 @(currentController == "Curriculum" ? "active" : "")"
                                               asp-controller="Curriculum" asp-action="Index">
                                                <div class="category-icon-box bg-danger-subtle text-danger">
                                                    <i class="bi bi-collection-play-fill"></i>
                                                </div>
                                                <div class="category-content-box">
                                                    <span class="category-text-title" data-lang-key="nav_curriculum">@(isEn ? "Full Curriculum (101 Lessons)" : "Chương trình C# (101 bài)")</span>
                                                    <span class="category-text-desc" data-lang-key="nav_curriculum_desc">@(isEn ? "7 modules based on official Microsoft .NET syllabus" : "7 phân hệ chuẩn hóa theo Microsoft .NET")</span>
                                                </div>
                                            </a>

                                            <a class="dropdown-item category-shortcut-card p-2 rounded-3 @(currentController == "Planner" ? "active" : "")"
                                               asp-controller="Planner" asp-action="Index">
                                                <div class="category-icon-box bg-success-subtle text-success">
                                                    <i class="bi bi-calendar2-check-fill"></i>
                                                </div>
                                                <div class="category-content-box">
                                                    <span class="category-text-title" data-lang-key="nav_planner">@(isEn ? "Personal Study Planner" : "Kế hoạch & Mục tiêu học")</span>
                                                    <span class="category-text-desc" data-lang-key="nav_planner_desc">@(isEn ? "Goal tracking & streak protection" : "Theo dõi mục tiêu & duy trì Streak")</span>
                                                </div>
                                            </a>

                                            <a class="dropdown-item category-shortcut-card p-2 rounded-3 @(currentController == "Roadmap" ? "active" : "")"
                                               asp-controller="Roadmap" asp-action="Index">
                                                <div class="category-icon-box bg-warning-subtle text-warning">
                                                    <i class="bi bi-signpost-split"></i>
                                                </div>
                                                <div class="category-content-box">
                                                    <span class="category-text-title" data-lang-key="nav_roadmap">@(isEn ? "Standard Roadmap" : "Lộ trình học chuẩn")</span>
                                                    <span class="category-text-desc" data-lang-key="nav_roadmap_desc">@(isEn ? "Roadmap from Zero to Senior .NET" : "Bản đồ từ Zero đến Senior .NET")</span>
                                                </div>
                                            </a>

                                            <a class="dropdown-item category-shortcut-card p-2 rounded-3 @(currentController == "CheatSheet" ? "active" : "")"
                                               asp-controller="CheatSheet" asp-action="Index">
                                                <div class="category-icon-box bg-info-subtle text-info">
                                                    <i class="bi bi-code-square"></i>
                                                </div>
                                                <div class="category-content-box">
                                                    <span class="category-text-title" data-lang-key="nav_cheatsheet">@(isEn ? "C# Cheatsheet" : "Tra cứu Code C#")</span>
                                                    <span class="category-text-desc" data-lang-key="nav_cheatsheet_desc">@(isEn ? "Quick syntax guide & code samples" : "Sổ tay cú pháp & ví dụ mẫu")</span>
                                                </div>
                                            </a>

                                            <a class="dropdown-item category-shortcut-card p-2 rounded-3 @(currentController == "Tutorials" && string.IsNullOrEmpty(Context.Request.Query["category"]) ? "active" : "")"
                                               asp-controller="Tutorials" asp-action="Index">
                                                <div class="category-icon-box bg-primary-subtle text-primary">
                                                    <i class="bi bi-book"></i>
                                                </div>
                                                <div class="category-content-box">
                                                    <span class="category-text-title" data-lang-key="nav_library">@(isEn ? "Tutorials Library" : "Thư viện bài học")</span>
                                                    <span class="category-text-desc" data-lang-key="nav_library_desc">@(isEn ? "Full treasury of C#/.NET tutorials" : "Toàn bộ kho tàng bài viết C#/.NET")</span>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Bottom quick link banner -->
                                <div class="pt-2 mt-2 border-top">
                                    <div class="d-flex align-items-center justify-content-between px-1">
                                        <span class="small text-muted" data-lang-key="nav_lessons_count">
                                            <i class="bi bi-stars text-warning me-1"></i>@(isEn ? "Over 50+ free lessons & interactive challenges" : "Hơn 50+ bài học & thử thách miễn phí")
                                        </span>
                                        <a asp-controller="Roadmap" asp-action="Index" class="small fw-semibold text-primary text-decoration-none">
                                            <span data-lang-key="nav_start_roadmap">@(isEn ? "Start roadmap now" : "Bắt đầu lộ trình ngay")</span> <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </li>

                        <!-- 3. Thực hành & Thi đấu (Dropdown) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-nowrap @(isPracticeActive ? "active fw-semibold" : "")"
                               href="#" id="navPracticeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-cpu me-1 text-danger"></i> <span data-lang-key="nav_practice">@(isEn ? "Practice & Arena" : "Thực hành & Thi đấu")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-start shadow-lg border-0 rounded-4 p-2 mt-0 nav-standard-dropdown" aria-labelledby="navPracticeDropdown" style="min-width: 300px;">
                                <li>
                                    <a class="dropdown-item category-shortcut-card p-2 rounded-3 mb-1 @(currentController == "Playground" ? "active" : "")"
                                       asp-controller="Playground" asp-action="Index">
                                        <div class="category-icon-box bg-danger-subtle text-danger">
                                            <i class="bi bi-terminal-fill"></i>
                                        </div>
                                        <div class="category-content-box">
                                            <span class="category-text-title" data-lang-key="nav_sandbox">@(isEn ? "C# Sandbox Playground" : "Luyện Code C# Sandbox")</span>
                                            <span class="category-text-desc" data-lang-key="nav_sandbox_desc">@(isEn ? "Live compile & solve challenges" : "Biên dịch trực tiếp & giải thử thách")</span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item category-shortcut-card p-2 rounded-3 mb-1 @(currentController == "Quiz" ? "active" : "")"
                                       asp-controller="Quiz" asp-action="Index">
                                        <div class="category-icon-box bg-success-subtle text-success">
                                            <i class="bi bi-patch-question"></i>
                                        </div>
                                        <div class="category-content-box">
                                            <span class="category-text-title" data-lang-key="nav_quiz">@(isEn ? "Knowledge Quiz" : "Trắc nghiệm kiến thức")</span>
                                            <span class="category-text-desc" data-lang-key="nav_quiz_desc">@(isEn ? "Quick revision & theory booster" : "Ôn tập nhanh củng cố lý thuyết")</span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item category-shortcut-card p-2 rounded-3 mb-1 @(currentController == "Exam" ? "active" : "")"
                                       asp-controller="Exam" asp-action="Index">
                                        <div class="category-icon-box bg-warning-subtle text-warning">
                                            <i class="bi bi-mortarboard"></i>
                                        </div>
                                        <div class="category-content-box">
                                            <span class="category-text-title" data-lang-key="nav_exam">@(isEn ? "Exams & Certification" : "Thi & Cấp chứng chỉ")</span>
                                            <span class="category-text-desc" data-lang-key="nav_exam_desc">@(isEn ? "Graduation exam & earn digital certificate" : "Sát hạch tốt nghiệp nhận chứng chỉ số")</span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item category-shortcut-card p-2 rounded-3 mb-1 @(currentController == "Project" ? "active" : "")"
                                       asp-controller="Project" asp-action="Index">
                                        <div class="category-icon-box bg-primary-subtle text-primary">
                                            <i class="bi bi-folder-check"></i>
                                        </div>
                                        <div class="category-content-box">
                                            <span class="category-text-title" data-lang-key="nav_project">@(isEn ? "Capstone Projects" : "Đồ án thực chiến (Capstone)")</span>
                                            <span class="category-text-desc" data-lang-key="nav_project_desc">@(isEn ? "Build production-grade applications" : "Xây dựng sản phẩm chuẩn doanh nghiệp")</span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item category-shortcut-card p-2 rounded-3 mb-1 @(currentController == "Interview" ? "active" : "")"
                                       asp-controller="Interview" asp-action="Index">
                                        <div class="category-icon-box bg-danger-subtle text-danger">
                                            <i class="bi bi-mortarboard-fill"></i>
                                        </div>
                                        <div class="category-content-box">
                                            <span class="category-text-title" data-lang-key="nav_interview">@(isEn ? "Interview Prep & Flashcards" : "Luyện Phỏng Vấn & Flashcards")</span>
                                            <span class="category-text-desc" data-lang-key="nav_interview_desc">@(isEn ? "Spaced repetition & technical mock exams" : "Thẻ ghi nhớ ngắt quãng & phỏng vấn thử")</span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item category-shortcut-card p-2 rounded-3 @(currentController == "AiTutor" ? "active" : "")"
                                       asp-controller="AiTutor" asp-action="Index">
                                        <div class="category-icon-box bg-info-subtle text-info">
                                            <i class="bi bi-robot"></i>
                                        </div>
                                        <div class="category-content-box">
                                            <span class="category-text-title" data-lang-key="nav_aitutor">@(isEn ? "AI .NET Tutor & Mentor" : "Trợ Lý AI Gia Sư .NET")</span>
                                            <span class="category-text-desc" data-lang-key="nav_aitutor_desc">@(isEn ? "Realtime error diagnosis & code hints" : "Chẩn đoán lỗi, gợi ý thuật toán & hỏi đáp")</span>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- 4. Cộng đồng (Dropdown) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-nowrap @(isCommunityActive ? "active fw-semibold" : "")"
                               href="#" id="navCommunityDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-people-fill me-1 text-warning"></i> <span data-lang-key="nav_community">@(isEn ? "Community" : "Cộng đồng")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-start shadow-lg border-0 rounded-4 p-2 mt-0 nav-standard-dropdown" aria-labelledby="navCommunityDropdown" style="min-width: 280px;">
                                <li>
                                    <a class="dropdown-item category-shortcut-card p-2 rounded-3 mb-1 @(currentController == "Leaderboard" ? "active" : "")"
                                       asp-controller="Leaderboard" asp-action="Index">
                                        <div class="category-icon-box bg-warning-subtle text-warning">
                                            <i class="bi bi-trophy-fill"></i>
                                        </div>
                                        <div class="category-content-box">
                                            <span class="category-text-title" data-lang-key="nav_leaderboard">@(isEn ? "Hall of Fame" : "Bảng vinh danh")</span>
                                            <span class="category-text-desc" data-lang-key="nav_leaderboard_desc">@(isEn ? "Top 1,000 outstanding learners" : "Top 1.000 học viên xuất sắc")</span>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item category-shortcut-card p-2 rounded-3 @(currentController == "Activity" ? "active" : "")"
                                       asp-controller="Activity" asp-action="Index">
                                        <div class="category-icon-box bg-info-subtle text-info">
                                            <i class="bi bi-activity"></i>
                                        </div>
                                        <div class="category-content-box">
                                            <span class="category-text-title" data-lang-key="nav_activity">@(isEn ? "Activity Feed" : "Bảng tin hoạt động")</span>
                                            <span class="category-text-desc" data-lang-key="nav_activity_desc">@(isEn ? "Live learning pulse of community" : "Nhịp đập học tập của cộng đồng")</span>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Search Box & Command Palette Trigger -->
                    <div class="d-flex align-items-center my-2 my-lg-0 me-lg-2 w-100 w-lg-auto">
                        <form class="d-flex w-100" asp-controller="Tutorials" asp-action="Index" method="get">
                            <div class="input-group input-group-sm search-group w-100">
                                <input class="form-control" type="search" name="search" placeholder="@(isEn ? "Search lessons..." : "Tìm bài học...")" aria-label="Search" value="@Context.Request.Query["search"]" data-lang-placeholder="search_placeholder">
                                <button class="btn btn-outline-primary" type="submit" title="@(isEn ? "Search" : "Tìm kiếm")">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-secondary d-none d-xl-inline-flex align-items-center gap-1 rounded-pill px-2.5 py-1 ms-1.5 text-muted text-nowrap shadow-none" onclick="openCommandPaletteModal()" title="@(isEn ? "Quick Search & Command (Ctrl+K)" : "Tìm nhanh & Bảng lệnh (Ctrl+K)")" style="font-size: 0.75rem; height: 31px;">
                            <i class="bi bi-command"></i> <kbd class="bg-transparent border-0 p-0 text-muted">Ctrl K</kbd>
                        </button>
                    </div>

                    <!-- User Account / Auth Menu -->
                    <div class="d-flex align-items-center gap-2 me-lg-2 my-2 my-lg-0 mobile-nav-auth">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Desktop Language Switcher Dropdown (Authenticated) -->
                            <div class="dropdown lang-dropdown-container">
                                <button class="btn btn-sm lang-switcher-btn rounded-circle p-0" type="button" id="langDropdownUser" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="@(isEn ? "Language" : "Ngôn ngữ")">
                                    <img src="@currentFlagPath" alt="@currentLangText" class="lang-flag-current" width="28" height="28" />
                                </button>
                                <ul class="dropdown-menu shadow border-0 lang-dropdown-menu py-1.5 px-1 mt-1" aria-labelledby="langDropdownUser">
                                    <li>
                                        <a class="dropdown-item lang-item d-flex align-items-center gap-2.5 py-1.5 px-2.5 rounded-2 @(isEn ? "active fw-semibold" : "")"
                                           asp-controller="Language" asp-action="SetLanguage" asp-route-culture="en" asp-route-returnUrl="@returnUrl">
                                            <img src="/images/flags/en.svg" alt="English" class="lang-flag-option" width="22" height="22" />
                                            <span>English</span>
                                            @if (isEn) { <i class="bi bi-check2 ms-auto text-primary small"></i> }
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item lang-item d-flex align-items-center gap-2.5 py-1.5 px-2.5 rounded-2 @(!isEn ? "active fw-semibold" : "")"
                                           asp-controller="Language" asp-action="SetLanguage" asp-route-culture="vi" asp-route-returnUrl="@returnUrl">
                                            <img src="/images/flags/vn.svg" alt="Tiếng Việt" class="lang-flag-option" width="22" height="22" />
                                            <span>Tiếng Việt</span>
                                            @if (!isEn) { <i class="bi bi-check2 ms-auto text-primary small"></i> }
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Streak Quick Badge Button -->
                            <button id="btnNavStreak" class="btn btn-sm btn-outline-warning rounded-pill px-3 py-1.5 d-flex align-items-center gap-2 text-nowrap fw-bold shadow-none"
                                    type="button" data-bs-toggle="modal" data-bs-target="#streakModal" title="@(isEn ? "Daily Learning Streak" : "Chuỗi học tập hàng ngày (Streak)")">
                                <i class="bi bi-fire text-danger fs-6 streak-fire-icon me-1"></i>
                                <span id="navStreakCountText">0 @(isEn ? "days" : "ngày")</span>
                            </button>

                            <!-- Notification Center Dropdown -->
                            <div class="dropdown" id="notificationDropdownContainer">
                                <button id="btnNavNotification" class="btn btn-sm btn-outline-secondary rounded-circle position-relative p-1.5 d-flex align-items-center justify-content-center shadow-none"
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false" title="@(isEn ? "Notification Center" : "Trung tâm Thông báo")" style="width: 34px; height: 34px;">
                                    <i class="bi bi-bell-fill fs-6" id="navBellIcon"></i>
                                    <span id="navNotificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 0.65rem;">
                                        0
                                    </span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg border rounded-4 p-0 mt-2 notification-menu" style="width: 360px; max-width: 92vw;">
                                    <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-body-tertiary rounded-top-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="fw-bold mb-0"><i class="bi bi-bell-fill text-primary me-2"></i>@(isEn ? "Notifications" : "Thông báo")</h6>
                                            <span id="notificationUnreadPill" class="badge bg-danger rounded-pill d-none">0 @(isEn ? "new" : "mới")</span>
                                        </div>
                                        <button id="btnMarkAllRead" class="btn btn-sm btn-link text-decoration-none p-0 small fw-semibold text-muted" type="button">
                                            <i class="bi bi-check2-all me-2"></i>@(isEn ? "Mark all read" : "Đọc tất cả")
                                        </button>
                                    </div>
                                    <div id="notificationListItems" class="notification-scroll-container overflow-y-auto" style="max-height: 380px;">
                                        <div class="text-center py-4 text-muted small" id="notificationLoadingState">
                                            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                                            <div>@(isEn ? "Loading notifications..." : "Đang tải thông báo...")</div>
                                        </div>
                                    </div>
                                    <div class="p-2 border-top text-center bg-body-tertiary rounded-bottom-4">
                                        <a asp-controller="Activity" asp-action="Index" class="btn btn-sm btn-link text-decoration-none small fw-semibold text-primary">
                                            @(isEn ? "View community activity feed" : "Xem bảng tin hoạt động cộng đồng") <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="dropdown w-100 w-lg-auto">
                                <button class="btn btn-sm btn-outline-primary dropdown-toggle d-flex align-items-center justify-content-between justify-content-lg-start gap-2 rounded-pill px-3 py-1.5 text-nowrap w-100 w-lg-auto shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-circle fs-6 me-1"></i>
                                        <span class="fw-semibold text-truncate" style="max-width: 140px;">@(User.Identity.Name?.Split('@')[0] ?? (isEn ? "Learner" : "Học viên"))</span>
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border rounded-3 p-2 mt-2 w-100 w-lg-auto" style="min-width: 260px;">
                                    <li>
                                        <a class="dropdown-item py-2 px-3 rounded-2 d-flex align-items-center gap-2.5 text-nowrap @(currentController == "Account" && currentAction == "Profile" ? "active" : "")" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-mortarboard text-primary fs-6"></i> <span>@(isEn ? "Learning Dashboard" : "Góc học tập")</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 px-3 rounded-2 d-flex align-items-center gap-2.5 text-nowrap @(currentController == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="MyPortfolio">
                                            <i class="bi bi-briefcase-fill text-info fs-6"></i> <span>@(isEn ? "Public Portfolio" : "Hồ sơ Portfolio")</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 px-3 rounded-2 d-flex align-items-center gap-2.5 @(currentController == "Project" && currentAction == "MyProjects" ? "active" : "")" asp-controller="Project" asp-action="MyProjects">
                                            <i class="bi bi-folder-check text-success fs-6"></i> <span>@(isEn ? "My Projects" : "Đồ án của tôi")</span>
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 px-3 rounded-2 d-flex align-items-center gap-2.5 text-primary fw-semibold @(currentController == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-speedometer2 fs-6"></i> <span>@(isEn ? "LMS Admin" : "Quản trị LMS")</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 px-3 rounded-2 d-flex align-items-center gap-2.5 text-warning fw-semibold @(currentController == "AdminProjects" ? "active" : "")" asp-controller="AdminProjects" asp-action="Submissions">
                                                <i class="bi bi-inbox-fill fs-6"></i> <span>@(isEn ? "Review Submissions" : "Duyệt đồ án học viên")</span>
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider my-1.5 opacity-50"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item py-2 px-3 rounded-2 d-flex align-items-center gap-2.5 text-danger">
                                                <i class="bi bi-box-arrow-right fs-6"></i> <span>@(isEn ? "Logout" : "Đăng xuất")</span>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="auth-btn-group d-flex align-items-center w-100 w-lg-auto" style="gap: 8px;">
                                <!-- Language Switcher Dropdown (Matches Image 2) -->
                                <div class="dropdown lang-dropdown-container">
                                    <button class="btn btn-sm lang-switcher-btn rounded-circle p-0" type="button" id="langDropdownAuth" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" title="@(isEn ? "Language" : "Ngôn ngữ")">
                                        <img src="@currentFlagPath" alt="@currentLangText" class="lang-flag-current" width="28" height="28" />
                                    </button>
                                    <ul class="dropdown-menu shadow border-0 lang-dropdown-menu py-1.5 px-1 mt-1" aria-labelledby="langDropdownAuth">
                                        <li>
                                            <a class="dropdown-item lang-item d-flex align-items-center gap-2.5 py-1.5 px-2.5 rounded-2 @(isEn ? "active fw-semibold" : "")"
                                               asp-controller="Language" asp-action="SetLanguage" asp-route-culture="en" asp-route-returnUrl="@returnUrl">
                                                <img src="/images/flags/en.svg" alt="English" class="lang-flag-option" width="22" height="22" />
                                                <span>English</span>
                                                @if (isEn) { <i class="bi bi-check2 ms-auto text-primary small"></i> }
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item lang-item d-flex align-items-center gap-2.5 py-1.5 px-2.5 rounded-2 @(!isEn ? "active fw-semibold" : "")"
                                               asp-controller="Language" asp-action="SetLanguage" asp-route-culture="vi" asp-route-returnUrl="@returnUrl">
                                                <img src="/images/flags/vn.svg" alt="Tiếng Việt" class="lang-flag-option" width="22" height="22" />
                                                <span>Tiếng Việt</span>
                                                @if (!isEn) { <i class="bi bi-check2 ms-auto text-primary small"></i> }
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1.5 fw-semibold text-nowrap flex-grow-1 flex-lg-grow-0 text-center">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>@(isEn ? "Login" : "Đăng nhập")
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-semibold text-nowrap flex-grow-1 flex-lg-grow-0 text-center">
                                    @(isEn ? "Register" : "Đăng ký")
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Desktop Theme Switcher -->
                    <div class="d-none d-lg-flex align-items-center">
                        <button id="themeToggleBtn" class="btn btn-sm btn-outline-secondary rounded-circle theme-btn" type="button" title="@(isEn ? "Toggle theme" : "Chuyển chế độ Sáng / Tối")">
                            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1 pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-4 bg-body-tertiary border-top">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-0">
                        <img src="~/images/csharp-logo.png" alt="C# Logo" width="24" height="27" style="object-fit: contain;" />
                        <span class="badge bg-primary text-white p-1 px-2 rounded">.NET 10</span>
                        <span class="fw-bold">.NET Tutos</span>
                    </div>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <p class="text-muted small mb-0" data-lang-key="footer_copyright">
                        © @DateTime.Now.Year .NET Tutos. @(isEn ? "High-quality .NET programming learning & practice platform." : "Nền tảng học tập & thực hành lập trình .NET chất lượng cao.")
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Prism.js Syntax Highlighting & Copy Button -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-csharp.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-sql.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/toolbar/prism-toolbar.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/copy-to-clipboard/prism-copy-to-clipboard.min.js"></script>

    <!-- SignalR Client Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Global Floating AI Tutor Shortcut Button -->
    @if (currentController != "AiTutor")
    {
        <div class="floating-ai-container" style="position: fixed; bottom: 24px; right: 24px; z-index: 1070;">
            <a asp-controller="AiTutor" asp-action="Index" 
               class="btn btn-primary rounded-circle shadow-lg p-0 d-flex align-items-center justify-content-center floating-ai-btn position-relative text-decoration-none" 
               title="@(isEn ? "AI .NET Tutor & Mentor - Ask anything!" : "Trợ lý AI Gia sư .NET - Hỏi đáp & Sửa lỗi!")" 
               aria-label="AI Tutor">
                <i class="bi bi-robot fs-4 text-white"></i>
                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-danger border border-white shadow-sm floating-ai-badge">
                    AI
                    <span class="visually-hidden">AI Tutor</span>
                </span>
            </a>
        </div>
    }

    <!-- Live Notification Toast Container -->
    <div id="notificationToastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;"></div>

    <!-- Command Palette Modal (Ctrl + K / Cmd + K) -->
    <div class="modal fade" id="commandPaletteModal" tabindex="-1" aria-labelledby="commandPaletteLabel" aria-hidden="true" data-bs-backdrop="true">
        <div class="modal-dialog modal-dialog-centered command-palette-dialog">
            <div class="modal-content command-palette-content border-0">
                <div class="p-3 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-search text-primary fs-5"></i>
                    <input type="text" id="commandPaletteInput" class="form-control command-palette-input flex-grow-1"
                           placeholder="@(isEn ? "Search lessons, pages, or quick actions... (Esc to close)" : "Tìm bài học, điều hướng nhanh hoặc tác vụ... (Esc để đóng)")"
                           autocomplete="off" spellcheck="false" />
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="p-2 border-bottom d-flex align-items-center gap-2 bg-body-tertiary text-muted small px-3">
                    <span class="fw-semibold">@(isEn ? "Filters:" : "Bộ lọc:")</span>
                    <button type="button" class="badge rounded-pill bg-primary text-white border-0 cp-filter-tag" data-filter="all">@(isEn ? "All" : "Tất cả")</button>
                    <button type="button" class="badge rounded-pill bg-body-secondary text-body border-0 cp-filter-tag" data-filter="lesson">@(isEn ? "Lessons" : "Bài học")</button>
                    <button type="button" class="badge rounded-pill bg-body-secondary text-body border-0 cp-filter-tag" data-filter="nav">@(isEn ? "Navigation" : "Chuyển trang")</button>
                    <button type="button" class="badge rounded-pill bg-body-secondary text-body border-0 cp-filter-tag" data-filter="action">@(isEn ? "Actions" : "Tác vụ")</button>
                </div>
                <div class="command-palette-results py-2" id="commandPaletteResults">
                    <!-- Populated dynamically via JS -->
                </div>
                <div class="p-2.5 px-3 bg-body-tertiary border-top d-flex align-items-center justify-content-between text-muted small" style="font-size: 0.75rem;">
                    <div class="d-flex align-items-center gap-3">
                        <span><kbd class="bg-body text-body border shadow-none px-1 py-0.5">↑</kbd> <kbd class="bg-body text-body border shadow-none px-1 py-0.5">↓</kbd> @(isEn ? "Navigate" : "Di chuyển")</span>
                        <span><kbd class="bg-body text-body border shadow-none px-1 py-0.5">↵</kbd> @(isEn ? "Open" : "Chọn")</span>
                        <span><kbd class="bg-body text-body border shadow-none px-1 py-0.5">Esc</kbd> @(isEn ? "Close" : "Đóng")</span>
                    </div>
                    <span class="d-none d-sm-inline fw-semibold text-primary">NET-Tutos Quick Jump</span>
                </div>
            </div>
        </div>
    </div>
    <script id="commandPaletteData" type="application/json">@Html.Raw(searchDataJson)</script>

    <!-- Real-time Network Indicator Toast (PWA/Offline) -->
    <div id="networkStatusToast" class="network-status-toast" role="status" aria-live="polite">
        <i class="bi bi-wifi-off fs-5" id="networkStatusIcon"></i>
        <div>
            <div class="fw-bold" id="networkStatusTitle">@(isEn ? "Offline Mode" : "Chế độ Ngoại tuyến")</div>
            <div class="small opacity-75" id="networkStatusDesc">@(isEn ? "Viewing cached content" : "Đang dùng nội dung lưu trữ đệm")</div>
        </div>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_StreakModal" />
    }
</body>
</html>
