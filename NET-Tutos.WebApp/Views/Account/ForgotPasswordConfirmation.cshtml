@{
    bool isEn = Context.IsEnglish();
    ViewData["Title"] = isEn ? "Password Reset Instructions | NET-Tutos" : "Hướng dẫn đặt lại mật khẩu | NET-Tutos";
    bool userFound = ViewBag.UserFound == true;
    string? resetLink = ViewBag.ResetLink as string;
    string? email = ViewBag.SubmittedEmail as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border shadow-lg rounded-4 overflow-hidden bg-body text-center">
                <div class="card-header bg-gradient-dotnet text-white p-4">
                    <div class="rounded-circle bg-white bg-opacity-20 d-inline-flex p-3 mb-2">
                        <i class="bi bi-envelope-check-fill text-white fs-3"></i>
                    </div>
                    <h4 class="fw-bold mb-1">@(isEn ? "Password Reset Requested" : "Yêu Cầu Đã Được Tiếp Nhận")</h4>
                    <p class="small opacity-90 mb-0">@(isEn ? "Check the instructions below to complete your password update." : "Vui lòng xem thông tin bên dưới để tiếp tục đổi mật khẩu.")</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (userFound && !string.IsNullOrEmpty(resetLink))
                    {
                        <div class="alert alert-success rounded-3 p-3 text-start mb-4">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                <span class="fw-bold">@(isEn ? "Verification Successful!" : "Đã xác thực tài khoản hợp lệ!")</span>
                            </div>
                            <p class="small text-muted mb-3">
                                @(isEn
                                    ? $"A password reset token was generated for {email}. In this learning environment, click the button below to proceed directly to the new password setup:"
                                    : $"Mã bảo mật đặt lại mật khẩu đã được tạo cho tài khoản {email}. Trong môi trường học tập NET-Tutos, bạn có thể bấm trực tiếp vào nút dưới đây:")
                            </p>
                            <a href="@resetLink" class="btn btn-primary rounded-pill w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-shield-lock-fill"></i>
                                <span>@(isEn ? "Set New Password Now" : "Đặt Mật Khẩu Mới Ngay")</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info rounded-3 p-3 text-start mb-4">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-info-circle-fill text-info fs-5"></i>
                                <span class="fw-bold">@(isEn ? "Request Notice" : "Thông báo tiếp nhận")</span>
                            </div>
                            <p class="small text-muted mb-0">
                                @(isEn
                                    ? $"If the email \"{email}\" is registered in our database, password reset instructions have been handled. Please check your inbox or try signing in again."
                                    : $"Nếu địa chỉ email \"{email}\" đã được đăng ký trong hệ thống, yêu cầu đặt lại mật khẩu đã được xử lý. Vui lòng kiểm tra lại thông tin hoặc thử đăng nhập.")
                            </p>
                        </div>
                    }

                    <div class="d-flex justify-content-center gap-3 pt-3 border-top">
                        <a asp-action="Login" class="btn btn-outline-primary rounded-pill px-4 small fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i>@(isEn ? "Sign In" : "Đăng nhập")
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill px-4 small">
                            <i class="bi bi-house-door me-1"></i>@(isEn ? "Home" : "Trang chủ")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
