<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NET_Tutos.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:NET_Tutos.Mobile.Views"
    Title=".NET Tutos"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0B1120}"
    Shell.ForegroundColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
    Shell.TitleColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}"
    Shell.TabBarForegroundColor="#6366F1"
    Shell.TabBarTitleColor="#6366F1"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}">

    <TabBar Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}"
            Shell.TabBarForegroundColor="#6366F1"
            Shell.TabBarTitleColor="#6366F1"
            Shell.TabBarUnselectedColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}">
        <Tab Title="Trang chủ" Route="home" Icon="nav_home.png">
            <ShellContent
                Title="Trang chủ"
                ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>

        <Tab Title="Bài học" Route="tutorials" Icon="nav_tutorials.png">
            <ShellContent
                Title="Bài học"
                ContentTemplate="{DataTemplate views:TutorialsPage}" />
        </Tab>

        <Tab Title="Lộ trình" Route="roadmap" Icon="nav_roadmap.png">
            <ShellContent
                Title="Lộ trình"
                ContentTemplate="{DataTemplate views:RoadmapPage}" />
        </Tab>

        <Tab Title="Tài khoản" Route="login" Icon="nav_account.png">
            <ShellContent
                Title="Tài khoản"
                ContentTemplate="{DataTemplate views:LoginPage}" />
        </Tab>
    </TabBar>

</Shell>
