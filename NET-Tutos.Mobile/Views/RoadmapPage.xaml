<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NET_Tutos.Mobile.ViewModels"
             xmlns:models="clr-namespace:NET_Tutos.Mobile.Models"
             x:Class="NET_Tutos.Mobile.Views.RoadmapPage"
             x:DataType="vm:RoadmapViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B1120">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadRoadmapCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="18,22,18,24">
                
                <!-- Header Title Bar -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Lộ Trình Chuyên Nghiệp" TextColor="#F8FAFC" FontSize="22" FontAttributes="Bold" />
                    <Label Text="Con đường chuẩn hóa từ Zero đến Senior .NET Developer" TextColor="#94A3B8" FontSize="13" />
                </VerticalStackLayout>

                <!-- Roadmap Intro Banner with Radiant Gradient -->
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="#4338CA"
                        StrokeThickness="1.5"
                        Padding="18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E1B4B" Offset="0.0" />
                            <GradientStop Color="#0F172A" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#4F46E5"
                                BackgroundColor="#312E81"
                                WidthRequest="44"
                                HeightRequest="44"
                                VerticalOptions="Center">
                            <Label Text=".NET" TextColor="#A5B4FC" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="4 Giai Đoạn Chinh Phục .NET 10" TextColor="#A5B4FC" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Học tuần tự từng module để nắm vững từ cú pháp C#, tư duy OOP, kiến trúc EF Core đến thiết kế Web API enterprise."
                                   TextColor="#CBD5E1"
                                   FontSize="12"
                                   LineHeight="1.3" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Modules List with Distinct Accent Colors -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Modules}" Spacing="16">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:RoadmapModule">
                            <Border StrokeShape="RoundRectangle 18"
                                    Stroke="#1E293B"
                                    StrokeThickness="1"
                                    Padding="18"
                                    Margin="0,0,0,16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#141E33" Offset="0.0" />
                                        <GradientStop Color="#0F172A" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                            <Border StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="{Binding ModuleBgColor}"
                                                    Padding="8,4">
                                                <Label Text="{Binding ModuleTag}" TextColor="{Binding ModuleAccentColor}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="{Binding Title, StringFormat='Module {0}'}"
                                                   TextColor="#F8FAFC"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 10"
                                                Stroke="#334155"
                                                BackgroundColor="#111827"
                                                Padding="10,4"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding ProgressText}" TextColor="{Binding ModuleAccentColor}" FontSize="11" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding Description}" TextColor="#94A3B8" FontSize="12" LineHeight="1.3" />

                                    <!-- Progress Bar -->
                                    <ProgressBar Progress="{Binding ProgressPercent}" ProgressColor="{Binding ModuleAccentColor}" />

                                    <!-- Lessons in this module -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lessons}" Spacing="8" Margin="0,6,0,0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:TutorialSummary">
                                                <Border StrokeShape="RoundRectangle 12"
                                                        Stroke="#24324D"
                                                        BackgroundColor="#111827"
                                                        Padding="14,10">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoadmapViewModel}}, Path=OpenTutorialCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                        <BoxView Grid.Column="0" Color="{Binding CategoryAccentColor}" WidthRequest="6" HeightRequest="6" CornerRadius="3" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding Title}" TextColor="#E2E8F0" FontSize="13" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                                        <Border Grid.Column="2"
                                                                IsVisible="{Binding IsCompleted}"
                                                                StrokeShape="RoundRectangle 6"
                                                                BackgroundColor="#064E3B"
                                                                Padding="6,2">
                                                            <Label Text="✓" TextColor="#34D399" FontSize="11" FontAttributes="Bold" />
                                                        </Border>
                                                        <Label Grid.Column="2"
                                                               IsVisible="{Binding IsNotCompleted}"
                                                               Text="→"
                                                               TextColor="{Binding CategoryAccentColor}"
                                                               FontSize="14"
                                                               FontAttributes="Bold"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
