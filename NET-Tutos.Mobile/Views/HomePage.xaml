<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NET_Tutos.Mobile.ViewModels"
             xmlns:models="clr-namespace:NET_Tutos.Mobile.Models"
             x:Class="NET_Tutos.Mobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B1120">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadDataCommand}">
        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="18,24,18,24">
                
                <!-- Modern Top Brand Bar -->
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Border StrokeShape="RoundRectangle 12"
                                WidthRequest="40"
                                HeightRequest="40"
                                Stroke="#6366F1"
                                StrokeThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0.0" />
                                    <GradientStop Color="#7C3AED" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Label Text=".NET"
                                   TextColor="White"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="NET-Tutos" TextColor="#F8FAFC" FontSize="17" FontAttributes="Bold" />
                            <Label Text="C# 14 &amp; .NET 10" TextColor="#818CF8" FontSize="11" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Streak Badge -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 16"
                            Stroke="#D97706"
                            BackgroundColor="#451A03"
                            Padding="12,6"
                            VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <BoxView Color="#F59E0B" WidthRequest="6" HeightRequest="6" CornerRadius="3" VerticalOptions="Center" />
                            <Label Text="{Binding StreakBadgeText}"
                                   TextColor="#FDE68A"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Hero Greeting & Stats Card -->
                <Border StrokeShape="RoundRectangle 22"
                        Stroke="#4338CA"
                        StrokeThickness="1.5"
                        Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E1B4B" Offset="0.0" />
                            <GradientStop Color="#0F172A" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding GreetingText}"
                                   TextColor="#F8FAFC"
                                   FontSize="21"
                                   FontAttributes="Bold" />
                            <Label Text="Lộ trình học tập .NET 10 chuẩn mực &amp; thực chiến"
                                   TextColor="#A5B4FC"
                                   FontSize="13" />
                        </VerticalStackLayout>

                        <!-- Stats Row with distinct colors -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <!-- XP Stat: Sky Blue -->
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 14"
                                    Stroke="#0284C7"
                                    BackgroundColor="#082F49"
                                    Padding="10,12">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding User.TotalXp, FallbackValue=0}"
                                           TextColor="#38BDF8"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                    <Label Text="ĐIỂM XP"
                                           TextColor="#BAE6FD"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Level Stat: Mint Green -->
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 14"
                                    Stroke="#059669"
                                    BackgroundColor="#022C22"
                                    Padding="10,12">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding User.Level, FallbackValue=1}"
                                           TextColor="#34D399"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                    <Label Text="CẤP ĐỘ"
                                           TextColor="#A7F3D0"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Lessons Stat: Rose / Pink -->
                            <Border Grid.Column="2"
                                    StrokeShape="RoundRectangle 14"
                                    Stroke="#E11D48"
                                    BackgroundColor="#4C0519"
                                    Padding="10,12">
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                    <Label Text="{Binding User.CompletedLessonsCount, FallbackValue=0}"
                                           TextColor="#FB7185"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                    <Label Text="ĐÃ HỌC"
                                           TextColor="#FECDD3"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Featured Categories Section -->
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Chuyên Đề Lập Trình" TextColor="#F8FAFC" FontSize="18" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="Xem tất cả →" TextColor="#818CF8" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Categories}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryItem">
                                <!-- Category Card with Colorful Accent -->
                                <Border StrokeShape="RoundRectangle 18"
                                        Stroke="#24324D"
                                        WidthRequest="160"
                                        HeightRequest="120"
                                        Padding="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#141E33" Offset="0.0" />
                                            <GradientStop Color="#0F172A" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenCategoryCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                        <!-- Category Code Badge -->
                                        <Border StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{Binding IconBgColor}"
                                                Padding="8,4"
                                                HorizontalOptions="Start">
                                            <Label Text="{Binding CategoryCode}"
                                                   TextColor="{Binding AccentColor}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="{Binding Name}"
                                               TextColor="#F8FAFC"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding TutorialCount, StringFormat='{0} bài học'}"
                                               TextColor="#818CF8"
                                               FontSize="11"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Recent Tutorials Section -->
                <VerticalStackLayout Spacing="14">
                    <Label Text="Bài Học Mới Nhất" TextColor="#F8FAFC" FontSize="18" FontAttributes="Bold" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentTutorials}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TutorialSummary">
                                <Border StrokeShape="RoundRectangle 18"
                                        Stroke="#1E293B"
                                        StrokeThickness="1"
                                        Margin="0,0,0,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#141E33" Offset="0.0" />
                                            <GradientStop Color="#0F172A" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenTutorialCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    
                                    <Grid ColumnDefinitions="4,*" ColumnSpacing="12" Padding="0,0,16,0">
                                        <!-- Left Accent Stripe -->
                                        <BoxView Grid.Column="0"
                                                 Color="{Binding CategoryAccentColor}"
                                                 VerticalOptions="Fill" />

                                        <!-- Card Content -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="10" Padding="0,14,0,14">
                                            
                                            <!-- Badges Row -->
                                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                <Border Grid.Column="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Stroke="{Binding CategoryBorderColor}"
                                                        BackgroundColor="{Binding CategoryBgColor}"
                                                        Padding="8,3"
                                                        HorizontalOptions="Start">
                                                    <Label Text="{Binding CategoryName}"
                                                           TextColor="{Binding CategoryAccentColor}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           MaxLines="1"
                                                           LineBreakMode="TailTruncation"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <Border Grid.Column="1"
                                                        StrokeShape="RoundRectangle 8"
                                                        Stroke="{Binding DifficultyBorderColor}"
                                                        BackgroundColor="{Binding DifficultyBgColor}"
                                                        Padding="8,3"
                                                        HorizontalOptions="End">
                                                    <Label Text="{Binding DifficultyText}"
                                                           TextColor="{Binding DifficultyColor}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center" />
                                                </Border>
                                            </Grid>

                                            <!-- Title -->
                                            <Label Text="{Binding Title}"
                                                   TextColor="#F8FAFC"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   LineHeight="1.2"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation" />

                                            <!-- Summary -->
                                            <Label Text="{Binding Summary}"
                                                   TextColor="#94A3B8"
                                                   FontSize="12"
                                                   LineHeight="1.3"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation" />

                                            <!-- Bottom Row -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                                <Border Grid.Column="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        Stroke="#334155"
                                                        BackgroundColor="#111827"
                                                        Padding="8,3">
                                                    <Label Text="{Binding ReadingTimeDisplay}"
                                                           TextColor="#94A3B8"
                                                           FontSize="11" />
                                                </Border>

                                                <Border Grid.Column="2"
                                                        IsVisible="{Binding IsCompleted}"
                                                        StrokeShape="RoundRectangle 8"
                                                        Stroke="#059669"
                                                        BackgroundColor="#064E3B"
                                                        Padding="8,3">
                                                    <Label Text="✓ Đã học"
                                                           TextColor="#6EE7B7"
                                                           FontSize="11"
                                                           FontAttributes="Bold" />
                                                </Border>

                                                <Label Grid.Column="2"
                                                       IsVisible="{Binding IsNotCompleted}"
                                                       Text="Khám phá →"
                                                       TextColor="#818CF8"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center" />
                                            </Grid>

                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
