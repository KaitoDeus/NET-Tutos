<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NET_Tutos.Mobile.ViewModels"
             xmlns:models="clr-namespace:NET_Tutos.Mobile.Models"
             x:Class="NET_Tutos.Mobile.Views.TutorialDetailPage"
             x:DataType="vm:TutorialDetailViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B1120">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="18,22,18,30">
            
            <!-- Top Navigation Bar -->
            <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                <Button Grid.Column="0"
                        Text="← Quay lại"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="#111827"
                        BorderColor="#334155"
                        BorderWidth="1"
                        TextColor="#A5B4FC"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="40"
                        Padding="16,0" />
            </Grid>

            <!-- Article Header Card with Subtle Gradient -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="#1E293B"
                    StrokeThickness="1"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#141E33" Offset="0.0" />
                        <GradientStop Color="#0F172A" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="{Binding Tutorial.CategoryBgColor}"
                                Padding="10,4">
                            <Label Text="{Binding Tutorial.CategoryName}" TextColor="{Binding Tutorial.CategoryAccentColor}" FontSize="11" FontAttributes="Bold" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="{Binding Tutorial.DifficultyBgColor}"
                                Padding="10,4">
                            <Label Text="{Binding Tutorial.DifficultyText}" TextColor="{Binding Tutorial.DifficultyColor}" FontSize="11" FontAttributes="Bold" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="#111827"
                                Padding="10,4">
                            <Label Text="{Binding Tutorial.EstimatedReadingMinutes, StringFormat='⏱️ ~{0} phút đọc'}" TextColor="#94A3B8" FontSize="11" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="{Binding Tutorial.Title}" TextColor="#F8FAFC" FontSize="21" FontAttributes="Bold" LineHeight="1.25" />

                    <Label Text="{Binding Tutorial.Summary}" TextColor="#94A3B8" FontSize="13" LineHeight="1.4" />
                </VerticalStackLayout>
            </Border>

            <!-- Markdown Content Body -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="#1E293B"
                    BackgroundColor="#0F172A"
                    Padding="20">
                <Label Text="{Binding Tutorial.ContentMarkdown}"
                       TextColor="#E2E8F0"
                       FontSize="14"
                       LineHeight="1.6" />
            </Border>

            <!-- Complete Lesson Action Box with Gradient -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="#4338CA"
                    StrokeThickness="1.5"
                    Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E1B4B" Offset="0.0" />
                        <GradientStop Color="#0F172A" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="🏆" FontSize="20" VerticalOptions="Center" />
                        <Label Text="Ghi Nhận Tiến Độ Học Tập" TextColor="#F8FAFC" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Hoàn thành bài đọc để nhận ngay +20 XP điểm kinh nghiệm và duy trì chuỗi Streak của bạn."
                           TextColor="#CBD5E1"
                           FontSize="12"
                           LineHeight="1.3" />

                    <Button Text="{Binding CompletionButtonText}"
                            Command="{Binding ToggleCompleteCommand}"
                            BackgroundColor="{Binding CompletionButtonColor}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="48"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <!-- Quick Knowledge Quiz Section -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding Quizzes.Count}">
                <Label Text="Trắc Nghiệm Ôn Tập Nhanh" TextColor="#F8FAFC" FontSize="18" FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding Quizzes}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QuizItem">
                            <Border StrokeShape="RoundRectangle 18"
                                    Stroke="#1E293B"
                                    BackgroundColor="#0F172A"
                                    Padding="18"
                                    Margin="0,0,0,14">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="{Binding QuestionText}" TextColor="#F8FAFC" FontSize="14" FontAttributes="Bold" />

                                    <VerticalStackLayout Spacing="8">
                                        <Border StrokeShape="RoundRectangle 10" Stroke="#334155" BackgroundColor="#111827" Padding="14,10">
                                            <Label Text="{Binding OptionA, StringFormat='A. {0}'}" TextColor="#CBD5E1" FontSize="13" />
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 10" Stroke="#334155" BackgroundColor="#111827" Padding="14,10">
                                            <Label Text="{Binding OptionB, StringFormat='B. {0}'}" TextColor="#CBD5E1" FontSize="13" />
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 10" Stroke="#334155" BackgroundColor="#111827" Padding="14,10">
                                            <Label Text="{Binding OptionC, StringFormat='C. {0}'}" TextColor="#CBD5E1" FontSize="13" />
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 10" Stroke="#334155" BackgroundColor="#111827" Padding="14,10">
                                            <Label Text="{Binding OptionD, StringFormat='D. {0}'}" TextColor="#CBD5E1" FontSize="13" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Correct Answer Banner -->
                                    <Border StrokeShape="RoundRectangle 10"
                                            Stroke="#059669"
                                            BackgroundColor="#064E3B"
                                            Padding="12,8">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding CorrectAnswer, StringFormat='Đáp án đúng: {0}'}"
                                                   TextColor="#6EE7B7"
                                                   FontSize="12"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Explanation}"
                                                   TextColor="#D1FAE5"
                                                   FontSize="11" />
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
