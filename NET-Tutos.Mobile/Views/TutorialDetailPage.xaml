<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NET_Tutos.Mobile.ViewModels"
             xmlns:models="clr-namespace:NET_Tutos.Mobile.Models"
             x:Class="NET_Tutos.Mobile.Views.TutorialDetailPage"
             x:DataType="vm:TutorialDetailViewModel"
             Title="{Binding Title}"
             BackgroundColor="#0b0f19">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="18">
            <!-- Article Header -->
            <Border StrokeShape="RoundRectangle 18"
                    Stroke="#1e293b"
                    BackgroundColor="#0f172a"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Border StrokeShape="RoundRectangle 12" Stroke="#4338ca" BackgroundColor="#312e81" Padding="10,4">
                            <Label Text="{Binding Tutorial.CategoryName}" TextColor="#a5b4fc" FontSize="11" FontAttributes="Bold" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 12" Stroke="#334155" BackgroundColor="#1e293b" Padding="10,4">
                            <Label Text="{Binding Tutorial.Difficulty}" TextColor="#94a3b8" FontSize="11" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 12" Stroke="#334155" BackgroundColor="#1e293b" Padding="10,4">
                            <Label Text="{Binding Tutorial.EstimatedReadingMinutes, StringFormat='~{0} phút'}" TextColor="#94a3b8" FontSize="11" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="{Binding Tutorial.Title}" TextColor="White" FontSize="22" FontAttributes="Bold" />

                    <Label Text="{Binding Tutorial.Summary}" TextColor="#94a3b8" FontSize="13" LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Markdown Content Body -->
            <Border StrokeShape="RoundRectangle 18"
                    Stroke="#1e293b"
                    BackgroundColor="#0f172a"
                    Padding="18">
                <Label Text="{Binding Tutorial.ContentMarkdown}"
                       TextColor="#e2e8f0"
                       FontSize="14"
                       LineHeight="1.5" />
            </Border>

            <!-- Complete Lesson Action Box -->
            <Border StrokeShape="RoundRectangle 18"
                    Stroke="#1e293b"
                    BackgroundColor="#0f172a"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Ghi Nhận Tiến Độ Học Tập" TextColor="White" FontSize="16" FontAttributes="Bold" />
                    <Label Text="Hoàn thành bài đọc để nhận ngay +20 XP điểm kinh nghiệm và duy trì chuỗi Streak của bạn."
                           TextColor="#94a3b8"
                           FontSize="12" />

                    <Button Text="{Binding CompletionButtonText}"
                            Command="{Binding ToggleCompleteCommand}"
                            BackgroundColor="{Binding CompletionButtonColor}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="48"
                            IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <!-- Quick Knowledge Quiz -->
            <VerticalStackLayout Spacing="14" IsVisible="{Binding Quizzes.Count}">
                <Label Text="Trắc Nghiệm Ôn Tập Nhanh" TextColor="White" FontSize="17" FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding Quizzes}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:QuizItem">
                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="#1e293b"
                                    BackgroundColor="#0f172a"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="{Binding QuestionText}" TextColor="White" FontSize="14" FontAttributes="Bold" />

                                    <VerticalStackLayout Spacing="6">
                                        <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1e293b" Padding="12,8">
                                            <Label Text="{Binding OptionA, StringFormat='A. {0}'}" TextColor="#cbd5e1" FontSize="13" />
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1e293b" Padding="12,8">
                                            <Label Text="{Binding OptionB, StringFormat='B. {0}'}" TextColor="#cbd5e1" FontSize="13" />
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1e293b" Padding="12,8">
                                            <Label Text="{Binding OptionC, StringFormat='C. {0}'}" TextColor="#cbd5e1" FontSize="13" />
                                        </Border>
                                        <Border StrokeShape="RoundRectangle 8" Stroke="#334155" BackgroundColor="#1e293b" Padding="12,8">
                                            <Label Text="{Binding OptionD, StringFormat='D. {0}'}" TextColor="#cbd5e1" FontSize="13" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Correct Answer & Explanation -->
                                    <Border StrokeShape="RoundRectangle 8" Stroke="#065f46" BackgroundColor="#064e3b" Padding="12,8" Margin="0,4,0,0">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding CorrectOption, StringFormat='✓ Đáp án chính xác: {0}'}" TextColor="#6ee7b7" FontSize="12" FontAttributes="Bold" />
                                            <Label Text="{Binding Explanation}" TextColor="#a7f3d0" FontSize="12" />
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Navigation Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,30">
                <Button Grid.Column="0"
                        Text="← Bài Trước"
                        Command="{Binding NavigatePrevCommand}"
                        BackgroundColor="#1e293b"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="44" />

                <Button Grid.Column="1"
                        Text="Bài Kế Tiếp →"
                        Command="{Binding NavigateNextCommand}"
                        BackgroundColor="#6366f1"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="44" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
