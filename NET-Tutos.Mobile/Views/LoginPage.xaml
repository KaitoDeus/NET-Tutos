<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NET_Tutos.Mobile.ViewModels"
             x:Class="NET_Tutos.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B1120">

    <ScrollView>
        <VerticalStackLayout Spacing="22" Padding="24,36,24,36" VerticalOptions="Center">
            
            <!-- Platform Pill Badge -->
            <Border StrokeShape="RoundRectangle 20"
                    Stroke="#312E81"
                    BackgroundColor="#1E1B4B"
                    Padding="14,6"
                    HorizontalOptions="Center">
                <Label Text="NỀN TẢNG HỌC LẬP TRÌNH .NET 10"
                       TextColor="#A5B4FC"
                       FontSize="11"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </Border>

            <!-- App Logo & Branding -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border StrokeShape="RoundRectangle 26"
                        StrokeThickness="2"
                        WidthRequest="88"
                        HeightRequest="88"
                        HorizontalOptions="Center">
                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0.0" />
                            <GradientStop Color="#A855F7" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1E1B4B" Offset="0.0" />
                            <GradientStop Color="#0F172A" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                        <Label Text=".NET" 
                               TextColor="#818CF8" 
                               FontSize="26" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" />
                        <Label Text="C# 14" 
                               TextColor="#C084FC" 
                               FontSize="11" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center" 
                               Margin="0,-3,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Label Text=".NET Tutos"
                       TextColor="#F8FAFC"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label Text="Làm chủ C# &amp; ASP.NET Core từ thiết bị di động"
                       TextColor="#94A3B8"
                       FontSize="13"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Quick Demo Helper Card -->
            <Border StrokeShape="RoundRectangle 14"
                    Stroke="#1E293B"
                    BackgroundColor="#0F172A"
                    Padding="14,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="#1E293B"
                            Padding="6,3"
                            VerticalOptions="Center">
                        <Label Text="DEMO" TextColor="#818CF8" FontSize="10" FontAttributes="Bold" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Tài khoản học viên trải nghiệm:"
                               TextColor="#CBD5E1"
                               FontSize="11"
                               FontAttributes="Bold" />
                        <Label Text="student@nettutos.com / StudentPassword@123"
                               TextColor="#818CF8"
                               FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border IsVisible="{Binding HasError}"
                    BackgroundColor="#450A0A"
                    Stroke="#DC2626"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FCA5A5"
                       FontSize="13" />
            </Border>

            <!-- Input Fields -->
            <VerticalStackLayout Spacing="14">
                <!-- Username/Email Input -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Tài khoản hoặc Email" TextColor="#CBD5E1" FontSize="13" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 14" 
                            Stroke="#334155" 
                            BackgroundColor="#111827" 
                            Padding="14,2">
                        <Entry Text="{Binding UsernameOrEmail}"
                               Placeholder="vd: student@nettutos.com"
                               PlaceholderColor="#64748B"
                               TextColor="#F8FAFC"
                               FontSize="14"
                               HeightRequest="46" />
                    </Border>
                </VerticalStackLayout>

                <!-- Password Input -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mật khẩu" TextColor="#CBD5E1" FontSize="13" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 14" 
                            Stroke="#334155" 
                            BackgroundColor="#111827" 
                            Padding="14,2">
                        <Entry Text="{Binding Password}"
                               IsPassword="True"
                               Placeholder="Nhập mật khẩu của bạn..."
                               PlaceholderColor="#64748B"
                               TextColor="#F8FAFC"
                               FontSize="14"
                               HeightRequest="46" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Action Buttons -->
            <VerticalStackLayout Spacing="10" Margin="0,6,0,0">
                <!-- Primary Login Button with Gradient -->
                <Button Text="Đăng Nhập Ngay"
                        Command="{Binding LoginCommand}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="14"
                        HeightRequest="50"
                        IsEnabled="{Binding IsNotBusy}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4F46E5" Offset="0.0" />
                            <GradientStop Color="#7C3AED" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <!-- Guest Button -->
                <Button Text="Khám Phá Dưới Tên Khách"
                        Command="{Binding ContinueAsGuestCommand}"
                        BackgroundColor="#0F172A"
                        BorderColor="#1E293B"
                        BorderWidth="1"
                        TextColor="#CBD5E1"
                        FontSize="13"
                        CornerRadius="14"
                        HeightRequest="46" />
            </VerticalStackLayout>

            <!-- Server URL Config Toggle -->
            <VerticalStackLayout Spacing="8" Margin="0,4,0,0">
                <Button Text="Thiết lập địa chỉ API Server"
                        Command="{Binding ToggleServerConfigCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#64748B"
                        FontSize="12"
                        HeightRequest="32" />

                <VerticalStackLayout IsVisible="{Binding IsConfiguringServer}" Spacing="8">
                    <Border StrokeShape="RoundRectangle 10" Stroke="#334155" BackgroundColor="#111827" Padding="12,2">
                        <Entry Text="{Binding ServerUrl}"
                               TextColor="#F8FAFC"
                               FontSize="12" />
                    </Border>
                    <Button Text="Lưu Địa Chỉ Máy Chủ"
                            Command="{Binding SaveServerUrlCommand}"
                            BackgroundColor="#1E293B"
                            TextColor="#A5B4FC"
                            FontSize="12"
                            HeightRequest="38"
                            CornerRadius="10" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#6366F1"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
