<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NET_Tutos.Mobile.ViewModels"
             xmlns:models="clr-namespace:NET_Tutos.Mobile.Models"
             x:Class="NET_Tutos.Mobile.Views.TutorialsPage"
             x:DataType="vm:TutorialsViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B1120">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="18,22,18,0">
        
        <!-- Header Title Bar -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <Label Text="Kho Bài Học Thực Chiến" TextColor="#F8FAFC" FontSize="22" FontAttributes="Bold" />
            <Label Text="Khám phá các bài học chuyên sâu C# 14 &amp; .NET 10" TextColor="#94A3B8" FontSize="13" />
        </VerticalStackLayout>

        <!-- Modern Search Bar -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 16"
                Stroke="#334155"
                BackgroundColor="#111827"
                Padding="12,0"
                Margin="0,0,0,14">
            <SearchBar Text="{Binding SearchQuery}"
                       Placeholder="Tìm kiếm bài học C#, cú pháp..."
                       PlaceholderColor="#64748B"
                       TextColor="#F8FAFC"
                       SearchCommand="{Binding PerformSearchCommand}"
                       BackgroundColor="Transparent" />
        </Border>

        <!-- Category Horizontal Filter Chips -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Categories}"
                        HeightRequest="42"
                        Margin="0,0,0,14">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryItem">
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="{Binding ChipBorderColor}"
                            BackgroundColor="{Binding ChipBgColor}"
                            Padding="14,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TutorialsViewModel}}, Path=SelectCategoryCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding IconEmoji}" FontSize="12" VerticalOptions="Center" />
                            <Label Text="{Binding Name}"
                                   TextColor="{Binding ChipTextColor}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Tutorials List with Pull-to-refresh -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadTutorialsCommand}">
            <CollectionView ItemsSource="{Binding Tutorials}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TutorialSummary">
                        <!-- Vibrant Card with Left Color Accent Indicator -->
                        <Border StrokeShape="RoundRectangle 18"
                                Stroke="#1E293B"
                                StrokeThickness="1"
                                Margin="0,0,0,14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#141E33" Offset="0.0" />
                                    <GradientStop Color="#0F172A" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TutorialsViewModel}}, Path=OpenTutorialCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="4,*" ColumnSpacing="12" Padding="0,0,16,0">
                                <!-- Left Category Accent Stripe -->
                                <BoxView Grid.Column="0"
                                         Color="{Binding CategoryAccentColor}"
                                         VerticalOptions="Fill" />

                                <!-- Main Card Content -->
                                <VerticalStackLayout Grid.Column="1" Spacing="10" Padding="0,14,0,14">
                                    
                                    <!-- Badges Row: Category on left, Difficulty on right -->
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <!-- Category Tag with matching topic color -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="{Binding CategoryBorderColor}"
                                                BackgroundColor="{Binding CategoryBgColor}"
                                                Padding="8,3"
                                                HorizontalOptions="Start">
                                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                                <Label Text="{Binding CategoryIcon}" FontSize="11" VerticalOptions="Center" />
                                                <Label Text="{Binding CategoryName}"
                                                       TextColor="{Binding CategoryAccentColor}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!-- Difficulty Tag with glowing difficulty color -->
                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="{Binding DifficultyBorderColor}"
                                                BackgroundColor="{Binding DifficultyBgColor}"
                                                Padding="8,3"
                                                HorizontalOptions="End">
                                            <Label Text="{Binding DifficultyText}"
                                                   TextColor="{Binding DifficultyColor}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Title -->
                                    <Label Text="{Binding Title}"
                                           TextColor="#F8FAFC"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           LineHeight="1.2"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Summary -->
                                    <Label Text="{Binding Summary}"
                                           TextColor="#94A3B8"
                                           FontSize="12"
                                           LineHeight="1.3"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Bottom Info Row -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                        <!-- Reading Time Pill -->
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="#334155"
                                                BackgroundColor="#111827"
                                                Padding="8,3">
                                            <Label Text="{Binding ReadingTimeDisplay}"
                                                   TextColor="#94A3B8"
                                                   FontSize="11" />
                                        </Border>

                                        <!-- Right Action: Completed badge or Start Learning link -->
                                        <Border Grid.Column="2"
                                                IsVisible="{Binding IsCompleted}"
                                                StrokeShape="RoundRectangle 8"
                                                Stroke="#059669"
                                                BackgroundColor="#064E3B"
                                                Padding="8,3">
                                            <Label Text="✓ Đã học"
                                                   TextColor="#6EE7B7"
                                                   FontSize="11"
                                                   FontAttributes="Bold" />
                                        </Border>

                                        <Label Grid.Column="2"
                                               IsVisible="{Binding IsNotCompleted}"
                                               Text="Khám phá →"
                                               TextColor="#818CF8"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
