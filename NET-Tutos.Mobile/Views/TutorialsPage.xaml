<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NET_Tutos.Mobile.ViewModels"
             xmlns:models="clr-namespace:NET_Tutos.Mobile.Models"
             x:Class="NET_Tutos.Mobile.Views.TutorialsPage"
             x:DataType="vm:TutorialsViewModel"
             Title="{Binding Title}"
             BackgroundColor="#0b0f19">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16,16,16,0">
        <!-- Search Bar -->
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 14"
                Stroke="#334155"
                BackgroundColor="#1e293b"
                Padding="12,0"
                Margin="0,0,0,12">
            <SearchBar Text="{Binding SearchQuery}"
                       Placeholder="Tìm kiếm bài học C#, cú pháp..."
                       PlaceholderColor="#64748b"
                       TextColor="White"
                       SearchCommand="{Binding PerformSearchCommand}"
                       BackgroundColor="Transparent" />
        </Border>

        <!-- Category Horizontal Filter Chips -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Categories}"
                        HeightRequest="42"
                        Margin="0,0,0,14">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryItem">
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="#334155"
                            BackgroundColor="#1e293b"
                            Padding="14,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TutorialsViewModel}}, Path=SelectCategoryCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Name}"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Tutorials List with Pull-to-refresh -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadTutorialsCommand}">
            <CollectionView ItemsSource="{Binding Tutorials}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TutorialSummary">
                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="#1e293b"
                                BackgroundColor="#0f172a"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TutorialsViewModel}}, Path=OpenTutorialCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Title}"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <Border Grid.Row="0" Grid.Column="1"
                                        IsVisible="{Binding IsCompleted}"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="#059669"
                                        BackgroundColor="#064e3b"
                                        Padding="8,4"
                                        VerticalOptions="Start">
                                    <Label Text="✓ Đã học" TextColor="#6ee7b7" FontSize="11" FontAttributes="Bold" />
                                </Border>

                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding Summary}"
                                       TextColor="#94a3b8"
                                       FontSize="12"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       Margin="0,4,0,8" />

                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="10">
                                    <Label Text="{Binding CategoryName}" TextColor="#818cf8" FontSize="11" FontAttributes="Bold" />
                                    <Label Text="•" TextColor="#64748b" FontSize="11" />
                                    <Label Text="{Binding ReadingTimeDisplay}" TextColor="#94a3b8" FontSize="11" />
                                    <Label Text="•" TextColor="#64748b" FontSize="11" />
                                    <Label Text="{Binding Difficulty}" TextColor="#cbd5e1" FontSize="11" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
